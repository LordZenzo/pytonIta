"""Crea gli esempi della galleria (cartelle RAD/esempi/<id>/). Si esegue una volta: pitonit _genera.pit   (rigenera tutto)."""
importa json
importa os
importa shutil
importa sqlite3
importa sys

QUI = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(QUI))
da rad importa form_modello, maschera_dati
da rad.form_modello importa Form


definisci scrivi(cartella, nome_file, testo_):
    percorso = os.path.join(cartella, nome_file)
    os.makedirs(os.path.dirname(percorso), exist_ok=Vero)
    con open(percorso, "w", encoding="utf-8", newline="\n") come f:
        f.write(testo_.strip("\n") + "\n")


definisci nuovo_esempio(id_, titolo, descrizione, livello, categoria, impara, principale="principale.pit"):
    cartella = os.path.join(QUI, id_)
    se os.path.exists(cartella):
        shutil.rmtree(cartella)
    os.makedirs(cartella)
    scrivi(cartella, "esempio.json", json.dumps({"id": id_, "titolo": titolo, "descrizione": descrizione, "livello": livello, "categoria": categoria,
                                                  "impara": impara, "principale": principale}, indent=2, ensure_ascii=Falso))
    scrivi(cartella, "progetto.rad.json", json.dumps({"nome": titolo, "principale": principale, "descrizione": descrizione, "argomenti": ", ".join(impara),
                                                       "creato": "", "modello": "esempio"}, indent=2, ensure_ascii=Falso))
    ritorna cartella


# ====================================================================== console
c = nuovo_esempio("indovina_il_numero", "Indovina il numero", "Il computer pensa a un numero da 1 a 100: hai 7 tentativi, ti dice se è troppo alto o basso.",
                  "Principiante", "Console", ["numeri casuali", "ciclo per", "se / altrimenti", "leggi e stampa"])
scrivi(c, "principale.pit", '''
"""Indovina il numero: il computer ne sceglie uno da 1 a 100 e tu hai 7 tentativi."""
importa random
importa sys

TENTATIVI = 7


definisci gioca():
    segreto = random.randint(1, 100)
    stampa(f"Ho pensato a un numero da 1 a 100. Hai {TENTATIVI} tentativi!")
    per tentativo in intervallo_di(1, TENTATIVI + 1):
        risposta = leggi_tastiera(f"Tentativo {tentativo}: ")
        se non risposta.isdigit():
            stampa("Scrivi un numero intero.")
            continua
        numero = tipo_intero(risposta)
        se numero == segreto:
            stampa(f"Bravo! L'hai indovinato in {tentativo} tentativi.")
            ritorna Vero
        altrimenti_se numero < segreto:
            stampa("Troppo basso")
        altrimenti:
            stampa("Troppo alto")
    stampa(f"Peccato, era {segreto}.")
    ritorna Falso


se lunghezza_di(sys.argv) > 1:
    random.seed(tipo_intero(sys.argv[1]))        # per ripetere sempre la stessa partita (prova: principale.pit 5)
gioca()
''')

c = nuovo_esempio("tabelline", "Le tabelline", "Scrivi un numero e il programma stampa la sua tabellina, con una riga per ogni moltiplicazione.",
                  "Principiante", "Console", ["leggi un numero", "ciclo per", "f-string", "funzioni"])
scrivi(c, "principale.pit", '''
"""Le tabelline: scrivi un numero e vedi la sua tabellina."""


definisci tabellina(n, fino_a=10):
    """Le righe della tabellina di n, da 1 a fino_a."""
    ritorna [f"{n} x {i:>2} = {n * i:>3}" per i in intervallo_di(1, fino_a + 1)]


mentre Vero:
    risposta = leggi_tastiera("Di che numero vuoi la tabellina? (invio per uscire) ")
    se risposta == "":
        interrompi
    se non risposta.isdigit():
        stampa("Serve un numero intero positivo.")
        continua
    stampa(f"--- Tabellina del {risposta} ---")
    per riga in tabellina(tipo_intero(risposta)):
        stampa(riga)
stampa("Ciao!")
''')

c = nuovo_esempio("rubrica_json", "Rubrica di contatti", "Una rubrica da console: aggiungi, cerca ed elenca i contatti. I dati restano salvati in un file JSON.",
                  "Intermedio", "Console", ["dizionari e liste", "file JSON", "funzioni", "menu con ciclo mentre"])
scrivi(c, "principale.pit", '''
"""Rubrica di contatti: i dati vengono salvati in rubrica.json accanto al programma."""
importa json
importa os

FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rubrica.json")


definisci carica():
    se os.path.exists(FILE):
        con open(FILE, encoding="utf-8") come f:
            ritorna json.load(f)
    ritorna {}


definisci salva(contatti):
    con open(FILE, "w", encoding="utf-8") come f:
        json.dump(contatti, f, indent=2, ensure_ascii=Falso)


definisci aggiungi(contatti):
    nome = leggi_tastiera("Nome: ").strip()
    se non nome:
        stampa("Il nome non può essere vuoto.")
        ritorna
    contatti[nome] = {"telefono": leggi_tastiera("Telefono: ").strip(), "email": leggi_tastiera("Email: ").strip()}
    salva(contatti)
    stampa(f"Salvato: {nome}")


definisci cerca(contatti):
    parte = leggi_tastiera("Cerca: ").strip().lower()
    trovati = [n per n in contatti se parte in n.lower()]
    se non trovati:
        stampa("Nessun contatto trovato.")
    per nome in trovati:
        stampa(f"{nome}  {contatti[nome]['telefono']}  {contatti[nome]['email']}")


definisci elenco(contatti):
    se non contatti:
        stampa("La rubrica è vuota.")
    per nome in sorted(contatti):
        stampa(f"- {nome}: {contatti[nome]['telefono']}")


contatti = carica()
mentre Vero:
    scelta = leggi_tastiera("[a]ggiungi, [c]erca, [e]lenco, [u]sci: ").strip().lower()
    se scelta == "a":
        aggiungi(contatti)
    altrimenti_se scelta == "c":
        cerca(contatti)
    altrimenti_se scelta == "e":
        elenco(contatti)
    altrimenti_se scelta == "u":
        interrompi
    altrimenti:
        stampa("Scelta non valida.")
stampa("Alla prossima!")
''')

c = nuovo_esempio("conta_parole", "Conta le parole", "Incolla un testo e il programma conta le parole e mostra le cinque più usate.",
                  "Intermedio", "Console", ["stringhe", "dizionari", "ordinare", "cicli"])
scrivi(c, "principale.pit", '''
"""Conta le parole di un testo e mostra le più frequenti."""


definisci parole_di(testo):
    """Le parole in minuscolo, senza punteggiatura."""
    pulito = "".join(c se (c.isalnum() o c.isspace()) altrimenti " " per c in testo.lower())
    ritorna pulito.split()


definisci frequenze(parole):
    conteggio = {}
    per p in parole:
        conteggio[p] = conteggio.get(p, 0) + 1
    ritorna conteggio


stampa("Scrivi il testo (una riga vuota per finire):")
righe = []
mentre Vero:
    riga = leggi_tastiera("")
    se riga == "":
        interrompi
    righe.append(riga)
parole = parole_di(" ".join(righe))
stampa(f"Parole: {lunghezza_di(parole)}   Diverse: {lunghezza_di(set(parole))}")
conteggio = frequenze(parole)
piu_usate = sorted(conteggio.items(), key=lambda coppia: (-coppia[1], coppia[0]))[:5]
per parola, quante in piu_usate:
    stampa(f"{parola:<12} {'#' * quante} {quante}")
''')


# ====================================================================== finestre
definisci logica(cartella, nome_form, testo_):
    scrivi(cartella, nome_form.lower() + ".pit", testo_)


# ---- Calcolatrice
c = nuovo_esempio("calcolatrice", "Calcolatrice", "Due numeri e quattro pulsanti: somma, sottrazione, moltiplicazione e divisione.",
                  "Principiante", "Finestre", ["campi di testo e pulsanti", "gestori degli eventi", "gestire gli errori"], "calcolatrice.pit")
f = Form("Calcolatrice", "Calcolatrice")
f.aspetto = "chiaro"
f.larghezza, f.altezza = 340, 230
f.aggiungi("Etichetta", 16, 18, nome="etichetta_a", testo="Primo numero", larghezza=100)
f.aggiungi("CampoTesto", 124, 16, nome="campo_a", larghezza=190, altezza=28)
f.aggiungi("Etichetta", 16, 56, nome="etichetta_b", testo="Secondo numero", larghezza=100)
f.aggiungi("CampoTesto", 124, 54, nome="campo_b", larghezza=190, altezza=28, al_invio="somma_clic")
per i, (nome, testo_, gestore) in enumera((("pulsante_somma", "+", "somma_clic"), ("pulsante_sottrai", "−", "sottrai_clic"),
                                            ("pulsante_per", "×", "moltiplica_clic"), ("pulsante_diviso", "÷", "dividi_clic"))):
    f.aggiungi("Pulsante", 16 + i * 79, 100, nome=nome, testo=testo_, larghezza=70, altezza=36, al_clic=gestore, carattere="Segoe UI 14 bold")
f.aggiungi("Etichetta", 16, 154, nome="risultato", testo="Risultato:", larghezza=300, altezza=40, carattere="Segoe UI 16 bold")
form_modello.salva_form(f, c)
logica(c, "Calcolatrice", '''"""Logica della Calcolatrice: legge i due numeri, calcola e scrive il risultato."""
importa interfaccia come tk
da calcolatrice_ui importa CalcolatriceUI


classe Calcolatrice(CalcolatriceUI):
    definisci __inizializza__(se_stesso, radice):
        se_stesso.costruisci_ui(radice)

    definisci _numeri(se_stesso):
        """I due numeri scritti dall'utente (la virgola va bene), oppure None se uno non è valido."""
        prova:
            ritorna float(se_stesso.campo_a.get().replace(",", ".")), float(se_stesso.campo_b.get().replace(",", "."))
        eccetto ValueError:
            se_stesso.risultato.configure(text="Scrivi due numeri")
            ritorna Nessuno

    definisci _mostra(se_stesso, valore):
        se_stesso.risultato.configure(text=f"Risultato: {valore:g}")

    definisci somma_clic(se_stesso, evento=Nessuno):
        n = se_stesso._numeri()
        se n:
            se_stesso._mostra(n[0] + n[1])

    definisci sottrai_clic(se_stesso, evento=Nessuno):
        n = se_stesso._numeri()
        se n:
            se_stesso._mostra(n[0] - n[1])

    definisci moltiplica_clic(se_stesso, evento=Nessuno):
        n = se_stesso._numeri()
        se n:
            se_stesso._mostra(n[0] * n[1])

    definisci dividi_clic(se_stesso, evento=Nessuno):
        n = se_stesso._numeri()
        se n:
            se n[1] == 0:
                se_stesso.risultato.configure(text="Non si divide per zero")
            altrimenti:
                se_stesso._mostra(n[0] / n[1])


se __nome__ == "__main__":
    radice = tk.Finestra()
    finestra = Calcolatrice(radice)
    radice.ciclo_principale()
''')

# ---- Convertitore di temperature
c = nuovo_esempio("convertitore_temperature", "Convertitore di temperature", "Scrivi i gradi Celsius e vedi subito Fahrenheit e Kelvin.",
                  "Principiante", "Finestre", ["calcoli con i decimali", "formattare i numeri", "tasto Invio"], "temperature.pit")
f = Form("Temperature", "Convertitore di temperature")
f.aspetto = "verde"
f.larghezza, f.altezza = 360, 220
f.aggiungi("Etichetta", 16, 20, nome="etichetta_c", testo="Gradi Celsius:", larghezza=110)
f.aggiungi("CampoTesto", 132, 18, nome="campo_celsius", larghezza=120, altezza=28, al_invio="converti_clic")
f.aggiungi("Pulsante", 262, 16, nome="pulsante_converti", testo="Converti", larghezza=84, altezza=32, al_clic="converti_clic")
f.aggiungi("Etichetta", 16, 80, nome="fahrenheit", testo="Fahrenheit: —", larghezza=320, altezza=30, carattere="Segoe UI 14")
f.aggiungi("Etichetta", 16, 120, nome="kelvin", testo="Kelvin: —", larghezza=320, altezza=30, carattere="Segoe UI 14")
f.aggiungi("Etichetta", 16, 168, nome="messaggio", testo="", larghezza=320, altezza=24, primo_piano="#b00020")
form_modello.salva_form(f, c)
logica(c, "Temperature", '''"""Convertitore di temperature."""
importa interfaccia come tk
da temperature_ui importa TemperatureUI


definisci celsius_in_fahrenheit(c):
    ritorna c * 9 / 5 + 32


definisci celsius_in_kelvin(c):
    ritorna c + 273.15


classe Temperature(TemperatureUI):
    definisci __inizializza__(se_stesso, radice):
        se_stesso.costruisci_ui(radice)
        se_stesso.campo_celsius.focus_set()

    definisci converti_clic(se_stesso, evento=Nessuno):
        prova:
            c = float(se_stesso.campo_celsius.get().replace(",", "."))
        eccetto ValueError:
            se_stesso.messaggio.configure(text="Scrivi un numero, per esempio 21,5")
            ritorna
        se c < -273.15:
            se_stesso.messaggio.configure(text="Sotto lo zero assoluto non si può")
            ritorna
        se_stesso.messaggio.configure(text="")
        se_stesso.fahrenheit.configure(text=f"Fahrenheit: {celsius_in_fahrenheit(c):.1f} °F")
        se_stesso.kelvin.configure(text=f"Kelvin: {celsius_in_kelvin(c):.2f} K")


se __nome__ == "__main__":
    radice = tk.Finestra()
    finestra = Temperature(radice)
    radice.ciclo_principale()
''')

# ---- Lista della spesa
c = nuovo_esempio("lista_della_spesa", "Lista della spesa", "Aggiungi e togli le cose da comprare: la lista resta salvata in un file di testo.",
                  "Intermedio", "Finestre", ["elenchi", "leggere e scrivere file", "ancoraggio ai bordi"], "spesa.pit")
f = Form("Spesa", "Lista della spesa")
f.aspetto = "chiaro"
f.larghezza, f.altezza = 380, 400
f.aggiungi("CampoTesto", 16, 16, nome="campo_voce", larghezza=250, altezza=28, al_invio="aggiungi_clic", ancoraggio="sd")
f.aggiungi("Pulsante", 276, 14, nome="pulsante_aggiungi", testo="Aggiungi", larghezza=88, altezza=32, al_clic="aggiungi_clic", ancoraggio="ds")
f.aggiungi("Elenco", 16, 58, nome="elenco_voci", larghezza=348, altezza=280, ancoraggio="sadb", al_selezione="scelta_voce")
f.aggiungi("Pulsante", 16, 350, nome="pulsante_togli", testo="Togli la voce scelta", larghezza=160, altezza=32, al_clic="togli_clic", ancoraggio="sb")
f.aggiungi("Etichetta", 190, 356, nome="etichetta_conto", testo="0 voci", larghezza=174, altezza=24, allineamento="destra", ancora="e", ancoraggio="db")
form_modello.salva_form(f, c)
logica(c, "Spesa", '''"""Lista della spesa: si salva da sola in spesa.txt."""
importa os
importa interfaccia come tk
da spesa_ui importa SpesaUI

FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "spesa.txt")


classe Spesa(SpesaUI):
    definisci __inizializza__(se_stesso, radice):
        se_stesso.costruisci_ui(radice)
        se_stesso.elenco_voci.delete(0, "end")
        se_stesso.voci = []
        se os.path.exists(FILE):
            con open(FILE, encoding="utf-8") come f:
                se_stesso.voci = [riga.strip() per riga in f se riga.strip()]
        per v in se_stesso.voci:
            se_stesso.elenco_voci.insert("end", v)
        se_stesso._aggiorna_conto()

    definisci _salva(se_stesso):
        con open(FILE, "w", encoding="utf-8") come f:
            f.write("\\n".join(se_stesso.voci))
        se_stesso._aggiorna_conto()

    definisci _aggiorna_conto(se_stesso):
        n = lunghezza_di(se_stesso.voci)
        se_stesso.etichetta_conto.configure(text=f"{n} voc{'e' se n == 1 altrimenti 'i'}")

    definisci aggiungi_clic(se_stesso, evento=Nessuno):
        voce = se_stesso.campo_voce.get().strip()
        se non voce:
            ritorna
        se_stesso.voci.append(voce)
        se_stesso.elenco_voci.insert("end", voce)
        se_stesso.campo_voce.delete(0, "end")
        se_stesso._salva()

    definisci togli_clic(se_stesso, evento=Nessuno):
        scelta = se_stesso.elenco_voci.curselection()
        se non scelta:
            ritorna
        indice = scelta[0]
        se_stesso.elenco_voci.delete(indice)
        elimina se_stesso.voci[indice]
        se_stesso._salva()

    definisci scelta_voce(se_stesso, evento=Nessuno):
        passa


se __nome__ == "__main__":
    radice = tk.Finestra()
    finestra = Spesa(radice)
    radice.ciclo_principale()
''')

# ---- Orologio digitale
c = nuovo_esempio("orologio_digitale", "Orologio digitale", "L'ora che scorre ogni secondo, con un Timer che aggiorna la scritta.",
                  "Principiante", "Finestre", ["il componente Timer", "data e ora", "cambiare il testo di un'etichetta"], "orologio.pit")
