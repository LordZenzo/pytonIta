f.larghezza, f.altezza = 360, 170
f.sfondo = "#101820"
f.aggiungi("Etichetta", 10, 24, nome="etichetta_ora", testo="00:00:00", larghezza=340, altezza=70, allineamento="centro", ancora="center",
           carattere="Consolas 44 bold", sfondo="#101820", primo_piano="#39ff88", ancoraggio="sd")
f.aggiungi("Etichetta", 10, 110, nome="etichetta_data", testo="", larghezza=340, altezza=30, allineamento="centro", ancora="center",
           carattere="Segoe UI 14", sfondo="#101820", primo_piano="#9fb3c8", ancoraggio="sd")
f.aggiungi("Timer", 10, 145, nome="timer1", intervallo=1000, attivo=Vero, al_tempo="aggiorna")
form_modello.salva_form(f, c)
logica(c, "Orologio", '''"""Orologio digitale: il Timer richiama «aggiorna» ogni secondo."""
importa time
importa interfaccia come tk
da orologio_ui importa OrologioUI

GIORNI = ["lunedì", "martedì", "mercoledì", "giovedì", "venerdì", "sabato", "domenica"]
MESI = ["gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno", "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre"]


classe Orologio(OrologioUI):
    definisci __inizializza__(se_stesso, radice):
        se_stesso.costruisci_ui(radice)
        se_stesso.aggiorna()

    definisci aggiorna(se_stesso, evento=Nessuno):
        adesso = time.localtime()
        se_stesso.etichetta_ora.configure(text=time.strftime("%H:%M:%S", adesso))
        se_stesso.etichetta_data.configure(text=f"{GIORNI[adesso.tm_wday]} {adesso.tm_mday} {MESI[adesso.tm_mon - 1]} {adesso.tm_year}")


se __nome__ == "__main__":
    radice = tk.Finestra()
    finestra = Orologio(radice)
    radice.ciclo_principale()
''')

# ---- Disegno libero
c = nuovo_esempio("disegno_libero", "Disegno libero", "Disegna con il mouse su una tela, scegli colore e spessore.",
                  "Intermedio", "Finestre", ["la tela (Canvas)", "eventi del mouse", "menu a tendina e cursore"], "disegno.pit")
f = Form("Disegno", "Disegno libero")
f.aspetto = "chiaro"
f.larghezza, f.altezza = 560, 420
f.aggiungi("Etichetta", 10, 12, nome="etichetta_colore", testo="Colore", larghezza=50)
f.aggiungi("CasellaCombinata", 62, 10, nome="colore_scelto", larghezza=110, altezza=26, valori=["nero", "rosso", "blu", "verde", "arancione"], valore="nero", al_selezione="cambia_colore")
f.aggiungi("Etichetta", 190, 12, nome="etichetta_spessore", testo="Spessore", larghezza=60)
f.aggiungi("Cursore", 252, 4, nome="spessore", larghezza=150, altezza=40, da=1, a=20, valore=3, al_cambio="cambia_spessore")
f.aggiungi("Pulsante", 450, 8, nome="pulsante_pulisci", testo="Pulisci", larghezza=96, altezza=30, al_clic="pulisci_clic", ancoraggio="ds")
f.aggiungi("Tela", 10, 52, nome="tela1", larghezza=540, altezza=358, ancoraggio="sadb")
form_modello.salva_form(f, c)
logica(c, "Disegno", '''"""Disegno libero: trascina il mouse sulla tela."""
importa interfaccia come tk
da disegno_ui importa DisegnoUI

COLORI = {"nero": "#000000", "rosso": "#d32f2f", "blu": "#1565c0", "verde": "#2e7d32", "arancione": "#ef6c00"}


classe Disegno(DisegnoUI):
    definisci __inizializza__(se_stesso, radice):
        se_stesso.costruisci_ui(radice)
        se_stesso.colore = COLORI["nero"]
        se_stesso.larghezza_penna = 3
        se_stesso.ultimo = Nessuno
        se_stesso.tela1.bind("<ButtonPress-1>", se_stesso.inizia)
        se_stesso.tela1.bind("<B1-Motion>", se_stesso.disegna)
        se_stesso.tela1.bind("<ButtonRelease-1>", se_stesso.finisci)

    definisci inizia(se_stesso, e):
        se_stesso.ultimo = (e.x, e.y)
        se_stesso._segno(e.x, e.y, e.x, e.y)

    definisci disegna(se_stesso, e):
        se se_stesso.ultimo:
            se_stesso._segno(se_stesso.ultimo[0], se_stesso.ultimo[1], e.x, e.y)
            se_stesso.ultimo = (e.x, e.y)

    definisci finisci(se_stesso, e):
        se_stesso.ultimo = Nessuno

    definisci _segno(se_stesso, x1, y1, x2, y2):
        se_stesso.tela1.create_line(x1, y1, x2, y2, fill=se_stesso.colore, width=se_stesso.larghezza_penna, capstyle="round", smooth=Vero)

    definisci cambia_colore(se_stesso, evento=Nessuno):
        se_stesso.colore = COLORI.get(se_stesso.colore_scelto.get(), "#000000")

    definisci cambia_spessore(se_stesso, valore=Nessuno):
        se_stesso.larghezza_penna = int(float(valore)) se valore è non Nessuno altrimenti 3

    definisci pulisci_clic(se_stesso, evento=Nessuno):
        se_stesso.tela1.delete("all")


se __nome__ == "__main__":
    radice = tk.Finestra()
    finestra = Disegno(radice)
    radice.ciclo_principale()
''')

# ---- Blocco note (menu, ancoraggio, file)
c = nuovo_esempio("blocco_note", "Blocco note", "Un piccolo editor di testo con la barra dei menu (File, Modifica, Aiuto), che si adatta alla finestra.",
                  "Intermedio", "Finestre", ["la barra dei menu", "ancoraggio ai bordi", "finestre di dialogo per aprire e salvare"], "notepad.pit")
f = Form("Notepad", "Blocco note")
f.aspetto = "chiaro"
f.larghezza, f.altezza = 560, 400
f.aggiungi("BarraMenu", 10, 370, nome="barraMenu1", voci="File\n  Nuovo = nuovo_clic\n  Apri… = apri_clic\n  Salva… = salva_clic\n  -\n  Esci = esci_clic\nModifica\n  Seleziona tutto = seleziona_clic\n  Cancella tutto = cancella_clic\nAiuto\n  Informazioni = info_clic")
f.aggiungi("AreaTesto", 8, 8, nome="area", larghezza=544, altezza=358, ancoraggio="sadb", carattere="Consolas 11")
f.aggiungi("Etichetta", 8, 372, nome="stato", testo="Nuovo documento", larghezza=544, altezza=22, ancoraggio="sdb", carattere="Segoe UI 9")
form_modello.salva_form(f, c)
logica(c, "Notepad", '''"""Blocco note: menu File/Modifica/Aiuto e un'area di testo che segue la finestra."""
importa os
importa interfaccia come tk
da tkinter importa filedialog, messagebox
da notepad_ui importa NotepadUI


classe Notepad(NotepadUI):
    definisci __inizializza__(se_stesso, radice):
        se_stesso.costruisci_ui(radice)
        se_stesso.percorso = Nessuno

    definisci _titolo(se_stesso):
        nome = os.path.basename(se_stesso.percorso) se se_stesso.percorso altrimenti "Nuovo documento"
        se_stesso.stato.configure(text=nome)
        se_stesso.radice.title(f"{nome} - Blocco note")

    definisci nuovo_clic(se_stesso, evento=Nessuno):
        se_stesso.area.delete("1.0", "end")
        se_stesso.percorso = Nessuno
        se_stesso._titolo()

    definisci apri_clic(se_stesso, evento=Nessuno):
        p = filedialog.askopenfilename(title="Apri", filetypes=[("Testo", "*.txt"), ("Tutti i file", "*.*")])
        se non p:
            ritorna
        prova:
            con open(p, encoding="utf-8") come f:
                testo_ = f.read()
        eccetto (OSError, UnicodeDecodeError) come errore:
            messagebox.showerror("Apri", f"Non riesco ad aprire il file:\\n{errore}")
            ritorna
        se_stesso.area.delete("1.0", "end")
        se_stesso.area.insert("1.0", testo_)
        se_stesso.percorso = p
        se_stesso._titolo()

    definisci salva_clic(se_stesso, evento=Nessuno):
        p = se_stesso.percorso o filedialog.asksaveasfilename(title="Salva", defaultextension=".txt", filetypes=[("Testo", "*.txt")])
        se non p:
            ritorna
        con open(p, "w", encoding="utf-8") come f:
            f.write(se_stesso.area.get("1.0", "end-1c"))
        se_stesso.percorso = p
        se_stesso._titolo()

    definisci seleziona_clic(se_stesso, evento=Nessuno):
        se_stesso.area.tag_add("sel", "1.0", "end")

    definisci cancella_clic(se_stesso, evento=Nessuno):
        se_stesso.area.delete("1.0", "end")

    definisci info_clic(se_stesso, evento=Nessuno):
        messagebox.showinfo("Blocco note", "Un esempio di PitStudio:\\nmenu, ancoraggio ai bordi e finestre di dialogo.")

    definisci esci_clic(se_stesso, evento=Nessuno):
        se_stesso.radice.destroy()


se __nome__ == "__main__":
    radice = tk.Finestra()
    finestra = Notepad(radice)
    radice.ciclo_principale()
''')


# ====================================================================== database
c = nuovo_esempio("rubrica_database", "Rubrica con database", "Una rubrica con la maschera creata da PitStudio: elenco, ricerca e modifica dei contatti in un database SQLite.",
                  "Intermedio", "Database", ["SQLite", "maschera collegata ai dati", "cercare, aggiungere, modificare, eliminare"], "mascheracontatti.pit")
db = os.path.join(c, "rubrica.db")
conn = sqlite3.connect(db)
conn.executescript("""
CREATE TABLE contatti (id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT NOT NULL, cognome TEXT, telefono TEXT, email TEXT, citta TEXT);
INSERT INTO contatti (nome, cognome, telefono, email, citta) VALUES
 ('Anna', 'Rossi', '333 1112233', 'anna.rossi@esempio.it', 'Roma'),
 ('Luca', 'Bianchi', '347 4445566', 'luca.bianchi@esempio.it', 'Milano'),
 ('Sara', 'Verdi', '339 7778899', 'sara.verdi@esempio.it', 'Torino'),
 ('Marco', 'Neri', '320 1230987', 'marco.neri@esempio.it', 'Napoli'),
 ('Giulia', 'Gialli', '366 5551234', 'giulia.gialli@esempio.it', 'Bologna');
""")
conn.commit()
conn.close()
maschera_dati.crea_maschera(c, "MascheraContatti", "contatti", ["id", "nome", "cognome", "telefono", "email", "citta"], "sqlite", db)
scrivi(c, "LEGGIMI.md", """
# Rubrica con database

Apri `mascheracontatti.pit` e scegli *Esegui → Esegui il file corrente*.

- La finestra (`mascheracontatti.form.json`) si modifica nel progettista.
- I dati sono in `rubrica.db`: aprilo con un doppio clic nell'albero del progetto per vederli e cambiarli (scheda *Database*).
- `fonte_dati.pit` collega la tabella alla finestra: è usabile anche in altre finestre.
""")

print("esempi creati")
