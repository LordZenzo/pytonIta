        se_stesso.etichetta_b.posiziona(x=16, y=56, width=100, height=24)
        se_stesso.campo_b = tk.CampoTesto(radice)
        se_stesso.campo_b.associa('<Return>', se_stesso.somma_clic)
        se_stesso.campo_b.posiziona(x=124, y=54, width=190, height=28)
        se_stesso.pulsante_somma = tk.Pulsante(radice, testo='+', carattere=('Segoe UI', 14, 'bold'), comando=se_stesso.somma_clic)
        se_stesso.pulsante_somma.posiziona(x=16, y=100, width=70, height=36)
        se_stesso.pulsante_sottrai = tk.Pulsante(radice, testo='−', carattere=('Segoe UI', 14, 'bold'), comando=se_stesso.sottrai_clic)
        se_stesso.pulsante_sottrai.posiziona(x=95, y=100, width=70, height=36)
        se_stesso.pulsante_per = tk.Pulsante(radice, testo='×', carattere=('Segoe UI', 14, 'bold'), comando=se_stesso.moltiplica_clic)
        se_stesso.pulsante_per.posiziona(x=174, y=100, width=70, height=36)
        se_stesso.pulsante_diviso = tk.Pulsante(radice, testo='÷', carattere=('Segoe UI', 14, 'bold'), comando=se_stesso.dividi_clic)
        se_stesso.pulsante_diviso.posiziona(x=253, y=100, width=70, height=36)
        se_stesso.risultato = tk.Etichetta(radice, testo='Risultato:', justify='left', anchor='w', carattere=('Segoe UI', 16, 'bold'))
        se_stesso.risultato.posiziona(x=16, y=154, width=300, height=40)
        ritorna radice

