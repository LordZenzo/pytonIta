"""Finestra Calcolatrice - generato da PitStudio (interprete 2.x). NON modificare: i cambi vanno nel progettista."""
importa interfaccia come tk
da interfaccia importa tema
importa os
da aspetto importa applica_aspetto


classe CalcolatriceUI:
    definisci costruisci_ui(se_stesso, radice, cartella=Nessuno):
        """Crea tutti i componenti dentro 'radice'."""
        se_stesso.radice = radice
        radice._interfaccia_ui = se_stesso     # tiene vive le variabili delle caselle anche se nessuno conserva l'oggetto
        se_stesso.cartella = cartella o os.path.dirname(os.path.abspath(__file__))
        applica_aspetto(radice, 'chiaro')      # prima dei componenti: i colori scritti a mano restano
        radice.titolo('Calcolatrice')
        radice.geometria("340x230")
        radice.ridimensionabile(Vero, Vero)
        se_stesso.immagini = []
        se_stesso.etichetta_a = tk.Etichetta(radice, testo='Primo numero', justify='left', anchor='w')
        se_stesso.etichetta_a.posiziona(x=16, y=18, width=100, height=24)
        se_stesso.campo_a = tk.CampoTesto(radice)
        se_stesso.campo_a.posiziona(x=124, y=16, width=190, height=28)
