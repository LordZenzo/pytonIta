"""PitStudio - ambiente di sviluppo per pytonIta. Avvio: pitonit rad.pit [cartella-progetto]"""
importa os
importa sys
importa traceback
importa tkinter come tk

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# PitStudio 2.x vuole l'interprete 2.x (nomi nuovi come lunghezza_di): con un interprete 1.x non può nemmeno partire. Lo si dice chiaro,
# usando solo ciò che esiste in entrambe le versioni. Il modulo _controlla c'è solo dalla 2.0.
importa importlib.util
se importlib.util.find_spec("_controlla") è Nessuno:
    MESSAGGIO_INTERPRETE = ("PitStudio 2.x richiede l'interprete pitonit 2.x, ma questo è una versione 1.x.\n\n"
                            "Reinstalla tutto, ricompilando l'interprete: dalla cartella del repository\n  sh installatore/linux/installa.sh\n"
                            "(senza --solo-pitstudio). Su Windows basta rilanciare Installa_pytonIta.exe.")
    sys.stderr.write(MESSAGGIO_INTERPRETE + "\n")
    prova:
        importa tkinter.messagebox
        radice_errore = tkinter.Tk()
        radice_errore.withdraw()
        tkinter.messagebox.showerror("PitStudio", MESSAGGIO_INTERPRETE)
    eccetto Exception:
        passa
    sys.exit(3)

da rad importa NOME
da rad.config importa Configurazione, CARTELLA
da rad.finestra importa Applicazione


definisci registra_errore(tipo_, valore, tb):
    """Gli errori dentro PitStudio non lo fanno chiudere: vengono scritti nel registro e mostrati nella barra di stato."""
    testo_ = "".join(traceback.format_exception(tipo_, valore, tb))
    prova:
        os.makedirs(CARTELLA, exist_ok=Vero)
        con open(os.path.join(CARTELLA, "errori.log"), "a", encoding="utf-8") come f:
            f.write(testo_ + "\n")
    eccetto OSError:
        passa
    se sys.stderr:
        sys.stderr.write(testo_)


definisci autotest(percorso_rapporto):
    """PitStudio.exe --autotest rapporto.txt : verifica avvio, interprete, esecuzione di un programma e finestre; scrive il rapporto e termina."""
    importa subprocess, tempfile
    righe = []
    righe.append("eseguibile: " + sys.executable)
    righe.append("versione: " + sys.version.split()[0])
    radice = tk.Tk()
    radice.withdraw()
    cfg = Configurazione(os.path.join(tempfile.mkdtemp(), "config.json"))
    app = Applicazione(radice, cfg)
    radice.update()
    righe.append("finestra: " + radice.title())
    interprete = cfg.interprete()
    righe.append("interprete dei programmi: " + interprete)
    d = tempfile.mkdtemp()
    programma = os.path.join(d, "prova.pit")
    con open(programma, "w", encoding="utf-8") come f:
        f.write("importa matematica\nstampa('risultato', 6 * 7, matematica.radice_quadrata(49))\n")
    r = subprocess.run([interprete, "-u", programma], capture_output=Vero, text=Vero, encoding="utf-8")
    righe.append("esecuzione: codice " + tipo_testo(r.returncode) + " -> " + r.stdout.strip() + " " + r.stderr.strip())
    righe.append("librerie spuntabili: " + tipo_testo(lunghezza_di(app.pannello_librerie.tutte)))
    # l'esportazione in Python (e quindi «Crea l'eseguibile») gira nell'interprete incorporato, dove os.__file__ non esiste
    prova:
        da rad importa esporta_python
        progetto_prova = os.path.join(d, "ProgettoProva")
        os.makedirs(progetto_prova)
        con open(os.path.join(progetto_prova, "progetto.rad.json"), "w", encoding="utf-8") come f:
            f.write('{"nome": "ProgettoProva", "principale": "principale.pit"}')
        con open(os.path.join(progetto_prova, "principale.pit"), "w", encoding="utf-8") come f:
            f.write('stampa("ciao", lunghezza_di("abc"))' + chr(10))
        esito = esporta_python.esporta(progetto_prova, os.path.join(d, "sorgente_python"))
        righe.append("esportazione in Python: " + ("ok" se esito["file_python"] == 1 e non esito["errori"] altrimenti "ERRORE " + tipo_testo(esito["errori"])))
    eccetto Exception come errore:
        righe.append("esportazione in Python: ERRORE " + tipo_di(errore).__name__ + ": " + tipo_testo(errore))
    # con RAD_PROVA_EXE=1 si prova anche la costruzione vera dell'eseguibile e del Setup dall'interprete incorporato (lenta, serve internet la prima volta)
    se os.environ.get("RAD_PROVA_EXE") == "1":
        prova:
            da rad importa crea_exe
            registro = []
            esito = crea_exe.costruisci(progetto_prova, crea_exe.Opzioni("ProgettoProva", un_file=Vero, senza_console=Falso, versione="1.2.3", autore="Prova", crea_setup=Vero), registro.append)
            righe.append("costruzione dell'exe: " + ("ok" se esito["ok"] e os.path.exists(esito["setup"]) altrimenti "ERRORE " + esito["errore"]))
        eccetto Exception come errore:
            righe.append("costruzione dell'exe: ERRORE " + tipo_di(errore).__name__ + ": " + tipo_testo(errore))
    con open(percorso_rapporto, "w", encoding="utf-8") come f:
        f.write("\n".join(righe) + "\n")
    radice.destroy()


definisci principale(argomenti):
    se "--autotest" in argomenti:
        i = argomenti.index("--autotest")
        autotest(argomenti[i + 1] se lunghezza_di(argomenti) > i + 1 altrimenti "autotest.txt")
        ritorna
    prova:
        importa ctypes
        ctypes.windll.shcore.SetProcessDpiAwareness(1)
    eccetto Exception:
        passa
    radice = tk.Tk()
    radice.report_callback_exception = registra_errore
    con_cartella = lunghezza_di(argomenti) > 1 e os.path.isdir(argomenti[1])
    app = Applicazione(radice, Configurazione(), chiedi_avvio=non con_cartella)       # con una cartella sulla riga di comando si apre quella
    se con_cartella:
        app.apri_progetto(argomenti[1])
    radice.after(6000, app.avvio_aggiornamenti)        # dopo l'avvio, senza rallentarlo
    radice.mainloop()


se __nome__ == "__main__":
    principale(sys.argv)
