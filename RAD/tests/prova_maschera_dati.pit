"""Maschere collegate ai dati: il generatore crea finestra e logica; la maschera funziona davvero (SQLite) e il codice si esporta in Python."""
importa sys, os, tempfile, subprocess
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
importa tkinter come tk
da tkinter importa messagebox
messagebox.showwarning = lambda *a, **k: Nessuno
messagebox.showerror = lambda *a, **k: Nessuno
messagebox.askyesno = lambda *a, **k: Vero
da rad importa database_modello come dbm
da rad importa maschera_dati, form_modello

cartella = tempfile.mkdtemp()
db = os.path.join(cartella, "negozio.db")
c = dbm.apri_sqlite(db)
c.esegui("CREATE TABLE clienti (id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT NOT NULL, citta TEXT, sconto REAL DEFAULT 0);"
         "INSERT INTO clienti (nome, citta, sconto) VALUES ('Anna', 'Roma', 5), ('Luca', 'Milano', 0), ('Sara', 'Roma', 10)")
nomi = [k.nome per k in c.colonne("clienti")]
r = maschera_dati.crea_maschera(cartella, "MascheraClienti", "clienti", nomi, "sqlite", db)
stampa("file scritti:", sorted(os.path.basename(x) per x in r["scritti"]))
f = form_modello.carica_form(r["form"])
stampa("componenti:", lunghezza(f.componenti), "| problemi del form:", f.problemi())
stampa("gestori richiesti:", sorted({n per _, _, n in f.eventi()}), "| fonte:", f.trova("fonte").valori["database"], f.trova("fonte").valori["tabella"])
logica = open(r["logica"], encoding="utf-8").read()
ui = open(os.path.join(cartella, "mascheraclienti_ui.pit"), encoding="utf-8").read()
stampa("la maschera apre il database relativo al progetto:", "'negozio.db'" in ui, "| usa i componenti dei dati:", "dati.Collegamento.crea" in ui, "dati.BarraDati" in ui)
prova:
    maschera_dati.crea_maschera(cartella, "MascheraClienti", "clienti", nomi, "sqlite", db)
eccetto FileExistsError:
    stampa("non sovrascrive una finestra esistente: Vero")
# tabella con molte colonne: due colonne di campi
c.esegui("CREATE TABLE larga (a INTEGER PRIMARY KEY, b TEXT, c TEXT, d TEXT, e TEXT, f TEXT, g TEXT, h TEXT, i TEXT, `nome strano` TEXT)")
nl = [k.nome per k in c.colonne("larga")]
r2 = maschera_dati.crea_maschera(cartella, "MascheraLarga", "larga", nl, "sqlite", db)
f2 = form_modello.carica_form(r2["form"])
stampa("tabella larga:", lunghezza(f2.componenti), "componenti | problemi:", f2.problemi(), "| campo con spazio:", f2.trova("campo_nome_strano") è non Nessuno)
c.chiudi()

# la maschera funziona (eseguendo la logica generata)
sys.path.insert(0, cartella)
importa importlib
fd = importlib.import_module("fonte_dati")
modulo = importlib.import_module("mascheraclienti")
radice = tk.Tk()
radice.geometry("820x700+20+20")
m = modulo.MascheraClienti(radice)
radice.update()
elenco = lambda: [m.elenco_dati.item(i, "values") per i in m.elenco_dati.get_children()]
stampa("elenco iniziale:", elenco(), "|", m.barra.etichetta.cget("text"))
stampa("campi del primo record:", m.campo_nome.get(), m.campo_citta.get(), m.campo_sconto.get(), m.campo_id.get())
m.elenco_dati.selection_set("1")
radice.update()
stampa("scelto il secondo:", m.campo_nome.get(), m.campo_citta.get())
# modifica
m.campo_citta.delete(0, "end")
m.campo_citta.insert(0, "Torino")
m.barra.pulsanti["salva"].invoke()
stampa("modificato:", [r[2] per r in elenco()])
# nuovo
m.barra.pulsanti["nuovo"].invoke()
stampa("campi vuoti per il nuovo:", repr(m.campo_nome.get()), m.fonte.in_nuovo)
m.campo_nome.insert(0, "Marco")
m.campo_sconto.insert(0, "2,5")
m.barra.pulsanti["salva"].invoke()
stampa("inserito:", m.fonte.numero_record(), "record |", elenco()[-1][1:], "| scelto:", m.campo_nome.get())
# nome obbligatorio: il database rifiuta
m.barra.pulsanti["nuovo"].invoke()
m.campo_citta.insert(0, "Padova")
m.barra.pulsanti["salva"].invoke()
stampa("NOT NULL: il record non è stato aggiunto:", m.fonte.numero_record() == 4)
# numero non valido
m.campo_nome.insert(0, "Zeno")
m.campo_sconto.insert(0, "molto")
m.barra.pulsanti["salva"].invoke()
stampa("numero non valido rifiutato:", m.fonte.numero_record() == 4)
m.barra.pulsanti["annulla"].invoke()
# ricerca
m.barra.campo_cerca.insert(0, "roma")
m.barra.pulsante_cerca.invoke()
stampa("ricerca «roma»:", [r[1] per r in elenco()], "|", m.barra.etichetta.cget("text"))
m.barra.pulsante_tutti.invoke()
stampa("tutti:", m.fonte.numero_record())
# eliminazione
m.barra.pulsanti["primo"].invoke()
m.barra.pulsanti["elimina"].invoke()
stampa("eliminato:", [r[1] per r in elenco()])
m.campo_nome.delete(0, "end")
m.campo_nome.insert(0, "cambiato")
m.barra.pulsanti["annulla"].invoke()
stampa("annulla rilegge il record scelto:", m.campo_nome.get())
m.fonte.chiudi()
radice.destroy()

# esportazione in Python: la maschera gira senza pytonIta (il programma gira in un processo a parte, senza mostrare la finestra)
da rad importa esporta_python
destinazione = os.path.join(tempfile.mkdtemp(), "export")
e = esporta_python.esporta(cartella, destinazione)
stampa("esportato:", e["file_python"], "file Python | errori:", e["errori"])
programma = os.path.join(destinazione, "prova_maschera.py")
open(programma, "w", encoding="utf-8").write("""
import os, sys, tkinter as tk
from tkinter import messagebox
messagebox.askyesno = lambda *a, **k: True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import mascheraclienti
r = tk.Tk(); r.withdraw()
m = mascheraclienti.MascheraClienti(r)
r.update()
print("record:", m.fonte.numero_record(), m.campo_nome.get())
m.campo_nome.delete(0, 'end'); m.campo_nome.insert(0, 'Python')
m.barra.pulsanti['salva'].invoke()
print("salvato:", [m.elenco_dati.item(i, 'values')[1] for i in m.elenco_dati.get_children()][0])
m.fonte.chiudi()
r.destroy()
""")
import_py = __import__("shutil").which("python") o __import__("shutil").which("py")
se import_py:
    u = subprocess.run([import_py, "-W", "ignore", programma], capture_output=Vero, text=Vero, encoding="utf-8", cwd=destinazione, timeout=120, env=dict(os.environ, PYTHONUTF8="1"))
    stampa("con Python normale:", u.stdout.strip().replace("\n", " | "), u.returncode, u.stderr.strip()[-200:])

# dal programma: scheda del database -> pulsante «Maschera…» -> finestra nel progetto, aperta nel progettista
da tkinter importa simpledialog
messagebox.showinfo = lambda *a, **k: Nessuno
da rad.config importa Configurazione
da rad.finestra importa Applicazione
da rad.progetto importa Progetto
da rad.database_ui importa VisoreDatabase
cfg = Configurazione(os.path.join(tempfile.mkdtemp(), "c.json"))
radice2 = tk.Tk()
radice2.geometry("1300x800+20+20")
app = Applicazione(radice2, cfg)
cart2 = os.path.join(tempfile.mkdtemp(), "Gestione")
Progetto.nuovo(cart2, "Gestione", "vuoto")
app.apri_progetto(cart2)
db2 = os.path.join(cart2, "dati.db")
cc = dbm.apri_sqlite(db2)
cc.esegui("CREATE TABLE ordini (id INTEGER PRIMARY KEY, cliente TEXT, totale REAL); INSERT INTO ordini (cliente, totale) VALUES ('Anna', 10)")
cc.chiudi()
w = app.apri_file(db2)
radice2.update()
stampa("scheda database:", tipo(w).__name__, "| pulsante Maschera:", any("Maschera" in b.cget("text") per b in w.pulsanti_barra))
w.elenco.selection_set("ordini")
radice2.update()
richiesti = []
simpledialog.askstring = lambda titolo, messaggio, **k: (richiesti.append(k.get("initialvalue")), k.get("initialvalue"))[1]
w.crea_maschera()
radice2.update()
stampa("nome proposto:", richiesti, "| file nel progetto:", sorted(f per f in os.listdir(cart2) se "ordini" in f.lower() o f == "fonte_dati.pit"))
stampa("la finestra è aperta nel progettista:", [tipo(x).__name__ per x in app.schede.values()])
stampa("menu: «Crea una maschera dalla tabella…» presente:", any(k.endswith("Crea una maschera dalla tabella…") per k in app.comandi_menu))
radice2.destroy()
