"""Finestra «ffmpeg» (Strumenti): con ffmpeg assente propone il download, chiede il consenso, mostra l'avanzamento e aggiorna la situazione.
Il download è finto: nessun accesso a Internet."""
importa sys, os, tempfile, time
radice_test = tempfile.mkdtemp()
os.environ["USERPROFILE"] = radice_test
os.environ["HOME"] = radice_test
qui = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(qui))
importa tkinter come tk
da tkinter importa messagebox
da rad.config importa Configurazione
da rad.finestra importa Applicazione
da rad.ffmpeg_ui importa DialogoFfmpeg
importa multimedia
da rad importa piattaforma

piattaforma.WINDOWS = Vero          # il flusso di Windows (download); quello degli altri sistemi si prova in fondo

avvisi = []
messagebox.showwarning = lambda titolo, testo_, **k: avvisi.append(testo_)
errori = []


definisci verifica(condizione, messaggio):
    se non condizione:
        errori.append(messaggio)
        stampa("ERRORE:", messaggio)


definisci aspetta(secondi, condizione=Nessuno):
    t0 = time.time()
    mentre time.time() - t0 < secondi:
        radice.update()
        se condizione e condizione():
            ritorna Vero
        time.sleep(0.02)
    ritorna Falso


cfg = Configurazione(os.path.join(radice_test, "config.json"))
radice = tk.Tk()
radice.geometry("1000x700+20+20")
app = Applicazione(radice, cfg)
radice.update()

# la voce di menu esiste e apre la finestra
barra = radice.nametowidget(radice.cget("menu"))
voci = []
per i in intervallo_di(barra.index("end") + 1):
    se barra.type(i) == "cascade" e barra.entrycget(i, "label") == "Strumenti":
        sotto = radice.nametowidget(barra.entrycget(i, "menu"))
        voci = [sotto.entrycget(j, "label") per j in intervallo_di(sotto.index("end") + 1) se sotto.type(j) == "command"]
verifica("ffmpeg: audio e video…" in voci, f"manca la voce di menu: {voci}")

# ffmpeg assente: la finestra lo dice e offre il download
presente = {"percorso": Nessuno}
multimedia.trova_ffmpeg = lambda programma="ffmpeg": presente["percorso"]
multimedia.versione_ffmpeg = lambda: "ffmpeg version finta 1.0"
chiamate = []
domande = []


definisci scarica_finto(avanzamento=Nessuno, **k):
    chiamate.append("scarica")
    per fatti in (10, 50, 100):
        avanzamento(fatti * 1048576, 100 * 1048576)
        time.sleep(0.2)
    presente["percorso"] = "C:/finto/bin/ffmpeg.exe"
    ritorna presente["percorso"]


finestra = DialogoFfmpeg(radice, app.colori, scarica=scarica_finto, conferma=lambda testo_: domande.append(testo_) o Falso)
radice.update()
verifica("non è installato" in finestra.situazione.cget("text"), "doveva dire che ffmpeg manca")
verifica(finestra.scarica.cget("state") == "normal", "il pulsante Scarica doveva essere attivo")
# senza consenso non scarica
finestra.scarica.invoke()
radice.update()
verifica(len(domande) == 1 e "115 MB" in domande[0] e multimedia.CARTELLA_FFMPEG in domande[0] e "SHA-256" in domande[0], f"testo del consenso: {domande}")
verifica(chiamate == [], "senza il tuo consenso non doveva scaricare")
# con il consenso scarica e aggiorna
finestra._conferma = lambda testo_: Vero
finestra.scarica.invoke()
aspetta(1.0, lambda: finestra._scaricando e finestra._avanzamento[0] > 0)
verifica(finestra.scarica.cget("state") == "disabled", "durante il download il pulsante deve essere disattivato")
verifica(finestra.chiudi.cget("text") == "Annulla", "durante il download il pulsante diventa Annulla")
aspetta(4, lambda: non finestra._scaricando)
verifica(chiamate == ["scarica"], f"download non partito: {chiamate}")
verifica("è pronto" in finestra.situazione.cget("text"), f"dopo il download: {finestra.situazione.cget('text')}")
verifica("C:/finto/bin/ffmpeg.exe" in finestra.dettagli.cget("text") e "finta 1.0" in finestra.dettagli.cget("text"), "mancano percorso e versione")
verifica(finestra.chiudi.cget("text") == "Chiudi", "alla fine il pulsante torna Chiudi")
finestra.destroy()

# ffmpeg già presente: niente da scaricare
finestra = DialogoFfmpeg(radice, app.colori, scarica=scarica_finto)
radice.update()
verifica("è pronto" in finestra.situazione.cget("text") e finestra.scarica.cget("state") == "disabled", "con ffmpeg presente non serve scaricare")
finestra.destroy()

# download che fallisce: avvisa e lascia riprovare
presente["percorso"] = Nessuno


definisci scarica_rotto(**k):
    solleva multimedia.ErroreMultimedia("rete assente")


finestra = DialogoFfmpeg(radice, app.colori, scarica=scarica_rotto, conferma=lambda testo_: Vero)
radice.update()
finestra.scarica.invoke()
aspetta(3, lambda: non finestra._scaricando)
radice.update()
verifica(avvisi e "rete assente" in avvisi[0], f"doveva avvisare: {avvisi}")
verifica("non riuscito" in finestra.stato.cget("text") e finestra.scarica.cget("state") == "normal", "dopo l'errore si deve poter riprovare")
finestra.destroy()

# ---- la scelta tra la versione essenziale e quella completa
presente["percorso"] = Nessuno
chiamate.clear()
domande.clear()
finestra = DialogoFfmpeg(radice, app.colori, scarica=scarica_finto, conferma=lambda testo_: domande.append(testo_) o Falso)
radice.update()
etichette = finestra.scelta_variante.cget("values")
verifica(lunghezza_di(etichette) == 2 e "Essenziale" in etichette[0] e "115" in etichette[0] e "Completa" in etichette[1] e "200" in etichette[1], f"menu delle versioni: {etichette}")
verifica(finestra.var_variante.get() == etichette[0], "di partenza c'e' la versione essenziale")
verifica("quasi sempre" in finestra.descrizione_variante.cget("text"), f"descrizione essenziale: {finestra.descrizione_variante.cget('text')}")
finestra.var_variante.set(etichette[1])
finestra.aggiorna_situazione()
verifica("stabile" in finestra.descrizione_variante.cget("text"), "la descrizione segue la scelta")
finestra.scarica.invoke()
verifica(lunghezza_di(domande) == 1 e "completa" in domande[0] e "200 MB" in domande[0] e "github.com" in domande[0] e "SHA-256" in domande[0], f"consenso per la completa: {domande}")
# con ffmpeg scaricato da PitStudio: se la versione scelta e' quella che c'e' non si scarica; se e' un'altra si puo' sostituire
presente["percorso"] = os.path.join(multimedia.CARTELLA_FFMPEG, "bin", "ffmpeg.exe")
multimedia.variante_installata = lambda *a, **k: {"variante": "essenziale"}
finestra.var_variante.set(etichette[0])
finestra.aggiorna_situazione()
verifica(finestra.scarica.cget("state") == "disabled" e "scaricato da PitStudio (versione essenziale)" in finestra.dettagli.cget("text"), f"stessa versione: {finestra.dettagli.cget('text')}")
finestra.var_variante.set(etichette[1])
finestra.aggiorna_situazione()
verifica(finestra.scarica.cget("state") == "normal" e "Sostituisci con la versione completa" in finestra.scarica.cget("text"), f"altra versione: {finestra.scarica.cget('text')}")
domande.clear()
finestra.scarica.invoke()
verifica(lunghezza_di(domande) == 1 e "Sostituisce" in domande[0], f"il consenso dice che sostituisce: {domande}")
# ffmpeg installato altrove (PATH): si usa quello, niente download
presente["percorso"] = "C:/ffmpeg/bin/ffmpeg.exe"
finestra.aggiorna_situazione()
verifica(finestra.scarica.cget("state") == "disabled" e "già installata sul computer" in finestra.dettagli.cget("text"), f"installato altrove: {finestra.dettagli.cget('text')}")
finestra.destroy()

# ---- altri sistemi (Linux, macOS): niente download, si spiega come installare ffmpeg con il gestore di pacchetti
piattaforma.WINDOWS = Falso
presente["percorso"] = Nessuno
multimedia._gestore_pacchetti = lambda: "apt"
finestra = DialogoFfmpeg(radice, app.colori, scarica=scarica_finto, conferma=lambda testo_: Vero)
radice.update()
verifica("non è installato" in finestra.situazione.cget("text"), "altri sistemi: ffmpeg mancante")
pannello = finestra.cornice_comandi.winfo_children()[0]
comandi = [tipo_testo(w.get()) per w in pannello.campi]
verifica(comandi == ["sudo apt update && sudo apt install ffmpeg", "sudo apt update && sudo apt install --no-install-recommends ffmpeg"], f"altri sistemi: i comandi per ffmpeg completo ed essenziale: {comandi}")
verifica(all(tipo_testo(w.cget("state")) == "readonly" per w in pannello.campi), "altri sistemi: i campi si possono selezionare e copiare")
pannello.pulsanti[1].invoke()
radice.update()
verifica(radice.clipboard_get() == comandi[1] e pannello.pulsanti[1].cget("text") == "Copiato ✓", f"altri sistemi: «Copia» mette il comando negli appunti: {radice.clipboard_get()}")
verifica(finestra.riga_versione.winfo_manager() == "" e finestra.scarica.winfo_manager() == "", "altri sistemi: niente scelta della versione né download")
per gestore, atteso in (("dnf", "ffmpeg-free"), ("pacman", "ffmpeg-headless")):
    multimedia._gestore_pacchetti = lambda g=gestore: g
    verifica(any(atteso in v["comando"] per v in multimedia.comandi_installazione("ffmpeg")), f"comandi per {gestore}")
multimedia._gestore_pacchetti = lambda: Nessuno
verifica(lunghezza_di(multimedia.comandi_installazione("vlc")) >= 4 e "gestore" in multimedia.istruzioni_ffmpeg(), "gestore sconosciuto: i comandi di tutti")
multimedia._gestore_pacchetti = lambda: "apt"
verifica([v["comando"] per v in multimedia.comandi_installazione("mpv")] == ["sudo apt update && sudo apt install mpv"], "comando di mpv")
verifica("Completo: sudo apt update && sudo apt install ffmpeg" in multimedia.istruzioni_ffmpeg() e "Essenziale:" in multimedia.istruzioni_ffmpeg(), "il messaggio di errore elenca completo ed essenziale")
finestra.destroy()
piattaforma.WINDOWS = Vero
radice.destroy()
stampa("ok" se non errori altrimenti f"{len(errori)} errori")
sys.exit(1 se errori altrimenti 0)
