"""Modello «Libreria»: un pacchetto completo con funzione, classe, prova e spiegazione; la prova gira."""
importa sys, os, tempfile, subprocess
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
da rad.progetto importa Progetto

PITONIT = os.path.join(os.path.dirname(sys.executable), "pitonit.exe")
radice = tempfile.mkdtemp()
per nome in ("Mia Libreria", "2geometrie", "classe"):
    cart = os.path.join(radice, nome.replace(" ", "_"))
    p = Progetto.nuovo(cart, nome, "libreria")
    file_ = sorted(os.path.relpath(os.path.join(d, f), cart).replace("\\", "/") per d, _, fs in os.walk(cart) per f in fs)
    pacchetto = [x.split("/")[0] per x in file_ se "/" in x e x.endswith("__init__.pit")][0]
    stampa(nome, "->", pacchetto, "|", [x per x in file_ se x != "progetto.rad.json"])
    r = subprocess.run([PITONIT, "prova.pit"], capture_output=Vero, text=Vero, encoding="utf-8", cwd=cart, timeout=60)
    stampa("   prova.pit:", r.stdout.strip().replace("\n", " | "), "| uscita", r.returncode, r.stderr.strip()[-150:])
leggimi = open(os.path.join(cart, "LEGGIMI.md"), encoding="utf-8").read()
stampa("LEGGIMI spiega la libreria:", "Come è fatta" in leggimi, "Come si usa in un altro progetto" in leggimi)
stampa("principale del progetto:", p.manifesto["principale"])
