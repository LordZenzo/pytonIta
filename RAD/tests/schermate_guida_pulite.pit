"""Due immagini della guida (aiuto/immagini): conversione.png e aspetto.png, senza dati personali.
Uso: pitonit schermate_guida_pulite.pit [cartella di uscita] [tema]
Ritaglia sempre la finestra (conversione) o un fondo neutro tutto nostro (aspetto): mai lo schermo dell'utente."""
importa sys, os, tempfile, time, shutil, importlib
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
importa tkinter come tk
da PIL importa ImageGrab
da rad.config importa Configurazione
da rad.finestra importa Applicazione
da rad.progetto importa Progetto
da rad.mattonelle_ui importa EditorMattonelle
da rad importa form_modello
da rad.form_modello importa Form

QUI = os.path.dirname(os.path.abspath(__file__))
uscita = sys.argv[1] se lunghezza_di(sys.argv) > 1 altrimenti tempfile.gettempdir()
tema_scelto = sys.argv[2] se lunghezza_di(sys.argv) > 2 altrimenti "scuro"
os.makedirs(uscita, exist_ok=Vero)
os.makedirs("C:/Progetti", exist_ok=Vero)
temp = tempfile.mkdtemp(dir="C:/Progetti")

# ---- 1. conversione.png: da codice a mattonelle ----
cfg = Configurazione(os.path.join(temp, "config.json"))
cfg.imposta("tema", tema_scelto, notifica=Falso)
radice = tk.Tk()
radice.geometry("1400x860+10+10")
radice.attributes("-topmost", Vero)
app = Applicazione(radice, cfg)
app._proponi_aggiornamento_1x = lambda *a, **k: Nessuno
app._proponi_aggiornamento_moduli = lambda *a, **k: Nessuno


definisci aspetta(secondi=0.6):
    t0 = time.time()
    mentre time.time() - t0 < secondi:
        radice.update()
        time.sleep(0.03)


cart = os.path.join(temp, "Esistente")
Progetto.nuovo(cart, "Esistente", "vuoto")
shutil.copy(os.path.join(QUI, "campioni", "esempio_completo.pit"), os.path.join(cart, "esempio.pit"))
app.apri_progetto(cart)
app.apri_file(os.path.join(cart, "esempio.pit"))
aspetta(0.5)
percorsi, rapporto = app.converti_in_mattonelle(nome=Nessuno, silenzioso=Vero)
aspetta(0.5)
ed = [w per w in app.schede.values() se isinstance(w, EditorMattonelle)][0]
ed.vai_alla_funzione("pari_o_dispari")
ed.vedi_codice()
prova:
    app.corpo.sash_place(0, 270, 0)
    app.corpo.forget(app.chat)
eccetto Exception:
    passa
app.chat.cliente_pronto = lambda: Vero
app._aggiorna_stato_ai()
radice.lift()
aspetta(0.9)
x, y = radice.winfo_rootx(), radice.winfo_rooty()
img = ImageGrab.grab(bbox=(x, y, x + radice.winfo_width(), y + radice.winfo_height()))
img.save(os.path.join(uscita, "conversione.png"))
stampa("salvata conversione.png", img.size)
app.chiudi_tutte_le_schede()
radice.destroy()

# ---- 2. aspetto.png: la stessa finestra in quattro aspetti, su fondo neutro ----
cartella = tempfile.mkdtemp()
sys.path.insert(0, cartella)
radice = tk.Tk()
radice.withdraw()
fondo = tk.Toplevel(radice)
fondo.overrideredirect(Vero)
fondo.configure(bg="#e9edf2")
LARG, ALT, MARGINE = 380, 372, 20
fondo.geometry(f"{4 * LARG + 5 * MARGINE}x{ALT + 2 * MARGINE + 34}+10+10")
fondo.attributes("-topmost", Vero)
finestre = []
n = 0
per aspetto_ in ("classico", "chiaro", "scuro", "verde"):
    n += 1
    f = Form(f"Prova{n}", "Aspetto " + aspetto_)
    f.larghezza, f.altezza = 380, 330
    f.aspetto = aspetto_
    f.aggiungi("Etichetta", 16, 14, nome="titolo", testo="Nuovo cliente", larghezza=300, carattere="Segoe UI 14 bold")
    f.aggiungi("Etichetta", 16, 56, nome="e1", testo="Nome", larghezza=70)
    f.aggiungi("CampoTesto", 96, 54, nome="nome", larghezza=260, altezza=28, testo="Anna Rossi")
    f.aggiungi("Etichetta", 16, 94, nome="e2", testo="Città", larghezza=70)
    f.aggiungi("CasellaCombinata", 96, 92, nome="citta", larghezza=260, altezza=28, valori=["Roma", "Milano", "Torino"], valore="Roma")
    f.aggiungi("CasellaSelezione", 96, 130, nome="c1", testo="Iscritto alla newsletter", larghezza=240, selezionata=Vero)
    f.aggiungi("Elenco", 16, 166, nome="el", larghezza=200, altezza=70, elementi=["Penna", "Quaderno", "Zaino"])
    f.aggiungi("BarraProgresso", 16, 250, nome="bp", larghezza=340, altezza=14, valore=60)
    f.aggiungi("Pulsante", 16, 280, nome="p1", testo="Salva", larghezza=100, altezza=32)
    f.aggiungi("Pulsante", 126, 280, nome="p2", testo="Annulla", larghezza=100, altezza=32)
    form_modello.salva_form(f, cartella)
    m = importlib.import_module(f"prova{n}")
    w = tk.Toplevel(radice)
    w.geometry(f"+{10 + MARGINE + (n - 1) * (LARG + MARGINE)}+{10 + MARGINE + 34}")
    getattr(m, f"Prova{n}")(w)
    w.attributes("-topmost", Vero)
    w.update()
    finestre.append(w)
t0 = time.time()
mentre time.time() - t0 < 1.2:
    radice.update()
    time.sleep(0.03)
per w in finestre:
    w.lift()
radice.update()
time.sleep(0.4)
radice.update()
x0, y0 = fondo.winfo_rootx(), fondo.winfo_rooty()
img = ImageGrab.grab(bbox=(x0, y0, x0 + fondo.winfo_width(), y0 + fondo.winfo_height()))
img.save(os.path.join(uscita, "aspetto.png"))
stampa("salvata aspetto.png", img.size)
radice.destroy()
