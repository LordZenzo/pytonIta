importa sys, os, subprocess, tempfile
QUI = os.path.dirname(os.path.abspath(__file__))
cartella = tempfile.mkdtemp()

definisci esegui_campione(nome):
    r = subprocess.run([sys.executable, "-u", os.path.join(QUI, "campioni", nome)], capture_output=Vero, text=Vero, encoding="utf-8", cwd=cartella)
    ritorna r

# 1. parole riservate usate come nomi
r = esegui_campione("nomi_riservati.pit")
atteso = ["3A", "Connection", "[1, 2, 3]", "2 3 4", "9 8", "mammifero 7 1", "15 9", "ok classe", "x", "Vero", "[0, 2, 4]", "e = divisione per zero"]
righe = [x.rstrip() per x in r.stdout.splitlines()]
mancanti = [a per a in atteso se a non in righe]
stampa("nomi riservati: codice", r.returncode, "| righe mancanti:", mancanti, r.stderr[-200:])

# 2. opzioni con nome in italiano
r = esegui_campione("opzioni_italiane.pit")
atteso = ["a-b!", "[1, 2, 3]", "1", "0", "[3, 2, 1]", "['a', 'b c']", "['a', 'b', 'c']", "2.6", "[(1, 'a'), (2, 'b')]", "13", "b'ciao'", "riga", "y Vero"]
righe = r.stdout.splitlines()
mancanti = [a per a in atteso se a non in righe]
stampa("opzioni italiane: codice", r.returncode, "| righe mancanti:", mancanti, r.stderr[-200:])

# 3. i programmi che scrivono 'e'/'o' a fine riga (condizioni su più righe) e gli import relativi
programma = os.path.join(cartella, "multiriga.pit")
con open(programma, "w", encoding="utf-8") come f:
    f.write("a = Vero" + chr(10) + "b = Falso" + chr(10) + "se (a e" + chr(10) + "        non b o" + chr(10) + "        Falso):" + chr(10) + "    stampa('multiriga ok')" + chr(10) + "x = [1, 2," + chr(10) + "     3]" + chr(10) + "stampa(x se a e " + chr(92) + chr(10) + "       Vero altrimenti 0)" + chr(10))
r = subprocess.run([sys.executable, programma], capture_output=Vero, text=Vero, encoding="utf-8")
stampa("multiriga:", r.stdout.split(), r.stderr[-150:])

# 4. messaggi d'errore tradotti
definisci errore_di(codice):
    p = os.path.join(cartella, "err.pit")
    con open(p, "w", encoding="utf-8") come f:
        f.write(codice)
    ritorna subprocess.run([sys.executable, p], capture_output=Vero, text=Vero, encoding="utf-8").stderr.strip().splitlines()[-1]
casi = [("se 1:\nstampa(1)\n", "dopo l'istruzione 'se' alla riga 1"), ("x = [1 2]\n", "Forse hai dimenticato una virgola?"),
        ("a, b = [1, 2, 3]\n", "troppi valori da decomprimere"), ("stampa(1, foo=2)\n", "stampa() ha ricevuto"),
        ("ritorna 5\n", "'ritorna' fuori da una funzione")]
bene = 0
per codice, atteso in casi:
    ultima = errore_di(codice)
    se atteso in ultima:
        bene += 1
    altrimenti:
        stampa("MANCA", atteso, "in", ultima)
stampa(f"errori tradotti: {bene}/{lunghezza(casi)}")

# 5. «elimina(x)» attaccato alla parentesi è una chiamata; «elimina x» cancella il nome
r = esegui_campione("elimina_chiamata.pit")
stampa("elimina come funzione/parametro:", [x.strip() per x in r.stdout.splitlines()], r.stderr[-120:])
programma = os.path.join(cartella, "del.pit")
con open(programma, "w", encoding="utf-8") come f:
    f.write("z = [1, 2]" + chr(10) + "elimina z[0]" + chr(10) + "y = 5" + chr(10) + "elimina y" + chr(10) + "stampa(z)" + chr(10))
r = subprocess.run([sys.executable, programma], capture_output=Vero, text=Vero, encoding="utf-8")
stampa("elimina x cancella:", r.stdout.split(), r.stderr[-100:])
