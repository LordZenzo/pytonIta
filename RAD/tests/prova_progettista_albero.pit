"""L'albero dei componenti del progettista: gerarchia, selezione nei due sensi, spostamento in un altro contenitore trascinando le righe."""
importa sys, os, tempfile
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
importa tkinter come tk
da rad.config importa Configurazione
da rad.tema importa colori, configura_stile, applica
da rad.form_modello importa Form
da rad importa form_modello come fm
da rad.progettista importa Progettista

errori = []


definisci verifica(c, m):
    se non c:
        errori.append(m)
        stampa("ERRORE:", m)


classe Az:
    definisci scheda_modificata(se_stesso, s): passa
    definisci info(se_stesso, m): passa
    definisci file_scritti(se_stesso, p): passa
    definisci apri_file(se_stesso, p): passa
    definisci apri_file_a_funzione(se_stesso, p, f): passa
    definisci esegui_file(se_stesso, p): passa
    definisci cartella_progetto(se_stesso): ritorna Nessuno


classe Ev:
    definisci __init__(se_stesso, x, y, stato=0):
        se_stesso.x_root = x
        se_stesso.y_root = y
        se_stesso.x = x
        se_stesso.y = y
        se_stesso.state = stato


cfg = Configurazione(os.path.join(os.environ["TEMP"], "rad_prova_config.json"))
c = colori(cfg)
radice = tk.Tk()
radice.geometry("1100x650")
configura_stile(radice, c)
d = tempfile.mkdtemp()
f = Form("Demo", "Demo")
p = Progettista(radice, os.path.join(d, "demo.form.json"), f, c, cfg, Az())
p.pack(fill="both", expand=Vero)
applica(radice, c)
radice.update()


definisci _inutile(nome, verso_x, verso_y):
    """Prende il componente e lo rilascia nel punto (verso_x, verso_y) della superficie."""
    w = p.widget[nome]
    p._premi(Ev(w.winfo_rootx() + 3, w.winfo_rooty() + 3), nome)
    sx, sy = p.superficie.winfo_rootx(), p.superficie.winfo_rooty()
    e = Ev(sx + verso_x, sy + verso_y)
    p._trascina(e, nome)
    radice.update()
    p._rilascia(e, nome)
    radice.update()


f.larghezza = 800
f.altezza = 500
p._disegna_griglia()
radice.update()
a = p.aggiungi_componente("Pulsante", 10, 10)
rq = p.aggiungi_componente("Riquadro", 60, 120, larghezza=300, altezza=160)
sc = p.aggiungi_componente("Schede", 400, 300, larghezza=250, altezza=150)
e = p.aggiungi_componente("Etichetta", 20, 20, genitore=rq.nome)
radice.update()
t = p.albero


definisci riga(iid):
    radice.update()
    x, y, l, h = t.bbox(iid)
    ritorna Ev(x + 20, y + h // 2)


verifica(t.exists("__finestra__") e t.exists(a.nome) e t.exists(rq.nome), "finestra e componenti nell'albero")
verifica(t.parent(a.nome) == "__finestra__" e t.parent(e.nome) == rq.nome, "l'etichetta sta sotto il riquadro: " + repr(t.parent(e.nome)))
verifica(t.exists(sc.nome + "#0") e t.exists(sc.nome + "#1") e t.parent(sc.nome + "#0") == sc.nome, "le pagine di schede sono nell'albero")

# selezione: progettista -> albero
p.seleziona([e.nome])
radice.update()
verifica(t.selection() == (e.nome,), "selezionando nella finestra si seleziona nell'albero: " + str(t.selection()))
# albero -> progettista
t.selection_set([a.nome])
radice.update()
verifica(p.selezione_ == [a.nome], "selezionando nell'albero si seleziona nel progettista: " + str(p.selezione_))
t.selection_set(["__finestra__"])
radice.update()
verifica(p.selezione_ == [], "la riga della finestra deseleziona")

# trascinare il pulsante sul riquadro: ci entra
t.selection_set([a.nome])
radice.update()
p._albero_premi(riga(a.nome))
p._albero_muovi(riga(rq.nome))
verifica("dentro" in p.stato.cget("text"), "la barra di stato dice dove finisce: " + p.stato.cget("text"))
p._albero_rilascia(riga(rq.nome))
radice.update()
verifica(f.trova(a.nome).genitore == rq.nome, "il pulsante è nel riquadro: " + repr(f.trova(a.nome).genitore))
verifica(t.parent(a.nome) == rq.nome, "e nell'albero sta sotto il riquadro")
verifica(p.widget[a.nome].master è p.widget[rq.nome], "e nel disegno è figlio del riquadro")

# rilasciato su un componente normale (l'etichetta nel riquadro): resta in quel contenitore
p._albero_premi(riga(a.nome))
p._albero_muovi(riga(e.nome))
p._albero_rilascia(riga(e.nome))
verifica(f.trova(a.nome).genitore == rq.nome, "su un componente normale non cambia")

# alla pagina 2 delle schede
p.seleziona([a.nome])
p._albero_premi(riga(a.nome))
p._albero_muovi(riga(sc.nome + "#1"))
p._albero_rilascia(riga(sc.nome + "#1"))
radice.update()
verifica(f.trova(a.nome).genitore == sc.nome + "#1", "nella seconda pagina di schede: " + repr(f.trova(a.nome).genitore))
verifica(t.parent(a.nome) == sc.nome + "#1", "e sta sotto la pagina nell'albero")

# fuori: sulla riga della finestra
p.seleziona([a.nome])
p._albero_premi(riga(a.nome))
p._albero_muovi(riga("__finestra__"))
p._albero_rilascia(riga("__finestra__"))
verifica(f.trova(a.nome).genitore == "", "sulla finestra: torna nella finestra")

# un riquadro non entra in se stesso né nei suoi figli
verifica(p.sposta_in([rq.nome], rq.nome) == Falso, "non dentro se stesso")
verifica(p.sposta_in([rq.nome], e.nome) == Falso o f.trova(rq.nome).genitore == "", "non dentro un suo figlio")

# rinomina: l'albero si aggiorna
p.imposta_proprieta(a.nome, "testo", "x")
vecchio_nome = a.nome
p._rinomina(f.trova(a.nome), "inviaTutto")
radice.update()
verifica(t.exists("inviaTutto") e non t.exists(vecchio_nome), "rinominando l'albero si aggiorna")

# elimina
p.seleziona(["inviaTutto"])
p.elimina_selezionati()
radice.update()
verifica(non t.exists("inviaTutto"), "eliminato dall'albero")

# annulla
p.annulla()
radice.update()
verifica(t.exists("inviaTutto"), "annulla: torna nell'albero")

radice.destroy()
stampa("PROVE FALLITE:" se errori altrimenti "tutte le prove superate", errori se errori altrimenti "")
