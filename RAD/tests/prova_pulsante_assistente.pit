"""Il pulsante «Assistente AI» nella barra è verde quando la chat è aperta e del colore normale quando è chiusa."""
importa sys, os, tempfile
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
importa tkinter come tk
da rad.config importa Configurazione
da rad.finestra importa Applicazione, COLORE_CHAT_APERTA

errori = []


definisci verifica(c, m):
    se non c:
        errori.append(m)
        stampa("ERRORE:", m)


cfg = Configurazione(os.path.join(tempfile.mkdtemp(), "c.json"))
cfg.imposta("finestra.chat_visibile", Vero, notifica=Falso)
r = tk.Tk()
r.geometry("1300x800+20+20")
app = Applicazione(r, cfg)
r.update()
b = app.pulsante_chat
verifica(b è non Nessuno, "il pulsante c'è nella barra")
verifica(app._chat_visibile(), "la chat parte aperta")
verifica(b.icona.cget("foreground") == COLORE_CHAT_APERTA, "aperta: icona verde: " + testo(b.icona.cget("foreground")))
app.mostra_chat()
r.update()
verifica(non app._chat_visibile() e b.icona.cget("foreground") == app.colori["primo_piano"], "chiusa: colore normale: " + testo(b.icona.cget("foreground")))
app.mostra_chat()
r.update()
verifica(b.icona.cget("foreground") == COLORE_CHAT_APERTA, "riaperta: di nuovo verde")
# dopo un cambio di tema o il passaggio del mouse il verde resta
b._entra()
b._esci()
verifica(b.icona.cget("foreground") == COLORE_CHAT_APERTA, "il verde resta dopo il passaggio del mouse")
app.mostra_chat()
app._costruisci_barra()
r.update()
verifica(app.pulsante_chat.icona.cget("foreground") == app.colori["primo_piano"], "la barra ricostruita rispetta lo stato (chiusa)")
# il pulsante «Console» funziona allo stesso modo
c = app.pulsante_console
verifica(c è non Nessuno e "Console" in c.etichetta.cget("text"), "c'è il pulsante «Console» nella barra")
verifica(app._console_visibile() e c.icona.cget("foreground") == COLORE_CHAT_APERTA, "console aperta: verde")
app._commuta("console")
r.update()
verifica(non app._console_visibile() e c.icona.cget("foreground") == app.colori["primo_piano"], "console chiusa: colore normale")
app._commuta("console")
r.update()
verifica(app._console_visibile() e c.icona.cget("foreground") == COLORE_CHAT_APERTA, "riaperta: di nuovo verde")
c.comando()
r.update()
verifica(non app._console_visibile(), "il pulsante nasconde la console")
c.comando()
r.update()
verifica(app._console_visibile(), "e la mostra")
# partenza con la console nascosta nella configurazione
cfg2 = Configurazione(os.path.join(tempfile.mkdtemp(), "c2.json"))
cfg2.imposta("finestra.console_visibile", Falso, notifica=Falso)
r2 = tk.Toplevel(r)
app2 = Applicazione(r2, cfg2)
r2.update()
verifica(non app2._console_visibile() e app2.pulsante_console.icona.cget("foreground") == app2.colori["primo_piano"], "parte con la console nascosta: pulsante normale")
r2.destroy()
r.destroy()
stampa("PROVE FALLITE:" se errori altrimenti "tutte le prove superate", errori se errori altrimenti "")
