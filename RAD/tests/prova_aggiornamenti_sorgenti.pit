"""Aggiornamento di PitStudio su Linux e macOS: scompatta i sorgenti della Release e lancia installa.sh --solo-pitstudio (senza rete)."""
importa sys, os, io, tarfile, tempfile, shutil, time
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
da rad importa aggiornamenti come ag

errori = []


definisci verifica(c, m):
    se non c:
        errori.append(m)
        stampa("ERRORE:", m)


se shutil.which("sh") è Nessuno:
    stampa("sh non disponibile su questo sistema: prova saltata")
altrimenti:
    lavoro = tempfile.mkdtemp()
    prefisso = os.path.join(lavoro, "installazione")
    os.makedirs(prefisso)

    definisci crea_tar(nome, voci):
        percorso = os.path.join(lavoro, nome)
        con tarfile.open(percorso, "w:gz") come t:
            per nome_voce, contenuto in voci:
                dati = contenuto.encode("utf-8")
                info = tarfile.TarInfo(nome_voce)
                info.size = len(dati)
                info.mode = 0o755
                t.addfile(info, io.BytesIO(dati))
        ritorna percorso

    # uno script finto che scrive come è stato chiamato
    script = '#!/bin/sh\necho "argomenti: $@" > "${2#--prefisso=}/chiamato.txt"\necho aggiornato\n'
    inizio = time.time() - 1
    buono = crea_tar("buono.tar.gz", [("LordZenzo-pytonIta-abc123/installatore/linux/installa.sh", script)])
    uscita = ag.installa_da_sorgenti(buono, prefisso)
    verifica("aggiornato" in uscita, "uscita dello script: " + uscita)
    chiamato = os.path.join(prefisso, "chiamato.txt")
    verifica(os.path.exists(chiamato), "lo script doveva essere eseguito")
    se os.path.exists(chiamato):
        testo_ = open(chiamato, encoding="utf-8").read()
        verifica("--solo-pitstudio" in testo_ e prefisso in testo_, "argomenti passati: " + testo_)
    temporanea = tempfile.gettempdir()
    resti = [d per d in os.listdir(temporanea) se d.startswith("pitstudio_sorgenti_") e os.path.getmtime(os.path.join(temporanea, d)) > inizio]
    verifica(non resti, "la cartella dei sorgenti scompattati doveva essere tolta: " + str(resti))

    # il file scaricato, se sta in una cartella pitstudio_aggiornamento_*, si toglie a installazione riuscita
    scarico = tempfile.mkdtemp(prefix="pitstudio_aggiornamento_")
    copia = os.path.join(scarico, "pytonita.tar.gz")
    shutil.copyfile(buono, copia)
    ag.installa_da_sorgenti(copia, prefisso)
    verifica(non os.path.exists(scarico), "il file scaricato doveva essere tolto a installazione riuscita")

    # archivio senza lo script: errore chiaro
    vuoto = crea_tar("vuoto.tar.gz", [("x/leggimi.txt", "niente")])
    sollevato = Falso
    prova:
        ag.installa_da_sorgenti(vuoto, prefisso)
    eccetto ag.ErroreAggiornamenti:
        sollevato = Vero
    verifica(sollevato, "senza installa.sh doveva dare errore")

    # percorso che esce dalla cartella: rifiutato
    cattivo = crea_tar("cattivo.tar.gz", [("../fuori.txt", "no"), ("a/installatore/linux/installa.sh", script)])
    sollevato = Falso
    prova:
        ag.installa_da_sorgenti(cattivo, prefisso)
    eccetto ag.ErroreAggiornamenti:
        sollevato = Vero
    verifica(sollevato, "un percorso con .. doveva essere rifiutato")
    verifica(non os.path.exists(os.path.join(lavoro, "fuori.txt")), "non deve scrivere fuori dalla cartella")

    # script che fallisce: errore con il testo
    guasto = crea_tar("guasto.tar.gz", [("a/installatore/linux/installa.sh", '#!/bin/sh\necho "compilazione fallita" >&2\nexit 3\n')])
    sollevato = Falso
    prova:
        ag.installa_da_sorgenti(guasto, prefisso)
    eccetto ag.ErroreAggiornamenti come errore:
        sollevato = "compilazione fallita" in testo(errore)
    verifica(sollevato, "lo script fallito doveva dare un errore con il suo testo")

    # archivio non valido
    rotto = os.path.join(lavoro, "rotto.tar.gz")
    open(rotto, "wb").write(b"non e' un archivio")
    sollevato = Falso
    prova:
        ag.installa_da_sorgenti(rotto, prefisso)
    eccetto ag.ErroreAggiornamenti:
        sollevato = Vero
    verifica(sollevato, "archivio non valido doveva dare errore")
    shutil.rmtree(lavoro, ignore_errors=Vero)
    stampa("PROVE FALLITE:" se errori altrimenti "tutte le prove superate", errori se errori altrimenti "")
