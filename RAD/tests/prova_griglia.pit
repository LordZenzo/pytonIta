"""Motore della disposizione a griglia (modelli_codice/griglia.pit): misure, pesi, estensioni, allineamento, finestre piccole."""
importa sys, os
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "modelli_codice"))
importa griglia come g

errori = []


definisci verifica(c, m):
    se non c:
        errori.append(m)
        stampa("ERRORE:", m)


# ----------------------------------------------------------------- pesi dal testo
verifica(g.pesi_da_testo("0, 1, 2") == [0.0, 1.0, 2.0], "pesi")
verifica(g.pesi_da_testo("") == [0.0] e g.pesi_da_testo("1;x;-3") == [1.0, 0.0, 0.0], "vuoti, sbagliati e negativi valgono 0: " + str(g.pesi_da_testo("1;x;-3")))
verifica(g.pesi_da_testo(Nessuno) == [0.0], "Nessuno")

# ----------------------------------------------------------------- misure naturali: una etichetta e un campo su due righe
voci = [(0, 0, 1, 1, "w", 80, 24), (0, 1, 1, 1, "", 160, 26), (1, 0, 1, 1, "w", 100, 24), (1, 1, 1, 1, "", 160, 26)]
r = g.calcola(480, 320, voci, [], [], 10, 6)
verifica(r[0][:2] == (10, 11) e r[1][:2] == (10 + 100 + 6, 10), "la colonna 0 prende la misura del componente più largo (100): " + str(r))
verifica(r[3][1] == 10 + 26 + 6 e r[2][1] == 10 + 26 + 6 + 1, "la riga 1 sta sotto la riga 0 (altezza 26) più lo spazio, e l'etichetta si centra nella riga: " + str(r[2:]))
verifica(r[0][2:] == (80, 24) e r[1][2:] == (160, 26), "senza riempire i componenti restano della loro misura")
# al centro della cella (sticky vuoto): l'etichetta da 80 nella colonna da 100 si centra
r = g.calcola(480, 320, [(0, 0, 1, 1, "", 80, 24), (1, 0, 1, 1, "", 100, 24)], [], [], 10, 6)
verifica(r[0][0] == 10 + 10 e r[1][0] == 10, "centrata nella cella: " + str(r))
r = g.calcola(480, 320, [(0, 0, 1, 1, "e", 80, 24), (1, 0, 1, 1, "w", 100, 24)], [], [], 10, 6)
verifica(r[0][0] == 10 + 20 e r[1][0] == 10, "a destra / a sinistra")

# ----------------------------------------------------------------- pesi: la colonna del campo si allarga con la finestra
voci = [(0, 0, 1, 1, "w", 80, 24), (0, 1, 1, 1, "ew", 120, 26)]
r = g.calcola(480, 320, voci, [0, 1], [], 10, 6)
verifica(r[0][:4] == (10, 11, 80, 24), "l'etichetta resta com'è: " + str(r[0]))
verifica(r[1][0] == 10 + 80 + 6 e r[1][2] == 480 - 10 - (10 + 80 + 6), "il campo riempie fino al margine destro: " + str(r[1]))
r2 = g.calcola(800, 320, voci, [0, 1], [], 10, 6)
verifica(r2[1][2] == 800 - 10 - (10 + 80 + 6), "con la finestra più larga il campo si allarga: " + str(r2[1]))
r3 = g.calcola(800, 320, voci, [0, 0], [], 10, 6)
verifica(r3[1][2] == 120, "senza pesi non si allarga: " + str(r3[1]))
# due colonne con pesi 1 e 3: lo spazio in più si divide 1 a 3
r = g.calcola(1000, 100, [(0, 0, 1, 1, "ew", 50, 20), (0, 1, 1, 1, "ew", 50, 20)], [1, 3], [], 0, 0)
verifica(r[0][2] == 50 + (1000 - 100) // 4 e r[0][2] + r[1][2] == 1000, "pesi 1 e 3: " + str(r))
# righe che si allargano
r = g.calcola(300, 500, [(0, 0, 1, 1, "nsew", 100, 30), (1, 0, 1, 1, "nsew", 100, 30)], [1], [0, 1], 10, 10)
verifica(r[0][3] == 30 e r[1][3] == 500 - 20 - 30 - 10, "la seconda riga prende l'altezza che avanza: " + str(r))
verifica(r[0][2] == 300 - 20, "riempie la larghezza")

# ----------------------------------------------------------------- estensioni
r = g.calcola(480, 320, [(0, 0, 1, 1, "w", 80, 24), (0, 1, 1, 1, "w", 80, 24), (1, 0, 1, 2, "ew", 300, 24)], [], [], 10, 6)
verifica(r[2][2] == 300, "un componente su due colonne da 300: " + str(r))
verifica(r[1][0] >= 10 + 80 + 6, "la differenza è andata a una colonna")
r = g.calcola(480, 320, [(0, 0, 2, 1, "ns", 80, 120), (0, 1, 1, 1, "w", 80, 24), (1, 1, 1, 1, "w", 80, 24)], [], [], 0, 10)
verifica(r[0][3] == 120 e r[0][1] == 0, "una cella su due righe: se la misura naturale non entra le righe crescono: " + str(r[0]))
verifica(r[2][1] == 34 + (86 - 24) // 2, "e la riga sotto è cresciuta della differenza (il componente si centra): " + str(r))

# ----------------------------------------------------------------- finestra più piccola dello spazio necessario
voci = [(0, 0, 1, 1, "w", 100, 24), (0, 1, 1, 1, "ew", 300, 24)]
r = g.calcola(260, 100, voci, [0, 1], [], 10, 6)
verifica(r[1][2] >= g.MINIMO e r[0][2] == 100, "la colonna che si allarga si comprime, l'altra no: " + str(r))
verifica(10 + 100 + 6 + r[1][2] <= 260 - 10 + 1, "e il campo entra nella finestra: " + str(r[1]))
r = g.calcola(120, 100, voci, [0, 1], [], 10, 6)
verifica(r[1][2] == g.MINIMO, "mai sotto il minimo: " + str(r[1]))

# ----------------------------------------------------------------- senza buchi con le divisioni non esatte
voci = [(0, 0, 1, 1, "nsew", 10, 10), (0, 1, 1, 1, "nsew", 10, 10), (0, 2, 1, 1, "nsew", 10, 10)]
r = g.calcola(101, 40, voci, [1, 1, 1], [1], 0, 0)
verifica(r[0][0] == 0 e r[0][0] + r[0][2] == r[1][0] e r[1][0] + r[1][2] == r[2][0] e r[2][0] + r[2][2] == 101, "le colonne si toccano e coprono tutto: " + str(r))
r = g.calcola(101, 40, voci, [1, 1, 1], [1], 0, 4)
verifica(r[1][0] - (r[0][0] + r[0][2]) == 4 e r[2][0] - (r[1][0] + r[1][2]) == 4, "con lo spazio di 4 tra le colonne: " + str(r))

# ----------------------------------------------------------------- casi limite
verifica(g.calcola(300, 200, [], [1], [1]) == [], "senza componenti niente")
r = g.calcola(300, 200, [(0, 0, 0, 0, "", 50, 20)], [], [], 5, 5)
verifica(r[0][2:] == (50, 20), "estensioni 0 valgono 1")
r = g.calcola(300, 200, [(2, 3, 1, 1, "w", 50, 20)], [], [], 5, 5)
verifica(r[0][0] == 5 e r[0][1] == 5, "le colonne e le righe vuote non occupano spazio: " + str(r))
r = g.calcola(300, 200, [(0, 0, 1, 1, "w", 400, 20)], [], [], 5, 5)
verifica(r[0][2] == 400, "un componente più grande della finestra: la colonna senza peso non si comprime (il resto esce dal bordo): " + str(r))

# ----------------------------------------------------------------- disponi su widget veri (Tk): disegno iniziale e finestra ridimensionata
importa tkinter come tk
radice = tk.Tk()
radice.geometry("400x200+20+20")
campo = tk.Entry(radice)
etichetta = tk.Label(radice, text="Nome")
g.disponi(radice, [(etichetta, 0, 0, 1, 1, "w", 60, 24), (campo, 0, 1, 1, 1, "ew", 100, 26)], [0, 1], [], 10, 6, 400, 200)
radice.update()
verifica((etichetta.winfo_x(), etichetta.winfo_y(), etichetta.winfo_width(), etichetta.winfo_height()) == (10, 11, 60, 24), "disegno iniziale: " + str((etichetta.winfo_x(), etichetta.winfo_width())))
verifica((campo.winfo_x(), campo.winfo_width()) == (76, 314), "il campo riempie: " + str((campo.winfo_x(), campo.winfo_width())))
radice.geometry("700x300")
radice.update()
verifica((campo.winfo_x(), campo.winfo_width()) == (76, 614), "ridimensionando la finestra il campo si allarga: " + str((campo.winfo_x(), campo.winfo_width())))
verifica(etichetta.winfo_width() == 60, "l'etichetta no")
radice.destroy()
stampa("PROVE FALLITE:" se errori altrimenti "tutte le prove superate", errori se errori altrimenti "")
