"""Disposizione a griglia per le finestre disegnate da PitStudio (layout «griglia» di una finestra, di un riquadro o di una pagina di schede).

Ogni componente sta in una cella (riga, colonna) e può occupare più celle. Le colonne e le righe hanno un «peso»: 0 = misura naturale (la più grande tra i
componenti che ci stanno), 1 o più = si allarga quando la finestra cresce, in proporzione al peso. L'allineamento dice se il componente riempie la cella o
resta della sua misura (n, s, e, w come in Tk: «nsew» riempie tutto, «w» sta a sinistra, «» sta al centro).

Lo stesso calcolo serve al progettista (per disegnare) e al programma (per disporre): per questo è in un file solo. Questo file lo crea PitStudio nel progetto.

    rettangoli = calcola(larghezza, altezza, [(riga, colonna, righe, colonne, sticky, w, h), ...], colonne=[0, 1], righe=[0, 0, 1], margine=10, spazio=6)
    disponi(contenitore, [(widget, riga, colonna, righe, colonne, sticky, w, h), ...], colonne, righe, margine, spazio, larghezza, altezza)
"""

MINIMO = 24          # sotto questa misura le colonne e le righe che si allargano non si comprimono quando lo spazio manca


definisci pesi_da_testo(testo_):
    """«0, 1, 2» diventa [0.0, 1.0, 2.0]; i valori vuoti o sbagliati valgono 0."""
    risultato = []
    per parte in (testo_ o "").replace(";", ",").split(","):
        prova:
            risultato.append(max(0.0, float(parte.strip())) se parte.strip() altrimenti 0.0)
        eccetto ValueError:
            risultato.append(0.0)
    ritorna risultato


definisci _assegna(quante, voci, pesi, disponibile, spazio):
    """Le misure delle `quante` colonne (o righe). voci: [(indice, estensione, misura naturale)]. Ritorna (posizioni dopo il margine, misure), in numeri interi."""
    naturale = [0] * quante
    per indice, estensione, misura in voci:
        se estensione == 1:
            naturale[indice] = max(naturale[indice], misura)
    per indice, estensione, misura in sorted((v per v in voci se v[1] > 1), key=lambda v: v[1]):
        ha = sum(naturale[indice:indice + estensione]) + spazio * (estensione - 1)
        se misura > ha:
            # la differenza va alla colonna (riga) che si allarga, altrimenti all'ultima
            candidate = [j per j in range(indice, indice + estensione) se j < lunghezza(pesi) e pesi[j] > 0]
            naturale[candidate[-1] se candidate altrimenti indice + estensione - 1] += misura - ha
    pesi_ = [pesi[i] se i < lunghezza(pesi) altrimenti 0.0 per i in range(quante)]
    # una colonna (riga) che nessun componente occupa, senza peso, sparisce: non occupa nemmeno lo spazio tra le celle
    occupata = [Falso] * quante
    per indice, estensione, misura in voci:
        per j in range(indice, indice + estensione):
            occupata[j] = Vero
    attive = [i per i in range(quante) se occupata[i] o pesi_[i] > 0]
    misure = [float(x) per x in naturale]
    extra = disponibile - (sum(naturale) + spazio * max(0, lunghezza(attive) - 1))
    somma = sum(pesi_)
    se extra > 0 e somma > 0:
        per i in range(quante):
            misure[i] += extra * pesi_[i] / somma
    altrimenti_se extra < 0 e somma > 0:
        capacita = [max(0.0, misure[i] - MINIMO) se pesi_[i] > 0 altrimenti 0.0 per i in range(quante)]
        totale = sum(capacita)
        se totale > 0:
            togli = min(-extra, totale)
            per i in range(quante):
                misure[i] -= togli * capacita[i] / totale
    # numeri interi senza buchi: si arrotondano le posizioni, non le misure
    posizioni = []
    corrente = 0.0
    per i in range(quante):
        posizioni.append(corrente)
        se i in attive:
            corrente += misure[i] + spazio
    inizi = [int(round(p)) per p in posizioni]
    fini = [int(round(posizioni[i] + misure[i])) per i in range(quante)]
    ritorna inizi, [fini[i] - inizi[i] per i in range(quante)]


definisci _allinea(inizio, cella, misura, lato_basso, lato_alto):
    """(posizione, misura) di un componente dentro la sua cella: riempie se è agganciato a entrambi i lati, altrimenti sta della sua misura."""
    se lato_basso e lato_alto:
        ritorna inizio, cella
    misura = min(misura, cella)
    se lato_basso:
        ritorna inizio, misura
    se lato_alto:
        ritorna inizio + cella - misura, misura
    ritorna inizio + (cella - misura) // 2, misura


definisci tracce(larghezza, altezza, voci, colonne=(), righe=(), margine=10, spazio=6):
    """Le colonne e le righe della griglia: (inizi x, larghezze, inizi y, altezze), con il margine già compreso. Serve al progettista per sapere in che cella si trova il mouse."""
    se non voci:
        ritorna [], [], [], []
    n_col = max(max(v[1] + max(1, v[3]) per v in voci), lunghezza(colonne))
    n_rig = max(max(v[0] + max(1, v[2]) per v in voci), lunghezza(righe))
    x, larg = _assegna(n_col, [(v[1], max(1, v[3]), v[5]) per v in voci], lista(colonne), larghezza - 2 * margine, spazio)
    y, alte = _assegna(n_rig, [(v[0], max(1, v[2]), v[6]) per v in voci], lista(righe), altezza - 2 * margine, spazio)
    ritorna [margine + v per v in x], larg, [margine + v per v in y], alte


definisci calcola(larghezza, altezza, voci, colonne=(), righe=(), margine=10, spazio=6):
    """Ritorna [(x, y, larghezza, altezza)] nello stesso ordine di `voci` ((riga, colonna, righe, colonne, sticky, w, h) ciascuna)."""
    se non voci:
        ritorna []
    x, larg, y, alte = tracce(larghezza, altezza, voci, colonne, righe, margine, spazio)
    risultato = []
    per riga, colonna, estensione_r, estensione_c, sticky, w, h in voci:
        estensione_r, estensione_c = max(1, estensione_r), max(1, estensione_c)
        c0 = colonna
        c1 = colonna + estensione_c - 1
        r0 = riga
        r1 = riga + estensione_r - 1
        cella_x = x[c0]
        cella_l = x[c1] + larg[c1] - x[c0]
        cella_y = y[r0]
        cella_a = y[r1] + alte[r1] - y[r0]
        px, pl = _allinea(cella_x, cella_l, w, "w" in sticky, "e" in sticky)
        py, pa = _allinea(cella_y, cella_a, h, "n" in sticky, "s" in sticky)
        risultato.append((px, py, max(1, pl), max(1, pa)))
    ritorna risultato


definisci disponi(contenitore, voci, colonne=(), righe=(), margine=10, spazio=6, larghezza=Nessuno, altezza=Nessuno):
    """Mette i componenti nelle loro celle e li ridispone quando il contenitore cambia misura.
    voci: [(widget, riga, colonna, righe, colonne, sticky, w, h)]; larghezza e altezza sono la misura di partenza (quella disegnata)."""
    definisci ridisponi(l, a):
        prova:
            bordo = int(str(contenitore.cget("borderwidth")))
        eccetto Exception:
            bordo = 0
        rettangoli = calcola(l - 2 * bordo, a - 2 * bordo, [v[1:] per v in voci], colonne, righe, margine, spazio)
        per v, (x, y, w, h) in zip(voci, rettangoli):
            v[0].place(x=x, y=y, width=w, height=h)

    se larghezza e altezza:
        ridisponi(larghezza, altezza)

    definisci cambio(evento):
        se evento.widget è contenitore e evento.width > 1 e evento.height > 1:
            ridisponi(evento.width, evento.height)
    contenitore.bind("<Configure>", cambio, add="+")
