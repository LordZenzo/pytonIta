"""Collega una tabella di un database a una finestra: FonteDati legge e scrive i record, MascheraDati li mostra in un elenco e in campi di testo.

    fonte = FonteDati.sqlite("dati.db", "clienti")                          # oppure FonteDati.con_mysql(server, porta, utente, password, database, "clienti")
    maschera = MascheraDati(fonte, finestra.elenco, {"nome": finestra.campo_nome, "citta": finestra.campo_citta}, finestra.etichetta_stato)
    maschera.ricarica()                                                     # poi: maschera.nuovo(), .salva(), .elimina(), .annulla(), .cerca("testo")

Questo file è stato creato da PitStudio (Database > Crea una maschera dalla tabella) e si può usare anche con finestre disegnate a mano.
"""
importa datetime
importa json
importa os
importa shutil
importa sqlite3
importa subprocess
importa sys
importa tkinter come tk
da tkinter importa filedialog, messagebox, simpledialog

TIPI_INTERI = ("INT",)
TIPI_DECIMALI = ("REAL", "DOUBLE", "FLOAT", "DECIMAL", "NUMERIC")
MASSIMO_RECORD = 2000


classe ErroreDati(Exception):
    """Un errore del database, con un messaggio leggibile."""


definisci cartella_dati_utente():
    """Dove un programma installato (exe) tiene i dati dell'utente: la cartella «<nome del programma>» dentro %APPDATA% (su Linux e macOS in ~/.local/share)."""
    nome = os.path.splitext(os.path.basename(sys.executable))[0] o "programma"
    base = os.environ.get("APPDATA") o os.path.join(os.path.expanduser("~"), ".local", "share")
    ritorna os.path.join(base, nome)


definisci posizione_dati(cartella):
    """Dove tiene i dati il programma costruito: «utente» (la cartella dei dati dell'utente, predefinito) o «accanto» (accanto all'exe, versione portatile):
    lo sceglie chi costruisce l'exe, e PitStudio lo scrive nel pacchetto (file dati_posizione.json)."""
    prova:
        con open(os.path.join(cartella, "dati_posizione.json"), encoding="utf-8") come f:
            ritorna json.load(f).get("posizione", "utente")
    eccetto (OSError, ValueError, AttributeError):
        ritorna "utente"


definisci cerca_database(cartella, database):
    """Se il database non sta dove la finestra lo cerca (accanto al programma), lo cerca nella cartella «risorse» e poi nelle sottocartelle (fino a 3 livelli):
    capita quando il file è stato spostato dopo aver scelto la fonte dati. Ritorna il percorso, o Nessuno."""
    nome = os.path.basename(database)
    diretto = os.path.join(cartella, "risorse", nome)
    se os.path.isfile(diretto):
        ritorna diretto
    base = os.path.abspath(cartella)
    per radice, cartelle, files in os.walk(base):
        cartelle[:] = sorted(c per c in cartelle se c non in (".rad", ".git", "__pycache__", "dist", "build", "venv", ".venv"))
        se radice[len(base):].count(os.sep) >= 3:
            cartelle[:] = []
        se nome in files:
            ritorna os.path.join(radice, nome)
    ritorna Nessuno


definisci percorso_database(cartella, database):
    """Il file del database SQLite da aprire. Nel progetto (e negli script) è quello accanto al programma. In un programma costruito con PitStudio (exe)
    i file stanno dentro il pacchetto, che a file singolo si scompatta in una cartella temporanea e si cancella alla chiusura: lì le modifiche andrebbero perse.
    Per questo alla prima apertura il database si copia nella cartella dei dati dell'utente (o accanto all'exe, se chi ha costruito il programma ha scelto la versione
    portatile e la cartella è scrivibile) e da quel momento si usa la copia: quello del pacchetto resta il punto di partenza."""
    se os.path.isabs(database):
        ritorna database
    originale = os.path.join(cartella, database)
    se non os.path.exists(originale):
        originale = cerca_database(cartella, database) o originale
    se non getattr(sys, "frozen", Falso):
        ritorna originale
    candidati = [os.path.join(cartella_dati_utente(), database)]
    se posizione_dati(cartella) == "accanto":
        candidati.insert(0, os.path.join(os.path.dirname(os.path.abspath(sys.executable)), database))
    per copia in candidati:
        prova:
            se non os.path.exists(copia) e os.path.exists(originale):
                os.makedirs(os.path.dirname(copia), exist_ok=Vero)
                shutil.copy2(originale, copia)
            se os.path.exists(copia):
                ritorna copia
        eccetto OSError:
            continua            # cartella non scrivibile: si prova la successiva
    ritorna candidati[-1]


definisci apri_cartella(percorso):
    """Mostra una cartella in Esplora risorse (o nel gestore file del sistema)."""
    prova:
        se os.name == "nt":
            os.startfile(percorso)
        altrimenti_se sys.platform == "darwin":
            subprocess.Popen(["open", percorso])
        altrimenti:
            subprocess.Popen(["xdg-open", percorso])
    eccetto Exception:
        passa


classe ErroreObbligatorio(ErroreDati):
    """Manca un campo obbligatorio: in una riga nuova della griglia si aspetta che sia compilato."""


classe FonteDati:
    """Una tabella: ne conosce le colonne e legge, aggiunge, modifica ed elimina i record."""

    definisci __inizializza__(se_stesso, conn, tabella, è_mysql=Falso):
        se_stesso.conn = conn
        se_stesso.tabella = tabella
        se_stesso.è_mysql = è_mysql
        se_stesso.segnaposto = "%s" se è_mysql altrimenti "?"
        se_stesso.cita = "`" se è_mysql altrimenti '"'
        se_stesso.colonne = []          # nomi
        se_stesso.tipi = {}             # nome -> tipo in maiuscolo
        se_stesso.chiave = []           # colonne della chiave primaria
        se_stesso.automatiche = []      # colonne che il database riempie da solo (auto-incremento)
        se_stesso.obbligatorie = []     # colonne NOT NULL senza valore predefinito: vanno compilate
        se_stesso.transazione = Falso   # Vero: le modifiche restano in sospeso finché non si chiama conferma()
        se_stesso.in_sospeso = 0        # quante modifiche aspettano la conferma
        se_stesso.percorso = ""         # il file del database (SQLite)
        se_stesso._leggi_struttura()

    @staticmethod
    definisci sqlite(percorso, tabella):
        prova:
            conn = sqlite3.connect(percorso)
        eccetto sqlite3.Error come eccezione:
            solleva ErroreDati(f"Non riesco ad aprire il database: {eccezione}")
        fonte = FonteDati(conn, tabella)
        fonte.percorso = os.path.abspath(percorso)
        ritorna fonte

    @staticmethod
    definisci con_mysql(server, porta, utente, password, database, tabella):
        prova:
            importa pymysql
        eccetto ImportError:
            solleva ErroreDati("Per MySQL serve il pacchetto pymysql (pip install pymysql).")
        prova:
            conn = pymysql.connect(host=server, port=int(porta), user=utente, password=password, database=database, charset="utf8mb4", connect_timeout=8)
        eccetto Exception come eccezione:
            solleva ErroreDati(f"Collegamento a MySQL non riuscito: {eccezione}")
        ritorna FonteDati(conn, tabella, è_mysql=Vero)

    definisci _n(se_stesso, nome):
        ritorna se_stesso.cita + nome.replace(se_stesso.cita, se_stesso.cita * 2) + se_stesso.cita

    definisci _esegui(se_stesso, sql, parametri=()):
        prova:
            cur = se_stesso.conn.cursor()
            se parametri:
                cur.execute(sql, tuple(parametri))
            altrimenti:
                cur.execute(sql)
        eccetto Exception come eccezione:
            solleva ErroreDati(tipo_testo(eccezione))
        ritorna cur

    definisci _leggi_struttura(se_stesso):
        se se_stesso.è_mysql:
            righe = se_stesso._esegui(f"SHOW COLUMNS FROM {se_stesso._n(se_stesso.tabella)}").fetchall()
            per r in righe:
                se_stesso.colonne.append(r[0])
                se_stesso.tipi[r[0]] = tipo_testo(r[1]).upper()
                se r[3] == "PRI":
                    se_stesso.chiave.append(r[0])
                se "auto_increment" in tipo_testo(r[5]):
                    se_stesso.automatiche.append(r[0])
                se r[2] == "NO" e r[4] è Nessuno e "auto_increment" non in tipo_testo(r[5]):
                    se_stesso.obbligatorie.append(r[0])
        altrimenti:
            righe = se_stesso._esegui(f"PRAGMA table_info({se_stesso._n(se_stesso.tabella)})").fetchall()
            per r in righe:
                se_stesso.colonne.append(r[1])
                se_stesso.tipi[r[1]] = (r[2] o "").upper()
                se r[5] > 0:
                    se_stesso.chiave.append(r[1])
                se r[3] e r[4] è Nessuno e r[5] == 0:
                    se_stesso.obbligatorie.append(r[1])
            se lunghezza_di(se_stesso.chiave) == 1 e "INT" in se_stesso.tipi[se_stesso.chiave[0]]:
                se_stesso.automatiche.append(se_stesso.chiave[0])
        se non se_stesso.colonne:
            solleva ErroreDati(f"La tabella «{se_stesso.tabella}» non esiste.")

    # ------------------------------------------------------------ lettura
    definisci record(se_stesso, ricerca="", filtro="", ordina_per="", decrescente=Falso):
        """Lista di (identificatore, {colonna: valore}) dei record, filtrati da un testo cercato in tutte le colonne.
        filtro: condizione SQL fissa (es. "citta = 'Roma'"); ordina_per: nome di una colonna."""
        condizioni = []
        par = []
        se filtro.strip():
            condizioni.append("(" + filtro.strip() + ")")
        se ricerca:
            tipo_testo = "CHAR" se se_stesso.è_mysql altrimenti "TEXT"
            condizioni.append("(" + " OR ".join(f"CAST({se_stesso._n(c)} AS {tipo_testo}) LIKE {se_stesso.segnaposto}" per c in se_stesso.colonne) + ")")
            par = ["%" + ricerca + "%"] * lunghezza_di(se_stesso.colonne)
        dove = (" WHERE " + " AND ".join(condizioni)) se condizioni altrimenti ""
        ordine = ""
        se ordina_per e ordina_per in se_stesso.colonne:
            ordine = f" ORDER BY {se_stesso._n(ordina_per)}" + (" DESC" se decrescente altrimenti "")
        t = se_stesso._n(se_stesso.tabella)
        risultato = []
        se se_stesso.è_mysql:
            righe = se_stesso._esegui(f"SELECT * FROM {t}{dove}{ordine} LIMIT {MASSIMO_RECORD}", par).fetchall()
            per r in righe:
                valori = dict(zip(se_stesso.colonne, r))
                risultato.append((tuple(valori[c] per c in se_stesso.chiave) se se_stesso.chiave altrimenti Nessuno, valori))
        altrimenti:
            ordine = ordine o " ORDER BY rowid"
            righe = se_stesso._esegui(f"SELECT rowid, * FROM {t}{dove}{ordine} LIMIT {MASSIMO_RECORD}", par).fetchall()
            per r in righe:
                risultato.append((r[0], dict(zip(se_stesso.colonne, r[1:]))))
        ritorna risultato

    # ------------------------------------------------------------ scrittura
    definisci _converti(se_stesso, colonna, valore_testo):
        tipo_ = se_stesso.tipi.get(colonna, "")
        numerica = any(t in tipo_ per t in TIPI_INTERI + TIPI_DECIMALI)
        se valore_testo == "":
            se colonna in se_stesso.obbligatorie:
                solleva ErroreObbligatorio(f"«{colonna}» è obbligatorio: compilalo.")
            ritorna Nessuno
        prova:
            se any(t in tipo_ per t in TIPI_INTERI):
                ritorna int(valore_testo)
            se any(t in tipo_ per t in TIPI_DECIMALI):
                ritorna float(valore_testo.replace(",", "."))
        eccetto ValueError:
            solleva ErroreDati(f"«{colonna}» deve essere un numero.")
        ritorna valore_testo

    definisci _dove(se_stesso, id_):
        se se_stesso.è_mysql:
            se id_ è Nessuno:
                solleva ErroreDati("La tabella non ha una chiave primaria: non posso individuare il record.")
            ritorna " AND ".join(f"{se_stesso._n(c)} = {se_stesso.segnaposto}" per c in se_stesso.chiave), tipo_lista(id_)
        ritorna f"rowid = {se_stesso.segnaposto}", [id_]

    definisci salva(se_stesso, valori_testo, id_=Nessuno):
        """Inserisce (id_ = Nessuno) o aggiorna un record. valori_testo: {colonna: testo}. Ritorna l'identificatore del record."""
        t = se_stesso._n(se_stesso.tabella)
        se id_ è Nessuno:
            nomi = [c per c in se_stesso.colonne se (c in valori_testo o c in se_stesso.obbligatorie) e non (c in se_stesso.automatiche e valori_testo.get(c, "") == "")]
            valori = [se_stesso._converti(c, valori_testo.get(c, "")) per c in nomi]
            se nomi:
                elenco_nomi = ", ".join(se_stesso._n(c) per c in nomi)
                segnaposti = ", ".join([se_stesso.segnaposto] * lunghezza_di(nomi))
                cur = se_stesso._esegui(f"INSERT INTO {t} ({elenco_nomi}) VALUES ({segnaposti})", valori)
            altrimenti:
                cur = se_stesso._esegui(f"INSERT INTO {t} DEFAULT VALUES" se non se_stesso.è_mysql altrimenti f"INSERT INTO {t} () VALUES ()")
            nuovo = cur.lastrowid
            se_stesso._fatto()
            se se_stesso.è_mysql:
                ritorna tuple((valori_testo.get(c) se valori_testo.get(c) != "" altrimenti Nessuno) o nuovo per c in se_stesso.chiave) se se_stesso.chiave altrimenti Nessuno
            ritorna nuovo
        nomi = [c per c in se_stesso.colonne se c non in se_stesso.automatiche e c in valori_testo]      # solo le colonne che la finestra mostra
        se non nomi:
            ritorna id_
        dove, par = se_stesso._dove(id_)
        assegnazioni = ", ".join(se_stesso._n(c) + " = " + se_stesso.segnaposto per c in nomi)
        se_stesso._esegui(f"UPDATE {t} SET {assegnazioni} WHERE {dove}", [se_stesso._converti(c, valori_testo.get(c, "")) per c in nomi] + par)
        se_stesso._fatto()
        ritorna id_

    definisci elimina(se_stesso, id_):
        dove, par = se_stesso._dove(id_)
        se_stesso._esegui(f"DELETE FROM {se_stesso._n(se_stesso.tabella)} WHERE {dove}", par)
        se_stesso._fatto()

    definisci _fatto(se_stesso):
        """Una modifica è stata eseguita: la rende definitiva, oppure (in transazione) la lascia in sospeso."""
        se se_stesso.transazione:
            se_stesso.in_sospeso += 1
        altrimenti:
            se_stesso.conn.commit()

    definisci conferma(se_stesso):
        """Commit: rende definitive tutte le modifiche in sospeso."""
        prova:
            se_stesso.conn.commit()
        eccetto Exception come problema:
            solleva ErroreDati(tipo_testo(problema))
        se_stesso.in_sospeso = 0

    definisci annulla_tutto(se_stesso):
        """Rollback: cancella tutte le modifiche in sospeso."""
        prova:
            se_stesso.conn.rollback()
        eccetto Exception come problema:
            solleva ErroreDati(tipo_testo(problema))
        se_stesso.in_sospeso = 0

    # ------------------------------------------------------------ copia di sicurezza e ripristino (solo SQLite)
    definisci cartella_dati(se_stesso):
        """La cartella che contiene il file del database."""
        ritorna os.path.dirname(se_stesso.percorso) se se_stesso.percorso altrimenti ""

    definisci _senza_sospese(se_stesso):
        se se_stesso.in_sospeso:
            solleva ErroreDati("Ci sono modifiche non confermate: confermale o annullale, poi riprova.")

    definisci copia_di_sicurezza(se_stesso, destinazione):
        """Salva una copia completa e coerente del database (anche se il programma lo sta usando)."""
        se se_stesso.è_mysql:
            solleva ErroreDati("La copia di sicurezza riguarda i database SQLite.")
        se_stesso._senza_sospese()
        se os.path.abspath(destinazione) == se_stesso.percorso:
            solleva ErroreDati("La copia deve avere un nome diverso dal database.")
        prova:
            copia = sqlite3.connect(destinazione)
            prova:
                se_stesso.conn.backup(copia)
            infine:
                copia.close()
        eccetto sqlite3.Error come eccezione:
            solleva ErroreDati(f"Non riesco a fare la copia: {eccezione}")
        ritorna destinazione

    definisci copia_automatica(se_stesso):
        """Una copia accanto al database, con la data nel nome: si fa prima di un ripristino, per poter tornare indietro."""
        radice, estensione = os.path.splitext(se_stesso.percorso)
        ritorna se_stesso.copia_di_sicurezza(f"{radice}_prima_del_ripristino_{datetime.datetime.now():%Y%m%d_%H%M%S}{estensione o '.db'}")

    definisci controlla_copia(se_stesso, percorso):
        """Solleva ErroreDati se il file non è una copia di questo database (stessa tabella, colonne compatibili)."""
        se non os.path.exists(percorso):
            solleva ErroreDati("Il file non esiste.")
        prova:
            c = sqlite3.connect("file:" + percorso.replace("\\", "/") + "?mode=ro", uri=Vero)
            prova:
                se c.execute("PRAGMA quick_check").fetchone()[0] != "ok":
                    solleva ErroreDati("Il file è danneggiato.")
                colonne = [r[1] per r in c.execute(f"PRAGMA table_info({se_stesso._n(se_stesso.tabella)})").fetchall()]
            infine:
                c.close()
        eccetto sqlite3.Error:
            solleva ErroreDati("Questo file non è una copia di un database valida.")
        se non colonne:
            solleva ErroreDati(f"La copia non contiene la tabella «{se_stesso.tabella}»: non è una copia di questi dati.")
        mancanti = [x per x in se_stesso.colonne se x non in colonne]
        se mancanti:
            solleva ErroreDati("La copia non ha le colonne " + ", ".join(mancanti) + ": viene da un'altra versione del programma.")

    definisci ripristina_da(se_stesso, percorso):
        """Sostituisce il contenuto del database con quello della copia. Prima va chiamato controlla_copia()."""
        se_stesso._senza_sospese()
        prova:
            origine = sqlite3.connect(percorso)
            prova:
                origine.backup(se_stesso.conn)
            infine:
                origine.close()
        eccetto sqlite3.Error come eccezione:
            solleva ErroreDati(f"Ripristino non riuscito: {eccezione}")

    definisci chiudi(se_stesso):
        prova:
            se_stesso.conn.close()
        eccetto Exception:
            passa


classe MascheraDati:
    """Collega una FonteDati a un elenco (Albero) e a campi di testo: mostra, aggiunge, salva ed elimina record."""

    definisci __inizializza__(se_stesso, fonte, elenco, campi, stato=Nessuno, colonne_elenco=Nessuno):
        se_stesso.fonte = fonte
        se_stesso.elenco = elenco
        se_stesso.campi = campi                # {colonna: campo di testo}
        se_stesso.stato = stato
        se_stesso.colonne_elenco = tipo_lista(colonne_elenco) se colonne_elenco altrimenti tipo_lista(elenco["columns"])
        se_stesso.record = []
        se_stesso.id_corrente = Nessuno
        se_stesso.ricerca = ""

    definisci _messaggio(se_stesso, testo_):
        se se_stesso.stato è non Nessuno:
            se_stesso.stato.configure(text=testo_)

    definisci ricarica(se_stesso, seleziona=Nessuno):
        """Rilegge i record (con la ricerca attuale) e seleziona quello indicato (o il primo)."""
        prova:
            se_stesso.record = se_stesso.fonte.record(se_stesso.ricerca)
        eccetto ErroreDati come errore:
            messagebox.showerror("Database", tipo_testo(errore))
            ritorna
        se_stesso.elenco.delete(*se_stesso.elenco.get_children())
        indice = Nessuno
        per i, (id_, valori) in enumera(se_stesso.record):
            se_stesso.elenco.insert("", "end", iid=tipo_testo(i), values=["" se valori.get(c) è Nessuno altrimenti valori.get(c) per c in se_stesso.colonne_elenco])
            se seleziona è non Nessuno e id_ == seleziona:
                indice = i
        se indice è Nessuno e se_stesso.record e seleziona è Nessuno:
            indice = 0
        se indice è non Nessuno:
            se_stesso.elenco.selection_set(tipo_testo(indice))
            se_stesso.elenco.see(tipo_testo(indice))
            se_stesso.mostra(indice)
        altrimenti:
            se_stesso.nuovo()
        n = lunghezza_di(se_stesso.record)
        se_stesso._messaggio(f"{n} record" + (f"  ·  ricerca: «{se_stesso.ricerca}»" se se_stesso.ricerca altrimenti "") + (f"  (mostrati i primi {MASSIMO_RECORD})" se n >= MASSIMO_RECORD altrimenti ""))

    definisci mostra(se_stesso, indice):
        id_, valori = se_stesso.record[indice]
        se_stesso.id_corrente = id_
        se_stesso._tutti_i_campi(valori)

    definisci _tutti_i_campi(se_stesso, valori):
        per colonna, campo in se_stesso.campi.items():
            v = valori.get(colonna)
            campo.delete(0, "end")
            campo.insert(0, "" se v è Nessuno altrimenti tipo_testo(v))

    definisci scelta_riga(se_stesso, evento=Nessuno):
        sel = se_stesso.elenco.selection()
        se sel:
            se_stesso.mostra(int(sel[0]))

    definisci nuovo(se_stesso):
        """Svuota i campi per scrivere un nuovo record."""
        se_stesso.id_corrente = Nessuno
        se_stesso.elenco.selection_remove(*se_stesso.elenco.selection())
        se_stesso._tutti_i_campi({})
        per colonna, campo in se_stesso.campi.items():
            se colonna non in se_stesso.fonte.automatiche:
                campo.focus_set()
                interrompi
        se_stesso._messaggio("Nuovo record: compila i campi e premi Salva.")

    definisci salva(se_stesso):
        valori = {colonna: campo.get() per colonna, campo in se_stesso.campi.items()}
        prova:
            id_ = se_stesso.fonte.salva(valori, se_stesso.id_corrente)
        eccetto ErroreDati come errore:
            messagebox.showwarning("Il record non è stato salvato", tipo_testo(errore))
            ritorna
        se_stesso.ricarica(id_)
        se_stesso._messaggio("Salvato.")

    definisci elimina(se_stesso):
        se se_stesso.id_corrente è Nessuno:
            se_stesso._messaggio("Scegli prima un record dall'elenco.")
            ritorna
        se non messagebox.askyesno("Elimina", "Elimino il record scelto? Non si può annullare."):
            ritorna
        prova:
            se_stesso.fonte.elimina(se_stesso.id_corrente)
        eccetto ErroreDati come errore:
            messagebox.showwarning("Il record non è stato eliminato", tipo_testo(errore))
            ritorna
        se_stesso.id_corrente = Nessuno
        se_stesso.ricarica()
        se_stesso._messaggio("Record eliminato.")

    definisci annulla(se_stesso):
        """Torna ai valori salvati del record scelto (o svuota i campi di un record nuovo)."""
        sel = se_stesso.elenco.selection()
        se sel:
            se_stesso.mostra(int(sel[0]))
        altrimenti:
            se_stesso.nuovo()

    definisci cerca(se_stesso, testo_cercato):
        se_stesso.ricerca = testo_cercato.strip()
        se_stesso.ricarica()


# ---------------------------------------------------------------------------------------------- componenti collegati ai dati
classe BarraDati(tk.Frame):
    """Barra di navigazione di una tabella: primo, precedente, successivo, ultimo, nuovo, salva, elimina, annulla e ricerca. Si collega con Collegamento.collega_barra()."""
    TESTI = {"primo": "|◀", "precedente": "◀", "successivo": "▶", "ultimo": "▶|", "nuovo": "Nuovo", "salva": "Salva", "elimina": "Elimina", "annulla": "Annulla",
             "conferma": "Conferma", "annulla_tutto": "Annulla tutto"}
    AIUTI = {"primo": "Primo record", "precedente": "Record precedente", "successivo": "Record successivo", "ultimo": "Ultimo record"}
    SOLO_NEL_PROGRAMMA = Vero       # il menu «Dati» compare nei programmi costruiti (exe), dove l'utente non sa dove sta il database

    definisci __inizializza__(se_stesso, genitore, pulsanti=("primo", "precedente", "successivo", "ultimo", "nuovo", "salva", "elimina", "annulla"), posizione=Vero, cerca=Falso, dati=Vero, **opzioni):
        tk.Frame.__init__(se_stesso, genitore, **opzioni)
        se_stesso.collegamento = Nessuno
        se_stesso.pulsanti = {}
        se_stesso.campo_cerca = Nessuno
        se_stesso.menu_dati = Nessuno
        se dati e (getattr(sys, "frozen", Falso) o non se_stesso.SOLO_NEL_PROGRAMMA):
            se_stesso.pulsante_dati = tk.Menubutton(se_stesso, text="Dati ▾", relief="raised", padx=8, pady=3, direction="below")
            se_stesso.menu_dati = tk.Menu(se_stesso.pulsante_dati, tearoff=0, postcommand=se_stesso._aggiorna_menu_dati)
            se_stesso.pulsante_dati.configure(menu=se_stesso.menu_dati)
            se_stesso.pulsante_dati.pack(side="right", padx=(4, 0))
            se_stesso.menu_dati.add_command(label="", state="disabled")
            se_stesso.menu_dati.add_separator()
            se_stesso.menu_dati.add_command(label="Apri la cartella dei dati", command=se_stesso._apri_cartella_dati)
            se_stesso.menu_dati.add_command(label="Crea una copia di sicurezza…", command=se_stesso._copia_di_sicurezza)
            se_stesso.menu_dati.add_command(label="Ripristina da una copia…", command=se_stesso._ripristina)
        se cerca:             # (la ricerca si impacchetta per prima: se la barra è stretta si accorciano gli altri pulsanti, non lei)
            se_stesso.pulsante_tutti = tk.Button(se_stesso, text="Tutti", command=lambda: se_stesso._cerca(""), padx=8, pady=3)
            se_stesso.pulsante_tutti.pack(side="right", padx=(4, 0))
            se_stesso.pulsante_cerca = tk.Button(se_stesso, text="Cerca", command=lambda: se_stesso._cerca(se_stesso.campo_cerca.get()), padx=8, pady=3)
            se_stesso.pulsante_cerca.pack(side="right", padx=(4, 0))
            se_stesso.campo_cerca = tk.Entry(se_stesso, width=14)
            se_stesso.campo_cerca.pack(side="right")
            se_stesso.campo_cerca.bind("<Return>", lambda ev: se_stesso._cerca(se_stesso.campo_cerca.get()))
        per nome in pulsanti:
            se nome non in se_stesso.TESTI:
                continua
            b = tk.Button(se_stesso, text=se_stesso.TESTI[nome], width=3 se nome in se_stesso.AIUTI altrimenti 0, command=lambda n=nome: se_stesso._premuto(n), padx=8, pady=3)
            b.pack(side="left", padx=(0, 4))
            se_stesso.pulsanti[nome] = b
        se_stesso.etichetta = Nessuno
        se posizione:
            se_stesso.etichetta = tk.Label(se_stesso, text="", anchor="w")
            se_stesso.etichetta.pack(side="left", padx=(6, 6))

    # ------------------------------------------------------------ il menu «Dati»
    definisci _fonte_sqlite(se_stesso):
        c = se_stesso.collegamento
        f = c.fonte se c altrimenti Nessuno
        ritorna f se (f e non f.è_mysql e f.percorso) altrimenti Nessuno

    definisci _aggiorna_menu_dati(se_stesso):
        f = se_stesso._fonte_sqlite()
        m = se_stesso.menu_dati
        m.entryconfigure(0, label=("Dati in: " + f.percorso) se f altrimenti "Nessun database SQLite collegato")
        per i in (2, 3, 4):
            m.entryconfigure(i, state="normal" se f altrimenti "disabled")

    definisci _apri_cartella_dati(se_stesso):
        f = se_stesso._fonte_sqlite()
        se f:
            apri_cartella(f.cartella_dati())

    definisci _copia_di_sicurezza(se_stesso):
        f = se_stesso._fonte_sqlite()
        se non f:
            ritorna
        nome, estensione = os.path.splitext(os.path.basename(f.percorso))
        scelto = filedialog.asksaveasfilename(parent=se_stesso, title="Salva la copia di sicurezza", defaultextension=estensione o ".db",
                                              initialfile=f"{nome}_copia_{datetime.date.today().isoformat()}{estensione o '.db'}",
                                              filetypes=[("Database", "*.db *.sqlite *.sqlite3"), ("Tutti i file", "*.*")])
        se non scelto:
            ritorna
        prova:
            f.copia_di_sicurezza(scelto)
        eccetto ErroreDati come errore:
            messagebox.showerror("Copia di sicurezza", tipo_testo(errore), parent=se_stesso)
            ritorna
        messagebox.showinfo("Copia di sicurezza", "Copia salvata:\n" + scelto + "\n\nPer tornare a questi dati usa «Ripristina da una copia…».", parent=se_stesso)

    definisci _ripristina(se_stesso):
        f = se_stesso._fonte_sqlite()
        se non f:
            ritorna
        scelto = filedialog.askopenfilename(parent=se_stesso, title="Scegli la copia da ripristinare", filetypes=[("Database", "*.db *.sqlite *.sqlite3"), ("Tutti i file", "*.*")])
        se non scelto:
            ritorna
        prova:
            f.controlla_copia(scelto)
        eccetto ErroreDati come errore:
            messagebox.showerror("Ripristino", tipo_testo(errore), parent=se_stesso)
            ritorna
        se non messagebox.askyesno("Ripristina da una copia", "I dati attuali verranno sostituiti con quelli della copia.\n\nPrima di sostituirli salvo una copia automatica dei dati di adesso "
                                   "accanto al database, così puoi tornare indietro. Procedo?", parent=se_stesso, icon="warning"):
            ritorna
        prova:
            automatica = f.copia_automatica()
            f.ripristina_da(scelto)
        eccetto ErroreDati come errore:
            messagebox.showerror("Ripristino", tipo_testo(errore), parent=se_stesso)
            ritorna
        se se_stesso.collegamento:
            se_stesso.collegamento.ricarica()
        messagebox.showinfo("Ripristino", "Dati ripristinati.\n\nLa copia dei dati di prima è in:\n" + automatica, parent=se_stesso)

    definisci _cerca(se_stesso, testo_cercato):
        se se_stesso.collegamento:
            se non testo_cercato e se_stesso.campo_cerca:
                se_stesso.campo_cerca.delete(0, "end")
            se_stesso.collegamento.cerca(testo_cercato)

    definisci _premuto(se_stesso, nome):
        se se_stesso.collegamento:
            getattr(se_stesso.collegamento, nome)()

    definisci aggiorna(se_stesso):
        """Abilita solo i pulsanti che in questo momento servono e scrive «3 / 25»."""
        c = se_stesso.collegamento
        n = c.numero_record() se c altrimenti 0
        i = c.indice se c altrimenti -1
        in_nuovo = bool(c e c.in_nuovo)
        pronto = bool(c e c.fonte)
        # scrivendo un record nuovo si può tornare ai record salvati con «primo», «precedente» e «ultimo»
        stato = {"primo": n > 0 e (in_nuovo o i > 0), "precedente": n > 0 e (in_nuovo o i > 0), "successivo": non in_nuovo e 0 <= i < n - 1,
                 "ultimo": n > 0 e (in_nuovo o i < n - 1),
                 "nuovo": pronto, "salva": pronto, "elimina": pronto e non in_nuovo e i >= 0, "annulla": pronto,
                 "conferma": pronto e c.fonte.transazione, "annulla_tutto": pronto e c.fonte.transazione}
        per nome, b in se_stesso.pulsanti.items():
            b.configure(state="normal" se stato.get(nome) altrimenti "disabled")
        se se_stesso.etichetta è non Nessuno:
            sospese = c.modifiche_in_sospeso() se pronto altrimenti 0
            coda = (f"  ·  {sospese} non confermata" se sospese == 1 altrimenti f"  ·  {sospese} non confermate") se sospese altrimenti ""
            se non pronto:
                se_stesso.etichetta.configure(text="(nessun database)")
            altrimenti_se in_nuovo:
                se_stesso.etichetta.configure(text=f"nuovo record  ·  {n} salvati{coda}")
            altrimenti_se n == 0:
                se_stesso.etichetta.configure(text=f"nessun record{coda}")
            altrimenti:
                se_stesso.etichetta.configure(text=f"{i + 1} / {n}{coda}")


classe Collegamento:
    """Collega una tabella ai componenti di una finestra: i campi mostrano il record corrente, gli elenchi mostrano tutti i record, la barra naviga.

        dati = Collegamento.crea(radice, cartella, "sqlite", "dati.db", "clienti")
        dati.collega_campo(finestra.campo_nome, "nome")      # un campo, una casella, un'area di testo, un cursore, una casella combinata, un'etichetta
        dati.collega_griglia(finestra.albero)                # un Albero (o un Elenco con la colonna da mostrare)
        dati.collega_barra(finestra.barra)
        dati.apri()
    """

    definisci __inizializza__(se_stesso, radice, fonte, filtro="", ordina_per="", decrescente=Falso, al_cambio=Nessuno, errore="", salva_da_solo=Vero, transazione=Falso):
        se_stesso.radice = radice
        se_stesso.transazione = transazione           # le modifiche restano in sospeso fino a conferma() (commit) o annulla_tutto() (rollback)
        se_stesso._sporche = set()                    # i record modificati e non ancora confermati (evidenziati nella griglia)
        se_stesso._editor = Nessuno
        se_stesso._riga_nuova = {}                    # i valori della riga che si sta aggiungendo nella griglia
        se_stesso.salva_da_solo = salva_da_solo       # salva le modifiche cambiando record, cercando e chiudendo la finestra
        se_stesso._istantanea = Nessuno               # i valori dei campi appena mostrati: serve a sapere se l'utente ha scritto qualcosa
        se_stesso._agganciata = Falso
        se_stesso.fonte = fonte
        se fonte:
            fonte.transazione = transazione
        se_stesso.errore = errore
        se_stesso.filtro = filtro
        se_stesso.ordina_per = ordina_per
        se_stesso.decrescente = decrescente
        se_stesso.al_cambio = al_cambio
        se_stesso.record = []
        se_stesso.indice = -1
        se_stesso.in_nuovo = Falso
        se_stesso.ricerca = ""
        se_stesso.campi = []            # (componente, colonna)
        se_stesso.griglie = []          # (componente, colonna o Nessuno)
        se_stesso.grafici = []          # (componente Grafico, colonna delle etichette, colonna dei valori)
        se_stesso.barre = []
        se_stesso._muovo = Falso

    # ------------------------------------------------------------ creazione
    @staticmethod
    definisci crea(radice, cartella, dialetto, database, tabella, server="localhost", porta=3306, utente="root", password=Nessuno, filtro="", ordina_per="", decrescente=Falso, al_cambio=Nessuno, salva_da_solo=Vero, transazione=Falso):
        """Apre la tabella. Se non ci riesce mostra l'errore e ritorna un Collegamento spento (la finestra si apre lo stesso).
        Per MySQL la password, se manca, viene chiesta all'utente (non viene mai scritta nel programma)."""
        errore = ""
        fonte = Nessuno
        prova:
            se non tabella:
                solleva ErroreDati("Nessuna tabella scelta: scegli «Tabella» nelle proprietà della fonte dati.")
            se dialetto == "mysql":
                se password è Nessuno:
                    password = simpledialog.askstring("MySQL", f"Password di {utente}@{server}:", show="*", parent=radice) o ""
                fonte = FonteDati.con_mysql(server, porta, utente, password, database, tabella)
            altrimenti:
                se non database:
                    solleva ErroreDati("Nessun database scelto: scegli «Database» nelle proprietà della fonte dati.")
                percorso = percorso_database(cartella, database)
                se non os.path.exists(percorso):
                    solleva ErroreDati(f"Il database «{database}» non esiste.")
                fonte = FonteDati.sqlite(percorso, tabella)
        eccetto ErroreDati come problema:
            errore = tipo_testo(problema)
            messagebox.showwarning("Database", errore, parent=radice)
        ritorna Collegamento(radice, fonte, filtro, ordina_per, decrescente, al_cambio, errore, salva_da_solo, transazione)

    definisci collega_campo(se_stesso, componente, colonna):
        se_stesso.campi.append((componente, colonna))

    definisci collega_griglia(se_stesso, componente, colonna=Nessuno, modificabile=Falso):
        """Un Albero mostra le colonne che hanno lo stesso nome di quelle della tabella; un Elenco mostra la colonna indicata.
        modificabile (solo Albero): doppio clic su una cella per scriverci, Tab per la cella dopo, Insert aggiunge una riga, Canc la elimina."""
        se_stesso.griglie.append((componente, colonna))
        se componente.winfo_class() == "Treeview":
            componente.bind("<<TreeviewSelect>>", se_stesso._scelta_griglia, add="+")
            componente.tag_configure("sporca", background="#fff3b0", foreground="#000000")
            se modificabile:
                componente.bind("<Double-1>", se_stesso._doppio_clic_griglia, add="+")
                componente.bind("<F2>", se_stesso._f2_griglia, add="+")
                componente.bind("<Insert>", lambda ev: se_stesso._riga_nuova_griglia(componente), add="+")
                componente.bind("<Delete>", lambda ev: se_stesso.elimina(), add="+")
        altrimenti:
            componente.bind("<<ListboxSelect>>", se_stesso._scelta_griglia, add="+")

    definisci collega_grafico(se_stesso, grafico, colonna_etichette="", colonna_valori=""):
        """Un Grafico mostra i record della tabella: le etichette dalla colonna indicata (se vuota: il numero del record) e i valori dalla colonna dei valori."""
        se_stesso.grafici.append((grafico, colonna_etichette, colonna_valori))
        se_stesso._riempi_grafici()

    definisci _riempi_grafici(se_stesso):
        per grafico, colonna_etichette, colonna_valori in se_stesso.grafici:
            voci = []
            per i, (id_, valori) in enumera(se_stesso.record):
                etichetta = valori.get(colonna_etichette) se colonna_etichette altrimenti i + 1
                voci.append(("" se etichetta è Nessuno altrimenti tipo_testo(etichetta), valori.get(colonna_valori) se colonna_valori altrimenti 1))
            prova:
                grafico.imposta_dati(voci)
            eccetto tk.TclError:
                passa

    definisci collega_barra(se_stesso, barra):
        barra.collegamento = se_stesso
        se_stesso.barre.append(barra)
        barra.aggiorna()

    # ------------------------------------------------------------ lettura e scrittura dei componenti
    @staticmethod
    definisci _leggi(w):
        """Il contenuto di un componente, come testo."""
        classe_tk = w.winfo_class()
        se classe_tk == "Text":
            ritorna w.get("1.0", "end-1c")
        se classe_tk == "Checkbutton":
            ritorna "1" se tipo_testo(w.getvar(tipo_testo(w.cget("variable")))) in ("1", "True", "true") altrimenti "0"
        se classe_tk == "Scale":
            x = float(w.get())
            ritorna tipo_testo(int(x)) se x == int(x) altrimenti tipo_testo(x)
        ritorna w.get()

    @staticmethod
    definisci _scrivi(w, valore):
        classe_tk = w.winfo_class()
        testo_ = "" se valore è Nessuno altrimenti tipo_testo(valore)
        se classe_tk == "Label":
            w.configure(text=testo_)
        altrimenti_se classe_tk == "Checkbutton":
            prova:
                acceso = bool(int(float(testo_ o "0")))
            eccetto ValueError:
                acceso = testo_.lower() in ("true", "vero", "si", "sì")
            w.select() se acceso altrimenti w.deselect()
        altrimenti_se classe_tk == "Scale":
            prova:
                w.set(float(testo_ o "0"))
            eccetto ValueError:
                w.set(0)
        altrimenti_se classe_tk == "TCombobox":
            w.set(testo_)
        altrimenti_se classe_tk == "Text":
            disattivo = tipo_testo(w.cget("state")) == "disabled"
            se disattivo:
                w.configure(state="normal")
            w.delete("1.0", "end")
            w.insert("1.0", testo_)
            se disattivo:
                w.configure(state="disabled")
        altrimenti:
            disattivo = tipo_testo(w.cget("state")) == "disabled"
            se disattivo:
                w.configure(state="normal")
            w.delete(0, "end")
            w.insert(0, testo_)
            se disattivo:
                w.configure(state="disabled")

    @staticmethod
    definisci _si_salva(w):
        """Le etichette sono solo da mostrare: non si salvano."""
        ritorna w.winfo_class() != "Label"

    # ------------------------------------------------------------ record
    definisci numero_record(se_stesso):
        ritorna lunghezza_di(se_stesso.record)

    definisci corrente(se_stesso):
        """Il record corrente come dizionario {colonna: valore} (vuoto se si sta scrivendo un record nuovo)."""
        se 0 <= se_stesso.indice < lunghezza_di(se_stesso.record) e non se_stesso.in_nuovo:
            ritorna dict(se_stesso.record[se_stesso.indice][1])
        ritorna {}

    definisci valore(se_stesso, colonna):
        ritorna se_stesso.corrente().get(colonna)

    definisci apri(se_stesso):
        """Legge i record e mostra il primo."""
        se_stesso.ricarica()
        se_stesso._aggancia_chiusura()

    definisci ricarica(se_stesso, seleziona=Nessuno):
        se non se_stesso.fonte:
            se_stesso._aggiorna_barre()
            ritorna
        prova:
            se_stesso.record = se_stesso.fonte.record(se_stesso.ricerca, se_stesso.filtro, se_stesso.ordina_per, se_stesso.decrescente)
        eccetto ErroreDati come problema:
            messagebox.showerror("Database", tipo_testo(problema), parent=se_stesso.radice)
            ritorna
        se_stesso._riempi_griglie()
        se_stesso._riempi_grafici()
        indice = Nessuno
        se seleziona è non Nessuno:
            per i, (id_, valori) in enumera(se_stesso.record):
                se id_ == seleziona:
                    indice = i
        se indice è Nessuno e se_stesso.record e seleziona è Nessuno:
            indice = 0
        se indice è non Nessuno:
            se_stesso._vai(indice)
        altrimenti:
            se_stesso._nuovo()

    definisci _riempi_griglie(se_stesso):
        se_stesso._muovo = Vero
        prova:
            per w, colonna in se_stesso.griglie:
                se w.winfo_class() == "Treeview":
                    w.delete(*w.get_children())
                    nomi = tipo_lista(w["columns"])
                    per i, (id_, valori) in enumera(se_stesso.record):
                        w.insert("", "end", iid=tipo_testo(i), values=["" se valori.get(n) è Nessuno altrimenti valori.get(n) per n in nomi],
                                 tags=("sporca",) se id_ in se_stesso._sporche altrimenti ())
                altrimenti:
                    w.delete(0, "end")
                    per id_, valori in se_stesso.record:
                        w.insert("end", "" se valori.get(colonna) è Nessuno altrimenti tipo_testo(valori.get(colonna)))
        infine:
            se_stesso._muovo = Falso

    definisci _seleziona_nelle_griglie(se_stesso):
        valido = 0 <= se_stesso.indice < lunghezza_di(se_stesso.record) e non se_stesso.in_nuovo
        se_stesso._muovo = Vero
        prova:
            per w, colonna in se_stesso.griglie:
                se w.winfo_class() == "Treeview":
                    voluta = (tipo_testo(se_stesso.indice),) se valido altrimenti ()
                    se tuple(w.selection()) != voluta:           # (se è già così non la tocco: ogni cambio rimanda un evento)
                        w.selection_set(voluta) se valido altrimenti w.selection_remove(*w.selection())
                    se valido:
                        w.see(tipo_testo(se_stesso.indice))
                altrimenti:
                    voluta = (se_stesso.indice,) se valido altrimenti ()
                    se tuple(w.curselection()) != voluta:
                        w.selection_clear(0, "end")
                        se valido:
                            w.selection_set(se_stesso.indice)
                    se valido:
                        w.see(se_stesso.indice)
        infine:
            se_stesso._muovo = Falso

    definisci _scelta_griglia(se_stesso, evento=Nessuno):
        se se_stesso._muovo:
            ritorna
        w = evento.widget
        sel = w.selection() se w.winfo_class() == "Treeview" altrimenti w.curselection()
        se sel e (int(sel[0]) != se_stesso.indice o se_stesso.in_nuovo):
            se_stesso.vai(int(sel[0]))

    # ------------------------------------------------------------ modifica nella griglia
    definisci _chiudi_editor(se_stesso):
        se se_stesso._editor:
            prova:
                se_stesso._editor.destroy()
            eccetto tk.TclError:
                passa
            se_stesso._editor = Nessuno

    definisci _doppio_clic_griglia(se_stesso, evento):
        w = evento.widget
        se w.identify_region(evento.x, evento.y) != "cell":
            ritorna
        riga = w.identify_row(evento.y)
        colonna = w.identify_column(evento.x)
        se riga e colonna:
            se_stesso._apri_editor(w, riga, int(colonna[1:]) - 1)

    definisci _f2_griglia(se_stesso, evento):
        w = evento.widget
        sel = w.selection()
        se sel:
            se_stesso._apri_editor(w, sel[0], 0)

    definisci _apri_editor(se_stesso, w, riga, numero_colonna):
        """Una casella di testo sopra la cella: Invio/Tab confermano, Esc annulla. Le colonne che il database riempie da solo non si scrivono."""
        se_stesso._chiudi_editor()
        nomi = tipo_lista(w["columns"])
        se numero_colonna < 0 o numero_colonna >= lunghezza_di(nomi):
            ritorna
        nome = nomi[numero_colonna]
        nuova = riga == "nuova"
        se nome in se_stesso.fonte.automatiche:               # salto alla prossima colonna scrivibile
            per k in range(numero_colonna + 1, lunghezza_di(nomi)):
                se nomi[k] non in se_stesso.fonte.automatiche:
                    se_stesso._apri_editor(w, riga, k)
                    ritorna
            ritorna
        w.see(riga)
        w.update_idletasks()
        riquadro = w.bbox(riga, f"#{numero_colonna + 1}")
        se non riquadro:
            ritorna
        x, y, larghezza, altezza = riquadro
        id_ = Nessuno se nuova altrimenti se_stesso.record[int(riga)][0]
        attuale = tipo_testo(w.set(riga, nome))
        casella = tk.Entry(w)
        casella.insert(0, attuale)
        casella.select_range(0, "end")
        casella.place(x=x, y=y, width=larghezza, height=altezza)
        casella.focus_set()
        se_stesso._editor = casella
        chiuso = [Falso]

        definisci finisci(vai_avanti=Falso):
            se chiuso[0]:
                ritorna
            chiuso[0] = Vero
            nuovo_testo = casella.get()
            se_stesso._chiudi_editor()
            se nuovo_testo == attuale e non nuova:
                se vai_avanti:
                    se_stesso._cella_dopo(w, id_, riga, numero_colonna)
                ritorna
            se_stesso._scrivi_cella(w, id_, riga, nome, nuovo_testo)
            se vai_avanti:
                se_stesso._cella_dopo(w, id_, riga, numero_colonna)

        casella.bind("<Return>", lambda ev: finisci())
        casella.bind("<Tab>", lambda ev: (finisci(Vero), "break")[1])
        casella.bind("<Escape>", lambda ev: (chiuso.__setitem__(0, Vero), se_stesso._chiudi_editor(), "break")[2])
        casella.bind("<FocusOut>", lambda ev: finisci())

    definisci _cella_dopo(se_stesso, w, id_, riga, numero_colonna):
        """Apre l'editor della cella a destra (nella stessa riga) dopo aver scritto la precedente."""
        nomi = tipo_lista(w["columns"])
        se numero_colonna + 1 >= lunghezza_di(nomi):
            ritorna
        iid = riga
        se riga != "nuova" e id_ è non Nessuno:
            iid = Nessuno
            per i, (rid, valori) in enumera(se_stesso.record):
                se rid == id_:
                    iid = tipo_testo(i)
            se iid è Nessuno:
                ritorna
        altrimenti_se riga == "nuova" e "nuova" non in w.get_children():
            ritorna            # la riga nuova è stata già salvata: finito
        se_stesso._apri_editor(w, iid, numero_colonna + 1)

    definisci _segna(se_stesso, id_):
        se se_stesso.transazione e id_ è non Nessuno:
            se_stesso._sporche.add(id_)

    definisci _scrivi_cella(se_stesso, w, id_, riga, nome, nuovo_testo):
        """Scrive una cella. In una riga nuova i valori si raccolgono e il record si inserisce appena sono sufficienti."""
        se riga == "nuova":
            se_stesso._riga_nuova[nome] = nuovo_testo
            w.set("nuova", nome, nuovo_testo)
            prova:
                nuovo_id = se_stesso.fonte.salva(dict(se_stesso._riga_nuova), Nessuno)
            eccetto ErroreObbligatorio:
                ritorna           # mancano ancora dei campi: si aspetta
            eccetto ErroreDati come problema:
                messagebox.showwarning("Il record non è stato salvato", tipo_testo(problema), parent=se_stesso.radice)
                ritorna
            se_stesso._riga_nuova = {}
            se_stesso._segna(nuovo_id)
            se_stesso.ricarica(nuovo_id)
            ritorna
        riuscito, _ = se_stesso._conferma()
        se non riuscito:
            ritorna
        prova:
            se_stesso.fonte.salva({nome: nuovo_testo}, id_)
        eccetto ErroreDati come problema:
            messagebox.showwarning("Il valore non è stato salvato", tipo_testo(problema), parent=se_stesso.radice)
            ritorna
        se_stesso._segna(id_)
        se_stesso.ricarica(id_)

    definisci _riga_nuova_griglia(se_stesso, w):
        """Insert: aggiunge in fondo una riga vuota da compilare cella per cella."""
        se non se_stesso.fonte:
            ritorna
        riuscito, id_ = se_stesso._conferma()
        se non riuscito:
            ritorna
        se "nuova" in w.get_children():
            w.delete("nuova")
        se_stesso._riga_nuova = {}
        nomi = tipo_lista(w["columns"])
        w.insert("", "end", iid="nuova", values=[""] * lunghezza_di(nomi), tags=("sporca",))
        w.see("nuova")
        per k, n in enumera(nomi):
            se n non in se_stesso.fonte.automatiche:
                se_stesso._apri_editor(w, "nuova", k)
                interrompi

    definisci _foto(se_stesso):
        """I valori attuali dei campi (come testo)."""
        prova:
            ritorna {colonna: se_stesso._leggi(w) per w, colonna in se_stesso.campi se se_stesso._si_salva(w)}
        eccetto tk.TclError:
            ritorna Nessuno               # la finestra è già chiusa

    definisci modificato(se_stesso):
        """True se l'utente ha scritto qualcosa nei campi dopo averli mostrati."""
        ora = se_stesso._foto()
        ritorna se_stesso._istantanea è non Nessuno e ora è non Nessuno e ora != se_stesso._istantanea

    definisci _mostra_campi(se_stesso, valori):
        per w, colonna in se_stesso.campi:
            se_stesso._scrivi(w, valori.get(colonna))
        se_stesso._istantanea = se_stesso._foto()

    definisci _scrivi_record(se_stesso):
        """Scrive nel database i valori dei campi. Ritorna (riuscito, identificatore del record)."""
        valori = se_stesso._foto()
        id_ = Nessuno se se_stesso.in_nuovo o se_stesso.indice < 0 altrimenti se_stesso.record[se_stesso.indice][0]
        prova:
            nuovo_id = se_stesso.fonte.salva(valori, id_)
        eccetto ErroreDati come problema:
            messagebox.showwarning("Il record non è stato salvato", tipo_testo(problema), parent=se_stesso.radice)
            ritorna Falso, Nessuno
        se_stesso._segna(nuovo_id)
        ritorna Vero, nuovo_id

    definisci _conferma(se_stesso):
        """Prima di lasciare il record: se è stato modificato (e il salvataggio automatico è acceso) lo salva.
        Ritorna (si può procedere, identificatore del record salvato o Nessuno)."""
        se non se_stesso.salva_da_solo o non se_stesso.fonte o non se_stesso.modificato():
            ritorna Vero, Nessuno
        riuscito, id_ = se_stesso._scrivi_record()
        ritorna riuscito, id_

    definisci _aggancia_chiusura(se_stesso):
        """Chiudendo la finestra salva le modifiche rimaste (se il salvataggio non riesce chiede cosa fare);
        in transazione chiede anche se confermare o annullare le modifiche in sospeso."""
        se se_stesso._agganciata o non (se_stesso.salva_da_solo o se_stesso.transazione) o non se_stesso.fonte:
            ritorna
        se_stesso._agganciata = Vero
        finestra = se_stesso.radice.winfo_toplevel()
        precedente = finestra.protocol("WM_DELETE_WINDOW")

        definisci chiudi_finestra():
            se_stesso._chiudi_editor()
            riuscito, _ = se_stesso._conferma()
            se non riuscito e non messagebox.askyesno("Chiudi", "Le modifiche non sono state salvate. Chiudo lo stesso?", parent=se_stesso.radice):
                ritorna
            se se_stesso.transazione e se_stesso.fonte.in_sospeso:
                n = se_stesso.fonte.in_sospeso
                risposta = messagebox.askyesnocancel("Chiudi", f"Ci sono {n} modifiche non confermate.\n\nSì = le confermo (commit)\nNo = le annullo (rollback)\nAnnulla = resto qui", parent=se_stesso.radice)
                se risposta è Nessuno:
                    ritorna
                prova:
                    se risposta:
                        se_stesso.fonte.conferma()
                    altrimenti:
                        se_stesso.fonte.annulla_tutto()
                eccetto ErroreDati come problema:
                    messagebox.showwarning("Database", tipo_testo(problema), parent=se_stesso.radice)
                    ritorna
            se precedente:
                finestra.tk.call(precedente)
            altrimenti:
                finestra.destroy()
        finestra.protocol("WM_DELETE_WINDOW", chiudi_finestra)

    definisci _aggiorna_barre(se_stesso):
        per b in se_stesso.barre:
            b.aggiorna()
        se se_stesso.al_cambio:
            se_stesso.al_cambio()

    # ------------------------------------------------------------ navigazione
    definisci vai(se_stesso, indice):
        """Va al record numero `indice` (da 0); se il record attuale è stato modificato lo salva prima."""
        se non se_stesso.record:
            ritorna
        indice = max(0, min(lunghezza_di(se_stesso.record) - 1, indice))
        destinazione = se_stesso.record[indice][0]
        riuscito, id_ = se_stesso._conferma()
        se non riuscito:
            se_stesso._seleziona_nelle_griglie()          # resta dov'è
            ritorna
        se id_ è non Nessuno:
            se_stesso.ricarica(id_)                       # il salvataggio può cambiare l'ordine: ritrovo la destinazione dal suo identificatore
            per i, (rid, valori) in enumera(se_stesso.record):
                se rid == destinazione:
                    indice = i
        se_stesso._vai(indice)

    definisci _vai(se_stesso, indice):
        se non se_stesso.record:
            ritorna
        indice = max(0, min(lunghezza_di(se_stesso.record) - 1, indice))
        se_stesso.indice = indice
        se_stesso.in_nuovo = Falso
        se_stesso._mostra_campi(se_stesso.record[indice][1])
        se_stesso._seleziona_nelle_griglie()
        se_stesso._aggiorna_barre()

    definisci primo(se_stesso):
        se_stesso.vai(0)

    definisci precedente(se_stesso):
        se_stesso.vai(lunghezza_di(se_stesso.record) - 1 se se_stesso.in_nuovo altrimenti se_stesso.indice - 1)

    definisci successivo(se_stesso):
        se_stesso.vai(se_stesso.indice + 1)

    definisci ultimo(se_stesso):
        se_stesso.vai(lunghezza_di(se_stesso.record) - 1)

    # ------------------------------------------------------------ modifiche
    definisci nuovo(se_stesso):
        """Svuota i campi per scrivere un nuovo record (prima salva quello attuale, se modificato)."""
        riuscito, id_ = se_stesso._conferma()
        se non riuscito:
            ritorna
        se id_ è non Nessuno:
            se_stesso.ricarica(id_)
        se_stesso._nuovo()

    definisci _nuovo(se_stesso):
        se_stesso.in_nuovo = Vero
        se_stesso._mostra_campi({})
        se_stesso._seleziona_nelle_griglie()
        per w, colonna in se_stesso.campi:
            se se_stesso._si_salva(w) e (non se_stesso.fonte o colonna non in se_stesso.fonte.automatiche):
                prova:
                    w.focus_set()
                eccetto Exception:
                    passa
                interrompi
        se_stesso._aggiorna_barre()

    definisci salva(se_stesso):
        se non se_stesso.fonte:
            ritorna
        riuscito, id_ = se_stesso._scrivi_record()
        se riuscito:
            se_stesso.ricarica(id_)

    definisci elimina(se_stesso):
        se non se_stesso.fonte o se_stesso.in_nuovo o se_stesso.indice < 0:
            ritorna
        se non messagebox.askyesno("Elimina", "Elimino il record scelto? Non si può annullare.", parent=se_stesso.radice):
            ritorna
        prova:
            se_stesso.fonte.elimina(se_stesso.record[se_stesso.indice][0])
        eccetto ErroreDati come problema:
            messagebox.showwarning("Il record non è stato eliminato", tipo_testo(problema), parent=se_stesso.radice)
            ritorna
        posto = se_stesso.indice
        se_stesso.ricarica()
        se se_stesso.record:
            se_stesso._vai(min(posto, lunghezza_di(se_stesso.record) - 1))

    definisci annulla(se_stesso):
        """Torna ai valori salvati del record (o svuota i campi di uno nuovo)."""
        se se_stesso.in_nuovo o se_stesso.indice < 0:
            se_stesso._nuovo()
        altrimenti:
            se_stesso._vai(se_stesso.indice)

    definisci cerca(se_stesso, testo_cercato):
        riuscito, id_ = se_stesso._conferma()
        se non riuscito:
            ritorna
        se_stesso.ricerca = testo_cercato.strip()
        se_stesso.ricarica()

    # ------------------------------------------------------------ transazione
    definisci modifiche_in_sospeso(se_stesso):
        """Quante modifiche (salvataggi ed eliminazioni) aspettano la conferma. Sempre 0 se la transazione è spenta."""
        ritorna se_stesso.fonte.in_sospeso se se_stesso.fonte altrimenti 0

    definisci conferma(se_stesso):
        """Commit: salva il record attuale (se modificato) e rende definitive tutte le modifiche in sospeso."""
        se non se_stesso.fonte:
            ritorna Falso
        se_stesso._chiudi_editor()
        riuscito, id_ = se_stesso._conferma()
        se non riuscito:
            ritorna Falso
        prova:
            se_stesso.fonte.conferma()
        eccetto ErroreDati come problema:
            messagebox.showwarning("Le modifiche non sono state confermate", tipo_testo(problema), parent=se_stesso.radice)
            ritorna Falso
        se_stesso._sporche.clear()
        se_stesso._ritrova(id_ se id_ è non Nessuno altrimenti se_stesso._id_corrente())
        ritorna Vero

    definisci annulla_tutto(se_stesso):
        """Rollback: cancella tutte le modifiche in sospeso (anche quelle dei campi non ancora salvate) e rilegge i dati."""
        se non se_stesso.fonte:
            ritorna Falso
        se_stesso._chiudi_editor()
        id_ = se_stesso._id_corrente()
        prova:
            se_stesso.fonte.annulla_tutto()
        eccetto ErroreDati come problema:
            messagebox.showwarning("Le modifiche non sono state annullate", tipo_testo(problema), parent=se_stesso.radice)
            ritorna Falso
        se_stesso._sporche.clear()
        se_stesso._ritrova(id_)
        ritorna Vero

    definisci _id_corrente(se_stesso):
        se 0 <= se_stesso.indice < lunghezza_di(se_stesso.record) e non se_stesso.in_nuovo:
            ritorna se_stesso.record[se_stesso.indice][0]
        ritorna Nessuno

    definisci _ritrova(se_stesso, id_):
        """Rilegge i record e torna a quello con l'identificatore dato (se esiste ancora), altrimenti al primo."""
        se_stesso.ricarica()
        se id_ è non Nessuno:
            per i, (rid, valori) in enumera(se_stesso.record):
                se rid == id_:
                    se_stesso._vai(i)
                    ritorna

    definisci chiudi(se_stesso):
        se se_stesso.fonte:
            se_stesso.fonte.chiudi()
