COLORI_MODIFICABILI = [
    ("sfondo", "Sfondo finestra"), ("pannello", "Pannelli"), ("editor", "Sfondo editor"),
    ("editor_testo", "Testo editor"), ("selezione", "Selezione"), ("accento", "Accento"),
    ("parola_chiave", "Parole chiave"), ("builtin", "Funzioni predefinite"), ("stringa", "Stringhe"),
    ("commento", "Commenti"), ("numero", "Numeri"), ("definizione", "Nomi definiti"),
    ("costante", "Vero / Falso / Nessuno"), ("decoratore", "Decoratori"), ("errore", "Errori"),
]


classe Impostazioni(DialogoBase):
    definisci __inizializza__(se_stesso, genitore, config, colori, pagina=Nessuno):
        DialogoBase.__init__(se_stesso, genitore, "Impostazioni", colori, 640, 560)
        se_stesso.resizable(Vero, Vero)
        se_stesso.config_ = config
        se_stesso.var = {}
        se_stesso.var_colori = {}
        se_stesso._tele = {}              # pagina -> tela che la fa scorrere
        c = colori
        se_stesso.grid_columnconfigure(0, weight=1)
        se_stesso.grid_rowconfigure(0, weight=1)
        blocco = ttk.Notebook(se_stesso)
        blocco.grid(row=0, column=0, sticky="nsew", padx=8, pady=8)
        se_stesso.blocco = blocco
        se_stesso._scheda_tema(blocco)
        per titolo, campi in SCHEDE:
            se_stesso._scheda(blocco, titolo, campi)
        lega_rotella(se_stesso, se_stesso._rotella)
        se pagina:
            titoli = [blocco.tab(t, "text").strip() per t in blocco.tabs()]
            se pagina in titoli:
                blocco.select(titoli.index(pagina))
        pulsanti = tk.Frame(se_stesso, background=c["pannello"])
        pulsanti.grid(row=1, column=0, sticky="e", padx=10, pady=(0, 10))
        tk.Button(pulsanti, text="Annulla", command=se_stesso.destroy, background=c["pulsante"],
                  foreground=c["primo_piano"], relief="flat", padx=14).pack(side="right", padx=4)
        tk.Button(pulsanti, text="Applica", command=se_stesso.applica, background=c["pulsante"],
                  foreground=c["primo_piano"], relief="flat", padx=14).pack(side="right", padx=4)
        tk.Button(pulsanti, text="OK", command=se_stesso.conferma, background=c["accento"],
                  foreground="#ffffff", relief="flat", padx=18).pack(side="right", padx=4)

    # --- schede
    definisci _pagina(se_stesso, blocco, titolo):
        """Una pagina che scorre in verticale quando le voci non ci stanno (rotella, barra a destra)."""
        sfondo = se_stesso.colori["pannello"]
        esterno = tk.Frame(blocco, background=sfondo)
        blocco.add(esterno, text=f" {titolo} ")
        tela = tk.Canvas(esterno, highlightthickness=0, background=sfondo, yscrollincrement=30)
        barra = ttk.Scrollbar(esterno, orient="vertical", command=tela.yview)
        tela.configure(yscrollcommand=barra.set)
        barra.pack(side="right", fill="y")
        tela.pack(side="left", fill="both", expand=Vero)
        cornice = tk.Frame(tela, background=sfondo)
        finestra_id = tela.create_window(0, 0, window=cornice, anchor="nw")
        cornice.bind("<Configure>", lambda evento: tela.configure(scrollregion=tela.bbox("all")))
        tela.bind("<Configure>", lambda elemento: tela.itemconfigure(finestra_id, width=elemento.width))
        cornice.grid_columnconfigure(1, weight=1)
        se_stesso._tele[tipo_testo(esterno)] = tela
        ritorna cornice

    definisci _rotella(se_stesso, evento):
        """La rotella fa scorrere la pagina aperta (non dove c'è già un campo di testo che scorre da solo)."""
        se evento.widget.winfo_class() in ("Text", "Listbox", "TCombobox"):
            ritorna
        prova:
            tela = se_stesso._tele.get(tipo_testo(se_stesso.blocco.nametowidget(se_stesso.blocco.select())))
        eccetto (tk.TclError, KeyError):
            ritorna
        se tela è Nessuno o tela.yview() == (0.0, 1.0):
            ritorna
        tela.yview_scroll(-1 se evento.delta > 0 altrimenti 1, "units")

    definisci _scheda(se_stesso, blocco, titolo, campi):
        pagina = se_stesso._pagina(blocco, titolo)
        c = se_stesso.colori
        per riga, (percorso, etichetta, tipo_, extra) in enumera(campi):
            valore = se_stesso.config_.ottieni(percorso)
            tk.Label(pagina, text=etichetta, anchor="w", background=c["pannello"], foreground=c["primo_piano"],
                     wraplength=250, justify="left").grid(row=riga, column=0, sticky="w", padx=12, pady=5)
            se tipo_ == "si_no":
                var = tk.BooleanVar(value=bool(valore))
                w = tk.Checkbutton(pagina, variable=var, background=c["pannello"], selectcolor=c["casella"],
                                   activebackground=c["pannello"])
            altrimenti_se tipo_ == "numero":
                var = tk.StringVar(value=tipo_testo(valore))
                w = tk.Spinbox(pagina, textvariable=var, from_=extra[0], to=extra[1], width=10,
                               background=c["campo"], foreground=c["primo_piano"], relief="flat",
                               insertbackground=c["cursore"], buttonbackground=c["pulsante"])
            altrimenti_se tipo_ == "carattere":
                var = tk.StringVar(value=valore)
                famiglie = sorted(set(tkfont.families()))
                w = ttk.Combobox(pagina, textvariable=var, values=famiglie, width=30)
            altrimenti_se tipo_.startswith("scelta:"):
                var = tk.StringVar(value=tipo_testo(valore))
                w = ttk.Combobox(pagina, textvariable=var, values=tipo_.split(":", 1)[1].split(","), state="readonly", width=20)
            altrimenti_se tipo_ == "lungo":
                var = tk.StringVar(value=valore)
                w = tk.Text(pagina, width=40, height=6, wrap="word", background=c["campo"], foreground=c["primo_piano"],
                            insertbackground=c["cursore"], relief="flat", highlightthickness=1,
                            highlightbackground=c["bordo"])
                w.insert("1.0", valore)
                w._variabile_lunga = Vero
            altrimenti:
                var = tk.StringVar(value=tipo_testo(valore se valore è non Nessuno altrimenti ""))
                w = tk.Entry(pagina, textvariable=var, width=40, background=c["campo"], foreground=c["primo_piano"],
                             insertbackground=c["cursore"], relief="flat", highlightthickness=1,
                             highlightbackground=c["bordo"], highlightcolor=c["accento"],
                             show="•" se tipo_ == "segreto" altrimenti "")
            w.grid(row=riga, column=1, sticky="we" se non (tipo_ in ("si_no", "numero") o tipo_.startswith("scelta:")) altrimenti "w", padx=12, pady=5)
            se_stesso.var[percorso] = (var, w, tipo_, valore)

    definisci _scheda_tema(se_stesso, blocco):
        pagina = se_stesso._pagina(blocco, "Tema")
        c = se_stesso.colori
        tk.Label(pagina, text="Tema", anchor="w", background=c["pannello"], foreground=c["primo_piano"]).grid(
            row=0, column=0, sticky="w", padx=12, pady=8)
        se_stesso.var_tema = tk.StringVar(value=se_stesso.config_.ottieni("tema"))
        cb = ttk.Combobox(pagina, textvariable=se_stesso.var_tema, values=tipo_lista(TEMI.keys()), state="readonly", width=14)
        cb.grid(row=0, column=1, sticky="w", padx=12)
        cb.bind("<<ComboboxSelected>>", lambda evento: se_stesso._ricarica_colori())
        tk.Label(pagina, text="Colori personalizzati (vuoto = quelli del tema)", anchor="w",
                 background=c["pannello"], foreground=c["tenue"]).grid(row=1, column=0, columnspan=2, sticky="w", padx=12)
        griglia = tk.Frame(pagina, background=c["pannello"])
        griglia.grid(row=2, column=0, columnspan=2, sticky="nsew", padx=12, pady=6)
        se_stesso.griglia_colori = griglia
        per i, (chiave, etichetta) in enumera(COLORI_MODIFICABILI):
            col = (i % 2) * 3
            riga = i // 2
            tk.Label(griglia, text=etichetta, anchor="w", background=c["pannello"], foreground=c["primo_piano"],
                     width=20).grid(row=riga, column=col, sticky="w", pady=3)
            var = tk.StringVar()
            elemento = tk.Entry(griglia, textvariable=var, width=9, background=c["campo"], foreground=c["primo_piano"],
                         relief="flat", insertbackground=c["cursore"])
            elemento.grid(row=riga, column=col + 1, padx=4)
            campione = tk.Label(griglia, text="   ", width=3, relief="solid", borderwidth=1)
            campione.grid(row=riga, column=col + 2, padx=(0, 14))
            campione.bind("<Button-1>", lambda ev, v=var, k=chiave: se_stesso._scegli_colore(v, k))
            var.trace_add("write", lambda *a, v=var, l=campione: se_stesso._aggiorna_campione(v, l))
            se_stesso.var_colori[chiave] = (var, campione)
        tk.Button(pagina, text="Ripristina i colori del tema", command=se_stesso._azzera_colori,
                  relief="flat", background=c["pulsante"], foreground=c["primo_piano"]).grid(
            row=3, column=0, columnspan=2, sticky="w", padx=12, pady=8)
        se_stesso._ricarica_colori()

    definisci _ricarica_colori(se_stesso):
        tema = se_stesso.var_tema.get()
        base = TEMI.get(tema, TEMI["scuro"])
        personalizzati = se_stesso.config_.ottieni("temi_personalizzati." + tema, {}) o {}
        per chiave, (var, campione) in se_stesso.var_colori.items():
            var.set(personalizzati.get(chiave, ""))
            se_stesso._aggiorna_campione(var, campione, base.get(chiave))

    definisci _aggiorna_campione(se_stesso, var, campione, predefinito=Nessuno):
        tema = TEMI.get(se_stesso.var_tema.get(), TEMI["scuro"])
        chiave = [k per k, (v, c) in se_stesso.var_colori.items() se v è var]
        valore = var.get().strip() o (predefinito o (tema.get(chiave[0]) se chiave altrimenti "#888888"))
        prova:
            campione.configure(background=valore)
        eccetto tk.TclError:
            campione.configure(background="#888888")

    definisci _scegli_colore(se_stesso, var, chiave):
        tema = TEMI.get(se_stesso.var_tema.get(), TEMI["scuro"])
        scelto = colorchooser.askcolor(color=var.get() o tema.get(chiave), parent=se_stesso)
        se scelto e scelto[1]:
            var.set(scelto[1])

    definisci _azzera_colori(se_stesso):
        per var, campione in se_stesso.var_colori.values():
            var.set("")

    # --- applicazione
    definisci applica(se_stesso):
        cfg = se_stesso.config_
        per percorso, (var, w, tipo_, originale) in se_stesso.var.items():
            se tipo_ == "si_no":
                nuovo = bool(var.get())
            altrimenti_se tipo_ == "numero":
                prova:
                    nuovo = int(float(var.get()))
                eccetto ValueError:
                    nuovo = originale
            altrimenti_se tipo_ == "lungo":
                nuovo = w.get("1.0", "end").strip()
            altrimenti:
                nuovo = var.get().strip()
            se nuovo != cfg.ottieni(percorso):
                cfg.imposta(percorso, nuovo, notifica=Falso)
        tema = se_stesso.var_tema.get()
        cfg.imposta("tema", tema, notifica=Falso)
        personalizzati = {k: v.get().strip() per k, (v, c) in se_stesso.var_colori.items() se v.get().strip()}
        cfg.imposta("temi_personalizzati." + tema, personalizzati, notifica=Falso)
        cfg.salva()
        cfg.notifica("*")

    definisci conferma(se_stesso):
        se_stesso.applica()
        se_stesso.risultato = Vero
        se_stesso.destroy()
