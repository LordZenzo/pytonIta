"""Finestra delle impostazioni di PitStudio (tutto è configurabile e salvato in ~/.rad/config.json)."""
importa tkinter come tk
importa tkinter.font come tkfont
da tkinter importa ttk, colorchooser, messagebox

da rad.tema importa TEMI
da rad.dialoghi importa DialogoBase
da rad.piattaforma importa lega_rotella

