CARTELLA_PROGETTI = os.path.join(os.path.expanduser("~"), "RAD_progetti")
COLORE_CHAT_APERTA = "#1e9e3a"       # verde del pulsante dell'assistente quando la chat è aperta


classe Applicazione:
    """Coordina tutti i pannelli. Fa anche da 'ambiente' per l'assistente AI."""

    definisci __inizializza__(se_stesso, radice, config=Nessuno, chiedi_avvio=Falso):
        se_stesso.radice = radice
        se_stesso.config_ = config o Configurazione()
        se_stesso.colori = tema.colori(se_stesso.config_)
        se_stesso.progetto = Nessuno
        se_stesso.schede = {}            # percorso assoluto -> widget della scheda
        se_stesso.storia = Nessuno       # Storia delle modifiche dell'assistente del progetto aperto
        se_stesso.punti_arresto = {}     # percorso assoluto -> insieme di righe con punto di arresto (debugger)
        se_stesso.dettagli_punti = {}    # percorso assoluto -> {riga: {"se", "dopo", "messaggio"}} (punti con condizione)
        se_stesso.debug = SessioneDebug(se_stesso)
        se_stesso.recupero = recupero.Recupero()
        se_stesso._sintassi = {}         # widget -> id del lavoro programmato
        se_stesso.ponte = PonteUI(radice)
        radice.title(NOME)
        radice.geometry(se_stesso.config_.ottieni("finestra.geometria", "1400x860"))
        radice.minsize(900, 560)
        se_stesso._costruisci()
        se_stesso.applica_tema()
        se_stesso.config_.quando_cambia(se_stesso._config_cambiata)
        radice.protocol("WM_DELETE_WINDOW", se_stesso.esci)
        se_stesso._associa_scorciatoie()
        se chiedi_avvio e se_stesso.config_.ottieni("avvio.chiedi", Vero):
            radice.after(250, se_stesso.mostra_avvio)           # la finestra d'avvio compare sopra la finestra già disegnata
        altrimenti:
            se_stesso.ripristina_ultimo_progetto()
        se chiedi_avvio:
            radice.after(1500, se_stesso.proponi_recupero)      # dopo una chiusura improvvisa: i file con modifiche non salvate
        radice.after(se_stesso._ritardo_recupero(), se_stesso._ciclo_recupero)

    # ================================================================== struttura
    definisci _costruisci(se_stesso):
        r = se_stesso.radice
        c = se_stesso.colori
        stile.imposta_icona_finestra(r)
        se_stesso._menu_principale()
        # ---- barra degli strumenti (personalizzabile: ogni comando dei menu può diventare un pulsante)
        se_stesso.barra = tk.Frame(r)
        se_stesso.barra.pack(side="top", fill="x")
        se_stesso.pulsanti_barra = []
        se_stesso._logo_barra = stile.logo_tk(26)
        tk.Label(se_stesso.barra, image=se_stesso._logo_barra, borderwidth=0).pack(side="left", padx=(10, 6), pady=5)
        se_stesso._etichetta_logo = se_stesso.barra.winfo_children()[0]
        se_stesso.barra.bind("<Button-3>", lambda evento: se_stesso._menu_barra(evento))
        se_stesso._etichetta_logo.bind("<Button-3>", lambda evento: se_stesso._menu_barra(evento))
        se_stesso.comandi_menu = barra_mod.raccogli_comandi(se_stesso.menu_barra)
        se_stesso._costruisci_barra()
        se_stesso.riga_barra = tk.Frame(r, height=1)
        se_stesso.riga_barra.pack(side="top", fill="x")
        # ---- barra di stato
        se_stesso.stato = tk.Frame(r)
        se_stesso.stato.pack(side="bottom", fill="x")
        se_stesso.testo_stato = tk.Label(se_stesso.stato, anchor="w", text="Pronto", font=(FONT_UI, 9))
        se_stesso.testo_stato.pack(side="left", padx=10, pady=3)
        se_stesso.segmenti_stato = []

        definisci segmento(testo_=""):
            sep = tk.Frame(se_stesso.stato, width=1)
            sep.pack(side="right", fill="y", pady=4)
            lab = tk.Label(se_stesso.stato, anchor="e", text=testo_, font=(FONT_UI, 9))
            lab.pack(side="right", padx=10)
            se_stesso.segmenti_stato.append((lab, sep))
            ritorna lab
        se_stesso.testo_ai = segmento("")
        se_stesso.testo_versione = segmento("pytonIta " + VERSIONE_INTERPRETE())
        se_stesso.testo_posizione = segmento("")
        se_stesso.testo_progetto = segmento("")
        per lab_, aiuto_ in ((se_stesso.testo_ai, "Stato dell'assistente AI"), (se_stesso.testo_versione, "Versione dell'interprete pytonIta"),
                             (se_stesso.testo_posizione, "Riga e colonna del cursore"), (se_stesso.testo_progetto, "Progetto aperto")):
            stile.suggerisci(lab_, aiuto_, c)
        stile.suggerisci(se_stesso.testo_stato, "Ultimo messaggio di PitStudio", c)
        # ---- corpo
        se_stesso.corpo = tk.PanedWindow(r, orient="horizontal", sashwidth=5, borderwidth=0, sashrelief="flat")
        se_stesso.corpo.pack(fill="both", expand=Vero)
        sinistra = tk.Frame(se_stesso.corpo)
        # due pannelli a schede nella colonna di sinistra: file del progetto e librerie spuntabili
        se_stesso.schede_sinistra = tk.Frame(sinistra)
        se_stesso.schede_sinistra.pack(fill="x", side="top")
        se_stesso.corpo_sinistra = tk.Frame(sinistra)
        se_stesso.corpo_sinistra.pack(fill="both", expand=Vero)
        se_stesso.pannello_progetto = PannelloProgetto(se_stesso.corpo_sinistra, se_stesso, se_stesso.config_)
        se_stesso.pannello_librerie = PannelloLibrerie(se_stesso.corpo_sinistra, se_stesso)
        se_stesso.pannello_test = PannelloTest(se_stesso.corpo_sinistra, se_stesso)
        se_stesso.pannello_git = PannelloGit(se_stesso.corpo_sinistra, se_stesso)
        se_stesso.pannello_pacchetti = PannelloPacchetti(se_stesso.corpo_sinistra, se_stesso)
        se_stesso.pulsanti_sinistra = {}
        AIUTI_SCHEDE = {"progetto": "Mostra i file e le cartelle del progetto",
                        "librerie": "Mostra le librerie: spunta per aggiungere l'importazione al file aperto",
                        "test": "Test: trova ed esegue le prove del progetto e ne mostra l'esito",
                        "git": "Git: modifiche, commit, rami, storia, pull e push",
                        "pacchetti": "Pacchetti Python (pip): installa e aggiorna le librerie del progetto"}
        per chiave, testo_ in (("progetto", "📁  Progetto"), ("librerie", "📚  Librerie"), ("test", "Test"), ("git", "Git"), ("pacchetti", "Pip")):
            b = tk.Label(se_stesso.schede_sinistra, text=testo_, padx=10 se chiave in ("progetto", "librerie") altrimenti 8, pady=6, cursor="hand2", font=(FONT_UI, 9))
            b.pack(side="left")
            b.bind("<Button-1>", lambda evento, k=chiave: se_stesso.mostra_pannello_sinistro(k))
            stile.suggerisci(b, AIUTI_SCHEDE[chiave], c)
            se_stesso.pulsanti_sinistra[chiave] = b
        se_stesso.pannello_sinistro = "progetto"
        se_stesso.mostra_pannello_sinistro("progetto")
        se_stesso.sinistra = sinistra
        centro = tk.PanedWindow(se_stesso.corpo, orient="vertical", sashwidth=5, borderwidth=0)
        se_stesso.centro = centro
        # l'editor ha due gruppi di schede affiancabili; i contenuti delle schede hanno per genitore l'area comune (si spostano da un gruppo all'altro)
        se_stesso.area_editor = tk.PanedWindow(centro, orient="horizontal", sashwidth=5, borderwidth=0)
        se_stesso.schede_nb = stile.SchedeScorrevoli(se_stesso.area_editor, c, quando_chiudi=lambda w: se_stesso.chiudi_scheda(w), quando_attivato=se_stesso._gruppo_attivato)
        se_stesso.schede_nb2 = stile.SchedeScorrevoli(se_stesso.area_editor, c, quando_chiudi=lambda w: se_stesso.chiudi_scheda(w), quando_attivato=se_stesso._gruppo_attivato)
        se_stesso._gruppo_ultimo = se_stesso.schede_nb
        per gruppo in (se_stesso.schede_nb, se_stesso.schede_nb2):
            gruppo.bind("<<NotebookTabChanged>>", se_stesso._scheda_cambiata)
            gruppo.bind("<Button-2>", se_stesso._chiudi_con_clic_centrale)
            gruppo.bind("<Button-3>", se_stesso._menu_scheda)
        se_stesso.area_editor.add(se_stesso.schede_nb, minsize=200, stretch="always")
        se_stesso.console = Console(centro, se_stesso.config_, se_stesso.colori, se_stesso)
        centro.add(se_stesso.area_editor, minsize=200, stretch="always")
        centro.add(se_stesso.console, minsize=90, height=se_stesso.config_.ottieni("finestra.console_altezza", 190))
        se_stesso.chat = PannelloChat(se_stesso.corpo, se_stesso.config_, se_stesso.colori, se_stesso, se_stesso.ponte)
        se_stesso.corpo.add(sinistra, minsize=160, width=se_stesso.config_.ottieni("finestra.pannello_sinistro", 320))
        se_stesso.corpo.add(centro, minsize=400, stretch="always")
        se_stesso.corpo.add(se_stesso.chat, minsize=280, width=se_stesso.config_.ottieni("finestra.pannello_destro", 430))
        se_stesso._benvenuto = Nessuno
        se_stesso._mostra_benvenuto()
        se non se_stesso.config_.ottieni("finestra.chat_visibile", Vero):
            se_stesso.corpo.forget(se_stesso.chat)
        se_stesso._colora_pulsante_chat()
        se non se_stesso.config_.ottieni("finestra.console_visibile", Vero):
            se_stesso.centro.forget(se_stesso.console)
        se non se_stesso.config_.ottieni("finestra.progetti_visibile", Vero):
            se_stesso.corpo.forget(se_stesso.sinistra)
        se_stesso._colora_pulsanti_stato()
        se_stesso._aggiorna_stato_ai()

    # ================================================================== barra degli strumenti personalizzabile
    definisci _proponi_nuovi_pulsanti(se_stesso, salvati):
        """Una barra personalizzata prima di un nuovo pulsante non lo conterrebbe mai: lo si aggiunge una volta sola (poi si può togliere)."""
        proposti = tipo_lista(se_stesso.config_.ottieni("finestra.barra_proposti", []) o [])
        cambiato = Falso
        per nuovo, prima_di in barra_mod.NUOVI_PULSANTI.items():
            se nuovo in proposti:
                continua
            proposti.append(nuovo)
            cambiato = Vero
            se nuovo non in salvati e prima_di in salvati e nuovo in se_stesso.comandi_menu:
                salvati = tipo_lista(salvati)
                salvati.insert(salvati.index(prima_di), nuovo)
                se_stesso.config_.imposta("finestra.barra", salvati, notifica=Falso)
        se cambiato:
            se_stesso.config_.imposta("finestra.barra_proposti", proposti, notifica=Falso)
            se_stesso.config_.salva()
        ritorna salvati

    definisci elementi_barra(se_stesso):
        """Gli elementi scelti dall'utente (id dei comandi, separatori, spazio), o quelli predefiniti."""
        salvati = se_stesso.config_.ottieni("finestra.barra", Nessuno)
        se isinstance(salvati, tipo_lista) e salvati:
            salvati = se_stesso._proponi_nuovi_pulsanti(salvati)
            ritorna [x per x in salvati se x in (barra_mod.SEPARATORE, barra_mod.SPAZIO) o x in se_stesso.comandi_menu]
        ritorna [x per x in barra_mod.PREDEFINITA se x in (barra_mod.SEPARATORE, barra_mod.SPAZIO) o x in se_stesso.comandi_menu]

    definisci _costruisci_barra(se_stesso):
        """(Ri)crea i pulsanti della barra secondo la scelta dell'utente. Ogni pulsante ha il suo suggerimento."""
        c = se_stesso.colori
        per b in se_stesso.pulsanti_barra:
            b.destroy()
        se_stesso.pulsanti_barra = []
        se_stesso.pulsanti_per_id = {}
        elementi = se_stesso.elementi_barra()
        a_destra = barra_mod.SPAZIO in elementi
        lato = "left"
        sequenza = []
        per x in elementi:
            se x == barra_mod.SPAZIO:
                lato = "right"
                continua
            sequenza.append((x, lato))
        # a destra si impacchetta dall'ultimo: nella barra l'ordine resta quello della lista, da sinistra a destra
        ordine = [t per t in sequenza se t[1] == "left"] + [t per t in sequenza se t[1] == "right"][::-1]
        per x, lato in ordine:
            se x == barra_mod.SEPARATORE:
                sep = stile.Separatore(se_stesso.barra, c)
                sep.pack(side=lato, fill="y", padx=6, pady=9)
                sep.bind("<Button-3>", lambda evento: se_stesso._menu_barra(evento))
                se_stesso.pulsanti_barra.append(sep)
                continua
            dati = se_stesso.comandi_menu[x]
            icona, testo_, aiuto, accento = barra_mod.aspetto(dati)
            b = stile.PulsanteIcona(se_stesso.barra, icona, testo_, dati["esegui"], c, accento, aiuto)
            b.pack(side=lato, padx=1, pady=4)
            per w in [b] + b.winfo_children():
                w.bind("<Button-3>", lambda evento, i=x: se_stesso._menu_barra(evento, i))
            se_stesso.pulsanti_barra.append(b)
            se_stesso.pulsanti_per_id[x] = b
        se_stesso.pulsante_chat = se_stesso.pulsanti_per_id.get("Visualizza/Assistente AI")
        se_stesso.pulsante_console = se_stesso.pulsanti_per_id.get("Visualizza/Console")
        se_stesso._colora_pulsanti_stato()

    definisci _chat_visibile(se_stesso):
        ritorna hasattr(se_stesso, "chat") e tipo_testo(se_stesso.chat) in [tipo_testo(x) per x in se_stesso.corpo.panes()]

    definisci _console_visibile(se_stesso):
        ritorna hasattr(se_stesso, "console") e tipo_testo(se_stesso.console) in [tipo_testo(x) per x in se_stesso.centro.panes()]

    definisci _colora_pulsanti_stato(se_stesso):
        """I pulsanti della barra che mostrano/nascondono un pannello (assistente e console) sono verdi quando il pannello è aperto,
        del colore normale (nero nel tema chiaro) quando è chiuso."""
        se non hasattr(se_stesso, "corpo"):
            ritorna
        per nome, aperto in (("pulsante_chat", se_stesso._chat_visibile), ("pulsante_console", se_stesso._console_visibile)):
            b = getattr(se_stesso, nome, Nessuno)
            se b è non Nessuno:
                b.imposta_colore_testo(COLORE_CHAT_APERTA se aperto() altrimenti Nessuno)

    definisci _colora_pulsante_chat(se_stesso):
        se_stesso._colora_pulsanti_stato()

    definisci personalizza_barra(se_stesso):
        """Apre «Personalizza barra»: aggiungere, togliere e riordinare i comandi dei menu nella barra."""
        scelta = barra_mod.DialogoBarra(se_stesso.radice, se_stesso.colori, se_stesso.comandi_menu, se_stesso.elementi_barra()).mostra()
        se scelta è non Nessuno:
            se_stesso.imposta_barra(scelta)

    definisci imposta_barra(se_stesso, elementi):
        se_stesso.config_.imposta("finestra.barra", tipo_lista(elementi))
        se_stesso.config_.salva()

    definisci _menu_barra(se_stesso, evento, id_=Nessuno):
        """Clic destro sulla barra: personalizzare, togliere il pulsante, tornare alla barra predefinita."""
        m = tk.Menu(se_stesso.radice, tearoff=0)
        se id_:
            m.add_command(label="Togli questo pulsante dalla barra", command=lambda: se_stesso.imposta_barra([x per x in se_stesso.elementi_barra() se x != id_]))
            m.add_separator()
        m.add_command(label="Personalizza barra…", command=se_stesso.personalizza_barra)
        m.add_command(label="Ripristina la barra predefinita", command=lambda: se_stesso.imposta_barra(barra_mod.PREDEFINITA))
        se_stesso._menu_colori(m, se_stesso.colori)
        m.tk_popup(evento.x_root, evento.y_root)
        ritorna "break"

    definisci _menu_principale(se_stesso):
        r = se_stesso.radice
        barra = tk.Menu(r)
        se_stesso.menu_barra = barra
        r.configure(menu=barra)

        file = tk.Menu(barra, tearoff=0)
        file.add_command(label="Finestra di avvio…", command=lambda: se_stesso.mostra_avvio())
        file.add_command(label="Nuovo progetto…", command=se_stesso.nuovo_progetto)
        file.add_command(label="Apri progetto…", command=se_stesso.apri_progetto, accelerator="Ctrl+O")
        se_stesso.menu_recenti = tk.Menu(file, tearoff=0)
        file.add_cascade(label="Progetti recenti", menu=se_stesso.menu_recenti)
        file.add_separator()
        file.add_command(label="Nuovo file…", command=lambda: se_stesso.pannello_progetto.nuovo_file(), accelerator="Ctrl+N")
        file.add_command(label="Nuova finestra (progettista)…", command=lambda: se_stesso.nuovo_form())
        file.add_command(label="Nuovo programma a mattonelle…", command=lambda: se_stesso.nuovo_mattonelle())
        file.add_command(label="Converti il file corrente in mattonelle…", command=lambda: se_stesso.converti_in_mattonelle())
        file.add_command(label="Traduci il file .py corrente in pytonIta…", command=lambda: se_stesso.traduci_in_pit())
        file.add_command(label="Converti un progetto Python in pytonIta…", command=lambda: se_stesso.converti_progetto_py())
        file.add_command(label="Esporta il progetto come Python…", command=lambda: se_stesso.esporta_progetto_python())
        file.add_command(label="Crea l'eseguibile (.exe)…", command=lambda: se_stesso.crea_eseguibile())
        file.add_separator()
        file.add_command(label="Salva", command=se_stesso.salva_scheda, accelerator="Ctrl+S")
        file.add_command(label="Salva tutto", command=se_stesso.salva_tutto, accelerator="Ctrl+Maiusc+S")
        file.add_command(label="Chiudi scheda", command=se_stesso.chiudi_scheda_corrente, accelerator="Ctrl+W")
        file.add_separator()
        file.add_command(label="Esci", command=se_stesso.esci)
        barra.add_cascade(label="File", menu=file)

        modifica = tk.Menu(barra, tearoff=0)
        per etichetta, funzione, acc in (("Annulla", lambda: se_stesso._su_editor("annulla"), "Ctrl+Z"),
                                          ("Ripeti", lambda: se_stesso._su_editor("ripeti"), "Ctrl+Y"),
                                          (Nessuno, Nessuno, ""),
                                          ("Trova e sostituisci…", lambda: se_stesso._su_editor("mostra_ricerca"), "Ctrl+F"),
                                          ("Vai a riga…", se_stesso.vai_a_riga, "Ctrl+G"),
                                          ("Commenta / decommenta", lambda: se_stesso._su_editor("commenta"), "Ctrl+/"),
                                          ("Duplica riga", lambda: se_stesso._su_editor("duplica_riga"), "Ctrl+D"),
                                          ("Mostra suggerimenti", lambda: se_stesso._su_editor("suggerisci", Vero), "Ctrl+Spazio")):
            se etichetta è Nessuno:
                modifica.add_separator()
            altrimenti:
                modifica.add_command(label=etichetta, command=funzione, accelerator=acc)
        modifica.add_separator()
        modifica.add_command(label="Vai alla definizione", command=lambda: se_stesso.vai_alla_definizione(), accelerator="F12")
        modifica.add_command(label="Trova gli usi", command=lambda: se_stesso.trova_usi_simbolo(), accelerator="Maiusc+F12")
        modifica.add_command(label="Rinomina in tutto il progetto…", command=lambda: se_stesso.rinomina_simbolo(), accelerator="F2")
        modifica.add_command(label="Ripulisci il codice", command=lambda: se_stesso.ripulisci_codice(), accelerator="Ctrl+Maiusc+L")
        barra.add_cascade(label="Modifica", menu=modifica)

        prog = tk.Menu(barra, tearoff=0)
        prog.add_command(label="Cerca nel progetto…", command=se_stesso.cerca_nel_progetto)
        prog.add_command(label="Aggiungi risorse (immagini, JSON…)…", command=lambda: se_stesso.pannello_progetto.aggiungi_risorse())
        prog.add_command(label="Imposta il file corrente come principale", command=se_stesso.imposta_corrente_principale)
        prog.add_command(label="Proprietà del progetto…", command=se_stesso.proprieta_progetto)
        prog.add_command(label="Aggiorna questo progetto dalla versione 1.x…", command=lambda: se_stesso.aggiorna_da_1x())
        prog.add_command(label="Aggiorna i moduli di PitStudio del progetto…", command=lambda: se_stesso.aggiorna_moduli())
        prog.add_command(label="Converti questo progetto Python in pytonIta…", command=lambda: se_stesso.converti_progetto_py(se_stesso.progetto.cartella se se_stesso.progetto altrimenti ""))
        prog.add_command(label="Esporta il progetto come Python…", command=lambda: se_stesso.esporta_progetto_python())
        prog.add_command(label="Crea l'eseguibile (.exe)…", command=lambda: se_stesso.crea_eseguibile())
        prog.add_command(label="Aggiorna l'albero", command=lambda: se_stesso.pannello_progetto.aggiorna())
        barra.add_cascade(label="Progetto", menu=prog)

        database = tk.Menu(barra, tearoff=0)
        database.add_command(label="Nuovo database SQLite…", command=lambda: se_stesso.nuovo_database_sqlite())
        database.add_command(label="Apri un database SQLite…", command=lambda: se_stesso.apri_database_sqlite())
        database.add_command(label="Collegati a MySQL…", command=lambda: se_stesso.collega_mysql())
        database.add_command(label="Collegati a PostgreSQL…", command=lambda: se_stesso.collega_postgres())
        database.add_separator()
        database.add_command(label="Crea una maschera dalla tabella…", command=lambda: se_stesso.maschera_dalla_scheda())
        database.add_separator()
        database.add_command(label="Installa il driver MySQL (pymysql)", command=lambda: se_stesso.installa_driver_mysql())
        database.add_command(label="Installa il driver PostgreSQL (psycopg2)", command=lambda: se_stesso.installa_driver_postgres())
        barra.add_cascade(label="Database", menu=database)

        esegui = tk.Menu(barra, tearoff=0)
        esegui.add_command(label="Esegui il file principale", command=se_stesso.esegui_principale, accelerator="F5")
        esegui.add_command(label="Esegui il file corrente", command=se_stesso.esegui_corrente)
        esegui.add_command(label="Ferma", command=se_stesso.ferma, accelerator="Maiusc+F5")
        esegui.add_separator()
        esegui.add_command(label="Debug: avvia il file principale", command=se_stesso.debug_avvia, accelerator="F6")
        esegui.add_command(label="Debug: avvia passo passo dalla prima riga", command=lambda: se_stesso.debug_avvia(Vero))
        esegui.add_command(label="Punto di arresto sulla riga corrente", command=se_stesso.alterna_punto_arresto, accelerator="F9")
        esegui.add_command(label="Punto di arresto con condizione…", command=se_stesso.punto_arresto_condizionale)
        esegui.add_command(label="Passo (sopra le chiamate)", command=lambda: se_stesso.debug.comando("passo"), accelerator="F10")
        esegui.add_command(label="Entra nella funzione", command=lambda: se_stesso.debug.comando("entra"), accelerator="F11")
        esegui.add_command(label="Esci dalla funzione", command=lambda: se_stesso.debug.comando("esci"), accelerator="Maiusc+F11")
        esegui.add_command(label="Togli tutti i punti di arresto", command=se_stesso.togli_punti_arresto)
        esegui.add_separator()
        esegui.add_command(label="Controlla la sintassi", command=se_stesso.controlla_corrente)
        esegui.add_command(label="Pulisci la console", command=lambda: se_stesso.console.pulisci())
        barra.add_cascade(label="Esegui", menu=esegui)

        vista = tk.Menu(barra, tearoff=0)
        vista.add_command(label="Pannello progetto", command=lambda: se_stesso._commuta("progetti"))
        vista.add_command(label="Console", command=lambda: se_stesso._commuta("console"))
        vista.add_command(label="Assistente AI", command=se_stesso.mostra_chat, accelerator="Ctrl+J")
        vista.add_separator()
        vista.add_command(label="Dividi l'editor: apri la scheda a fianco", command=lambda: se_stesso.sposta_scheda_nell_altro_gruppo(), accelerator="Ctrl+" + chr(92))
        vista.add_command(label="Unisci i gruppi di schede", command=lambda: se_stesso.unisci_gruppi())
        vista.add_separator()
        vista.add_command(label="Tema chiaro / scuro", command=se_stesso.commuta_tema)
        vista.add_command(label="Ingrandisci il testo", command=lambda: se_stesso.zoom(1), accelerator="Ctrl++")
        vista.add_command(label="Riduci il testo", command=lambda: se_stesso.zoom(-1), accelerator="Ctrl+-")
        vista.add_separator()
        vista.add_command(label="Personalizza la barra degli strumenti…", command=lambda: se_stesso.personalizza_barra())
        barra.add_cascade(label="Visualizza", menu=vista)

        strumenti = tk.Menu(barra, tearoff=0)
        strumenti.add_command(label="Impostazioni…", command=se_stesso.impostazioni)
        strumenti.add_command(label="Chiedi all'AI di spiegare il codice selezionato", command=se_stesso.ai_spiega)
        strumenti.add_command(label="Chiedi all'AI di correggere l'ultimo errore", command=se_stesso.ai_correggi)
        strumenti.add_command(label="Apri Claude Code nel progetto (con il tuo abbonamento)…", command=se_stesso.apri_claude_code)
        strumenti.add_command(label="Collega altri agenti (MCP)…", command=se_stesso.collega_agenti_mcp)
        strumenti.add_command(label="Annulla l'ultima modifica dell'assistente", command=se_stesso.annulla_ultima_ai)
        strumenti.add_command(label="Cronologia delle modifiche dell'assistente…", command=se_stesso.cronologia_ai)
        strumenti.add_command(label="Statistiche dell'assistente (token, codice valido)…", command=se_stesso.statistiche_ai)
        strumenti.add_separator()
        strumenti.add_command(label="Manuale pytonIta (apri)", command=se_stesso.apri_manuale)
        barra.add_cascade(label="Strumenti", menu=strumenti)

        aiuto = tk.Menu(barra, tearoff=0)
        aiuto.add_command(label="Guida di PitStudio", command=lambda: se_stesso.apri_aiuto(), accelerator="F1")
        aiuto.add_command(label="Galleria di esempi…", command=lambda: se_stesso.apri_galleria())
        aiuto.add_command(label="Lezioni (con quiz e professore)…", command=lambda: se_stesso.apri_lezioni())
        aiuto.add_command(label="Esercizi guidati…", command=lambda: se_stesso.apri_esercizi())
        aiuto.add_command(label="Primi passi", command=lambda: se_stesso.apri_aiuto("primi-passi"))
        aiuto.add_command(label="Scorciatoie da tastiera", command=lambda: se_stesso.apri_aiuto("scorciatoie"))
        aiuto.add_command(label="Riferimento del linguaggio pytonIta", command=lambda: se_stesso.apri_aiuto("linguaggio"))
        aiuto.add_command(label="Apri la guida nel browser", command=lambda: se_stesso.apri_aiuto("@browser"))
        aiuto.add_separator()
        aiuto.add_command(label="Controlla aggiornamenti…", command=lambda: se_stesso.controlla_aggiornamenti(Vero))
        aiuto.add_command(label=f"Informazioni su {NOME}", command=lambda: dialoghi.informazioni(se_stesso.radice, se_stesso.colori, lambda: se_stesso.apri_aiuto()))
        barra.add_cascade(label="Aiuto", menu=aiuto)
        se_stesso._aggiorna_recenti()

    definisci _aggiorna_recenti(se_stesso):
        m = se_stesso.menu_recenti
        m.delete(0, "end")
        recenti = [r per r in se_stesso.config_.ottieni("recenti", []) se os.path.isdir(r)]
        per r in recenti:
            m.add_command(label=r, command=lambda p=r: se_stesso.apri_progetto(p))
        se non recenti:
            m.add_command(label="(nessuno)", state="disabled")

    definisci _associa_scorciatoie(se_stesso):
        r = se_stesso.radice
        s = se_stesso.config_.ottieni("scorciatoie", {})
        per sequenza in getattr(se_stesso, "_sequenze", []):
            r.unbind(sequenza)
        se_stesso._sequenze = []
        mappa = {"salva": se_stesso.salva_scheda, "salva_tutto": se_stesso.salva_tutto,
                 "apri_progetto": se_stesso.apri_progetto, "nuovo_file": lambda: se_stesso.pannello_progetto.nuovo_file(),
                 "esegui": se_stesso.esegui_principale, "ferma": se_stesso.ferma,
                 "debug": se_stesso.debug_avvia, "punto_arresto": se_stesso.alterna_punto_arresto,
                 "passo": lambda: se_stesso.debug.comando("passo"), "entra": lambda: se_stesso.debug.comando("entra"),
                 "esci": lambda: se_stesso.debug.comando("esci"),
                 "trova": lambda: se_stesso._su_editor("mostra_ricerca"), "vai_a_riga": se_stesso.vai_a_riga,
                 "commenta": lambda: se_stesso._su_editor("commenta"),
                 "vai_a_definizione": lambda: se_stesso.vai_alla_definizione(),
                 "trova_usi": lambda: se_stesso.trova_usi_simbolo(),
                 "rinomina": lambda: se_stesso.rinomina_simbolo(),
                 "ripulisci": lambda: se_stesso.ripulisci_codice(),
                 "suggerisci": lambda: se_stesso._su_editor("suggerisci", Vero),
                 "chat": se_stesso.mostra_chat, "chiudi_scheda": se_stesso.chiudi_scheda_corrente,
                 "dividi_editor": lambda: se_stesso.sposta_scheda_nell_altro_gruppo()}
        per nome, funzione in mappa.items():
            seq = s.get(nome)
            se non seq:
                continua
            sequenza = f"<{seq}>"
            prova:
                r.bind(sequenza, lambda evento, f=funzione: f() o "break")
                se_stesso._sequenze.append(sequenza)
            eccetto tk.TclError:
                passa
        r.bind("<F1>", lambda evento: se_stesso.apri_aiuto(se_stesso._parola_sotto_cursore()) o "break")
        se non getattr(se_stesso, "_focus_legato", Falso):          # una volta sola, anche se le scorciatoie si rileggono
            r.bind_all("<FocusIn>", se_stesso._focus_cambiato, "+")
            se_stesso._focus_legato = Vero
        r.bind("<Control-plus>", lambda evento: se_stesso.zoom(1) o "break")
        r.bind("<Control-equal>", lambda evento: se_stesso.zoom(1) o "break")
        r.bind("<Control-minus>", lambda evento: se_stesso.zoom(-1) o "break")

    # ================================================================== tema e impostazioni
    definisci applica_tema(se_stesso):
        c = se_stesso.colori = tema.colori(se_stesso.config_)
        r = se_stesso.radice
        tema.configura_stile(r, c)
        r.configure(background=c["sfondo"])
        tema.applica(r, c)
        se_stesso.barra.configure(background=c["sfondo"])
        se_stesso._etichetta_logo.configure(background=c["sfondo"])
        se_stesso.riga_barra.configure(background=c["bordo"])
        per b in se_stesso.pulsanti_barra:
            b.applica_colori(c)
        per gruppo in (se_stesso.schede_nb, se_stesso.schede_nb2):
            gruppo.applica_stile(c)
        se_stesso.stato.configure(background=c["pannello"])
        se_stesso.testo_stato.configure(background=c["pannello"], foreground=c["primo_piano"])
        per lab, sep in se_stesso.segmenti_stato:
            lab.configure(background=c["pannello"], foreground=c["tenue"])
            sep.configure(background=c["bordo"])
        se_stesso.corpo.configure(background=c["sfondo"])
        se_stesso.centro.configure(background=c["sfondo"])
        se_stesso.sinistra.configure(background=c["pannello"])
        se_stesso.schede_sinistra.configure(background=c["pannello"])
        se_stesso.corpo_sinistra.configure(background=c["pannello"])
        se_stesso.pannello_librerie.applica_colori(c)
        se_stesso.pannello_test.applica_colori(c)
        se_stesso.pannello_git.applica_colori(c)
        se_stesso.pannello_pacchetti.applica_colori(c)
        se_stesso.mostra_pannello_sinistro(se_stesso.pannello_sinistro)
        se_stesso.pannello_progetto.configure(background=c["pannello"])
        se_stesso.pannello_progetto.barra.configure(background=c["pannello"])
        se_stesso.pannello_progetto.etichetta.configure(background=c["pannello"], foreground=c["primo_piano"])
        per b in se_stesso.pannello_progetto.barra.winfo_children():
            se b.winfo_class() == "Button":
                b.configure(background=c["pulsante"], foreground=c["primo_piano"], relief="flat", activebackground=c["pulsante_attivo"])
        se_stesso.console.applica_colori(c)
        se se_stesso.debug.pannello è non Nessuno:
            se_stesso.debug.pannello.applica_colori(c)
        se_stesso.chat.applica_colori(c)
        per w in se_stesso.schede.values():
            se hasattr(w, "applica_colori"):
                w.applica_colori(c)
        se_stesso._menu_colori(se_stesso.menu_barra, c)
        se_stesso._mostra_benvenuto(aggiorna=Vero)

    definisci _menu_colori(se_stesso, menu, c):
        prova:
            menu.configure(background=c["pannello"], foreground=c["primo_piano"], activebackground=c["accento"],
                           activeforeground="#ffffff", borderwidth=0)
        eccetto tk.TclError:
            ritorna
        per i in intervallo_di(menu.index("end") + 1 se menu.index("end") è non Nessuno altrimenti 0):
            prova:
                sotto = menu.nametowidget(menu.entrycget(i, "menu"))
                se_stesso._menu_colori(sotto, c)
            eccetto (tk.TclError, KeyError):
                passa

    definisci _aggiorna_stato_ai(se_stesso):
        pronta = bool(se_stesso.chat.cliente_pronto()) se hasattr(se_stesso, "chat") altrimenti Falso
        se_stesso.testo_ai.configure(text="●  Assistente AI pronto" se pronta altrimenti "○  Assistente AI: manca la chiave",
                                     foreground=se_stesso.colori["ok"] se pronta altrimenti se_stesso.colori["avviso"])

    definisci mostra_pannello_sinistro(se_stesso, chiave):
        """Passa dai file del progetto all'elenco delle librerie (e viceversa)."""
        se_stesso.pannello_sinistro = chiave
        pannelli = {"progetto": se_stesso.pannello_progetto, "librerie": se_stesso.pannello_librerie, "test": se_stesso.pannello_test,
                    "git": se_stesso.pannello_git, "pacchetti": se_stesso.pannello_pacchetti}
        per k, w in pannelli.items():
            w.pack_forget()
        pannelli[chiave].pack(fill="both", expand=Vero)
        # librerie, test, git e pacchetti hanno bisogno di più spazio (descrizioni, differenze, colonne)
        necessaria = {"librerie": 430, "test": 380, "git": 400, "pacchetti": 400}.get(chiave)
        prova:
            larghezza = se_stesso.corpo.sash_coord(0)[0]
            se necessaria e larghezza < necessaria - 10:
                se non getattr(se_stesso, "_larghezza_precedente", Nessuno):
                    se_stesso._larghezza_precedente = larghezza
                se_stesso.corpo.sash_place(0, necessaria, 1)
            altrimenti_se chiave == "progetto" e getattr(se_stesso, "_larghezza_precedente", Nessuno):
                se_stesso.corpo.sash_place(0, se_stesso._larghezza_precedente, 1)
                se_stesso._larghezza_precedente = Nessuno
        eccetto (tk.TclError, IndexError):
            passa
        se chiave in ("git", "pacchetti") e hasattr(pannelli[chiave], "quando_mostrato"):
            pannelli[chiave].quando_mostrato()
        c = se_stesso.colori
        per k, b in se_stesso.pulsanti_sinistra.items():
            attivo = k == chiave
            b.configure(background=c["sfondo"] se attivo altrimenti c["pannello"], foreground=c["primo_piano"] se attivo altrimenti c["tenue"],
                        font=semi(9) se attivo altrimenti (FONT_UI, 9))

    definisci _editor_corrente(se_stesso):
        w = se_stesso._scheda_corrente()
        ritorna w se isinstance(w, Editor) altrimenti Nessuno

    definisci _parola_sotto_cursore(se_stesso):
        """La parola dell'editor sotto il cursore (per la guida contestuale), oppure Nessuno."""
        w = se_stesso._scheda_corrente()
        se isinstance(w, Editor):
            prova:
                riga = w.t.get("insert linestart", "insert lineend")
                col = int(w.t.index("insert").split(".")[1])
                import_re = re
                per m in import_re.finditer(r"[^\W\d]\w*", riga):
                    se m.start() <= col <= m.end():
                        ritorna "@parola:" + m.group()
            eccetto tk.TclError:
                passa
        ritorna Nessuno

    definisci apri_aiuto(se_stesso, argomento=Nessuno):
        da rad.aiuto importa apri_aiuto
        apri_aiuto(se_stesso, argomento)

    definisci _config_cambiata(se_stesso, percorso):
        se_stesso._aggiorna_stato_ai()
        se percorso in ("*", "tema") o percorso.startswith("temi_personalizzati"):
            se_stesso.applica_tema()
        se percorso in ("*",) o percorso.startswith("editor"):
            per w in se_stesso.schede.values():
                se isinstance(w, Editor):
                    w.applica_impostazioni()
                    w.applica_colori(se_stesso.colori)
            se_stesso.console.applica_colori(se_stesso.colori)
        se percorso in ("*",) o percorso.startswith("finestra.barra"):
            se hasattr(se_stesso, "comandi_menu"):
                se_stesso._costruisci_barra()
        se percorso in ("*",) o percorso.startswith("scorciatoie"):
            se_stesso._associa_scorciatoie()
        se percorso in ("*",) o percorso.startswith("ai"):
            se_stesso.chat.var_modello.set(se_stesso.config_.ottieni(ai.chiave_modello(se_stesso.config_)))
            se_stesso.chat.selettore.configure(values=ai.modelli_di(se_stesso.config_))

    definisci impostazioni(se_stesso, pagina=Nessuno):
        Impostazioni(se_stesso.radice, se_stesso.config_, se_stesso.colori, pagina).mostra()

    definisci commuta_tema(se_stesso):
        se_stesso.config_.imposta("tema", "chiaro" se se_stesso.config_.ottieni("tema") == "scuro" altrimenti "scuro")
        se_stesso.config_.salva()

    definisci zoom(se_stesso, passo):
        n = max(6, min(40, se_stesso.config_.ottieni("editor.dimensione", 11) + passo))
        se_stesso.config_.imposta("editor.dimensione", n)
        se_stesso.config_.salva()

    definisci _commuta(se_stesso, cosa):
        se cosa == "console":
            se tipo_testo(se_stesso.console) in [tipo_testo(x) per x in se_stesso.centro.panes()]:
                se_stesso.centro.forget(se_stesso.console)
            altrimenti:
                se_stesso.centro.add(se_stesso.console, minsize=90, height=se_stesso.config_.ottieni("finestra.console_altezza", 190))
            se_stesso._colora_pulsanti_stato()
        altrimenti_se cosa == "progetti":
            se tipo_testo(se_stesso.sinistra) in [tipo_testo(x) per x in se_stesso.corpo.panes()]:
                se_stesso.corpo.forget(se_stesso.sinistra)
            altrimenti:
                se_stesso.corpo.add(se_stesso.sinistra, minsize=160, width=270, before=se_stesso.centro)

    definisci mostra_chat(se_stesso):
        visibile = tipo_testo(se_stesso.chat) in [tipo_testo(x) per x in se_stesso.corpo.panes()]
        se visibile:
            se_stesso.corpo.forget(se_stesso.chat)
        altrimenti:
            se_stesso.corpo.add(se_stesso.chat, minsize=280, width=se_stesso.config_.ottieni("finestra.pannello_destro", 430))
            se_stesso.chat.ingresso.focus_set()
        se_stesso._colora_pulsante_chat()

    # ================================================================== progetti
    # ================================================================== avvio e lezioni
    definisci mostra_avvio(se_stesso):
        """La finestra d'avvio: aprire l'ultimo lavoro, iniziare un progetto nuovo o una lezione. Ricorda «non chiedere più»."""
        da rad.avvio importa DialogoAvvio
        da rad importa quiz
        cfg = se_stesso.config_
        ultima = cfg.ottieni("lezioni.ultima", 0) o Nessuno
        d = DialogoAvvio(se_stesso.radice, se_stesso.colori, cfg.ottieni("recenti", []), ultima, cfg.ottieni("avvio.chiedi", Vero))
        scelta = d.mostra()
        non_chiedere = d.non_chiedere_piu()
        se non_chiedere != (non cfg.ottieni("avvio.chiedi", Vero)):
            cfg.imposta("avvio.chiedi", non non_chiedere, notifica=Falso)
            cfg.salva()
        ritorna se_stesso.esegui_scelta_avvio(scelta)

    definisci esegui_scelta_avvio(se_stesso, scelta):
        se non scelta:
            ritorna Nessuno
        se scelta[0] == "ultimo":
            se_stesso.ripristina_ultimo_progetto()
        altrimenti_se scelta[0] == "progetto":
            se_stesso.apri_progetto(scelta[1])
        altrimenti_se scelta[0] == "nuovo":
            se_stesso.nuovo_progetto()
        altrimenti_se scelta[0] == "lezione":
            se_stesso.apri_lezioni()
        ritorna scelta

    definisci apri_lezioni(se_stesso):
        """La finestra delle lezioni (una sola): leggere, fare il quiz e gli esercizi, chiedere al professore."""
        da rad.lezioni_ui importa FinestraLezioni
        f = getattr(se_stesso, "_finestra_lezioni", Nessuno)
        se f è Nessuno o non f.winfo_exists():
            f = FinestraLezioni(se_stesso)
            se_stesso._finestra_lezioni = f
        f.deiconify()
        f.lift()
        ritorna f

    definisci chiedi_al_professore(se_stesso, lezione):
        """Apre la chat in modalità professore sulla lezione (dict con numero e titolo)."""
        da rad importa quiz
        se tipo_testo(se_stesso.chat) non in [tipo_testo(x) per x in se_stesso.corpo.panes()]:
            se_stesso.mostra_chat()
        ok = se_stesso.chat.avvia_professore({"numero": lezione["numero"], "titolo": lezione["titolo"], "testo": quiz.testo_lezione(lezione["numero"])})
        se_stesso.chat.ingresso.focus_set()
        ritorna ok

    definisci ripristina_ultimo_progetto(se_stesso):
        recenti = se_stesso.config_.ottieni("recenti", [])
        se recenti e os.path.exists(os.path.join(recenti[0], "progetto.rad.json")):
            se_stesso.apri_progetto(recenti[0])

    definisci nuovo_progetto(se_stesso):
        os.makedirs(CARTELLA_PROGETTI, exist_ok=Vero)
        risultato = dialoghi.DialogoNuovoProgetto(se_stesso.radice, se_stesso.colori, CARTELLA_PROGETTI).mostra()
        se non risultato:
            ritorna
        nome, cartella, modello = risultato
        prova:
            Progetto.nuovo(cartella, nome, modello)
        eccetto OSError come errore:
            messagebox.showerror("Errore", tipo_testo(errore), parent=se_stesso.radice)
            ritorna
        se_stesso.apri_progetto(cartella)

    definisci apri_progetto(se_stesso, cartella=Nessuno):
        se non cartella:
            cartella = filedialog.askdirectory(parent=se_stesso.radice, initialdir=CARTELLA_PROGETTI se os.path.isdir(CARTELLA_PROGETTI) altrimenti os.path.expanduser("~"),
                                               title="Apri la cartella di un progetto")
        se non cartella:
            ritorna
        cartella = os.path.abspath(cartella)
        se se_stesso.progetto e se_stesso.progetto.cartella != cartella:
            se non se_stesso.chat.pronta_al_cambio():          # se l'assistente lavora, si chiede se fermarlo
                ritorna
            se non se_stesso.chiudi_tutte_le_schede():
                ritorna
            se_stesso.chat.salva_cronologia()                  # la conversazione del progetto che si lascia resta salvata lì
        se non os.path.exists(os.path.join(cartella, "progetto.rad.json")):
            se messagebox.askyesno("Nuovo progetto", "Questa cartella non è un progetto PitStudio. Vuoi trasformarla in un progetto?", parent=se_stesso.radice):
                p = Progetto(cartella)
                p.salva_manifesto()
            altrimenti:
                ritorna
        se_stesso.salva_sessione()
        se_stesso.progetto = Progetto(cartella)
        se_stesso.storia = Storia(se_stesso.progetto)
        se_stesso.config_.aggiungi_recente(cartella)
        se_stesso.pannello_progetto.imposta_progetto(se_stesso.progetto)
        se_stesso.pannello_librerie.imposta_progetto(se_stesso.progetto)
        se_stesso.pannello_test.imposta_progetto(se_stesso.progetto)
        se_stesso.pannello_git.imposta_progetto(se_stesso.progetto)
        se_stesso.pannello_pacchetti.imposta_progetto(se_stesso.progetto)
        se_stesso.radice.title(f"{se_stesso.progetto.nome} — {NOME}")
        se_stesso.testo_progetto.configure(text=f"📦 {se_stesso.progetto.nome}")
        se_stesso._aggiorna_recenti()
        se_stesso.chat.carica_cronologia(forza=Vero)
        se_stesso.chat.aggiorna_annulla()
        se_stesso.console.pulisci()
        se_stesso._nascondi_benvenuto()
        se_stesso.ripristina_sessione()
        se non se_stesso.schede e se_stesso.progetto.percorso_principale():
            se_stesso.apri_file(se_stesso.progetto.percorso_principale())
        se_stesso.info(f"Progetto aperto: {cartella}")
        se_stesso.radice.after(400, se_stesso._proponi_aggiornamento_1x)
        se_stesso.radice.after(900, se_stesso._proponi_aggiornamento_moduli)

    definisci _proponi_aggiornamento_1x(se_stesso):
        """Un progetto scritto con la 1.x (nomi vecchi, finestre generate col generatore vecchio) non parte: lo si propone subito all'apertura."""
        se non se_stesso.progetto o getattr(se_stesso, "_offerta_1x", Nessuno) == se_stesso.progetto.cartella:
            ritorna
        se_stesso._offerta_1x = se_stesso.progetto.cartella
        da rad importa versioni
        se versioni.generazione_del_progetto(se_stesso.progetto.manifesto) == versioni.generazione_interprete():
            ritorna                                   # il progetto dichiara già l'interprete giusto: niente da controllare
        prova:
            se_stesso.aggiorna_da_1x(offerto=Vero)
        eccetto Eccezione come errore:
            se_stesso.info(f"Controllo del progetto non riuscito: {errore}")

    definisci _proponi_aggiornamento_moduli(se_stesso):
        """All'apertura: se il progetto ha moduli di PitStudio più vecchi di quelli di PitStudio, si avvisa e si propone di prendere l'ultima versione."""
        se non se_stesso.progetto:
            ritorna
        prova:
            se_stesso.aggiorna_moduli(offerto=Vero)
        eccetto Eccezione come errore:
            se_stesso.info(f"Controllo dei moduli di PitStudio non riuscito: {errore}")

    definisci aggiorna_moduli(se_stesso, offerto=Falso):
        """Confronta i moduli di PitStudio copiati nel progetto con quelli attuali e propone di sostituire i vecchi (la vecchia copia resta come .bak).
        All'apertura (offerto) chiede solo per i moduli vecchi di cui non si è già detto «non ora»; dal menu mostra sempre lo stato di tutti."""
        da rad importa moduli_modelli
        se non se_stesso.progetto:
            messagebox.showinfo("Moduli di PitStudio", "Apri prima un progetto.", parent=se_stesso.radice)
            ritorna Falso
        cartella = se_stesso.progetto.cartella
        stati = moduli_modelli.stati_del_progetto(cartella)
        vecchi = moduli_modelli.da_proporre(cartella) se offerto altrimenti [s per s in stati se s["stato"] == "vecchio"]
        se non vecchi:
            se non offerto:
                righe = "\n".join("  " + moduli_modelli.riga_elenco(s) per s in stati) o "  (il progetto non contiene moduli di PitStudio)"
                messagebox.showinfo("Moduli di PitStudio", "Tutti i moduli sono aggiornati.\n\n" + righe, parent=se_stesso.radice)
            ritorna Falso
        elenco = "\n".join("  " + moduli_modelli.riga_elenco(s) per s in vecchi)
        altri = [s per s in stati se s["stato"] in ("modificato", "piu_nuovo")]
        nota = ("\n\nQuesti non si toccano:\n" + "\n".join("  " + moduli_modelli.riga_elenco(s) per s in altri)) se altri altrimenti ""
        se non messagebox.askyesno("Moduli di PitStudio", "Questo progetto ha moduli di PitStudio più vecchi di quelli attuali:\n\n" + elenco + nota
                                   + "\n\nLi sostituisco con l'ultima versione? Le vecchie copie restano come .bak.", parent=se_stesso.radice):
            se offerto:
                moduli_modelli.ricorda_rifiuto(cartella, vecchi)       # «Non ora»: non si richiede finché non esce una versione più nuova
            ritorna Falso
        se_stesso.salva_tutto()
        scritti = moduli_modelli.aggiorna_vecchi(cartella, [s["nome"] per s in vecchi])
        se_stesso.ricarica_file_cambiati()
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.info("Moduli di PitStudio aggiornati: " + ", ".join(scritti))
        ritorna Vero

    definisci aggiorna_da_1x(se_stesso, offerto=Falso):
        """Aggiorna il progetto aperto dalla 1.x (nomi predefiniti, lettere ambigue, finestre, moduli). Si può annullare con «Annulla»."""
        da rad importa aggiorna_1x
        se non se_stesso.progetto:
            messagebox.showinfo("Aggiorna dalla 1.x", "Apri prima un progetto.", parent=se_stesso.radice)
            ritorna Falso
        rapporto = aggiorna_1x.aggiorna_progetto(se_stesso.progetto.cartella)
        testo_ = aggiorna_1x.testo_rapporto(rapporto)
        se non aggiorna_1x.ha_modifiche(rapporto):
            se non offerto:
                messagebox.showinfo("Aggiorna dalla 1.x", testo_, parent=se_stesso.radice)
            se non rapporto["residui"]:
                da rad importa versioni
                versioni.segna_versioni(se_stesso.progetto.cartella)         # è già a posto: lo si dichiara, la prossima apertura non controlla più
                se_stesso.progetto.carica_manifesto()
            ritorna Falso
        se non messagebox.askyesno("Aggiorna dalla 1.x", "Questo progetto usa nomi della versione 1.x che la 2.x non accetta.\nEcco cosa cambierebbe:\n\n" + testo_
                                   + "\n\nSi può annullare con «Annulla» nella chat. Procedo?", parent=se_stesso.radice):
            ritorna Falso
        se_stesso.salva_tutto()
        se_stesso.storia.prima_di_modificare("aggiorna_1x", "Aggiornamento dalla versione 1.x")
        rapporto = aggiorna_1x.aggiorna_progetto(se_stesso.progetto.cartella, applica=Vero)
        se_stesso.storia.concludi()
        se_stesso.progetto.carica_manifesto()
        se_stesso.ricarica_file_cambiati()
        se_stesso.chat.aggiorna_annulla()
        se_stesso.console.pulisci()
        se_stesso.console.scrivi("Aggiornamento dalla versione 1.x\n" + aggiorna_1x.testo_rapporto(rapporto, Vero) + "\n")
        ritorna Vero

    definisci proprieta_progetto(se_stesso):
        se non se_stesso.progetto:
            ritorna
        p = se_stesso.progetto
        nuovo = simpledialog.askstring("Proprietà del progetto", "Argomenti da passare al programma principale:",
                                       initialvalue=p.manifesto.get("argomenti", ""), parent=se_stesso.radice)
        se nuovo è non Nessuno:
            p.manifesto["argomenti"] = nuovo
            p.salva_manifesto()

    definisci imposta_corrente_principale(se_stesso):
        w = se_stesso._scheda_corrente()
        p = se_stesso._percorso_di(w)
        se p e se_stesso.progetto e se_stesso.progetto.contiene(p) e p.endswith(".pit"):
            se_stesso.progetto.imposta_principale(se_stesso.progetto.relativo(p))
            se_stesso.pannello_progetto.aggiorna()
            se_stesso.info(f"File principale: {se_stesso.progetto.principale}")

    # ---- sessione (schede aperte)
    definisci _file_sessione(se_stesso):
        ritorna os.path.join(se_stesso.progetto.cartella, ".rad", "sessione.json") se se_stesso.progetto altrimenti Nessuno

    definisci salva_sessione(se_stesso):
        f = se_stesso._file_sessione()
        se non f:
            ritorna
        aperti = [se_stesso.progetto.relativo(p) per p in se_stesso.schede se se_stesso.progetto.contiene(p)]
        attivo = se_stesso._percorso_di(se_stesso._scheda_corrente())
        prova:
            os.makedirs(os.path.dirname(f), exist_ok=Vero)
            con open(f, "w", encoding="utf-8") come fl:
                secondo = [se_stesso.progetto.relativo(p) per p, w in se_stesso.schede.items() se se_stesso.progetto.contiene(p) e se_stesso._gruppo_di(w) è se_stesso.schede_nb2]
                json.dump({"aperti": aperti, "secondo_gruppo": secondo, "attivo": se_stesso.progetto.relativo(attivo) se attivo e se_stesso.progetto.contiene(attivo) altrimenti "",
                           "punti_arresto": {se_stesso.progetto.relativo(p): sorted(r) per p, r in se_stesso.punti_arresto.items() se se_stesso.progetto.contiene(p) e r},
                           "punti_dettagli": {se_stesso.progetto.relativo(p): {tipo_testo(r): d per r, d in dd.items() se r in se_stesso.punti_arresto.get(p, ())}
                                              per p, dd in se_stesso.dettagli_punti.items() se se_stesso.progetto.contiene(p) e dd},
                           "osservate": tipo_lista(se_stesso.debug.osservate)}, fl)
        eccetto OSError:
            passa

    definisci ripristina_sessione(se_stesso):
        se_stesso.punti_arresto = {}
        se_stesso.dettagli_punti = {}
        f = se_stesso._file_sessione()
        prova:
            con open(f, encoding="utf-8") come fl:
                d = json.load(fl)
        eccetto (OSError, ValueError, ErroreDiTipo):
            ritorna
        se_stesso.punti_arresto = {os.path.abspath(os.path.join(se_stesso.progetto.cartella, rel)): set(righe)
                                   per rel, righe in d.get("punti_arresto", {}).items()}
        per rel, dd in d.get("punti_dettagli", {}).items():
            se_stesso.dettagli_punti[os.path.abspath(os.path.join(se_stesso.progetto.cartella, rel))] = {int(r): x per r, x in dd.items()}
        se_stesso.debug.osservate = [x per x in d.get("osservate", []) se isinstance(x, str)]
        per rel in d.get("aperti", []):
            p = os.path.join(se_stesso.progetto.cartella, rel)
            se os.path.exists(p):
                se_stesso.apri_file(p)
        per rel in d.get("secondo_gruppo", []):            # le schede che stavano nel gruppo a fianco tornano lì
            w = se_stesso.schede.get(os.path.abspath(os.path.join(se_stesso.progetto.cartella, rel)))
            se w è non Nessuno e se_stesso._gruppo_di(w) è se_stesso.schede_nb:
                se_stesso.sposta_scheda_nell_altro_gruppo(w)
        attivo = d.get("attivo")
        se attivo:
            se_stesso.apri_file(os.path.join(se_stesso.progetto.cartella, attivo))

    # ================================================================== schede
    # ---- i due gruppi di schede
    @property
    definisci gruppi(se_stesso):
        ritorna [se_stesso.schede_nb, se_stesso.schede_nb2]

    definisci _gruppo2_visibile(se_stesso):
        ritorna str(se_stesso.schede_nb2) in [tipo_testo(x) per x in se_stesso.area_editor.panes()]

    definisci _gruppo_di(se_stesso, widget):
        """Il gruppo che contiene la scheda (None se non è in nessuno)."""
        per gruppo in se_stesso.gruppi:
            se str(widget) in gruppo.tabs():
                ritorna gruppo
        ritorna Nessuno

    definisci _gruppo_attivo(se_stesso):
        """Il gruppo in cui si sta lavorando: l'ultimo in cui si è cliccato, si è scelta una scheda o è andato il focus (il primo se i gruppi sono uno)."""
        se se_stesso._gruppo2_visibile():
            ritorna se_stesso._gruppo_ultimo
        ritorna se_stesso.schede_nb

    definisci _focus_cambiato(se_stesso, evento):
        """Quando il focus entra nella scheda di un gruppo, quel gruppo diventa quello attivo. (Legato a tutta l'applicazione: scatta anche per
        i widget di altre finestre o di finestre già chiuse, che si ignorano.)"""
        prova:
            se evento.widget.winfo_toplevel() è non se_stesso.radice o non se_stesso._gruppo2_visibile():
                ritorna
            nome = str(evento.widget)
            per gruppo in se_stesso.gruppi:
                scelta = gruppo.select()
                se scelta e (nome == scelta o nome.startswith(scelta + ".")):
                    se gruppo è non se_stesso._gruppo_ultimo:
                        se_stesso._gruppo_ultimo = gruppo
                        se_stesso._segna_gruppi()
                    ritorna
        eccetto (tk.TclError, KeyError, AttributeError):
            passa

    definisci _gruppo_attivato(se_stesso, gruppo):
        se_stesso._gruppo_ultimo = gruppo
        se_stesso._segna_gruppi()

    definisci _segna_gruppi(se_stesso):
        """La riga colorata in cima dice in quale dei due gruppi si scrive (solo quando i gruppi sono due)."""
        doppio = se_stesso._gruppo2_visibile()
        attivo = se_stesso._gruppo_ultimo se doppio altrimenti Nessuno
        per gruppo in se_stesso.gruppi:
            gruppo.segna_attivo(doppio e gruppo è attivo)

    definisci _seleziona(se_stesso, widget):
        """Sceglie la scheda nel suo gruppo e rende attivo quel gruppo."""
        gruppo = se_stesso._gruppo_di(widget)
        se gruppo è Nessuno:
            ritorna
        gruppo.select(widget)
        se_stesso._gruppo_ultimo = gruppo
        se_stesso._segna_gruppi()

    definisci _aggiorna_gruppi(se_stesso):
        """Il secondo gruppo c'è solo finché ha schede."""
        se se_stesso._gruppo2_visibile() e non se_stesso.schede_nb2.tabs():
            se_stesso.area_editor.forget(se_stesso.schede_nb2)
            se_stesso._gruppo_ultimo = se_stesso.schede_nb
        se_stesso._segna_gruppi()

    definisci sposta_scheda_nell_altro_gruppo(se_stesso, widget=Nessuno):
        """«Apri a fianco»: porta la scheda (quella corrente se non si dice) nell'altro gruppo; il secondo gruppo compare se serve."""
        w = widget o se_stesso._scheda_corrente()
        se w è Nessuno:
            ritorna Falso
        origine = se_stesso._gruppo_di(w)
        se origine è Nessuno o w è se_stesso._benvenuto:
            ritorna Falso
        destinazione = se_stesso.schede_nb2 se origine è se_stesso.schede_nb altrimenti se_stesso.schede_nb
        se destinazione è se_stesso.schede_nb2 e non se_stesso._gruppo2_visibile():
            se_stesso.area_editor.add(se_stesso.schede_nb2, minsize=200, stretch="always")
        titolo = se_stesso._titolo_scheda(w)
        origine.forget(w)
        destinazione.add(w, text=titolo)
        destinazione.select(w)
        se_stesso._gruppo_ultimo = destinazione
        se_stesso._aggiorna_gruppi()
        se_stesso.salva_sessione()
        ritorna Vero

    definisci unisci_gruppi(se_stesso):
        """Riporta tutte le schede del secondo gruppo nel primo."""
        per w in [se_stesso.schede_nb2.nametowidget(n) per n in se_stesso.schede_nb2.tabs()]:
            titolo = se_stesso._titolo_scheda(w)
            se_stesso.schede_nb2.forget(w)
            se_stesso.schede_nb.add(w, text=titolo)
        se_stesso._aggiorna_gruppi()
        se_stesso.salva_sessione()

    definisci _scheda_corrente(se_stesso):
        per gruppo in [se_stesso._gruppo_attivo()] + se_stesso.gruppi:
            prova:
                nome = gruppo.select()
                se nome:
                    ritorna gruppo.nametowidget(nome)
            eccetto (tk.TclError, KeyError):
                passa
        ritorna Nessuno

    definisci _percorso_di(se_stesso, widget):
        per p, w in se_stesso.schede.items():
            se w è widget:
                ritorna p
        ritorna Nessuno

    definisci _titolo_scheda(se_stesso, widget):
        p = se_stesso._percorso_di(widget)
        nome = os.path.basename(p) se p altrimenti "?"
        se isinstance(widget, Progettista):
            nome = "🪟 " + widget.form.nome
        altrimenti_se isinstance(widget, EditorMattonelle):
            nome = "🧱 " + widget.nome_base()
        altrimenti_se getattr(widget, "titolo_scheda", Nessuno):
            nome = widget.titolo_scheda
        ritorna ("● " se getattr(widget, "modificato", Falso) altrimenti "") + nome

    definisci scheda_modificata(se_stesso, widget):
        prova:
            se_stesso._gruppo_di(widget).tab(widget, text=se_stesso._titolo_scheda(widget))
        eccetto (tk.TclError, AttributeError):
            passa
        se isinstance(widget, Editor) e widget.modificato:
            se_stesso._programma_sintassi(widget)
            se_stesso.pannello_librerie.aggiorna_uso()

    definisci _aggiungi_scheda(se_stesso, percorso, widget):
        se_stesso._nascondi_benvenuto()
        se_stesso.schede[percorso] = widget
        gruppo = se_stesso._gruppo_attivo()
        gruppo.add(widget, text=se_stesso._titolo_scheda(widget))
        se_stesso._seleziona(widget)

    definisci apri_file(se_stesso, percorso, riga=Nessuno):
        percorso = os.path.abspath(percorso)
        se percorso in se_stesso.schede:
            se_stesso._seleziona(se_stesso.schede[percorso])
            w = se_stesso.schede[percorso]
        altrimenti:
            se non os.path.exists(percorso):
                se_stesso.info(f"File non trovato: {percorso}")
                ritorna Nessuno
            cartelle = [se_stesso.progetto.cartella] se se_stesso.progetto altrimenti []
            tipo_ = tipo_file(percorso)
            w = Nessuno
            prova:
                se tipo_ == "form":
                    f = form_modello.carica_form(percorso)
                    w = Progettista(se_stesso.area_editor, percorso, f, se_stesso.colori, se_stesso.config_, se_stesso)
                altrimenti_se tipo_ == "mattonelle":
                    prog = mattonelle_modello.carica_programma(percorso)
                    w = EditorMattonelle(se_stesso.area_editor, percorso, prog, se_stesso.colori, se_stesso.config_, se_stesso)
                altrimenti:
                    w = crea_visore(se_stesso.area_editor, percorso, se_stesso.colori, se_stesso.config_, se_stesso)
                    se w è Nessuno:
                        w = Editor(se_stesso.area_editor, se_stesso.config_, se_stesso.colori, percorso,
                                   sul_cambio=se_stesso.scheda_modificata, sul_cursore=se_stesso._cursore,
                                   cartelle_progetto=cartelle)
                        w.carica(percorso)
                        w.app = se_stesso
                        w.fornitore_doc = se_stesso.documentazione_di
                        w.punti_arresto = set(se_stesso.punti_arresto.get(os.path.abspath(percorso), ()))
                        w.dettagli_punti = dict(se_stesso.dettagli_punti.get(os.path.abspath(percorso), {}))
                        w.sui_punti_arresto = se_stesso._cambio_punti_arresto
            eccetto (OSError, ValueError, KeyError) come errore:
                messagebox.showerror("Errore", f"Impossibile aprire {os.path.basename(percorso)}:\n{errore}", parent=se_stesso.radice)
                ritorna Nessuno
            tema.applica(w, se_stesso.colori)
            se hasattr(w, "applica_colori"):
                w.applica_colori(se_stesso.colori)
            se_stesso._aggiungi_scheda(percorso, w)
            se isinstance(w, Editor):
                se_stesso._programma_sintassi(w, subito=Vero)
        se riga e isinstance(w, Editor):
            w.vai_a(riga)
        altrimenti_se isinstance(w, Editor):
            w.t.focus_set()
        ritorna w

    definisci apri_file_a_riga(se_stesso, percorso, riga):
        se non os.path.isabs(percorso) e se_stesso.progetto:
            percorso = os.path.join(se_stesso.progetto.cartella, percorso)
        w = se_stesso.apri_file(percorso, riga)
        se isinstance(w, Editor):
            w.segna_errore(riga)

    definisci apri_file_a_funzione(se_stesso, percorso, nome_funzione):
        w = se_stesso.apri_file(percorso)
        se isinstance(w, Editor) e nome_funzione:
            w.ricarica_se_cambiato_su_disco()
            ricerca = w.t.search(f"definisci {nome_funzione}", "1.0", stopindex="end")
            se ricerca:
                w.vai_a(int(ricerca.split(".")[0]))

    definisci _scheda_cambiata(se_stesso, evento=Nessuno):
        se evento è non Nessuno e evento.widget in se_stesso.gruppi:
            se_stesso._gruppo_ultimo = evento.widget
            se_stesso._segna_gruppi()
        w = se_stesso._scheda_corrente()
        p = se_stesso._percorso_di(w)
        se_stesso.pannello_librerie.aggiorna_uso()
        se p:
            se_stesso.testo_stato.configure(text=p)
            se_stesso.testo_posizione.configure(text="")
            se isinstance(w, Editor):
                se_stesso._cursore(w.riga_cursore(), 1)
        altrimenti:
            se_stesso.testo_stato.configure(text="Pronto")

    definisci _cursore(se_stesso, riga, colonna):
        se_stesso.testo_posizione.configure(text=f"Riga {riga}, col {colonna}")

    definisci chiudi_scheda(se_stesso, widget, chiedi=Vero):
        se widget è Nessuno:
            ritorna Vero
        se chiedi e getattr(widget, "modificato", Falso):
            nome = os.path.basename(se_stesso._percorso_di(widget) o "?")
            r = messagebox.askyesnocancel("Modifiche non salvate", f"Salvare le modifiche a «{nome}»?", parent=se_stesso.radice)
            se r è Nessuno:
                ritorna Falso
            se r:
                widget.salva()
        p = se_stesso._percorso_di(widget)
        se hasattr(widget, "chiudi"):
            widget.chiudi()
        gruppo = se_stesso._gruppo_di(widget)
        prova:
            se gruppo è non Nessuno:
                gruppo.forget(widget)
        eccetto tk.TclError:
            passa
        se p:
            elimina se_stesso.schede[p]
            se_stesso.recupero.togli(p)             # salvato o scartato di proposito: la copia di sicurezza non serve più
        widget.destroy()
        se_stesso._aggiorna_gruppi()
        se non se_stesso.schede:
            se_stesso._mostra_benvenuto()
        ritorna Vero

    definisci chiudi_scheda_corrente(se_stesso):
        se_stesso.chiudi_scheda(se_stesso._scheda_corrente())

    definisci chiudi_tutte_le_schede(se_stesso):
        se_stesso.salva_sessione()
        per w in tipo_lista(se_stesso.schede.values()):
            se non se_stesso.chiudi_scheda(w):
                ritorna Falso
        ritorna Vero

    definisci _chiudi_con_clic_centrale(se_stesso, evento):
        gruppo = evento.widget
        prova:
            indice = gruppo.index(f"@{evento.x},{evento.y}")
            se_stesso.chiudi_scheda(gruppo.nametowidget(gruppo.tabs()[indice]))
        eccetto (tk.TclError, IndexError, KeyError):
            passa

    definisci _menu_scheda(se_stesso, evento):
        gruppo = evento.widget
        prova:
            indice = gruppo.index(f"@{evento.x},{evento.y}")
            w = gruppo.nametowidget(gruppo.tabs()[indice])
        eccetto (tk.TclError, IndexError, KeyError):
            ritorna
        m = tk.Menu(se_stesso.radice, tearoff=0)
        m.add_command(label="Chiudi", command=lambda: se_stesso.chiudi_scheda(w))
        se w è non se_stesso._benvenuto:
            m.add_command(label="Apri a fianco" se gruppo è se_stesso.schede_nb altrimenti "Sposta nell'altro gruppo",
                          command=lambda: se_stesso.sposta_scheda_nell_altro_gruppo(w))
        m.add_command(label="Chiudi le altre", command=lambda: [se_stesso.chiudi_scheda(x) per x in tipo_lista(se_stesso.schede.values()) se x è non w])
        p = se_stesso._percorso_di(w)
        se p:
            m.add_command(label="Copia percorso", command=lambda: (se_stesso.radice.clipboard_clear(), se_stesso.radice.clipboard_append(p)))
        m.tk_popup(evento.x_root, evento.y_root)

    definisci _su_editor(se_stesso, metodo, *argomenti):
        w = se_stesso._scheda_corrente()
        se isinstance(w, Editor):
            getattr(w, metodo)(*argomenti)
        altrimenti_se isinstance(w, Progettista) e metodo in ("annulla", "ripeti"):
            getattr(w, metodo)()

    definisci vai_a_riga(se_stesso):
        w = se_stesso._scheda_corrente()
        se isinstance(w, Editor):
            n = simpledialog.askinteger("Vai a riga", "Numero di riga:", parent=se_stesso.radice, minvalue=1)
            se n:
                w.vai_a(n)

    # ---- salvataggio
    definisci salva_scheda(se_stesso):
        w = se_stesso._scheda_corrente()
        se w è Nessuno:
            ritorna
        prova:
            w.salva()
        eccetto OSError come errore:
            messagebox.showerror("Errore", tipo_testo(errore), parent=se_stesso.radice)
            ritorna
        se_stesso.info(f"Salvato {os.path.basename(se_stesso._percorso_di(w) o '')}")
        se isinstance(w, Editor):
            se_stesso._programma_sintassi(w, subito=Vero)

    # ---- salvataggio di sicurezza
    definisci _ritardo_recupero(se_stesso):
        prova:
            ritorna max(5, int(se_stesso.config_.ottieni("recupero.secondi", 30))) * 1000
        eccetto (TypeError, ValueError):
            ritorna 30000

    definisci _ciclo_recupero(se_stesso):
        prova:
            se se_stesso.config_.ottieni("recupero.attivo", Vero):
                se_stesso.salva_copie_di_sicurezza()
        eccetto Exception:
            passa
        prova:
            se_stesso.radice.after(se_stesso._ritardo_recupero(), se_stesso._ciclo_recupero)
        eccetto tk.TclError:
            passa

    definisci salva_copie_di_sicurezza(se_stesso):
        """Copia i file con modifiche non salvate in ~/.rad/recupero e toglie le copie dei file ormai salvati. Ritorna quante copie ha scritto."""
        scritte = 0
        per p, w in tipo_lista(se_stesso.schede.items()):
            se getattr(w, "modificato", Falso) e hasattr(w, "contenuto"):
                prova:
                    se se_stesso.recupero.copia(p, w.contenuto()):
                        scritte += 1
                eccetto (tk.TclError, AttributeError):
                    passa
            altrimenti:
                se_stesso.recupero.togli(p)
        ritorna scritte

    definisci proponi_recupero(se_stesso, voci=Nessuno):
        """All'avvio: se ci sono copie di file con modifiche non salvate (chiusura improvvisa) chiede se ripristinarle. Ritorna il numero di file ripristinati."""
        voci = se_stesso.recupero.elenco() se voci è Nessuno altrimenti voci
        se non voci:
            ritorna 0
        elenco = "\n".join("  • " + v["percorso"] per v in voci[:8]) + (f"\n  … e altri {lunghezza_di(voci) - 8}" se lunghezza_di(voci) > 8 altrimenti "")
        r = messagebox.askyesnocancel("Recupero", "PitStudio si è chiuso prima che le modifiche fossero salvate.\nHo trovato una copia di questi file:\n\n"
                                      + elenco + "\n\nVuoi ripristinarle? (Sì = ripristina e riapri i file, No = scarta le copie, Annulla = decidi alla prossima apertura)",
                                      parent=se_stesso.radice)
        se r è Nessuno:
            ritorna 0
        se non r:
            per v in voci:
                se_stesso.recupero.togli(v["percorso"])
            ritorna 0
        ritorna se_stesso.ripristina_copie(voci)

    definisci ripristina_copie(se_stesso, voci):
        """Riapre i file e rimette il contenuto copiato (restano «modificati»: salvi tu). Le finestre del progettista tornano come erano; gli altri tipi di file
        si salvano accanto all'originale con l'estensione .recuperato. Ritorna quanti ne ha ripristinati."""
        fatti = 0
        per v in voci:
            p = v["percorso"]
            w = se_stesso.apri_file(p)
            se w è Nessuno:
                continua
            prova:
                se isinstance(w, Editor):
                    w.sostituisci_testo(v["contenuto"])
                altrimenti_se isinstance(w, Progettista):
                    w.imposta_form(form_modello.Form.da_json(v["contenuto"]))
                    w._segna_modificato(Vero)
                altrimenti:
                    con open(p + ".recuperato", "w", encoding="utf-8") come fp:
                        fp.write(v["contenuto"])
                    se_stesso.info(f"Copia di «{os.path.basename(p)}» salvata come {os.path.basename(p)}.recuperato")
            eccetto (OSError, ValueError, KeyError, TypeError) come errore:
                se_stesso.info(f"Non sono riuscito a ripristinare {os.path.basename(p)}: {errore}")
                continua
            fatti += 1
        se fatti:
            se_stesso.info(f"Ripristinati {fatti} file con le modifiche non salvate: ricordati di salvarli.")
        ritorna fatti

    definisci salva_tutto(se_stesso):
        per w in tipo_lista(se_stesso.schede.values()):
            se getattr(w, "modificato", Falso):
                prova:
                    w.salva()
                eccetto OSError:
                    passa

    # ---- controllo sintassi in tempo reale
    definisci _programma_sintassi(se_stesso, widget, subito=Falso):
        vecchio = se_stesso._sintassi.pop(widget, Nessuno)
        se vecchio:
            prova:
                se_stesso.radice.after_cancel(vecchio)
            eccetto tk.TclError:
                passa
        se_stesso._sintassi[widget] = se_stesso.radice.after(50 se subito altrimenti 700, lambda: se_stesso._controlla(widget))

    definisci _controlla(se_stesso, widget):
        se_stesso._sintassi.pop(widget, Nessuno)
        prova:
            se non widget.winfo_exists():
                ritorna
        eccetto tk.TclError:
            ritorna
        p = se_stesso._percorso_di(widget)
        se non p o linguaggio_di(p) è Nessuno:
            ritorna
        widget.cancella_errori()
        errore = esecuzione.controlla_sintassi(widget.contenuto(), p, widget.linguaggio)
        se non errore:
            se se_stesso.config_.ottieni("editor.omonimi", Vero):
                prova:
                    widget.segna_omonimi(omonimi.trova(widget.contenuto(), widget.linguaggio))
                eccetto Exception:
                    widget.cancella_omonimi()
            altrimenti:
                widget.cancella_omonimi()
        # il controllo prima dell'esecuzione: gli stessi errori gravi che bloccherebbero il programma
        widget.cancella_controllo()
        se non errore e se_stesso.config_.ottieni("editor.controllo", Vero):
            prova:
                widget.segna_controllo(controllo.trova(widget.contenuto(), widget.linguaggio))
            eccetto Exception:
                widget.cancella_controllo()
        se errore:
            riga, colonna, messaggio = errore
            widget.segna_errore(riga, messaggio)
            se widget è se_stesso._scheda_corrente():
                se_stesso.testo_stato.configure(text=f"⚠ riga {riga}: {messaggio}")
        altrimenti_se widget.errori_gravi():
            gravi = [q per q in widget._controllo se q["grave"]]
            se widget è se_stesso._scheda_corrente():
                se_stesso.testo_stato.configure(text=f"⛔ riga {gravi[0]['riga']}: {gravi[0]['motivo']}" + (f"  (e altri {lunghezza_di(gravi) - 1})" se lunghezza_di(gravi) > 1 altrimenti ""))
        altrimenti_se widget è se_stesso._scheda_corrente():
            se_stesso.testo_stato.configure(text=p)

    definisci controlla_corrente(se_stesso):
        w = se_stesso._scheda_corrente()
        se isinstance(w, Editor):
            se_stesso._controlla(w)
            se non w._righe_errore:
                se_stesso.info("Sintassi corretta ✔")

    # ================================================================== esecuzione
    definisci cartella_progetto(se_stesso):
        ritorna se_stesso.progetto.cartella se se_stesso.progetto altrimenti Nessuno

    # ---- debugger
    definisci debug_avvia(se_stesso, inizio=Falso):
        """Esegue il file principale (o il file aperto) sotto il debugger, fermandosi sui punti di arresto."""
        se se_stesso.debug.attiva:
            se_stesso.debug.comando("continua")
            ritorna
        p = se_stesso.progetto.percorso_principale() se se_stesso.progetto e se_stesso.progetto.percorso_principale() altrimenti Nessuno
        corrente = se_stesso._percorso_di(se_stesso._scheda_corrente())
        se corrente e corrente.lower().endswith((".pit", ".py", ".pyw")) e (non p o se_stesso.config_.ottieni("esecuzione.debug_file_corrente", Falso)):
            p = corrente
        se non p:
            se_stesso.info("Apri un file .pit o .py (o imposta il file principale) per avviare il debug.")
            ritorna
        se_stesso.debug.avvia(p, inizio)

    definisci alterna_punto_arresto(se_stesso):
        w = se_stesso._editor_corrente()
        se w è Nessuno e se_stesso._percorso_di(se_stesso._scheda_corrente()):
            ritorna
        se w:
            w.alterna_punto_arresto()

    definisci punto_arresto_condizionale(se_stesso):
        w = se_stesso._editor_corrente()
        se w:
            w.modifica_punto_arresto()

    definisci _cambio_punti_arresto(se_stesso, editor):
        se editor.percorso:
            percorso = os.path.abspath(editor.percorso)
            se editor.punti_arresto:
                se_stesso.punti_arresto[percorso] = set(editor.punti_arresto)
            altrimenti:
                se_stesso.punti_arresto.pop(percorso, Nessuno)
            se editor.dettagli_punti:
                se_stesso.dettagli_punti[percorso] = dict(editor.dettagli_punti)
            altrimenti:
                se_stesso.dettagli_punti.pop(percorso, Nessuno)
        se_stesso.salva_sessione()

    definisci togli_punti_arresto(se_stesso):
        se_stesso.punti_arresto.clear()
        se_stesso.dettagli_punti.clear()
        per w in se_stesso.schede.values():
            se isinstance(w, Editor):
                w.punti_arresto = set()
                w.dettagli_punti = {}
                w._ridisegna_numeri()
        se_stesso.salva_sessione()

    definisci esegui_principale(se_stesso):
        se se_stesso.debug.attiva e se_stesso.debug.fermo:
            se_stesso.debug.comando("continua")      # durante il debug F5 prosegue
            ritorna
        se se_stesso.progetto e se_stesso.progetto.percorso_principale():
            se_stesso.esegui_file(se_stesso.progetto.percorso_principale())
        altrimenti:
            se_stesso.esegui_corrente()

    definisci esegui_corrente(se_stesso):
        p = se_stesso._percorso_di(se_stesso._scheda_corrente())
        se p e p.lower().endswith((".pit", ".py", ".pyw")):
            se_stesso.esegui_file(p)
        altrimenti_se p e (p.endswith(".form.json") o p.endswith(".mattonelle.json")):
            w = se_stesso._scheda_corrente()
            w.esegui()
        altrimenti:
            se_stesso.info("Apri un file .pit o .py da eseguire (o imposta il file principale).")

    definisci esegui_file(se_stesso, percorso):
        se se_stesso.config_.ottieni("esecuzione.salva_prima", Vero):
            se_stesso.salva_tutto()
        argomenti = [se_stesso.config_.interprete(), "-u", percorso]
        extra = (se_stesso.config_.ottieni("esecuzione.argomenti", "") o "")
        se se_stesso.progetto e percorso == se_stesso.progetto.percorso_principale():
            extra = (extra + " " + se_stesso.progetto.manifesto.get("argomenti", "")).strip()
        se extra:
            prova:
                argomenti += shlex.split(extra, posix=Falso)
            eccetto ValueError:
                argomenti += extra.split()
        cartella = se_stesso.progetto.cartella se se_stesso.progetto e se_stesso.progetto.contiene(percorso) altrimenti os.path.dirname(percorso)
        per w in se_stesso.schede.values():
            se isinstance(w, Editor):
                w.cancella_errori()
        nome = os.path.basename(percorso)
        se_stesso._ultimo_eseguito = os.path.abspath(percorso)
        # la finestra provata ricorda dove l'hai messa (anche quando la prova si riavvia da sola): il file lo scrive lei, vedi form_modello.genera_ui
        se percorso.endswith(".pit") e os.path.exists(percorso[:-4] + ".form.json"):
            cartella_pos = os.path.join(os.path.expanduser("~"), ".rad", "anteprima")
            os.makedirs(cartella_pos, exist_ok=Vero)
            os.environ["PITSTUDIO_ANTEPRIMA"] = os.path.join(cartella_pos, hashlib.sha1(os.path.abspath(percorso).lower().encode("utf-8")).hexdigest()[:16] + ".txt")
        prova:
            se_stesso.console.esegui(argomenti, cartella, f"{nome}")
        infine:
            os.environ.pop("PITSTUDIO_ANTEPRIMA", Nessuno)

    definisci prova_in_corso(se_stesso, percorso):
        """True se questo file è il programma che sta girando adesso (la prova di una finestra)."""
        ritorna getattr(se_stesso, "_ultimo_eseguito", Nessuno) == os.path.abspath(percorso) e se_stesso.console.esecutore.in_esecuzione

    definisci riavvia_prova(se_stesso, percorso):
        """Ferma la prova e la rilancia con la finestra appena modificata."""
        se_stesso.console.esecutore.ferma()
        se_stesso._riavvia_quando_fermo(percorso, 40)

    definisci _riavvia_quando_fermo(se_stesso, percorso, tentativi):
        se se_stesso.console.esecutore.in_esecuzione e tentativi > 0:
            se_stesso.radice.after(100, lambda: se_stesso._riavvia_quando_fermo(percorso, tentativi - 1))
            ritorna
        se non se_stesso.console.esecutore.in_esecuzione:
            se_stesso.esegui_file(percorso)

    definisci ferma(se_stesso):
        se_stesso.console.ferma()

    definisci stato_esecuzione(se_stesso, in_corso):
        se_stesso.info("Programma in esecuzione…" se in_corso altrimenti "Programma terminato")

    definisci esecuzione_finita(se_stesso, codice):
        se codice != 0 e se_stesso.progetto:
            testo_ = se_stesso.console.t.get("1.0", "end")
            trovati = tipo_lista(re.finditer(r'File "([^"]+)", (?:riga|line) (\d+)', testo_))
            per m in reversed(trovati):
                p = m.group(1)
                se os.path.exists(p) e se_stesso.progetto.contiene(p):
                    w = se_stesso.schede.get(os.path.abspath(p))
                    se isinstance(w, Editor):
                        w.segna_errore(int(m.group(2)))
                    interrompi

    # ================================================================== finestre (progettista)
    definisci nuovo_form(se_stesso, cartella_relativa=""):
        se non se_stesso.progetto:
            messagebox.showinfo("Progetto", "Apri o crea prima un progetto.", parent=se_stesso.radice)
            ritorna
        esistenti = [os.path.basename(f)[:-len(".form.json")] per f in se_stesso.progetto.forms()]
        scelta = dialoghi.DialogoModelloFinestra(se_stesso.radice, se_stesso.colori, esistenti, modelli_finestra.MODELLI).mostra()
        se non scelta:
            ritorna
        nome, modello = scelta
        cartella = se_stesso.progetto.assoluto(cartella_relativa) se cartella_relativa altrimenti se_stesso.progetto.cartella
        prova:
            r = modelli_finestra.crea(modello, nome, cartella)
        eccetto (OSError, ValueError) come errore:
            messagebox.showerror("Nuova finestra", f"Non sono riuscito a creare la finestra:\n{errore}", parent=se_stesso.radice)
            ritorna
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.apri_file(r["form"])

    definisci nuovo_mattonelle(se_stesso, cartella_relativa="", nome=Nessuno):
        """Crea un programma a mattonelle (con la finestra del flusso principale pronta) e lo apre."""
        se non se_stesso.progetto:
            messagebox.showinfo("Progetto", "Apri o crea prima un progetto.", parent=se_stesso.radice)
            ritorna Nessuno
        esistenti = [os.path.basename(f)[:-len(".mattonelle.json")] per f in se_stesso.progetto.tutti_i_file() se f.endswith(".mattonelle.json")]
        se nome è Nessuno:
            nome = dialoghi.DialogoNuovaFinestra(se_stesso.radice, se_stesso.colori, esistenti, "Nuovo programma a mattonelle",
                                                 "programma").mostra()
        se non nome:
            ritorna Nessuno
        cartella = se_stesso.progetto.assoluto(cartella_relativa) se cartella_relativa altrimenti se_stesso.progetto.cartella
        prog = mattonelle_modello.Programma(nome)
        mattonelle_modello.salva_programma(prog, cartella)
        se_stesso.pannello_progetto.aggiorna()
        ritorna se_stesso.apri_file(mattonelle_modello.percorsi_programma(cartella, nome)["json"])

    # ================================================================== database
    definisci maschera_dalla_scheda(se_stesso):
        """Crea la maschera della tabella scelta nella scheda del database aperta."""
        w = se_stesso._scheda_corrente()
        se non isinstance(w, VisoreDatabase):
            messagebox.showinfo("Maschera", "Apri un database e scegli a sinistra la tabella di cui vuoi la maschera.", parent=se_stesso.radice)
            ritorna Nessuno
        ritorna se_stesso.crea_maschera_da_tabella(w.conn, w.tabella, w.percorso)

    definisci crea_maschera_da_tabella(se_stesso, conn, tabella, percorso_db=""):
        """Crea nel progetto una finestra (progettista) collegata alla tabella: ricerca, elenco, campi e pulsanti Nuovo/Salva/Elimina/Annulla."""
        se non se_stesso.progetto:
            messagebox.showinfo("Maschera", "Apri o crea prima un progetto: la maschera diventa una sua finestra.", parent=se_stesso.radice)
            ritorna Nessuno
        se non tabella:
            messagebox.showinfo("Maschera", "Scegli a sinistra la tabella di cui vuoi la maschera.", parent=se_stesso.radice)
            ritorna Nessuno
        esistenti = {os.path.basename(f)[:-len(".form.json")].lower() per f in se_stesso.progetto.tutti_i_file() se f.endswith(".form.json")}
        base = "Maschera" + "".join(parte.capitalize() per parte in re.split(r"\W+", tabella) se parte)
        proposta = base
        n = 2
        mentre proposta.lower() in esistenti:
            proposta = f"{base}{n}"
            n += 1
        nome = simpledialog.askstring("Crea la maschera", f"Nome della nuova finestra per la tabella «{tabella}»:", initialvalue=proposta, parent=se_stesso.radice)
        se non nome:
            ritorna Nessuno
        nome = nome.strip()
        se non form_modello.nome_valido(nome) o nome.lower() in esistenti:
            messagebox.showwarning("Nome non valido", "Usa lettere, cifre e _ (senza iniziare con una cifra) e un nome non ancora usato.", parent=se_stesso.radice)
            ritorna Nessuno
        prova:
            nomi = [c.nome per c in conn.colonne(tabella)]
            r = maschera_dati.crea_maschera(se_stesso.progetto.cartella, nome, tabella, nomi, conn.dialetto, percorso_db se conn.dialetto == "sqlite" altrimenti "",
                                            getattr(conn, "parametri", Nessuno))
        eccetto (OSError, ValueError, database_modello.ErroreDatabase) come errore:
            messagebox.showerror("Maschera", f"Non sono riuscito a creare la maschera:\n{errore}", parent=se_stesso.radice)
            ritorna Nessuno
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.apri_file(r["form"])
        se_stesso.apri_file(r["logica"])
        se_stesso.info(f"Maschera «{nome}» creata: premi «Esegui il file corrente» per provarla.")
        messagebox.showinfo("Maschera creata", f"La finestra «{nome}» è pronta e collegata alla tabella «{tabella}».\n\n"
                            f"• Si modifica nel progettista (scheda «{nome}»).\n• Per provarla: nel file {nome.lower()}.pit scegli Esegui → Esegui il file corrente.\n"
                            "• Il collegamento ai dati sta in fonte_dati.pit, che puoi usare anche in altre finestre.", parent=se_stesso.radice)
        ritorna r

    # ================================================================== navigazione nel codice
    definisci _cartella_di_lavoro(se_stesso, ed):
        se se_stesso.progetto:
            ritorna se_stesso.progetto.cartella
        ritorna os.path.dirname(os.path.abspath(ed.percorso)) se ed.percorso altrimenti os.getcwd()

    definisci _testi_aperti(se_stesso):
        """{percorso: testo} degli editor aperti (anche con modifiche non salvate)."""
        ritorna {p: w.contenuto() per p, w in se_stesso.schede.items() se isinstance(w, Editor)}

    definisci documentazione_di(se_stesso, editor, nome):
        """Il testo che compare passando il mouse sopra un nome nell'editor."""
        ritorna navigazione.documentazione(se_stesso._cartella_di_lavoro(editor), nome, editor.percorso, editor.contenuto())

    definisci _nome_per_navigare(se_stesso, ed, indice="insert"):
        nome = ed.parola_a_indice(indice)
        se non nome:
            se_stesso.info("Metti il cursore su un nome.")
        ritorna nome

    definisci vai_alla_definizione(se_stesso, ed=Nessuno, indice="insert"):
        """F12: apre il punto in cui è definito il nome sotto il cursore (funzione, classe, costante o modulo del progetto)."""
        ed = ed o se_stesso._editor_corrente()
        se ed è Nessuno:
            ritorna Nessuno
        nome = se_stesso._nome_per_navigare(ed, indice)
        se non nome:
            ritorna Nessuno
        se navigazione.parola_riservata(nome):
            se_stesso.apri_aiuto(nome)
            ritorna Nessuno
        cartella = se_stesso._cartella_di_lavoro(ed)
        trovate = navigazione.cerca_definizione(cartella, nome, ed.percorso, ed.contenuto())
        se non trovate:
            modulo = navigazione.modulo_del_progetto(cartella, nome)
            se modulo:
                ritorna se_stesso.apri_file(modulo)
            se_stesso.info(f"Non trovo la definizione di «{nome}» nel progetto (può essere una funzione predefinita o di una libreria: F1 apre la guida).")
            ritorna Nessuno
        se lunghezza_di(trovate) == 1:
            t = trovate[0]
            ritorna se_stesso.apri_file_a_riga(t["percorso"], t["riga"]) se os.path.abspath(t["percorso"]) != os.path.abspath(ed.percorso o "") altrimenti ed.vai_a(t["riga"])
        FinestraRisultati(se_stesso.radice, se_stesso.colori, f"Definizioni di «{nome}»", [(t["percorso"], t["riga"], t["firma"]) per t in trovate],
                          se_stesso.apri_file_a_riga, cartella)
        ritorna Nessuno

    definisci trova_usi_simbolo(se_stesso, ed=Nessuno):
        """Maiusc+F12: elenco di tutti i punti del progetto dove si usa il nome sotto il cursore."""
        ed = ed o se_stesso._editor_corrente()
        se ed è Nessuno:
            ritorna Nessuno
        nome = se_stesso._nome_per_navigare(ed)
        se non nome:
            ritorna Nessuno
        cartella = se_stesso._cartella_di_lavoro(ed)
        usi = navigazione.trova_usi(cartella, nome, se_stesso._testi_aperti())
        se non usi:
            se_stesso.info(f"«{nome}» non è usato altrove nel progetto.")
            ritorna Nessuno
        FinestraRisultati(se_stesso.radice, se_stesso.colori, f"Usi di «{nome}»  ·  {lunghezza_di(usi)} punti", [(u["percorso"], u["riga"], u["testo"]) per u in usi],
                          se_stesso.apri_file_a_riga, cartella)
        ritorna usi

    definisci rinomina_simbolo(se_stesso, ed=Nessuno, nuovo_nome=Nessuno):
        """F2: rinomina il nome sotto il cursore in tutto il progetto (codice, gestori dei form), con conferma."""
        ed = ed o se_stesso._editor_corrente()
        se ed è Nessuno:
            ritorna Nessuno
        vecchio = se_stesso._nome_per_navigare(ed)
        se non vecchio:
            ritorna Nessuno
        se navigazione.parola_riservata(vecchio):
            se_stesso.info("Una parola del linguaggio non si può rinominare.")
            ritorna Nessuno
        se nuovo_nome è Nessuno:
            nuovo_nome = simpledialog.askstring("Rinomina", f"Nuovo nome per «{vecchio}» (in tutto il progetto):", initialvalue=vecchio, parent=se_stesso.radice)
        se non nuovo_nome:
            ritorna Nessuno
        nuovo_nome = nuovo_nome.strip()
        errore = navigazione.controlla_nuovo_nome(nuovo_nome, vecchio)
        se errore:
            messagebox.showwarning("Rinomina", errore, parent=se_stesso.radice)
            ritorna Nessuno
        cartella = se_stesso._cartella_di_lavoro(ed)
        cambi = navigazione.rinomina_nel_progetto(cartella, vecchio, nuovo_nome, se_stesso._testi_aperti())
        omonimo = [p per p in getattr(ed, "_omonimi", []) se p["nome"] == vecchio]
        se non cambi:
            se_stesso.info(f"«{vecchio}» non compare nel progetto.")
            ritorna Nessuno
        totale = sum(n per _, n in cambi.values())
        elenco = "\n".join(f"  {os.path.relpath(p, cartella)}: {n}" per p, (_, n) in sorted(cambi.items())[:12])
        avviso = (f"ATTENZIONE: «{vecchio}» è usato per cose diverse (è evidenziato come omonimo, per esempio alla riga {omonimo[0]['riga']}): "
                  "il cambio le rinomina tutte insieme.\n\n") se omonimo altrimenti ""
        se non messagebox.askyesno("Rinomina in tutto il progetto", f"Cambio «{vecchio}» in «{nuovo_nome}»: {totale} punti in {lunghezza_di(cambi)} file.\n\n{avviso}{elenco}\n\n"
                                   "Nei file aperti si può annullare con Ctrl+Z; negli altri il cambio viene scritto subito sul disco. Procedo?", parent=se_stesso.radice):
            ritorna Nessuno
        aperti = {os.path.abspath(p): w per p, w in se_stesso.schede.items() se isinstance(w, Editor)}
        scritti = 0
        per p, (testo_nuovo, n) in cambi.items():
            w = aperti.get(os.path.abspath(p))
            se w è non Nessuno:
                w.sostituisci_testo(testo_nuovo)
            altrimenti:
                prova:
                    con open(p, "w", encoding="utf-8", newline="") come f:
                        f.write(testo_nuovo)
                    scritti += 1
                eccetto OSError come errore_file:
                    messagebox.showerror("Rinomina", f"Non riesco a scrivere {p}:\n{errore_file}", parent=se_stesso.radice)
        per w in tipo_lista(se_stesso.schede.values()):
            se hasattr(w, "ricarica_se_cambiato_su_disco") e non isinstance(w, Editor):
                prova:
                    w.ricarica_se_cambiato_su_disco()
                eccetto Exception:
                    passa
        se_stesso.info(f"«{vecchio}» rinominato in «{nuovo_nome}»: {totale} punti, {lunghezza_di(cambi)} file ({scritti} scritti sul disco).")
        ritorna cambi

    definisci ripulisci_codice(se_stesso):
        ed = se_stesso._editor_corrente()
        se ed è Nessuno:
            ritorna 0
        n = ed.ripulisci_codice()
        se_stesso.info(f"Codice ripulito: {n} righe cambiate." se n altrimenti "Il codice era già in ordine.")
        ritorna n

    definisci apri_galleria(se_stesso):
        """Galleria di esempi: sceglie un esempio e lo copia in un nuovo progetto, già aperto."""
        esempio = DialogoEsempi(se_stesso.radice, se_stesso.colori).mostra()
        se non esempio:
            ritorna Nessuno
        os.makedirs(CARTELLA_PROGETTI, exist_ok=Vero)
        scelta = filedialog.askdirectory(parent=se_stesso.radice, title="In quale cartella creo il progetto?", initialdir=CARTELLA_PROGETTI)
        se non scelta:
            ritorna Nessuno
        destinazione = os.path.join(scelta, esempio["id"])
        n = 2
        mentre os.path.exists(destinazione) e os.listdir(destinazione):
            destinazione = os.path.join(scelta, f"{esempio['id']}_{n}")
            n += 1
        prova:
            principale = esempi.copia_esempio(esempio, destinazione)
        eccetto (OSError, FileExistsError) come errore:
            messagebox.showerror("Esempi", f"Non sono riuscito a copiare l'esempio:{chr(10)}{errore}", parent=se_stesso.radice)
            ritorna Nessuno
        se_stesso.apri_progetto(destinazione)
        se_stesso.apri_file(principale)
        se_stesso.info(f"Esempio «{esempio['titolo']}» copiato in {destinazione}: premi Esegui per provarlo.")
        ritorna destinazione

    # ================================================================== esercizi guidati
    definisci _lista_esercizi(se_stesso):
        ritorna esercizi.carica_esercizi(se_stesso.config_.ottieni("esercizi.cartelle", []))

    definisci apri_esercizi(se_stesso):
        """Apre la finestra degli esercizi. Se non c'è un progetto aperto ne crea uno («Esercizi») dove l'allievo scrive il codice."""
        se non se_stesso.progetto:
            cartella = os.path.join(CARTELLA_PROGETTI, "Esercizi")
            se os.path.exists(os.path.join(cartella, "progetto.rad.json")):
                se_stesso.apri_progetto(cartella)
            altrimenti:
                os.makedirs(CARTELLA_PROGETTI, exist_ok=Vero)
                Progetto.nuovo(cartella, "Esercizi", "vuoto")
                se_stesso.apri_progetto(cartella)
        ritorna FinestraEsercizi(se_stesso.radice, se_stesso.colori, se_stesso.config_, se_stesso._lista_esercizi(), se_stesso)

    definisci apri_esercizio(se_stesso, evento):
        """Crea (se manca) il file dell'esercizio nel progetto e lo apre nell'editor."""
        percorso = esercizi.file_dell_esercizio(evento, se_stesso.progetto.cartella)
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.apri_file(percorso)
        ritorna percorso

    definisci controlla_esercizio(se_stesso, evento):
        """Salva tutto, esegue il programma dell'allievo con le prove dell'esercizio e registra il tentativo. Ritorna il risultato."""
        percorso = esercizi.file_dell_esercizio(evento, se_stesso.progetto.cartella)
        se_stesso.salva_tutto()
        aperto = se_stesso.schede.get(os.path.abspath(percorso))
        se aperto è non Nessuno e hasattr(aperto, "salva"):
            aperto.salva()                     # il file dell'esercizio si controlla sempre com'è nell'editor
        r = esercizi.controlla(percorso, evento, se_stesso.config_.interprete())
        esercizi.registra_tentativo(se_stesso.config_, evento["id"], r["ok"])
        ritorna r

    definisci aggiungi_cartella_esercizi(se_stesso):
        cartella = filedialog.askdirectory(parent=se_stesso.radice, title="Cartella con gli esercizi (file .json)")
        se cartella:
            elenco = tipo_lista(se_stesso.config_.ottieni("esercizi.cartelle", []))
            se cartella non in elenco:
                elenco.append(cartella)
            se_stesso.config_.imposta("esercizi.cartelle", elenco, notifica=Falso)
            se_stesso.config_.salva()
            ritorna se_stesso.apri_esercizi()

    definisci importa_pacchetto_esercizi(se_stesso):
        """Apre un file .pitesercizi dell'insegnante: gli esercizi finiscono in una cartella di PitStudio e compaiono nell'elenco."""
        percorso = filedialog.askopenfilename(parent=se_stesso.radice, title="Pacchetto di esercizi",
                                              filetypes=[("Pacchetto di esercizi", "*" + esercizi.ESTENSIONE_PACCHETTO), ("Tutti", "*.*")])
        se non percorso:
            ritorna Nessuno
        nome = os.path.splitext(os.path.basename(percorso))[0]
        destinazione = os.path.join(os.path.dirname(se_stesso.config_.file), "pacchetti_esercizi", nome)
        prova:
            quanti, titolo = esercizi.importa_pacchetto(percorso, destinazione)
        eccetto ErroreDiValore come errore:
            messagebox.showerror("Pacchetto di esercizi", tipo_testo(errore), parent=se_stesso.radice)
            ritorna Nessuno
        elenco = tipo_lista(se_stesso.config_.ottieni("esercizi.cartelle", []))
        se destinazione non in elenco:
            elenco.append(destinazione)
        se_stesso.config_.imposta("esercizi.cartelle", elenco, notifica=Falso)
        se_stesso.config_.salva()
        messagebox.showinfo("Pacchetto di esercizi", f"Aggiunti {quanti} esercizi" + (f" del pacchetto «{titolo}»" se titolo altrimenti "") + ".", parent=se_stesso.radice)
        ritorna se_stesso.apri_esercizi()

    definisci crea_pacchetto_esercizi(se_stesso):
        """Per gli insegnanti: mette in un solo file gli esercizi delle proprie cartelle, da dare agli allievi."""
        propri = [voce per voce in esercizi.carica_esercizi(se_stesso.config_.ottieni("esercizi.cartelle", [])) se voce["origine"] != esercizi.CARTELLA_ESERCIZI]
        se non propri:
            messagebox.showinfo("Pacchetto di esercizi", "Non hai ancora esercizi tuoi: aggiungi prima una cartella di esercizi (file .json).", parent=se_stesso.radice)
            ritorna Nessuno
        titolo = simpledialog.askstring("Pacchetto di esercizi", "Titolo del pacchetto:", parent=se_stesso.radice)
        se non titolo:
            ritorna Nessuno
        percorso = filedialog.asksaveasfilename(parent=se_stesso.radice, title="Salva il pacchetto", defaultextension=esercizi.ESTENSIONE_PACCHETTO,
                                                initialfile=titolo.strip().replace(" ", "_") + esercizi.ESTENSIONE_PACCHETTO, filetypes=[("Pacchetto di esercizi", "*" + esercizi.ESTENSIONE_PACCHETTO)])
        se non percorso:
            ritorna Nessuno
        n = esercizi.crea_pacchetto(percorso, propri, titolo.strip())
        messagebox.showinfo("Pacchetto di esercizi", f"Creato il pacchetto con {n} esercizi:" + chr(10) + percorso + chr(10) + chr(10) + "Dallo agli allievi: lo aprono da Esercizi → Classe → Importa un pacchetto.", parent=se_stesso.radice)
        ritorna n

    definisci esporta_progressi_esercizi(se_stesso):
        """Salva i progressi dell'allievo in un file da consegnare all'insegnante."""
        nome = simpledialog.askstring("I miei progressi", "Il tuo nome:", parent=se_stesso.radice)
        se non nome:
            ritorna Nessuno
        percorso = filedialog.asksaveasfilename(parent=se_stesso.radice, title="Salva i progressi", defaultextension=".json",
                                                initialfile="progressi_" + nome.strip().replace(" ", "_") + ".json", filetypes=[("Progressi", "*.json")])
        se non percorso:
            ritorna Nessuno
        dati = esercizi.esporta_progressi(se_stesso.config_, percorso, nome, se_stesso._lista_esercizi())
        messagebox.showinfo("I miei progressi", "Salvato: " + percorso + chr(10) + chr(10) + "Consegna questo file all'insegnante.", parent=se_stesso.radice)
        ritorna dati

    definisci report_classe_esercizi(se_stesso):
        """Per gli insegnanti: sceglie i file di progressi degli allievi e mostra il report della classe."""
        percorsi = filedialog.askopenfilenames(parent=se_stesso.radice, title="File dei progressi degli allievi", filetypes=[("Progressi", "*.json")])
        se non percorsi:
            ritorna Nessuno
        testo_ = esercizi.testo_report(esercizi.report_classe(tipo_lista(percorsi)))
        finestra = tk.Toplevel(se_stesso.radice)
        finestra.title("Report della classe")
        finestra.geometry("720x520+120+90")
        finestra.configure(background=se_stesso.colori["pannello"])
        t = tk.Text(finestra, font=(FONT_MONO, 10), wrap="none", background=se_stesso.colori["campo"], foreground=se_stesso.colori["primo_piano"], relief="flat", padx=12, pady=10)
        t.pack(fill="both", expand=Vero, padx=10, pady=(10, 4))
        t.insert("1.0", testo_)
        t.configure(state="disabled")
        b = tk.Button(finestra, text="Copia negli appunti", relief="flat", background=se_stesso.colori["pulsante"], foreground=se_stesso.colori["primo_piano"],
                      command=lambda: (se_stesso.radice.clipboard_clear(), se_stesso.radice.clipboard_append(testo_)))
        b.pack(side="right", padx=10, pady=8)
        ritorna testo_

    definisci nuovo_database_sqlite(se_stesso):
        """Crea un file SQLite vuoto (di solito nella cartella del progetto) e lo apre."""
        iniziale = se_stesso.progetto.cartella se se_stesso.progetto altrimenti os.path.expanduser("~")
        percorso = filedialog.asksaveasfilename(parent=se_stesso.radice, title="Nuovo database SQLite", initialdir=iniziale, initialfile="dati.db",
                                                defaultextension=".db", filetypes=[("Database SQLite", "*.db *.sqlite *.sqlite3"), ("Tutti i file", "*.*")])
        se non percorso:
            ritorna Nessuno
        prova:
            database_modello.apri_sqlite(percorso).chiudi()
        eccetto database_modello.ErroreDatabase come errore:
            messagebox.showerror("Database", tipo_testo(errore), parent=se_stesso.radice)
            ritorna Nessuno
        se se_stesso.progetto:
            se_stesso.pannello_progetto.aggiorna()
        ritorna se_stesso.apri_file(percorso)

    definisci apri_database_sqlite(se_stesso):
        iniziale = se_stesso.progetto.cartella se se_stesso.progetto altrimenti os.path.expanduser("~")
        percorso = filedialog.askopenfilename(parent=se_stesso.radice, title="Apri un database SQLite", initialdir=iniziale,
                                              filetypes=[("Database SQLite", "*.db *.sqlite *.sqlite3 *.db3"), ("Tutti i file", "*.*")])
        se non percorso:
            ritorna Nessuno
        ritorna se_stesso.apri_file(percorso)

    definisci collega_mysql(se_stesso):
        """Si collega a un server MySQL/MariaDB e apre il database in una scheda."""
        conn = DialogoMysql(se_stesso.radice, se_stesso.colori, se_stesso.config_, se_stesso.config_.interprete()).mostra()
        se conn è Nessuno:
            ritorna Nessuno
        chiave = "mysql://" + conn.nome_visibile
        se chiave in se_stesso.schede:
            se_stesso._seleziona(se_stesso.schede[chiave])
            conn.chiudi()
            ritorna se_stesso.schede[chiave]
        w = VisoreDatabase(se_stesso.area_editor, chiave, se_stesso.colori, se_stesso.config_, se_stesso, connessione=conn)
        tema.applica(w, se_stesso.colori)
        w.applica_colori(se_stesso.colori)
        se_stesso._aggiungi_scheda(chiave, w)
        ritorna w

    definisci installa_driver_mysql(se_stesso):
        se_stesso.info("Installo il driver MySQL (pymysql)…")
        se_stesso.radice.update_idletasks()
        riuscito, uscita = database_modello.installa_driver_mysql(se_stesso.config_.interprete())
        se riuscito:
            importa importlib
            importlib.invalidate_caches()
            se_stesso.info("Driver MySQL installato.")
            messagebox.showinfo("Database", "Driver MySQL (pymysql) installato.", parent=se_stesso.radice)
        altrimenti:
            se_stesso.info("Installazione del driver non riuscita")
            messagebox.showerror("Database", "Non sono riuscito a installare pymysql:\n" + uscita, parent=se_stesso.radice)

    definisci collega_postgres(se_stesso):
        """Si collega a un server PostgreSQL e apre il database in una scheda."""
        conn = DialogoPostgres(se_stesso.radice, se_stesso.colori, se_stesso.config_, se_stesso.config_.interprete()).mostra()
        se conn è Nessuno:
            ritorna Nessuno
        chiave = "postgres://" + conn.nome_visibile
        se chiave in se_stesso.schede:
            se_stesso._seleziona(se_stesso.schede[chiave])
            conn.chiudi()
            ritorna se_stesso.schede[chiave]
        w = VisoreDatabase(se_stesso.area_editor, chiave, se_stesso.colori, se_stesso.config_, se_stesso, connessione=conn)
        tema.applica(w, se_stesso.colori)
        w.applica_colori(se_stesso.colori)
        se_stesso._aggiungi_scheda(chiave, w)
        ritorna w

    definisci installa_driver_postgres(se_stesso):
        se_stesso.info("Installo il driver PostgreSQL (psycopg2)…")
        se_stesso.radice.update_idletasks()
        riuscito, uscita = database_modello.installa_driver_postgres(se_stesso.config_.interprete())
        se riuscito:
            importa importlib
            importlib.invalidate_caches()
            se_stesso.info("Driver PostgreSQL installato.")
            messagebox.showinfo("Database", "Driver PostgreSQL (psycopg2) installato.", parent=se_stesso.radice)
        altrimenti:
            se_stesso.info("Installazione del driver non riuscita")
            messagebox.showerror("Database", "Non sono riuscito a installare psycopg2:\n" + uscita, parent=se_stesso.radice)

    definisci crea_eseguibile(se_stesso):
        """Apre la finestra che costruisce un .exe del progetto (conversione in Python + PyInstaller)."""
        se non se_stesso.progetto:
            messagebox.showinfo("Crea l'eseguibile", "Apri o crea prima un progetto.", parent=se_stesso.radice)
            ritorna Nessuno
        se_stesso.salva_tutto()
        d = DialogoEseguibile(se_stesso.radice, se_stesso.colori, se_stesso.progetto.cartella)
        d.mostra()
        se se_stesso.progetto:
            se_stesso.pannello_progetto.aggiorna()
        ritorna d.esito

    definisci esporta_progetto_python(se_stesso):
        """Crea una cartella con il progetto convertito in Python (senza bisogno di pytonIta) e le librerie da installare."""
        se non se_stesso.progetto:
            messagebox.showinfo("Esporta come Python", "Apri o crea prima un progetto.", parent=se_stesso.radice)
            ritorna Nessuno
        se_stesso.salva_tutto()
        origine = se_stesso.progetto.cartella
        scelta = filedialog.askdirectory(parent=se_stesso.radice, title="In quale cartella creo il progetto Python?",
                                         initialdir=os.path.dirname(os.path.normpath(origine)), mustexist=Vero)
        se non scelta:
            ritorna Nessuno
        destinazione = esporta_python.proposta_destinazione(os.path.join(scelta, os.path.basename(os.path.normpath(origine))))
        se_stesso.info("Converto il progetto in Python…")
        se_stesso.radice.update_idletasks()
        prova:
            r = esporta_python.esporta(origine, destinazione)
        eccetto Exception come eccezione:
            messagebox.showerror("Esporta come Python", f"Non sono riuscito a convertire il progetto:\n{eccezione}", parent=se_stesso.radice)
            se_stesso.info("Esportazione non riuscita")
            ritorna Nessuno
        se_stesso.info(f"Progetto Python creato in {destinazione}")
        se messagebox.askyesno("Esporta come Python", esporta_python.riassunto(r) + "\n\nAprire la cartella?", parent=se_stesso.radice):
            prova:
                piattaforma.apri(destinazione)
            eccetto Exception:
                passa
        ritorna r

    definisci converti_progetto_py(se_stesso, origine=""):
        """Apre la finestra che converte un intero progetto Python in un nuovo progetto pytonIta."""
        d = converti_progetto.DialogoConversione(se_stesso.radice, se_stesso.colori, origine, se_stesso.apri_progetto)
        d.grab_set()
        ritorna d

    definisci traduci_in_pit(se_stesso, percorso=Nessuno, silenzioso=Falso):
        """Traduce un programma Python classico (.py) in pytonIta (.pit) accanto all'originale, che non viene toccato.

        Ritorna (percorso_pit, testo_del_rapporto) oppure Nessuno."""
        se percorso è Nessuno:
            percorso = se_stesso._percorso_di(se_stesso._scheda_corrente())
        se non percorso o non percorso.lower().endswith((".py", ".pyw")):
            se_stesso.info("Seleziona o apri un file .py da tradurre.")
            ritorna Nessuno
        percorso = os.path.abspath(percorso)
        w = se_stesso.schede.get(percorso)
        sorgente = w.contenuto() se isinstance(w, Editor) altrimenti open(percorso, encoding="utf-8").read()
        errore = esecuzione.controlla_sintassi(sorgente, percorso, "py")
        se errore:
            testo_ = f"Il file ha un errore di sintassi alla riga {errore[0]}: {errore[2]}"
            se silenzioso:
                solleva ErroreDiValore(testo_)
            messagebox.showerror("Traduzione", testo_, parent=se_stesso.radice)
            ritorna Nessuno
        importa sys
        strumenti = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "pitonit", "tools")
        se strumenti non in sys.path:
            sys.path.insert(0, strumenti)
        importa py2pit
        rapporto = []
        tradotto = py2pit.traduci(sorgente, rapporto)
        base = os.path.splitext(percorso)[0]
        destinazione = base + ".pit"
        n = 2
        mentre os.path.exists(destinazione):
            destinazione = f"{base}_{n}.pit"
            n += 1
        con open(destinazione, "w", encoding="utf-8", newline="\n") come f:
            f.write(tradotto)
        nomi = sorted({r[1] per r in rapporto})
        testo_ = "Parole chiave, funzioni e costanti sono ora in italiano."
        se nomi:
            testo_ += "\nNomi rinominati perché coincidevano con parole italiane riservate: " + ", ".join(f"{n} → {n}_" per n in nomi)
        testo_ += "\nLe librerie restano con i loro nomi originali (funzionano uguale)."
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.apri_file(destinazione)
        se_stesso.info(f"Tradotto in pytonIta: {os.path.basename(destinazione)}")
        se non silenzioso:
            messagebox.showinfo("Traduzione in pytonIta", f"{os.path.basename(percorso)} → {os.path.basename(destinazione)}\n\n{testo_}\n\nL'originale non è stato toccato.",
                                parent=se_stesso.radice)
        ritorna destinazione, testo_

    definisci converti_in_mattonelle(se_stesso, percorso=Nessuno, nome=Nessuno, silenzioso=Falso):
        """Trasforma un programma .pit in un programma a mattonelle (nome_mattonelle.mattonelle.json) e lo apre.

        Ritorna (percorsi, testo_del_rapporto) oppure Nessuno se non è possibile."""
        se percorso è Nessuno:
            percorso = se_stesso._percorso_di(se_stesso._scheda_corrente())
        se percorso e percorso.lower().endswith(".py"):
            se_stesso.info("Per convertire in mattonelle un file .py traducilo prima in pytonIta (clic destro → Traduci in pytonIta).")
            ritorna Nessuno
        se non percorso o non percorso.lower().endswith(".pit"):
            se_stesso.info("Seleziona o apri un file .pit da convertire.")
            ritorna Nessuno
        percorso = os.path.abspath(percorso)
        w = se_stesso.schede.get(percorso)
        sorgente = w.contenuto() se isinstance(w, Editor) altrimenti open(percorso, encoding="utf-8").read()
        errore = esecuzione.controlla_sintassi(sorgente, percorso)
        se errore:
            testo_ = f"Il file ha un errore di sintassi alla riga {errore[0]}: {errore[2]}\nCorreggilo prima di convertire."
            se silenzioso:
                solleva ErroreDiValore(testo_)
            messagebox.showerror("Conversione", testo_, parent=se_stesso.radice)
            ritorna Nessuno
        cartella = os.path.dirname(percorso)
        base = nome o (os.path.splitext(os.path.basename(percorso))[0] + "_mattonelle")
        n = 2
        originale = base
        mentre os.path.exists(mattonelle_modello.percorsi_programma(cartella, base)["json"]):
            base = f"{originale}{n}"
            n += 1
        programma, rapporto = mattonelle_converti.converti_sorgente(sorgente, base)
        percorsi, avvisi = mattonelle_modello.salva_programma(programma, cartella)
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.apri_file(percorsi[0])
        testo_ = mattonelle_converti.descrivi_rapporto(rapporto)
        se_stesso.info(f"Convertito in mattonelle: {os.path.basename(percorsi[0])}")
        se non silenzioso:
            messagebox.showinfo("Conversione in mattonelle", f"{os.path.basename(percorso)} → {os.path.basename(percorsi[0])}\n\n{testo_}\n\n"
                                "Il codice generato dalle mattonelle è in " + os.path.basename(percorsi[1])
                                + "; l'originale non è stato toccato.", parent=se_stesso.radice)
        ritorna [se_stesso.progetto.relativo(p) se se_stesso.progetto e se_stesso.progetto.contiene(p) altrimenti p per p in percorsi], testo_

    definisci file_scritti(se_stesso, percorsi):
        """Il progettista ha scritto dei file: aggiorna albero ed editor aperti."""
        se_stesso.pannello_progetto.aggiorna()
        per p in percorsi:
            w = se_stesso.schede.get(os.path.abspath(p))
            se w e hasattr(w, "ricarica_se_cambiato_su_disco") e w non in se_stesso._progettisti():
                w.ricarica_se_cambiato_su_disco()

    definisci _progettisti(se_stesso):
        ritorna [w per w in se_stesso.schede.values() se isinstance(w, Progettista)]

    # ================================================================== operazioni sui file (dal pannello)
    definisci file_rinominato(se_stesso, vecchio, nuovo):
        w = se_stesso.schede.pop(os.path.abspath(vecchio), Nessuno)
        se w:
            se_stesso.schede[os.path.abspath(nuovo)] = w
            w.percorso = nuovo
            se_stesso.scheda_modificata(w)

    definisci file_eliminato(se_stesso, percorso):
        percorso = os.path.abspath(percorso)
        per p, w in tipo_lista(se_stesso.schede.items()):
            se p == percorso o p.startswith(percorso + os.sep):
                se_stesso.chiudi_scheda(w, chiedi=Falso)

    definisci info(se_stesso, messaggio):
        se_stesso.testo_stato.configure(text=messaggio)

    # ================================================================== aggiornamenti
    definisci avvio_aggiornamenti(se_stesso):
        """Controllo automatico, al massimo una volta al giorno e solo se non è disattivato nelle impostazioni."""
        importa datetime
        cfg = se_stesso.config_
        oggi = datetime.date.today().isoformat()
        se non cfg.ottieni("aggiornamenti.controlla_all_avvio", Vero) o cfg.ottieni("aggiornamenti.ultimo_controllo", "") == oggi:
            ritorna
        cfg.imposta("aggiornamenti.ultimo_controllo", oggi, notifica=Falso)
        cfg.salva()
        se_stesso.controlla_aggiornamenti(Falso)

    definisci controlla_aggiornamenti(se_stesso, manuale=Vero):
        """PitStudio (ultima Release su GitHub) e librerie (indice online). Manuale: risponde sempre; automatico: parla solo se c'è qualcosa."""
        se manuale:
            se_stesso.info("Cerco aggiornamenti…")

        definisci lavoro():
            risultato = {"app": Nessuno, "errore": Nessuno, "librerie": Nessuno}
            prova:
                risultato["app"] = aggiornamenti.controlla()
            eccetto aggiornamenti.ErroreAggiornamenti come errore:
                risultato["errore"] = tipo_testo(errore)
            prova:
                risultato["librerie"] = librerie_online.scarica_indice()
            eccetto librerie_online.ErroreLibrerie:
                passa
            ritorna risultato

        definisci fine(riuscito, r):
            se non riuscito:
                se manuale:
                    messagebox.showwarning("Aggiornamenti", tipo_testo(r), parent=se_stesso.radice)
                ritorna
            pl = se_stesso.pannello_librerie
            se r["librerie"]:
                pl._carica_online(r["librerie"])
                pl.riempi()
            riassunto_librerie = pl.riassunto_online()
            app = r["app"]
            se app e app["nuova"]:
                se manuale:
                    da rad.aggiornamenti_ui importa DialogoAggiornamento
                    DialogoAggiornamento(se_stesso.radice, se_stesso.colori, app, se_stesso.installa_aggiornamento).mostra()
                altrimenti:
                    se_stesso.info(f"{NOME} {app['versione']} è disponibile: Aiuto → Controlla aggiornamenti" + (f" · librerie: {riassunto_librerie}" se riassunto_librerie altrimenti ""))
                ritorna
            se riassunto_librerie e non manuale:
                se_stesso.info(f"Librerie online: {riassunto_librerie} (pannello Librerie → Aggiorna)")
            se manuale:
                se r["errore"]:
                    messagebox.showwarning("Aggiornamenti", r["errore"], parent=se_stesso.radice)
                altrimenti:
                    messagebox.showinfo("Aggiornamenti", f"{NOME} {VERSIONE_BASE} è l'ultima versione.\n\nLibrerie online: " + (riassunto_librerie o "tutte aggiornate") + ".",
                                        parent=se_stesso.radice)
        esecuzione.in_secondo_piano(se_stesso.radice, lavoro, fine)

    definisci _aggiorna_da_sorgenti(se_stesso, archivio):
        """Linux e macOS: riscrive PitStudio e le librerie dai sorgenti scaricati, poi propone di riavviare."""
        se_stesso.info("Aggiorno PitStudio…")

        definisci fine(riuscito, r):
            se non riuscito:
                se_stesso.info("Aggiornamento non riuscito")
                messagebox.showerror("Aggiornamento", tipo_testo(r), parent=se_stesso.radice)
                ritorna
            se_stesso.info("PitStudio aggiornato")
            se messagebox.askyesno("Aggiornamento", "PitStudio è stato aggiornato.\n\nLo riavvio adesso?", parent=se_stesso.radice):
                comando = [sys.executable, os.path.join(sys.prefix, "PitStudio", "rad.pit")]
                se_stesso.esci()
                prova:
                    vivo = bool(se_stesso.radice.winfo_exists())
                eccetto tk.TclError:
                    vivo = Falso
                se non vivo:
                    subprocess.Popen(comando, start_new_session=Vero)
        esecuzione.in_secondo_piano(se_stesso.radice, lambda: aggiornamenti.installa_da_sorgenti(archivio), fine)

    definisci installa_aggiornamento(se_stesso, percorso):
        """Chiude PitStudio (chiedendo di salvare) e avvia l'installatore scaricato. Se l'uscita viene annullata, l'installazione resta da fare."""
        se non piattaforma.WINDOWS:
            se_stesso._aggiorna_da_sorgenti(percorso)
            ritorna
        se_stesso.esci()
        prova:
            vivo = bool(se_stesso.radice.winfo_exists())
        eccetto tk.TclError:
            vivo = Falso
        se non vivo:
            aggiornamenti.avvia_installatore(percorso)
        altrimenti:
            se_stesso.info(f"Installazione rimandata: l'installatore è in {percorso}")

    # ================================================================== finestra di ricerca e manuale
    definisci cerca_nel_progetto(se_stesso):
        se non se_stesso.progetto:
            ritorna
        dialoghi.DialogoCerca(se_stesso.radice, se_stesso.colori, se_stesso.progetto,
                              lambda p, riga: se_stesso.apri_file(p, riga)).mostra()

    definisci apri_manuale(se_stesso):
        p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "manuale.md")
        se os.path.exists(p):
            se_stesso.apri_file(p)

    # ================================================================== schermata iniziale
    definisci _mostra_benvenuto(se_stesso, aggiorna=Falso):
        se_stesso._nascondi_benvenuto()
        se se_stesso.schede:
            ritorna
        c = se_stesso.colori
        f = tk.Frame(se_stesso.area_editor, background=c["editor"])
        centro = tk.Frame(f, background=c["editor"])
        centro.place(relx=0.5, rely=0.46, anchor="center")
        se_stesso._logo_benvenuto = stile.logo_tk(88)
        tk.Label(centro, image=se_stesso._logo_benvenuto, background=c["editor"]).grid(row=0, column=0, rowspan=2, padx=(0, 18))
        tk.Label(centro, text=NOME, font=semi(30), background=c["editor"], foreground=c["primo_piano"]).grid(
            row=0, column=1, sticky="sw")
        tk.Label(centro, text=f"Ambiente di sviluppo per pytonIta  ·  versione {VERSIONE}", font=(FONT_UI, 11),
                 background=c["editor"], foreground=c["tenue"]).grid(row=1, column=1, sticky="nw")
        carte = tk.Frame(centro, background=c["editor"])
        carte.grid(row=2, column=0, columnspan=2, pady=(28, 6))
        voci = [("nuovo", "Nuovo progetto", "Console, finestra, mattonelle…", se_stesso.nuovo_progetto),
                ("apri", "Apri progetto", "Riprendi il lavoro in una cartella", se_stesso.apri_progetto),
                ("mattonelle", "Programma a mattonelle", "Programma senza scrivere codice", lambda: se_stesso.nuovo_mattonelle()),
                ("stella", "Galleria di esempi", "Progetti pronti da provare e studiare", lambda: se_stesso.apri_galleria()),
                ("libro", "Esercizi guidati", "Impara esercitandoti, con controllo automatico", lambda: se_stesso.apri_esercizi()),
                ("aiuto", "Guida di PitStudio", "Primi passi e riferimento completo", lambda: se_stesso.apri_aiuto())]
        per i, (icona, titolo, descr, comando) in enumera(voci):
            carta = tk.Frame(carte, background=c["pannello"], cursor="hand2", highlightthickness=1, highlightbackground=c["bordo"])
            carta.grid(row=i // 2, column=i % 2, padx=8, pady=8, sticky="nsew")
            lab_i = tk.Label(carta, text=stile.glifo(icona), font=(stile.famiglia_icone() o FONT_SIMBOLI, 20),
                             background=c["pannello"], foreground=c["accento"], width=3)
            lab_i.grid(row=0, column=0, rowspan=2, padx=(12, 4), pady=12)
            lab_t = tk.Label(carta, text=titolo, font=semi(11), background=c["pannello"],
                             foreground=c["primo_piano"], anchor="w", width=22)
            lab_t.grid(row=0, column=1, sticky="sw", padx=(0, 14), pady=(12, 0))
            lab_d = tk.Label(carta, text=descr, font=(FONT_UI, 9), background=c["pannello"], foreground=c["tenue"], anchor="w")
            lab_d.grid(row=1, column=1, sticky="nw", padx=(0, 14), pady=(0, 12))
            per w in (carta, lab_i, lab_t, lab_d):
                w.bind("<Button-1>", lambda evento, fn=comando: fn())
                stile.suggerisci(w, titolo + ": " + descr, c)
                w.bind("<Enter>", lambda evento, k=carta: k.configure(highlightbackground=c["accento"]))
                w.bind("<Leave>", lambda evento, k=carta: k.configure(highlightbackground=c["bordo"]))
        recenti = [r per r in se_stesso.config_.ottieni("recenti", []) se os.path.isdir(r)][:5]
        se recenti:
            tk.Label(centro, text="PROGETTI RECENTI", font=semi(9), background=c["editor"],
                     foreground=c["tenue"]).grid(row=3, column=0, columnspan=2, sticky="w", padx=10, pady=(18, 4))
            per r in recenti:
                riga = tk.Frame(centro, background=c["editor"], cursor="hand2")
                riga.grid(sticky="we", columnspan=2)
                nome_ = tk.Label(riga, text=os.path.basename(r), font=semi(10), background=c["editor"],
                                 foreground=c["accento"], anchor="w")
                nome_.pack(side="left", padx=(10, 12))
                perc = tk.Label(riga, text=r, font=(FONT_UI, 9), background=c["editor"], foreground=c["tenue"], anchor="w")
                perc.pack(side="left")
                per w in (riga, nome_, perc):
                    w.bind("<Button-1>", lambda evento, p=r: se_stesso.apri_progetto(p))
                    stile.suggerisci(w, "Apri il progetto " + r, c)
        tk.Label(f, text="Premi F1 in qualsiasi momento per aprire la guida", font=(FONT_UI, 9), background=c["editor"],
                 foreground=c["tenue"]).place(relx=0.5, rely=0.97, anchor="s")
        se_stesso._benvenuto = f
        se_stesso.schede_nb.add(f, text="Benvenuto")

    definisci _nascondi_benvenuto(se_stesso):
        se se_stesso._benvenuto è non Nessuno:
            prova:
                se_stesso.schede_nb.forget(se_stesso._benvenuto)
                se_stesso._benvenuto.destroy()
            eccetto tk.TclError:
                passa
            se_stesso._benvenuto = Nessuno

    # ================================================================== AI: scorciatoie
    definisci ai_spiega(se_stesso):
        w = se_stesso._scheda_corrente()
        se isinstance(w, Editor) e w.selezione_con_righe():
            se tipo_testo(se_stesso.chat) non in [tipo_testo(x) per x in se_stesso.corpo.panes()]:
                se_stesso.mostra_chat()
            se_stesso.chat.chiedi("Spiegami questo codice (selezione nell'editor) e dimmi se vedi problemi.", economico=Vero)
        altrimenti:
            se_stesso.info("Seleziona del codice nell'editor.")

    definisci ai_correggi(se_stesso):
        se tipo_testo(se_stesso.chat) non in [tipo_testo(x) per x in se_stesso.corpo.panes()]:
            se_stesso.mostra_chat()
        se_stesso.chat.chiedi("L'ultima esecuzione ha dato un errore (vedi la console con stato_ide). "
                              "Trova la causa, correggi il codice e verifica eseguendolo.")

    # ---- Claude Code (app ufficiale di Anthropic, con l'abbonamento dell'utente)
    definisci collega_agenti_mcp(se_stesso):
        """Mostra come collegare altri agenti (Claude Code, Cursor…) agli strumenti di PitStudio via MCP."""
        da rad importa mcp_server
        da rad.dialoghi importa DialogoMcp
        cartella = se_stesso.progetto.cartella se se_stesso.progetto altrimenti os.getcwd()
        comando, argomenti = mcp_server.comando_di_collegamento(cartella, se_stesso.config_.interprete())
        ritorna DialogoMcp(se_stesso.radice, se_stesso.colori, comando, argomenti).mostra()

    definisci apri_claude_code(se_stesso):
        """Prepara il progetto (istruzioni e controlli) e apre il Claude Code ufficiale in una nuova console."""
        se non se_stesso.progetto:
            se_stesso.info("Apri un progetto: Claude Code lavora nella cartella del progetto.")
            ritorna
        claude = claude_code.trova_claude(se_stesso.config_)
        se non claude:
            messagebox.showinfo("Claude Code non trovato",
                                "Non trovo il programma «claude» sul computer.\n\nInstalla Claude Code dal sito ufficiale di Anthropic "
                                "(code.claude.com) ed esegui «claude» una volta in un terminale per accedere con il tuo account; poi riprova.\n\n"
                                "Se è installato in un posto insolito, scrivi il percorso di claude.exe in config.json (claude_code.percorso).",
                                parent=se_stesso.radice)
            ritorna
        cartella = se_stesso.progetto.cartella
        se non claude_code.preparato(cartella, se_stesso.config_):
            scelta = messagebox.askyesnocancel(
                "Claude Code nel progetto",
                "PitStudio può preparare questo progetto per Claude Code:\n\n"
                "• CLAUDE.md: spiega a Claude che i file .pit usano parole chiave italiane e come eseguirli;\n"
                "• .claude/settings.local.json: controlli locali (solo sul tuo computer) che\n"
                "     – fotografano i file a ogni richiesta, così puoi usare «Annulla» di PitStudio,\n"
                "     – controllano la sintassi dei .pit/.py dopo ogni scrittura e avvisano Claude se è sbagliata.\n\n"
                "Non vengono inviati dati a nessuno e PitStudio non tocca il tuo accesso a Claude.\n\n"
                "Sì = prepara e apri    No = apri senza preparare    Annulla = niente",
                parent=se_stesso.radice)
            se scelta è Nessuno:
                ritorna
            se scelta:
                prova:
                    toccati = claude_code.prepara_progetto(cartella, se_stesso.config_, se_stesso.progetto.nome)
                eccetto (OSError, ErroreDiValore) come errore:
                    messagebox.showerror("Claude Code", f"Non riesco a preparare il progetto:\n{errore}", parent=se_stesso.radice)
                    ritorna
                se_stesso.pannello_progetto.aggiorna()
                se_stesso.info("Progetto preparato per Claude Code: " + ", ".join(os.path.basename(p) per p in toccati))
        prova:
            claude_code.avvia(cartella, claude)
        eccetto OSError come errore:
            messagebox.showerror("Claude Code", f"Non riesco ad avviare Claude Code:\n{errore}", parent=se_stesso.radice)
            ritorna
        se_stesso.info("Claude Code avviato in una nuova finestra. Le modifiche ai file compaiono qui da sole.")
        se non getattr(se_stesso, "_claude_code_attivo", Falso):
            se_stesso._claude_code_attivo = Vero
            se_stesso._sincronizza_file_aperti()

    definisci ricarica_file_cambiati(se_stesso):
        """Rilegge i file aperti cambiati sul disco (dopo un cambio di ramo, un pull o un annulla di Git) e aggiorna l'elenco dei file."""
        per w in tipo_lista(se_stesso.schede.values()):
            se hasattr(w, "ricarica_se_cambiato_su_disco"):          # editor di testo, ma anche mattonelle, progettista e visori: tutti vanno riletti
                prova:
                    w.ricarica_se_cambiato_su_disco()
                eccetto Exception:
                    passa
        se_stesso.pannello_progetto.aggiorna()

    definisci _sincronizza_file_aperti(se_stesso):
        """Rilegge i file aperti cambiati su disco da un programma esterno (Claude Code) e tiene aggiornato «Annulla»."""
        se non getattr(se_stesso, "_claude_code_attivo", Falso):
            ritorna
        cambiato = Falso
        per w in tipo_lista(se_stesso.schede.values()):
            se isinstance(w, Editor):
                prova:
                    cambiato = w.ricarica_se_cambiato_su_disco() o cambiato
                eccetto Exception:
                    passa
        se se_stesso.storia e se_stesso.chat:
            se_stesso.chat.aggiorna_annulla()
        se cambiato:
            se_stesso.pannello_progetto.aggiorna()
        se_stesso.radice.after(2500, se_stesso._sincronizza_file_aperti)

    # ---- annullare le modifiche dell'assistente
    definisci ripristina_file(se_stesso, assoluto, dati):
        """Rimette sul disco il contenuto (in byte) di un file e aggiorna la scheda se è aperta."""
        assoluto = os.path.abspath(assoluto)
        os.makedirs(os.path.dirname(assoluto), exist_ok=Vero)
        con open(assoluto, "wb") come f:
            f.write(dati)
        w = se_stesso.schede.get(assoluto)
        se w è non Nessuno e hasattr(w, "ricarica_se_cambiato_su_disco"):
            w.ricarica_se_cambiato_su_disco()
        se_stesso.pannello_progetto.aggiorna()

    definisci annulla_gruppo_ai(se_stesso, gruppo):
        """Annulla un gruppo di modifiche dell'assistente. Ritorna l'elenco (file, azione)."""
        fatti = se_stesso.storia.annulla(gruppo, se_stesso.ripristina_file, se_stesso.elimina_percorso)
        se_stesso.pannello_progetto.aggiorna()
        se_stesso.chat.aggiorna_annulla()
        ritorna fatti

    definisci annulla_ultima_ai(se_stesso):
        se non se_stesso.storia:
            se_stesso.info("Apri un progetto: non ci sono modifiche dell'assistente da annullare.")
            ritorna
        gruppo = se_stesso.storia.ultimo_annullabile()
        se non gruppo:
            se_stesso.info("Nessuna modifica dell'assistente da annullare.")
            ritorna
        elenco = "\n".join("  " + r per r in se_stesso.storia.descrivi(gruppo))
        se non messagebox.askyesno("Annulla la modifica dell'assistente",
                                   f"Richiesta: «{gruppo.get('descrizione') o gruppo['id']}»\n({gruppo['quando']})\n\n{elenco}\n\n"
                                   "I file torneranno come erano prima (i file creati verranno tolti). Procedo?", parent=se_stesso.radice):
            ritorna
        fatti = se_stesso.annulla_gruppo_ai(gruppo)
        se_stesso.info(f"Annullata la modifica dell'assistente: {lunghezza_di(fatti)} file.")

    definisci cronologia_ai(se_stesso):
        se non se_stesso.storia:
            se_stesso.info("Apri un progetto per vedere la cronologia delle modifiche dell'assistente.")
            ritorna
        dialoghi.DialogoCronologiaAI(se_stesso.radice, se_stesso.colori, se_stesso.storia, se_stesso.annulla_gruppo_ai)

    definisci statistiche_ai(se_stesso):
        """Riepilogo del registro dell'assistente: token, codice valido al primo tentativo, esecuzioni."""
        se non se_stesso.progetto:
            se_stesso.info("Apri un progetto per vedere le statistiche dell'assistente.")
            ritorna
        percorso = os.path.join(se_stesso.progetto.cartella, ".rad", "ai_registro.jsonl")
        eventi = registro_ai.leggi_registro(percorso)
        messagebox.showinfo("Statistiche dell'assistente", registro_ai.testo_riepilogo(eventi, se_stesso.config_.ottieni("ai.prezzi", {})) + f"\n\nRegistro: {percorso}",
                            parent=se_stesso.radice)

    # ================================================================== interfaccia per l'assistente AI
    definisci stato_ide(se_stesso):
        schede = []
        per p, w in se_stesso.schede.items():
            schede.append({"file": se_stesso.progetto.relativo(p) se se_stesso.progetto e se_stesso.progetto.contiene(p) altrimenti p,
                           "modificato": bool(getattr(w, "modificato", Falso)), "tipo": tipo_di(w).__name__})
        w = se_stesso._scheda_corrente()
        p = se_stesso._percorso_di(w)
        d = {"progetto": se_stesso.progetto.nome se se_stesso.progetto altrimenti Nessuno,
             "cartella": se_stesso.progetto.cartella se se_stesso.progetto altrimenti Nessuno,
             "file_principale": se_stesso.progetto.principale se se_stesso.progetto altrimenti Nessuno,
             "finestre": se_stesso.progetto.forms() se se_stesso.progetto altrimenti [],
             "schede_aperte": schede,
             "file_attivo": se_stesso.progetto.relativo(p) se (p e se_stesso.progetto e se_stesso.progetto.contiene(p)) altrimenti p,
             "programma_in_esecuzione": se_stesso.console.in_esecuzione}
        se isinstance(w, Editor):
            d["riga_cursore"] = w.riga_cursore()
            trovata = w.selezione_con_righe()
            se trovata:
                d["selezione"] = trovata[0][:4000]
                d["selezione_righe"] = f"{trovata[1]}-{trovata[2]}"
        d["console_ultime_righe"] = se_stesso.console.t.get("1.0", "end")[-3000:]
        ritorna d

    definisci contesto_corto(se_stesso):
        w = se_stesso._scheda_corrente()
        p = se_stesso._percorso_di(w)
        se non p:
            ritorna ""
        rel = se_stesso.progetto.relativo(p) se (se_stesso.progetto e se_stesso.progetto.contiene(p)) altrimenti p
        righe = [f"File attivo: {rel}"]
        se isinstance(w, Editor):
            righe.append(f"Riga del cursore: {w.riga_cursore()}")
            trovata = w.selezione_con_righe()
            se trovata:
                righe.append(f"Selezione (righe {trovata[1]}-{trovata[2]}), è il «codice selezionato» di cui parla l'utente:\n" + trovata[0][:3500])
            altrimenti:
                righe.append("Selezione: nessuna (se l'utente parla di «codice selezionato» chiedigli di selezionarlo nell'editor)")
        ritorna "\n".join(righe)

    definisci contenuto_aperto(se_stesso, assoluto):
        w = se_stesso.schede.get(os.path.abspath(assoluto))
        se isinstance(w, Editor):
            ritorna w.contenuto()
        se isinstance(w, (Progettista, EditorMattonelle)):
            ritorna w.contenuto()
        ritorna Nessuno

    definisci scrivi_file(se_stesso, assoluto, contenuto):
        assoluto = os.path.abspath(assoluto)
        os.makedirs(os.path.dirname(assoluto), exist_ok=Vero)
        con open(assoluto, "w", encoding="utf-8", newline="\n") come f:
            f.write(contenuto)
        w = se_stesso.schede.get(assoluto)
        se isinstance(w, Editor):
            pos = w.t.index("insert")
            w.imposta_contenuto(contenuto)
            w.t.mark_set("insert", pos)
            se_stesso._programma_sintassi(w, subito=Vero)
        altrimenti_se w è Nessuno:
            se_stesso.apri_file(assoluto)
        altrimenti_se hasattr(w, "ricarica_se_cambiato_su_disco"):
            w.ricarica_se_cambiato_su_disco()
        se_stesso.pannello_progetto.aggiorna()

    definisci elimina_percorso(se_stesso, assoluto):
        rel = se_stesso.progetto.relativo(assoluto)
        se_stesso.progetto.cancella(rel)
        se_stesso.file_eliminato(assoluto)
        se_stesso.pannello_progetto.aggiorna()

    definisci chiedi_modifica(se_stesso, percorso, vecchio, nuovo, spiegazione=""):
        """Finestra «prima / dopo» per una modifica proposta dall'assistente. Ritorna True se l'utente la accetta."""
        ritorna bool(dialoghi.DialogoModifica(se_stesso.radice, se_stesso.colori, percorso, vecchio, nuovo, spiegazione).mostra())

    definisci chiedi_conferma(se_stesso, titolo, dettaglio):
        ritorna messagebox.askyesno(titolo, dettaglio, parent=se_stesso.radice, icon="question")

    definisci mostra_in_console(se_stesso, nome, r):
        se_stesso.console.pulisci()
        se_stesso.console.scrivi(f"🤖 eseguito dall'assistente: {nome}\n", "info")
        se r["uscita"]:
            se_stesso.console.scrivi(r["uscita"], "out")
        se r["errori"]:
            se_stesso.console.scrivi(r["errori"], "err")
        se_stesso.console.scrivi(f"\n{'✔' se r['codice'] == 0 altrimenti '✖'} codice {r['codice']} ({r['secondi']} s)\n",
                                 "ok" se r["codice"] == 0 altrimenti "err")

    definisci anteprima_png(se_stesso, nome=""):
        """I byte PNG di una schermata del progettista di una finestra (quello aperto ora se `nome` è vuoto). Solo per l'assistente AI."""
        progettisti = se_stesso._progettisti()
        scelto = Nessuno
        se nome:
            scelto = prossimo_elemento((w per w in progettisti se w.form.nome.lower() == nome.lower()), Nessuno)
        altrimenti_se se_stesso._scheda_corrente() in progettisti:
            scelto = se_stesso._scheda_corrente()
        altrimenti_se progettisti:
            scelto = progettisti[0]
        se scelto è Nessuno:
            solleva ErroreDiValore("Non c'è nessun progettista aperto" + (f" per la finestra «{nome}»" se nome altrimenti "") + ": aprilo con apri_file.")
        se_stesso._seleziona(scelto)
        se_stesso.radice.update()
        ritorna scelto.cattura_png()

    definisci json_form(se_stesso, nome):
        per w in se_stesso._progettisti():
            se w.form.nome.lower() == nome.lower():
                ritorna w.form.a_json()
        p = form_modello.percorsi_form(se_stesso.progetto.cartella, nome)["json"]
        # cerca anche nelle sottocartelle
        se non os.path.exists(p):
            per rel in se_stesso.progetto.forms():
                se os.path.basename(rel).lower() == nome.lower() + ".form.json":
                    p = se_stesso.progetto.assoluto(rel)
        se non os.path.exists(p):
            solleva ErroreDiValore(f"finestra non trovata: {nome}")
        ritorna open(p, encoding="utf-8").read()

    definisci imposta_form(se_stesso, f):
        """Applica un form dell'AI: aggiorna il progettista aperto (o ne apre uno) e genera i file."""
        cartella = se_stesso.progetto.cartella
        esistente = Nessuno
        per w in se_stesso._progettisti():
            se w.form.nome.lower() == f.nome.lower():
                esistente = w
        se esistente è Nessuno:
            per rel in se_stesso.progetto.forms():
                se os.path.basename(rel).lower() == f.nome.lower() + ".form.json":
                    cartella = os.path.dirname(se_stesso.progetto.assoluto(rel))
        altrimenti:
            cartella = esistente.cartella
        scritti = form_modello.salva_form(f, cartella)
        se esistente:
            esistente.form = f
            esistente.cronologia = [f.a_json()]
            esistente.indice_cronologia = 0
            esistente.modificato = Falso
            esistente.ricostruisci()
            esistente.seleziona([])
            se_stesso.scheda_modificata(esistente)
        altrimenti:
            se_stesso.apri_file(form_modello.percorsi_form(cartella, f.nome)["json"])
        per p in scritti:
            w = se_stesso.schede.get(os.path.abspath(p))
            se isinstance(w, Editor):
                w.ricarica_se_cambiato_su_disco()
        se_stesso.pannello_progetto.aggiorna()
        ritorna [se_stesso.progetto.relativo(p) per p in scritti]

    definisci json_mattonelle(se_stesso, nome):
        per w in se_stesso.schede.values():
            se isinstance(w, EditorMattonelle) e w.nome_base().lower() == nome.lower():
                ritorna w.contenuto()
        per rel in se_stesso.progetto.tutti_i_file():
            se os.path.basename(rel).lower() == nome.lower() + ".mattonelle.json":
                ritorna open(se_stesso.progetto.assoluto(rel), encoding="utf-8").read()
        solleva ErroreDiValore(f"programma a mattonelle non trovato: {nome}")

    definisci imposta_mattonelle(se_stesso, nome, dizionario):
        """Sostituisce/crea un programma a mattonelle (dall'AI), lo salva e genera il codice. Ritorna (relativi, avvisi)."""
        prog = mattonelle_modello.Programma.da_dizionario(dizionario)
        prog.nome = nome
        editor = Nessuno
        cartella = se_stesso.progetto.cartella
        per w in se_stesso.schede.values():
            se isinstance(w, EditorMattonelle) e w.nome_base().lower() == nome.lower():
                editor = w
        se editor è Nessuno:
            per rel in se_stesso.progetto.tutti_i_file():
                se os.path.basename(rel).lower() == nome.lower() + ".mattonelle.json":
                    cartella = os.path.dirname(se_stesso.progetto.assoluto(rel))
        altrimenti:
            cartella = editor.cartella
        se editor:
            editor.imposta_programma(prog)
            editor.salva()
            percorsi = [editor.percorso, editor.percorso_codice()]
            _, avvisi = mattonelle_modello.genera_codice(prog)
        altrimenti:
            percorsi, avvisi = mattonelle_modello.salva_programma(prog, cartella)
            se_stesso.apri_file(percorsi[0])
        per p in percorsi:
            w = se_stesso.schede.get(os.path.abspath(p))
            se isinstance(w, Editor):
                w.ricarica_se_cambiato_su_disco()
        se_stesso.pannello_progetto.aggiorna()
        ritorna [se_stesso.progetto.relativo(p) per p in percorsi], avvisi

    definisci inserisci_nell_editor(se_stesso, codice):
        w = se_stesso._scheda_corrente()
        se isinstance(w, Editor):
            se w.t.tag_ranges("sel"):
                w.t.delete("sel.first", "sel.last")
            w.inserisci_a_cursore(codice)
            w.t.focus_set()
        altrimenti:
            se_stesso.info("Apri prima un file di testo nell'editor.")

    definisci codice_in_nuovo_file(se_stesso, codice):
        se non se_stesso.progetto:
            ritorna
        nome = simpledialog.askstring("Nuovo file", "Nome del file (es. nuovo.pit):", parent=se_stesso.radice)
        se nome:
            p = se_stesso.progetto.crea_file(nome, codice + "\n")
            se_stesso.pannello_progetto.aggiorna()
            se_stesso.apri_file(p)

    definisci chat_finita(se_stesso):
        se_stesso.pannello_progetto.aggiorna()
        per w in tipo_lista(se_stesso.schede.values()):
            se hasattr(w, "ricarica_se_cambiato_su_disco"):
                w.ricarica_se_cambiato_su_disco()

    definisci salva_stato_finestra(se_stesso):
        cfg = se_stesso.config_
        cfg.imposta("finestra.geometria", se_stesso.radice.geometry(), notifica=Falso)
        prova:
            panes = se_stesso.corpo.panes()
            se tipo_testo(se_stesso.sinistra) in [tipo_testo(x) per x in panes]:
                cfg.imposta("finestra.pannello_sinistro", se_stesso.sinistra.winfo_width(), notifica=Falso)
            se tipo_testo(se_stesso.chat) in [tipo_testo(x) per x in panes]:
                cfg.imposta("finestra.pannello_destro", se_stesso.chat.winfo_width(), notifica=Falso)
            cfg.imposta("finestra.chat_visibile", tipo_testo(se_stesso.chat) in [tipo_testo(x) per x in panes], notifica=Falso)
            cfg.imposta("finestra.progetti_visibile", tipo_testo(se_stesso.sinistra) in [tipo_testo(x) per x in panes], notifica=Falso)
            alte = se_stesso.centro.panes()
            cfg.imposta("finestra.console_visibile", tipo_testo(se_stesso.console) in [tipo_testo(x) per x in alte], notifica=Falso)
            se tipo_testo(se_stesso.console) in [tipo_testo(x) per x in alte]:
                cfg.imposta("finestra.console_altezza", se_stesso.console.winfo_height(), notifica=Falso)
        eccetto tk.TclError:
            passa
        cfg.salva()

    definisci esci(se_stesso):
        se se_stesso.console.in_esecuzione:
            se messagebox.askyesno("Esci", "Un programma è ancora in esecuzione. Terminarlo e uscire?", parent=se_stesso.radice):
                se_stesso.console.ferma()
            altrimenti:
                ritorna
        se non se_stesso.chiudi_tutte_le_schede():
            ritorna
        se_stesso.recupero.scarta_tutto()           # uscita normale: niente da recuperare
        se_stesso.chat.salva_cronologia()
        se_stesso.salva_stato_finestra()
        se_stesso.radice.destroy()


definisci not_pit(percorso):
    ritorna non percorso.lower().endswith(".pit")


definisci VERSIONE_INTERPRETE():
    importa sys
    ritorna ".".join(tipo_testo(x) per x in sys.version_info[:3])
