"""Debugger di PitStudio: punti di arresto, esecuzione passo-passo, variabili, pila delle chiamate ed espressioni osservate.

Il programma gira in un processo separato sotto rad/debug_runner.py; gli eventi arrivano dalla console (vedi Console.gestore_debug)
e i comandi tornano sullo stesso canale di ingresso, prefissati da un carattere di controllo.
"""
importa json
importa os
importa tempfile
importa tkinter come tk
da rad importa stile
da rad.memoria_vista importa VistaMemoria
da tkinter importa ttk
da rad.piattaforma importa FONT_MONO, FONT_UI, semi

RUNNER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "debug_runner.py")
INIZIO_EVENTO = chr(1) + "DBG"
FINE_EVENTO = chr(2)
PREFISSO_COMANDO = chr(1) + "CMD "

COMANDI = [("continua", "▶", "Continua", "F5"), ("passo", "⤼", "Passo", "F10"), ("entra", "↧", "Entra", "F11"),
           ("esci", "↥", "Esci", "Maiusc+F11"), ("ferma", "■", "Ferma", "Maiusc+F5")]


classe FinestraValore(tk.Toplevel):
    """Il valore intero di una variabile o di una espressione osservata, in una finestra che resta aperta e si aggiorna a ogni passo."""

    definisci __inizializza__(se_stesso, genitore, colori, sessione):
        tk.Toplevel.__init__(se_stesso, genitore)
        se_stesso.sessione = sessione
        se_stesso.espressione = ""
        se_stesso.title("Valore")
        se_stesso.geometry("620x420")
        se_stesso.minsize(320, 200)
        se_stesso.configure(background=colori["pannello"])
        se_stesso.rowconfigure(1, weight=1)
        se_stesso.columnconfigure(0, weight=1)
        se_stesso.info = tk.Label(se_stesso, anchor="w", justify="left", background=colori["pannello"], foreground=colori["tenue"], font=(FONT_UI, 9))
        se_stesso.info.grid(row=0, column=0, sticky="we", padx=10, pady=(8, 2))
        cornice = tk.Frame(se_stesso, background=colori["pannello"])
        cornice.grid(row=1, column=0, sticky="nsew", padx=10, pady=2)
        cornice.rowconfigure(0, weight=1)
        cornice.columnconfigure(0, weight=1)
        se_stesso.t = tk.Text(cornice, wrap="none", font=(FONT_MONO, 10), background=colori["campo"], foreground=colori["primo_piano"],
                              insertbackground=colori["cursore"], relief="flat", highlightthickness=1, highlightbackground=colori["bordo"], padx=6, pady=4)
        sy = ttk.Scrollbar(cornice, orient="vertical", command=se_stesso.t.yview)
        sx = ttk.Scrollbar(cornice, orient="horizontal", command=se_stesso.t.xview)
        se_stesso.t.configure(yscrollcommand=sy.set, xscrollcommand=sx.set)
        se_stesso.t.grid(row=0, column=0, sticky="nsew")
        sy.grid(row=0, column=1, sticky="ns")
        sx.grid(row=1, column=0, sticky="we")
        barra = tk.Frame(se_stesso, background=colori["pannello"])
        barra.grid(row=2, column=0, sticky="we", padx=10, pady=(4, 8))
        se_stesso.var_a_capo = tk.BooleanVar(value=Falso)
        tk.Checkbutton(barra, text="A capo automatico", variable=se_stesso.var_a_capo, command=se_stesso._a_capo, background=colori["pannello"],
                       foreground=colori["primo_piano"], selectcolor=colori["casella"], activebackground=colori["pannello"]).pack(side="left")
        tk.Button(barra, text="Chiudi", command=se_stesso.destroy, relief="flat", background=colori["pulsante"], foreground=colori["primo_piano"], padx=12).pack(side="right")
        tk.Button(barra, text="Copia tutto", command=se_stesso.copia, relief="flat", background=colori["pulsante"], foreground=colori["primo_piano"], padx=12).pack(side="right", padx=6)
        se_stesso.bind("<Escape>", lambda evento: se_stesso.destroy())
        se_stesso.protocol("WM_DELETE_WINDOW", se_stesso.destroy)

    definisci _a_capo(se_stesso):
        se_stesso.t.configure(wrap="word" se se_stesso.var_a_capo.get() altrimenti "none")

    definisci copia(se_stesso):
        se_stesso.clipboard_clear()
        se_stesso.clipboard_append(se_stesso.t.get("1.0", "end-1c"))

    definisci mostra(se_stesso, ev):
        """Mostra la risposta del debugger («valore»): il testo intero, il tipo e la lunghezza."""
        se_stesso.espressione = ev.get("espressione", "")
        se_stesso.title(f"Valore di {se_stesso.espressione}")
        se_stesso.t.configure(state="normal")
        se_stesso.t.delete("1.0", "end")
        se ev.get("errore"):
            se_stesso.info.configure(text="Non si può calcolare adesso")
            se_stesso.t.insert("1.0", "⚠ " + ev["errore"])
        altrimenti:
            lunghezza = ev.get("lunghezza")
            se_stesso.info.configure(text=f"{se_stesso.espressione}   ·   tipo: {ev.get('tipo')}" + (f"   ·   {lunghezza} elementi" se lunghezza è non Nessuno altrimenti ""))
            se_stesso.t.insert("1.0", ev.get("testo", ""))
        se_stesso.t.configure(state="disabled")


classe PannelloDebug(tk.Frame):
    """Barra dei comandi + variabili, pila e espressioni osservate."""

    definisci __inizializza__(se_stesso, genitore, sessione):
        tk.Frame.__init__(se_stesso, genitore)
        se_stesso.sessione = sessione
        se_stesso.barra = tk.Frame(se_stesso)
        se_stesso.barra.pack(fill="x")
        se_stesso.titolo = tk.Label(se_stesso.barra, text="🐞 Debug", font=semi(9))
        se_stesso.titolo.pack(side="left", padx=(8, 12), pady=3)
        se_stesso.pulsanti = {}
        per nome, simbolo, etichetta, tasto in COMANDI:
            b = tk.Button(se_stesso.barra, text=f"{simbolo} {etichetta}", relief="flat", padx=8, pady=1,
                          command=lambda n=nome: sessione.comando(n))
            b.pack(side="left", padx=1, pady=2)
            se_stesso.pulsanti[nome] = b
            stile.suggerisci(b, f"{etichetta} ({tasto})")
        se_stesso.stato = tk.Label(se_stesso.barra, text="", anchor="e", font=(FONT_UI, 9))
        se_stesso.stato.pack(side="right", padx=8)
        se_stesso.var_memoria = tk.BooleanVar(value=Falso)
        se_stesso.pulsante_memoria = tk.Checkbutton(se_stesso.barra, text="🧠 Memoria", variable=se_stesso.var_memoria, indicatoron=Falso, relief="flat", padx=8, pady=1,
                                                    command=se_stesso.commuta_memoria)
        se_stesso.pulsante_memoria.pack(side="right", padx=4, pady=2)
        stile.suggerisci(se_stesso.pulsante_memoria, "Mostra le variabili come scatole con le frecce verso gli oggetti: si vede quando due nomi sono lo stesso oggetto")
        se_stesso.ultima_memoria = Nessuno
        # come si calcola la riga in cui il programma è fermo (es.  a + b * 2  →  3 + 8  →  11)
        se_stesso.valutazione = tk.Label(se_stesso, text="", anchor="w", justify="left", font=(FONT_MONO, 10))
        se_stesso.corpo = tk.PanedWindow(se_stesso, orient="horizontal", sashwidth=4, borderwidth=0)
        se_stesso.corpo.pack(fill="both", expand=Vero)

        a = tk.Frame(se_stesso.corpo)
        se_stesso.variabili = ttk.Treeview(a, columns=("nome", "valore", "tipo"), show="headings", height=6, selectmode="browse")
        se_stesso.variabili.heading("nome", text="Variabile")
        se_stesso.variabili.heading("valore", text="Valore")
        se_stesso.variabili.heading("tipo", text="Tipo")
        se_stesso.variabili.column("nome", width=90, minwidth=60, stretch=Falso)
        se_stesso.variabili.column("valore", width=150, minwidth=60, stretch=Vero)
        se_stesso.variabili.column("tipo", width=60, minwidth=40, stretch=Falso)
        se_stesso.variabili.tag_configure("cambiata", foreground="#e0a030")
        se_stesso.variabili.bind("<ButtonRelease-1>", lambda evento: se_stesso._clic_valore(se_stesso.variabili, evento, "#2", Falso))
        sb = ttk.Scrollbar(a, orient="vertical", command=se_stesso.variabili.yview)
        se_stesso.variabili.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        se_stesso.variabili.pack(fill="both", expand=Vero)
        se_stesso.cornice_variabili = a
        se_stesso.vista_memoria = VistaMemoria(a)
        se_stesso.corpo.add(a, minsize=220, stretch="always", width=330)

        b = tk.Frame(se_stesso.corpo)
        tk.Label(b, text="Pila delle chiamate", anchor="w", font=(FONT_UI, 9)).pack(fill="x", padx=4)
        se_stesso.pila = tk.Listbox(b, height=5, activestyle="none", exportselection=Falso, borderwidth=0, highlightthickness=0, font=(FONT_UI, 9))
        se_stesso.pila.pack(fill="both", expand=Vero)
        se_stesso.pila.bind("<<ListboxSelect>>", se_stesso._scelta_pila)
        se_stesso._etichetta_pila = b.winfo_children()[0]
        se_stesso.corpo.add(b, minsize=140, stretch="never", width=200)

        c = tk.Frame(se_stesso.corpo)
        se_stesso._etichetta_osserva = tk.Label(c, text="Osservate · clic sul valore = vedi tutto · doppio clic 👁 = ferma se cambia", anchor="w", font=(FONT_UI, 9))
        se_stesso._etichetta_osserva.pack(fill="x", padx=4)
        se_stesso.var_osserva = tk.StringVar()
        se_stesso.campo = tk.Entry(c, textvariable=se_stesso.var_osserva, relief="flat", font=(FONT_UI, 9))
        se_stesso.campo.pack(fill="x", padx=4, ipady=2)
        se_stesso.campo.bind("<Return>", se_stesso._aggiungi_osservata)
        se_stesso.osservate = ttk.Treeview(c, columns=("valore", "ferma"), show="tree headings", height=4, selectmode="browse")
        se_stesso.osservate.heading("#0", text="Espressione")
        se_stesso.osservate.heading("valore", text="Valore")
        se_stesso.osservate.heading("ferma", text="👁")
        se_stesso.osservate.column("#0", width=110)
        se_stesso.osservate.column("valore", width=110)
        se_stesso.osservate.column("ferma", width=30, minwidth=30, stretch=Falso, anchor="center")
        se_stesso.osservate.bind("<Double-Button-1>", se_stesso._doppio_clic_osservata)
        se_stesso.osservate.bind("<ButtonRelease-1>", lambda evento: se_stesso._clic_valore(se_stesso.osservate, evento, "#1", Vero))
        se_stesso._clic_in_attesa = Nessuno
        se_stesso._ignora_rilascio = Falso
        se_stesso.osservate.pack(fill="both", expand=Vero, padx=4, pady=(2, 0))
        se_stesso.osservate.bind("<Delete>", se_stesso._rimuovi_osservata)
        se_stesso.corpo.add(c, minsize=180, stretch="never", width=260)
        se_stesso._frame_pila = []
        se_stesso.attiva_comandi(Falso)

    definisci commuta_memoria(se_stesso):
        """Passa dalla tabella delle variabili al disegno della memoria (e viceversa)."""
        se se_stesso.var_memoria.get():
            se_stesso.variabili.pack_forget()
            se_stesso.vista_memoria.pack(fill="both", expand=Vero)
            se_stesso.vista_memoria.mostra(se_stesso.ultima_memoria)
        altrimenti:
            se_stesso.vista_memoria.pack_forget()
            se_stesso.variabili.pack(fill="both", expand=Vero)

    definisci attiva_comandi(se_stesso, fermo):
        per nome, b in se_stesso.pulsanti.items():
            b.configure(state="normal" se (fermo o nome == "ferma") altrimenti "disabled")
        se_stesso.stato.configure(text="fermo" se fermo altrimenti "in esecuzione…")

    definisci mostra_stato(se_stesso, ev, mantieni=Nessuno):
        """Mostra variabili, pila ed espressioni. mantieni: numero della riga della pila scelta dall'utente (la tiene selezionata)."""
        se_stesso.attiva_comandi(Vero)
        se ev.get("memoria") è non Nessuno:
            se_stesso.ultima_memoria = ev["memoria"]
            se se_stesso.var_memoria.get():
                se_stesso.vista_memoria.mostra(se_stesso.ultima_memoria)
        se_stesso.variabili.delete(*se_stesso.variabili.get_children())
        per v in ev.get("variabili", []):
            se_stesso.variabili.insert("", "end", values=(v["nome"], v["valore"], v["tipo"]), tags=("cambiata",) se v.get("cambiata") altrimenti ())
        se_stesso.mostra_valutazione(ev.get("valutazione", []))
        se_stesso.pila.delete(0, "end")
        se_stesso._frame_pila = ev.get("pila", [])
        per f in se_stesso._frame_pila:
            se_stesso.pila.insert("end", f"{f['funzione']}   ·   {os.path.basename(f['file'])}:{f['riga']}")
        se mantieni è non Nessuno e mantieni < lunghezza_di(se_stesso._frame_pila):
            se_stesso.pila.selection_set(mantieni)
        se_stesso.aggiorna_osservate(ev.get("osservate", []))
        se_stesso.stato.configure(text=f"fermo alla riga {ev.get('riga')}" se mantieni è Nessuno altrimenti f"{ev.get('funzione')}, riga {ev.get('riga')}")
        se ev.get("avviso"):
            se_stesso.stato.configure(text="⚠ " + ev["avviso"])

    definisci mostra_valutazione(se_stesso, passi):
        """La riga che sta per essere eseguita, ridotta passo dopo passo al suo valore."""
        se passi:
            se_stesso.valutazione.configure(text="Riga " + "  →  ".join(passi))
            se non se_stesso.valutazione.winfo_manager():
                se_stesso.valutazione.pack(fill="x", padx=8, pady=(0, 2), before=se_stesso.corpo)
        altrimenti:
            se_stesso.valutazione.pack_forget()

    definisci aggiorna_osservate(se_stesso, osservate):
        se_stesso.osservate.delete(*se_stesso.osservate.get_children())
        per elemento in osservate:
            se_stesso.osservate.insert("", "end", text=elemento["espressione"], values=(elemento["valore"], "👁" se elemento["espressione"] in se_stesso.sessione.ferma_su altrimenti ""),
                                       tags=("cambiata",) se elemento.get("cambiata") altrimenti ())

    definisci _clic_valore(se_stesso, albero, evento, colonna, e_osservata):
        """Un clic sul valore di una variabile o di una espressione osservata apre la finestra con il valore intero. Si aspetta un attimo:
        se è l'inizio di un doppio clic (👁) la finestra non si apre."""
        se e_osservata e se_stesso._ignora_rilascio:          # è il rilascio che chiude un doppio clic: non è un clic sul valore
            se_stesso._ignora_rilascio = Falso
            ritorna
        riga = albero.identify_row(evento.y)
        se non riga o albero.identify_column(evento.x) != colonna:
            ritorna
        espressione = albero.item(riga, "text") se e_osservata altrimenti albero.item(riga, "values")[0]
        se se_stesso._clic_in_attesa è non Nessuno:
            se_stesso.after_cancel(se_stesso._clic_in_attesa)
        se_stesso._clic_in_attesa = se_stesso.after(280, lambda: se_stesso._apri_valore(espressione))

    definisci _doppio_clic_osservata(se_stesso, evento=Nessuno):
        se se_stesso._clic_in_attesa è non Nessuno:
            se_stesso.after_cancel(se_stesso._clic_in_attesa)
            se_stesso._clic_in_attesa = Nessuno
        se_stesso._ignora_rilascio = Vero
        se_stesso._commuta_ferma(evento)

    definisci _apri_valore(se_stesso, espressione):
        se_stesso._clic_in_attesa = Nessuno
        se_stesso.sessione.chiedi_valore(espressione, Vero)

    definisci _commuta_ferma(se_stesso, evento=Nessuno):
        """Doppio clic su una espressione osservata: ferma il programma quando il suo valore cambia (o toglie la richiesta)."""
        riga = se_stesso.osservate.identify_row(evento.y) se evento è non Nessuno altrimenti ""
        se riga:
            se_stesso.sessione.commuta_ferma(se_stesso.osservate.item(riga, "text"))

    definisci _scelta_pila(se_stesso, evento=Nessuno):
        sel = se_stesso.pila.curselection()
        se sel e sel[0] < lunghezza_di(se_stesso._frame_pila):
            f = se_stesso._frame_pila[sel[0]]
            se_stesso.sessione.mostra_posizione(f["file"], f["riga"])
            se_stesso.sessione.scegli_frame(sel[0])

    definisci _aggiungi_osservata(se_stesso, evento=Nessuno):
        espressione = se_stesso.var_osserva.get().strip()
        se espressione:
            se_stesso.sessione.aggiungi_osservata(espressione)
            se_stesso.var_osserva.set("")

    definisci _rimuovi_osservata(se_stesso, evento=Nessuno):
        sel = se_stesso.osservate.selection()
        se sel:
            se_stesso.sessione.rimuovi_osservata(se_stesso.osservate.item(sel[0], "text"))

    definisci applica_colori(se_stesso, c):
        se_stesso.configure(background=c["pannello"])
        per w in (se_stesso.barra, se_stesso.corpo):
            w.configure(background=c["pannello"])
        per w in (se_stesso.titolo, se_stesso.stato, se_stesso._etichetta_pila, se_stesso._etichetta_osserva):
            w.configure(background=c["pannello"], foreground=c["primo_piano"] se w è se_stesso.titolo altrimenti c["tenue"])
        per b in se_stesso.pulsanti.values():
            b.configure(background=c["pulsante"], foreground=c["primo_piano"], activebackground=c["pulsante_attivo"],
                        disabledforeground=c["tenue"])
        se_stesso.valutazione.configure(background=c["pannello"], foreground=c["accento"])
        se_stesso.vista_memoria.applica_colori(c)
        se_stesso.pulsante_memoria.configure(background=c["pulsante"], foreground=c["primo_piano"], activebackground=c["pulsante_attivo"], selectcolor=c["accento"])
        se_stesso.osservate.tag_configure("cambiata", foreground="#e0a030")
        se_stesso.pila.configure(background=c["sfondo"], foreground=c["primo_piano"], selectbackground=c["accento"])
        se_stesso.campo.configure(background=c["sfondo"], foreground=c["primo_piano"], insertbackground=c["primo_piano"])
        per f in se_stesso.corpo.winfo_children():
            f.configure(background=c["pannello"])


classe SessioneDebug:
    """Una sessione di debug: avvia il programma sotto il debugger e coordina editor, console e pannello."""

    definisci __inizializza__(se_stesso, app):
        se_stesso.app = app
        se_stesso.pannello = Nessuno
        se_stesso.attiva = Falso          # il programma è in corso sotto il debugger
        se_stesso.fermo = Falso           # ed è fermo, in attesa di un comando
        se_stesso.osservate = []
        se_stesso.ferma_su = set()        # espressioni osservate con «ferma quando cambia»
        se_stesso.file_fermo = Nessuno
        se_stesso.finestra_valore = Nessuno           # la finestra «Valore di …», se aperta
        se_stesso._frame_scelto = 0

    # ------------------------------------------------------------ avvio
    definisci avvia(se_stesso, percorso, inizio=Falso):
        app = se_stesso.app
        se app.console.in_esecuzione:
            app.info("Un programma è già in esecuzione: fermalo prima.")
            ritorna Falso
        se app.config_.ottieni("esecuzione.salva_prima", Vero):
            app.salva_tutto()
        file_punti = os.path.join(tempfile.mkdtemp(prefix="pitstudio_dbg_"), "punti.json")
        con open(file_punti, "w", encoding="utf-8") come f:
            json.dump(se_stesso.punti_arresto(), f)
        argomenti = [app.config_.interprete(), "-u", RUNNER, percorso, "--punti", file_punti]
        se inizio:
            argomenti.append("--inizio")
        extra = (app.config_.ottieni("esecuzione.argomenti", "") o "").split()
        argomenti += extra
        cartella = app.progetto.cartella se app.progetto e app.progetto.contiene(percorso) altrimenti os.path.dirname(percorso)
        per w in app.schede.values():
            se hasattr(w, "cancella_errori"):
                w.cancella_errori()
        se_stesso._mostra_pannello()
        app.console.gestore_debug = se_stesso.gestisci_evento
        se non app.console.esegui(argomenti, cartella, f"🐞 {os.path.basename(percorso)}  (debug)"):
            se_stesso._nascondi_pannello()
            app.console.gestore_debug = Nessuno
            ritorna Falso
        se_stesso.attiva = Vero
        se_stesso.fermo = Falso
        se_stesso._osservate_da_inviare = Vero       # le espressioni osservate nelle sessioni precedenti si mandano alla prima sosta
        se_stesso.pannello.attiva_comandi(Falso)
        ritorna Vero

    definisci punti_arresto(se_stesso):
        """{percorso: [riga | [riga, condizione, dopo, messaggio]]} di tutti i punti di arresto (anche dei file non aperti)."""
        risultato = {}
        per p, righe in se_stesso.app.punti_arresto.items():
            se non righe:
                continua
            dettagli = se_stesso.app.dettagli_punti.get(p, {})
            voci = []
            per riga in sorted(righe):
                d = dettagli.get(riga)
                se d e (d.get("se") o d.get("dopo") o d.get("messaggio")):
                    voci.append([riga, d.get("se", ""), d.get("dopo", 0), d.get("messaggio", "")])
                altrimenti:
                    voci.append(riga)
            risultato[p] = voci
        ritorna risultato

    # ------------------------------------------------------------ eventi dal programma
    definisci gestisci_evento(se_stesso, ev):
        tipo_ = ev.get("evento")
        se tipo_ == "fermo":
            se_stesso.fermo = Vero
            se_stesso._frame_scelto = 0
            se_stesso.file_fermo = ev["file"]
            se_stesso.mostra_posizione(ev["file"], ev["riga"], segna=Vero)
            se se_stesso.pannello:
                se_stesso.pannello.mostra_stato(ev)
            se se_stesso._finestra_valore_aperta():
                se_stesso.chiedi_valore(se_stesso.finestra_valore.espressione)          # la finestra aperta si aggiorna a ogni passo
            se getattr(se_stesso, "_osservate_da_inviare", Falso):
                se_stesso._osservate_da_inviare = Falso
                se se_stesso.osservate:
                    se_stesso._invia_osservate()
        altrimenti_se tipo_ == "frame":
            se se_stesso.pannello:
                se_stesso.pannello.mostra_stato(ev, mantieni=se_stesso._frame_scelto)
        altrimenti_se tipo_ == "valore":
            se_stesso.mostra_valore(ev)
        altrimenti_se tipo_ in ("fine", "fine_processo"):
            se_stesso.termina()

    definisci mostra_posizione(se_stesso, percorso, riga, segna=Falso):
        app = se_stesso.app
        se_stesso._cancella_marcatore()
        se os.path.exists(percorso):
            w = app.apri_file(percorso, riga)
            se hasattr(w, "imposta_riga_debug"):
                w.imposta_riga_debug(riga)
                se_stesso._editor_marcato = w

    definisci _cancella_marcatore(se_stesso):
        w = getattr(se_stesso, "_editor_marcato", Nessuno)
        se w è non Nessuno:
            prova:
                w.imposta_riga_debug(Nessuno)
            eccetto tk.TclError:
                passa
        se_stesso._editor_marcato = Nessuno

    definisci _finestra_valore_aperta(se_stesso):
        ritorna se_stesso.finestra_valore è non Nessuno e se_stesso.finestra_valore.winfo_exists() e bool(se_stesso.finestra_valore.espressione)

    definisci chiedi_valore(se_stesso, espressione, apri=Falso):
        """Chiede al debugger il valore intero (se il programma è fermo). La risposta arriva come evento «valore» e apre/aggiorna la finestra."""
        se non (se_stesso.attiva e se_stesso.fermo) o non espressione:
            ritorna Falso
        se apri e non (se_stesso.finestra_valore è non Nessuno e se_stesso.finestra_valore.winfo_exists()):
            se_stesso.finestra_valore = FinestraValore(se_stesso.app.radice, se_stesso.app.colori, se_stesso)
        se apri:
            se_stesso.finestra_valore.espressione = espressione
        se_stesso.app.console.esecutore.invia(PREFISSO_COMANDO + "valore " + json.dumps({"e": espressione}))
        ritorna Vero

    definisci mostra_valore(se_stesso, ev):
        se se_stesso.finestra_valore è non Nessuno e se_stesso.finestra_valore.winfo_exists():
            se_stesso.finestra_valore.mostra(ev)
            se_stesso.finestra_valore.lift()

    definisci termina(se_stesso):
        se se_stesso.finestra_valore è non Nessuno e se_stesso.finestra_valore.winfo_exists():
            se_stesso.finestra_valore.destroy()
        se_stesso.finestra_valore = Nessuno
        se_stesso.attiva = Falso
        se_stesso.fermo = Falso
        se_stesso._cancella_marcatore()
        se_stesso.app.console.gestore_debug = Nessuno
        se_stesso._nascondi_pannello()

    # ------------------------------------------------------------ comandi
    definisci comando(se_stesso, nome):
        se non se_stesso.attiva:
            ritorna
        se nome == "ferma":
            se_stesso.fermo = Falso
            se_stesso.app.console.ferma()
            se_stesso.termina()
            ritorna
        se non se_stesso.fermo:
            ritorna
        c = se_stesso.app.console.esecutore
        c.invia(PREFISSO_COMANDO + "punti " + json.dumps(se_stesso.punti_arresto()))
        c.invia(PREFISSO_COMANDO + "osservate " + json.dumps(se_stesso.osservate_per_il_runner()))     # con «ferma quando cambia» il «continua» le controlla
        c.invia(PREFISSO_COMANDO + nome)
        se_stesso.fermo = Falso
        se_stesso._cancella_marcatore()
        se se_stesso.pannello:
            se_stesso.pannello.attiva_comandi(Falso)

    definisci scegli_frame(se_stesso, numero):
        """Mostra variabili ed espressioni di un'altra riga della pila delle chiamate (0 = quella in cui il programma è fermo)."""
        se se_stesso.attiva e se_stesso.fermo:
            se_stesso._frame_scelto = numero
            se_stesso.app.console.esecutore.invia(PREFISSO_COMANDO + f"frame {numero}")

    definisci aggiungi_osservata(se_stesso, espressione):
        se espressione non in se_stesso.osservate:
            se_stesso.osservate.append(espressione)
        se_stesso._invia_osservate()

    definisci rimuovi_osservata(se_stesso, espressione):
        se espressione in se_stesso.osservate:
            se_stesso.osservate.remove(espressione)
        se_stesso.ferma_su.discard(espressione)
        se_stesso._invia_osservate()

    definisci commuta_ferma(se_stesso, espressione):
        """Accende o spegne il watchpoint dell'espressione: con «continua» il programma si ferma appena il valore cambia."""
        se espressione non in se_stesso.osservate:
            ritorna
        se espressione in se_stesso.ferma_su:
            se_stesso.ferma_su.discard(espressione)
        altrimenti:
            se_stesso.ferma_su.add(espressione)
        se_stesso._invia_osservate()

    definisci osservate_per_il_runner(se_stesso):
        ritorna [{"e": elemento, "ferma": elemento in se_stesso.ferma_su} per elemento in se_stesso.osservate]

    definisci _invia_osservate(se_stesso):
        se se_stesso.attiva e se_stesso.fermo:
            se_stesso.app.console.esecutore.invia(PREFISSO_COMANDO + "osserva " + json.dumps(se_stesso.osservate_per_il_runner()))
        altrimenti_se se_stesso.pannello:
            se_stesso.pannello.aggiorna_osservate([{"espressione": elemento, "valore": "…"} per elemento in se_stesso.osservate])

    # ------------------------------------------------------------ pannello
    definisci _mostra_pannello(se_stesso):
        app = se_stesso.app
        se se_stesso.pannello è Nessuno:
            se_stesso.pannello = PannelloDebug(app.centro, se_stesso)
            se_stesso.pannello.applica_colori(app.colori)
        riquadri = [tipo_testo(x) per x in app.centro.panes()]
        se str(se_stesso.pannello) non in riquadri:
            se str(app.console) in riquadri:
                app.centro.add(se_stesso.pannello, before=app.console, minsize=110, height=210)
            altrimenti:                      # la console è chiusa: non è nel pannello diviso, e «before» darebbe errore
                app.centro.add(se_stesso.pannello, minsize=110, height=210)
        se_stesso.pannello.aggiorna_osservate([{"espressione": elemento, "valore": "…"} per elemento in se_stesso.osservate])

    definisci _nascondi_pannello(se_stesso):
        se se_stesso.pannello è non Nessuno e se_stesso.pannello.winfo_exists():
            prova:
                se_stesso.app.centro.forget(se_stesso.pannello)
            eccetto tk.TclError:
                passa
