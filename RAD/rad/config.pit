"""Configurazione di PitStudio: valori predefiniti, lettura e scrittura su disco."""
importa json
importa os
importa copy
da rad.piattaforma importa FONT_MONO, WINDOWS

CARTELLA = os.path.join(os.path.expanduser("~"), ".rad")
FILE_CONFIG = os.path.join(CARTELLA, "config.json")

PREDEFINITI = {
    "tema": "scuro",
    "temi_personalizzati": {},
    "editor": {
        "carattere": FONT_MONO,
        "dimensione": 11,
        "tabulazione": 4,
        "numeri_riga": Vero,
        "a_capo": Falso,
        "salvataggio_automatico": 0,
        "omonimi": Vero,                 # evidenzia con uno sfondo colorato le variabili omonime (stesso nome per cose diverse)
        "guida_colonna": 0,              # colonna della guida verticale nell'editor (0 = nessuna; per esempio 100)
        "controllo": Vero,               # sottolinea gli errori gravi che bloccherebbero il programma (parole chiave come nomi, funzioni predefinite nascoste)
        "suggerimenti": Vero,
        "ritardo_suggerimenti_ms": 200,
        "evidenzia_riga": Vero,
        "chiudi_parentesi": Vero,
        "mostra_spazi": Falso,
    },
    "esecuzione": {
        "interprete": "",
        "argomenti": "",
        "salva_prima": Vero,
        "pulisci_console": Vero,
        "tempo_massimo_s": 0,
        "limite_memoria_mb": 0,          # 0 = nessun limite; altrimenti i programmi che superano la memoria vengono fermati
        "limite_processi": 0,            # 0 = nessun limite sul numero di processi avviati dal programma
    },
    "ai": {
        "chiave_api": "",
        "modello": "claude-sonnet-5-5",
        "modello_economico": "claude-haiku-5-5",      # per spiegazioni e piccole correzioni (casella «economico» della chat)
        "modelli": ["claude-sonnet-5-5", "claude-opus-5-5", "claude-haiku-5-5", "claude-fable-5-1"],
        "fornitore": "claude",           # claude | gemini | deepseek
        "chiave_gemini": "",
        "modello_gemini": "gemini-3.6-flash",
        "modello_economico_gemini": "gemini-3.5-flash-lite",
        "modelli_gemini": ["gemini-3.6-flash", "gemini-3.5-flash", "gemini-3.5-flash-lite"],
        "url_gemini": "https://generativelanguage.googleapis.com/v1beta",
        "chiave_deepseek": "",
        "modello_deepseek": "deepseek-chat",
        "modello_economico_deepseek": "deepseek-chat",
        "modelli_deepseek": ["deepseek-chat", "deepseek-reasoner"],
        "url_deepseek": "https://api.deepseek.com",
        "max_token": 4096,
        "conferma_scrittura": Vero,
        "conferma_esecuzione": Vero,
        "istruzioni_extra": "",
        "url": "https://api.anthropic.com/v1/messages",
        "versione_api": "2023-06-01",
        "passi_massimi": 25,
        "includi_file_attivo": Vero,
        "cache_cronologia": Vero,        # riusa la conversazione già letta (costa molto meno)
        "correzioni_automatiche": 2,     # quante volte l'assistente corregge da solo il codice con errori di sintassi
        "compatta_oltre_token": 30000,   # oltre questa lunghezza (stimata) i vecchi risultati vengono accorciati; 0 = mai
        "limite_memoria_mb": 1024,       # tetto di memoria per i programmi eseguiti dall'assistente
        "limite_processi": 20,           # e numero massimo di processi che possono avviare
        "prezzi": {},                    # prezzi per la stima dei costi: {"modello": [ingresso, uscita, cache_lettura, cache_scrittura]} in dollari per milione di token
        "storia": Vero,                  # copie di sicurezza per annullare le modifiche dell'assistente (.rad/storia)
        "registro": Vero,                # registro locale di token e codice generato (.rad/ai_registro.jsonl)
    },
    "recupero": {
        "attivo": Vero,                  # copie di sicurezza periodiche dei file con modifiche non salvate (.rad/recupero), proposte all'avvio dopo una chiusura improvvisa
        "secondi": 30,
    },
    "avvio": {
        "chiedi": Vero,                  # all'avvio la finestra «Aprire l'ultimo / nuovo progetto / lezione»; se Falso si riapre subito l'ultimo lavoro
    },
    "lezioni": {
        "progressi": {},                 # {"8": {"migliore": 4, "su": 5, "completata": true, ...}}
        "ultima": 0,                     # l'ultima lezione su cui si è fatto il quiz
    },
    "aggiornamenti": {
        "controlla_all_avvio": Vero,     # una volta al giorno controlla se ci sono una versione nuova di PitStudio e librerie nuove
        "ultimo_controllo": "",          # data (AAAA-MM-GG) dell'ultimo controllo automatico
    },
    "claude_code": {
        "percorso": "",                  # percorso di claude.exe se non è nel PATH
    },
    "finestra": {
        "geometria": "1400x860",
        "pannello_sinistro": 270 se WINDOWS altrimenti 320,        # sugli altri sistemi i caratteri sono più larghi
        "pannello_destro": 430 se WINDOWS altrimenti 480,
        "console_altezza": 190,
        "chat_visibile": Vero,
        "progetti_visibile": Vero,
        "console_visibile": Vero,
    },
    "scorciatoie": {
        "salva": "Control-s",
        "salva_tutto": "Control-Shift-S",
        "apri_progetto": "Control-o",
