"""Progetti di PitStudio: cartella + manifesto, modelli iniziali, operazioni sui file, pannello ad albero."""
importa json
importa os
importa re
importa shutil
importa subprocess
importa sys
importa time
importa tkinter come tk
da tkinter importa ttk, messagebox, simpledialog, filedialog

da rad importa form_modello, piattaforma, stile

NOME_MANIFESTO = "progetto.rad.json"
IGNORA = {"__pycache__", ".git", ".rad", ".claude", ".idea", ".vscode", "node_modules"}
ESTENSIONI_CODICE = {".pit"}
ESTENSIONI_IMMAGINE = {".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico", ".webp", ".tif", ".tiff"}
ESTENSIONI_TABELLA = {".csv", ".tsv"}
ESTENSIONI_DATABASE = {".db", ".sqlite", ".sqlite3", ".db3"}
ESTENSIONI_TESTO = {".txt", ".md", ".ini", ".cfg", ".toml", ".yaml", ".yml", ".xml", ".html",
                    ".css", ".js", ".log", ".bat", ".sh", ".sql", ".rst"}

MODELLI = {
    "console": "Programma da console",
    "finestra": "Programma con finestra (progettista)",
    "mattonelle": "Mattonelle a console",
    "mattonelle_finestra": "Mattonelle a finestra",
    "vuoto": "Progetto vuoto",
    "libreria": "Libreria (pacchetto)",
    "python": "Programma Python classico (.py)",
}

PROGRAMMA_CONSOLE = '''"""{nome} - programma da console pytonIta."""


definisci principale():
    nome = leggi("Come ti chiami? ")
    stampa(f"Ciao, {{nome}}!")
    per i in intervallo(1, 4):
        stampa("Conto:", i)


se __nome__ == "__main__":
    principale()
'''


PROGRAMMA_PYTHON = '''"""{nome} - programma Python classico (eseguito da pitonit)."""


def main():
    nome = input("Come ti chiami? ")
    print(f"Ciao, {{nome}}!")
    for i in range(1, 4):
        print("Conto:", i)


if __name__ == "__main__":
    main()
'''


PAROLE_RISERVATE_NOMI = {"classe", "definisci", "se", "per", "da", "con", "e", "o", "non", "in", "passa", "prova", "mentre",
                         "ritorna", "importa", "lambda", "elimina", "attendi", "asincrono", "interrompi", "continua"}


definisci file_libreria(nome, pacchetto):
    """I file di un progetto «libreria»: un pacchetto piccolo ma completo (funzione, classe, prova e spiegazione) da riempire."""
    ritorna {
        f"{pacchetto}/__init__.pit": f'''"""{nome} - una libreria pytonIta.

Questa cartella è la libreria: chi scrive «importa {pacchetto}» carica questo file.
Qui si elencano le cose che la libreria offre agli altri, prendendole dai suoi moduli.
"""
VERSIONE = "0.1"

da {pacchetto}.saluti importa saluta
da {pacchetto}.contatore importa Contatore
da rad importa piattaforma
''',
        f"{pacchetto}/saluti.pit": '''"""Un modulo della libreria: funzioni semplici. Aggiungi qui le tue."""


definisci saluta(nome="mondo"):
    """Restituisce un saluto. (La riga tra virgolette doppie, qui sotto la definizione, è la documentazione.)"""
    ritorna f"Ciao, {nome}!"
''',
        f"{pacchetto}/contatore.pit": '''"""Un altro modulo: una classe. Ogni modulo può contenere funzioni, classi e costanti."""


classe Contatore:
    """Conta quante volte lo chiami."""

    definisci __inizializza__(se_stesso, partenza=0):
        se_stesso.valore = partenza

    definisci incrementa(se_stesso, passo=1):
        se_stesso.valore += passo
        ritorna se_stesso.valore
''',
        "prova.pit": f'''"""Prova della libreria: usa la libreria come la userebbe un altro programma. Premi F5 per eseguirla."""
importa {pacchetto}
da {pacchetto} importa saluta, Contatore

stampa("Libreria {nome}, versione", {pacchetto}.VERSIONE)
stampa(saluta("pytonIta"))

c = Contatore()
c.incrementa()
c.incrementa(5)
se c.valore == 6:
    stampa("Il contatore funziona: valore", c.valore)
altrimenti:
    stampa("Qualcosa non va: valore", c.valore)
''',
        "LEGGIMI.md": f"""# {nome}

Una libreria pytonIta: un pacchetto di funzioni e classi da riutilizzare in altri programmi.

## Come è fatta

| File | A cosa serve |
|---|---|
| `{pacchetto}/__init__.pit` | È la «porta» della libreria: chi scrive `importa {pacchetto}` carica questo file. Qui si elenca ciò che la libreria offre. |
| `{pacchetto}/saluti.pit` | Un modulo con una funzione (`saluta`). |
| `{pacchetto}/contatore.pit` | Un modulo con una classe (`Contatore`). |
| `prova.pit` | Un programma che usa la libreria come farebbe un altro programma (F5 per eseguirlo). |

## Come si lavora

1. Aggiungi funzioni e classi nei moduli (o crea nuovi file dentro `{pacchetto}/`).
2. Per renderle disponibili scrivile in `__init__.pit`: `da {pacchetto}.mio_modulo importa mia_funzione`.
3. Prova tutto in `prova.pit` ed eseguilo con F5.

## Come si usa in un altro progetto

Copia la cartella `{pacchetto}` accanto al programma che la vuole usare, poi:

```
importa {pacchetto}
stampa({pacchetto}.saluta("mondo"))
```
""",
    }


definisci _unisci(cartella_, nome):
    ritorna cartella_ + "/" + nome se cartella_ altrimenti nome


definisci tipo_file(percorso):
    """Categoria di un file: codice, form, immagine, json, tabella, testo, binario."""
    nome = os.path.basename(percorso).lower()
    estensione = os.path.splitext(nome)[1]
    se nome.endswith(".mattonelle.json"):
        ritorna "mattonelle"
    se nome.endswith(".form.json"):
        ritorna "form"
    se estensione in ESTENSIONI_CODICE:
        ritorna "codice"
    se estensione in (".py", ".pyw"):
        ritorna "python"
    se estensione == ".json":
        ritorna "json"
    se estensione in ESTENSIONI_IMMAGINE:
        ritorna "immagine"
    se estensione in ESTENSIONI_TABELLA:
        ritorna "tabella"
    se estensione in ESTENSIONI_DATABASE:
        ritorna "database"
    se estensione in ESTENSIONI_TESTO o nome in ("readme", "license", "makefile"):
        ritorna "testo"
    # prova a capire se è testo
    prova:
        con open(percorso, "rb") come f:
            blocco = f.read(2048)
        se b"\0" in blocco:
            ritorna "binario"
        blocco.decode("utf-8")
        ritorna "testo"
    eccetto (OSError, UnicodeDecodeError):
        ritorna "binario"


classe Progetto:
    definisci __inizializza__(se_stesso, cartella):
        se_stesso.cartella = os.path.abspath(cartella)
        se_stesso.manifesto = {}
        se_stesso.carica_manifesto()

    # --- manifesto
    @property
    definisci percorso_manifesto(se_stesso):
        ritorna os.path.join(se_stesso.cartella, NOME_MANIFESTO)

    definisci carica_manifesto(se_stesso):
        prova:
            con open(se_stesso.percorso_manifesto, encoding="utf-8") come f:
                se_stesso.manifesto = json.load(f)
        eccetto (OSError, ValueError):
            se_stesso.manifesto = {"nome": os.path.basename(se_stesso.cartella), "principale": "",
                                   "descrizione": "", "argomenti": ""}

    definisci salva_manifesto(se_stesso):
        con open(se_stesso.percorso_manifesto, "w", encoding="utf-8") come f:
            json.dump(se_stesso.manifesto, f, indent=2, ensure_ascii=Falso)

    @property
    definisci nome(se_stesso):
        ritorna se_stesso.manifesto.get("nome") o os.path.basename(se_stesso.cartella)

    @property
    definisci principale(se_stesso):
        ritorna se_stesso.manifesto.get("principale", "")

    definisci imposta_principale(se_stesso, relativo):
        se_stesso.manifesto["principale"] = relativo
        se_stesso.salva_manifesto()

    definisci percorso_principale(se_stesso):
        se se_stesso.principale:
            p = se_stesso.assoluto(se_stesso.principale)
            se os.path.exists(p):
                ritorna p
        ritorna Nessuno

    # --- percorsi
    definisci assoluto(se_stesso, relativo):
        p = os.path.normpath(os.path.join(se_stesso.cartella, relativo))
        se non (p == se_stesso.cartella o p.startswith(se_stesso.cartella + os.sep)):
            solleva ErroreDiValore(f"percorso fuori dal progetto: {relativo}")
        ritorna p

    definisci relativo(se_stesso, assoluto):
        ritorna os.path.relpath(assoluto, se_stesso.cartella).replace("\\", "/")

    definisci contiene(se_stesso, percorso):
        p = os.path.abspath(percorso)
        ritorna p == se_stesso.cartella o p.startswith(se_stesso.cartella + os.sep)

    # --- creazione
    @staticmethod
    definisci nuovo(cartella, nome, modello="console"):
        os.makedirs(cartella, exist_ok=Vero)
        se os.path.exists(os.path.join(cartella, NOME_MANIFESTO)):
            solleva FileEsistente("esiste già un progetto in questa cartella")
        p = Progetto(cartella)
        p.manifesto = {"nome": nome, "principale": "", "descrizione": "", "argomenti": "",
                       "creato": time.strftime("%Y-%m-%d %H:%M"), "modello": modello}
        se modello == "console":
            p.crea_file("principale.pit", PROGRAMMA_CONSOLE.format(nome=nome))
            p.manifesto["principale"] = "principale.pit"
        altrimenti_se modello == "finestra":
            f = form_modello.Form("Principale", nome)
            f.larghezza, f.altezza = 420, 260
            f.aggiungi("Etichetta", 20, 20, testo="Ciao dal progettista!", larghezza=260)
            f.aggiungi("CampoTesto", 20, 60, larghezza=260)
            f.aggiungi("Pulsante", 20, 110, testo="Saluta", al_clic="al_clic_saluta", larghezza=120)
            form_modello.salva_form(f, cartella)
            p.manifesto["principale"] = "principale.pit"
        altrimenti_se modello in ("mattonelle", "mattonelle_finestra"):
            da rad importa mattonelle_modello
            se modello == "mattonelle_finestra":
                prog = mattonelle_modello.programma_di_esempio_finestra("principale")
            altrimenti:
                prog = mattonelle_modello.programma_di_esempio("principale")
            mattonelle_modello.salva_programma(prog, cartella)
            p.manifesto["principale"] = "principale.pit"
        altrimenti_se modello == "python":
            p.crea_file("principale.py", PROGRAMMA_PYTHON.format(nome=nome))
            p.manifesto["principale"] = "principale.py"
        altrimenti_se modello == "libreria":
            nome_pacchetto = re.sub(r"\W+", "_", nome.lower()).strip("_") o "pacchetto"
            se nome_pacchetto[0].isdigit() o nome_pacchetto in PAROLE_RISERVATE_NOMI:
                nome_pacchetto = "lib_" + nome_pacchetto
            per relativo, contenuto in file_libreria(nome, nome_pacchetto).items():
                p.crea_file(relativo, contenuto)
            p.manifesto["principale"] = "prova.pit"
        altrimenti:
            p.crea_file("principale.pit", f'"""{nome}."""\n\nstampa("Ciao!")\n')
            p.manifesto["principale"] = "principale.pit"
        se non os.path.exists(p.assoluto("LEGGIMI.md")):
            p.crea_file("LEGGIMI.md", f"# {nome}\n\nProgetto creato con PitStudio.\n")
        p.salva_manifesto()
        ritorna p

    # --- file
    definisci crea_file(se_stesso, relativo, contenuto=""):
        p = se_stesso.assoluto(relativo)
        os.makedirs(os.path.dirname(p), exist_ok=Vero)
        con open(p, "w", encoding="utf-8", newline="\n") come f:
            f.write(contenuto)
        ritorna p

    definisci crea_cartella(se_stesso, relativo):
        p = se_stesso.assoluto(relativo)
        os.makedirs(p, exist_ok=Vero)
        ritorna p

    definisci leggi(se_stesso, relativo):
        con open(se_stesso.assoluto(relativo), "rb") come f:
            dati = f.read()
        prova:
            ritorna dati.decode("utf-8")
        eccetto UnicodeDecodeError:
            ritorna dati.decode("latin-1")

    definisci cancella(se_stesso, relativo):
        p = se_stesso.assoluto(relativo)
        se p == se_stesso.cartella:
            solleva ErroreDiValore("non si può eliminare la cartella del progetto")
        se os.path.isdir(p):
            shutil.rmtree(p)
        altrimenti:
            os.remove(p)
        se se_stesso.principale == relativo:
            se_stesso.imposta_principale("")

    definisci rinomina(se_stesso, relativo, nuovo_nome):
        p = se_stesso.assoluto(relativo)
        nuovo = os.path.join(os.path.dirname(p), nuovo_nome)
        se os.path.exists(nuovo):
            solleva FileEsistente(nuovo_nome)
        os.rename(p, nuovo)
        nuovo_rel = se_stesso.relativo(nuovo)
        se se_stesso.principale == relativo:
            se_stesso.imposta_principale(nuovo_rel)
        ritorna nuovo

    # --- finestre disegnate: <nome>.form.json + <nome>_ui.pit + <nome>.pit vanno trattati insieme
    definisci _base_finestra(se_stesso, relativo):
        """(cartella relativa, nome di base) se `relativo` è uno dei file di una finestra disegnata, altrimenti None."""
        cartella_, nome = os.path.split(relativo.replace("\\", "/"))
        se nome.endswith(".form.json"):
            base = nome[:-len(".form.json")]
        altrimenti_se nome.endswith("_ui.pit"):
            base = nome[:-len("_ui.pit")]
        altrimenti_se nome.endswith(".pit"):
            base = nome[:-len(".pit")]
        altrimenti:
            ritorna Nessuno
        se base e os.path.exists(se_stesso.assoluto(_unisci(cartella_, base + ".form.json"))):
            ritorna cartella_, base
        ritorna Nessuno

    definisci gruppo_finestra(se_stesso, relativo):
        """[(relativo, descrizione)] dei file della finestra a cui appartiene `relativo` (vuota se non è una finestra con almeno due file)."""
        b = se_stesso._base_finestra(relativo)
        se non b:
            ritorna []
        cartella_, base = b
        voci = [(_unisci(cartella_, base + ".form.json"), "il disegno"),
                (_unisci(cartella_, base + "_ui.pit"), "il codice dell'aspetto (si rigenera dal disegno)"),
                (_unisci(cartella_, base + ".pit"), "il codice della finestra (il tuo)")]
        trovate = [(r, d) per r, d in voci se os.path.exists(se_stesso.assoluto(r))]
        ritorna trovate se lunghezza(trovate) >= 2 altrimenti []

    definisci rinomina_finestra(se_stesso, relativo, nuovo_nome):
        """Rinomina insieme i file di una finestra e aggiorna i nomi che ne dipendono (modulo, classi, importazioni, nome nel disegno).
        Ritorna ([(vecchio, nuovo) percorsi assoluti dei file spostati], [percorsi assoluti dei file riscritti])."""
        da rad importa navigazione
        b = se_stesso._base_finestra(relativo)
        se non b:
            solleva ErroreDiValore("non è una finestra disegnata")
        cartella_, vecchia_base = b
        nuovo_nome = nuovo_nome.strip()
        errore = navigazione.controlla_nuovo_nome(nuovo_nome, vecchia_base)
        se errore:
            solleva ErroreDiValore(errore)
        nuova_base = nuovo_nome.lower()
        se nuova_base == vecchia_base:
            solleva ErroreDiValore("Il nome è lo stesso.")
        coppie = []
        per suffisso in (".form.json", "_ui.pit", ".pit"):
            v = _unisci(cartella_, vecchia_base + suffisso)
            se os.path.exists(se_stesso.assoluto(v)):
                n = _unisci(cartella_, nuova_base + suffisso)
                se os.path.exists(se_stesso.assoluto(n)):
                    solleva FileEsistente(n)
                coppie.append((se_stesso.assoluto(v), se_stesso.assoluto(n)))
        percorso_json = coppie[0][0]
        con open(percorso_json, encoding="utf-8") come f:
            disegno = json.loads(f.read())
        vecchio_nome = disegno.get("nome") o vecchia_base
        sposta = {os.path.normcase(v): n per v, n in coppie}
        # i nuovi testi, calcolati prima di spostare niente
        scritture = {}
        per p in navigazione.file_del_progetto(se_stesso.cartella):
            try_ = Nessuno
            prova:
                con open(p, encoding="utf-8", newline="") come f:
                    try_ = f.read()
            eccetto (OSError, UnicodeDecodeError):
                continua
            della_finestra = os.path.normcase(p) in sposta
            se non (della_finestra o navigazione.importa_finestra(try_, vecchio_nome)):
                continua
            nuovo_testo = navigazione.rinomina_finestra_nel_testo(try_, vecchio_nome, nuovo_nome)
            se nuovo_testo != try_:
                scritture[sposta.get(os.path.normcase(p), p)] = nuovo_testo
        disegno["nome"] = nuovo_nome
        scritture[coppie[0][1]] = json.dumps(disegno, indent=2, ensure_ascii=Falso)
        relativo_principale = se_stesso.principale
        per v, n in coppie:
            os.rename(v, n)
            se relativo_principale e os.path.normcase(se_stesso.assoluto(relativo_principale)) == os.path.normcase(v):
                se_stesso.imposta_principale(se_stesso.relativo(n))
        per p, testo_nuovo in scritture.items():
            con open(p, "w", encoding="utf-8", newline="") come f:
                f.write(testo_nuovo)
        ritorna coppie, lista(scritture)

    definisci aggiungi_risorse(se_stesso, file_origine, sottocartella="risorse"):
        destinazione = se_stesso.assoluto(sottocartella)
        os.makedirs(destinazione, exist_ok=Vero)
        copiati = []
        per f in file_origine:
            d = os.path.join(destinazione, os.path.basename(f))
            shutil.copy2(f, d)
            copiati.append(d)
        ritorna copiati

    definisci elenca(se_stesso, relativo=""):
        """[(nome, è_cartella)] ordinati: prima le cartelle."""
        p = se_stesso.assoluto(relativo) se relativo altrimenti se_stesso.cartella
        voci = []
        prova:
            nomi = os.listdir(p)
        eccetto OSError:
            ritorna []
        per n in nomi:
            se n in IGNORA o n.endswith(".pyc"):
                continua
            voci.append((n, os.path.isdir(os.path.join(p, n))))
        voci.sort(key=lambda v: (non v[1], v[0].lower()))
        ritorna voci

    definisci tutti_i_file(se_stesso, estensioni=Nessuno, massimo=5000):
        risultato = []
        per radice, cartelle, file in os.walk(se_stesso.cartella):
            cartelle[:] = [d per d in cartelle se d non in IGNORA]
            per n in file:
                se n.endswith(".pyc"):
                    continua
                se estensioni e os.path.splitext(n)[1].lower() non in estensioni:
                    continua
                risultato.append(se_stesso.relativo(os.path.join(radice, n)))
                se lunghezza(risultato) >= massimo:
                    ritorna risultato
        ritorna sorted(risultato)

    definisci forms(se_stesso):
        ritorna [r per r in se_stesso.tutti_i_file() se r.endswith(".form.json")]

    definisci cerca(se_stesso, testo_, estensioni=Nessuno, maiuscole=Falso, massimo=200):
        """[(relativo, riga, contenuto)] delle righe che contengono il testo."""
        chiave = testo_ se maiuscole altrimenti testo_.lower()
        trovati = []
        per rel in se_stesso.tutti_i_file(estensioni):
            p = se_stesso.assoluto(rel)
            se tipo_file(p) non in ("codice", "testo", "json", "tabella", "form"):
                continua
            prova:
                righe = open(p, encoding="utf-8", errors="replace").read().splitlines()
            eccetto OSError:
                continua
            per n, riga in enumera(righe, 1):
                se chiave in (riga se maiuscole altrimenti riga.lower()):
                    trovati.append((rel, n, riga.strip()[:200]))
                    se lunghezza(trovati) >= massimo:
                        ritorna trovati
        ritorna trovati


# --------------------------------------------------------------------------- pannello
ICONE = {"cartella": "📁", "codice": "🧩", "python": "🐍", "form": "🪟", "mattonelle": "🧱", "immagine": "🖼", "json": "{}",
         "tabella": "▦", "database": "🗄", "testo": "📄", "binario": "▪"}


classe DialogoGruppoFinestra(tk.Toplevel):
    """Elimina una finestra disegnata: una spunta per ciascuno dei suoi file (all'inizio tutte attive); togliendone una, quel file resta."""

    definisci __inizializza__(se_stesso, genitore, nome, voci):
        tk.Toplevel.__init__(se_stesso, genitore)
        se_stesso.title("Elimina finestra")
        se_stesso.transient(genitore.winfo_toplevel())
        se_stesso.resizable(Falso, Falso)
        se_stesso.risultato = Nessuno
        se_stesso._voci = voci
        se_stesso._var = []
        ttk.Label(se_stesso, justify="left",
                  text=f"La finestra «{nome}» è fatta di {lunghezza(voci)} file.\nSpunta quelli da eliminare definitivamente:").pack(anchor="w", padx=14, pady=(12, 6))
        per rel, descrizione in voci:
            v = tk.BooleanVar(value=Vero)
            v.trace_add("write", lambda *a: se_stesso._aggiorna())
            se_stesso._var.append(v)
            ttk.Checkbutton(se_stesso, text=f"{rel}  —  {descrizione}", variable=v).pack(anchor="w", padx=24, pady=2)
        riga = ttk.Frame(se_stesso)
        riga.pack(fill="x", padx=14, pady=12)
        ttk.Button(riga, text="Annulla", command=se_stesso.destroy).pack(side="right")
        se_stesso.bottone = ttk.Button(riga, text="Elimina", command=se_stesso._conferma)
        se_stesso.bottone.pack(side="right", padx=(0, 8))
        se_stesso.bind("<Escape>", lambda e: se_stesso.destroy())
        se_stesso.update_idletasks()
        p = genitore.winfo_toplevel()
        x = p.winfo_rootx() + max(0, (p.winfo_width() - se_stesso.winfo_reqwidth()) // 2)
        y = p.winfo_rooty() + max(0, (p.winfo_height() - se_stesso.winfo_reqheight()) // 3)
        se_stesso.geometry(f"+{x}+{y}")
        prova:
            se_stesso.grab_set()
        eccetto tk.TclError:
            passa

    definisci scelti(se_stesso):
        ritorna [rel per (rel, _), v in zip(se_stesso._voci, se_stesso._var) se v.get()]

    definisci _aggiorna(se_stesso):
        se_stesso.bottone.configure(state="normal" se se_stesso.scelti() altrimenti "disabled")

    definisci _conferma(se_stesso):
        se_stesso.risultato = se_stesso.scelti()
        se_stesso.destroy()

    definisci mostra(se_stesso):
        se_stesso.wait_window(se_stesso)
        ritorna se_stesso.risultato


classe PannelloProgetto(tk.Frame):
    """Albero del progetto con menu contestuale e barra degli strumenti."""

    definisci __inizializza__(se_stesso, genitore, azioni, config):
        tk.Frame.__init__(se_stesso, genitore)
        se_stesso.azioni = azioni
        se_stesso.config_ = config
        se_stesso.progetto = Nessuno
        se_stesso._nodi = {}
        barra = tk.Frame(se_stesso)
        barra.pack(fill="x")
        se_stesso.etichetta = tk.Label(barra, text="Nessun progetto", anchor="w")
        se_stesso.etichetta.pack(side="left", fill="x", expand=Vero, padx=6, pady=4)
        se_stesso.barra = barra
        per simbolo, suggerimento, comando in (("⟳", "Aggiorna", se_stesso.aggiorna),
                                               ("＋", "Nuovo file", lambda: se_stesso.nuovo_file()),
                                               ("📁", "Nuova cartella", lambda: se_stesso.nuova_cartella())):
            b = tk.Button(barra, text=simbolo, command=comando, width=3)
            b.pack(side="right", padx=1, pady=2)
            stile.suggerisci(b, suggerimento)
        se_stesso.albero = ttk.Treeview(se_stesso, show="tree", selectmode="browse")
        barra_y = ttk.Scrollbar(se_stesso, orient="vertical", command=se_stesso.albero.yview)
        se_stesso.albero.configure(yscrollcommand=barra_y.set)
        barra_y.pack(side="right", fill="y")
        se_stesso.albero.pack(fill="both", expand=Vero)
        se_stesso.albero.bind("<<TreeviewOpen>>", se_stesso._alla_apertura)
        se_stesso.albero.bind("<Double-1>", se_stesso._doppio_clic)
        se_stesso.albero.bind("<Return>", se_stesso._doppio_clic)
        se_stesso.albero.bind("<Button-3>", se_stesso._menu_contestuale)
        se_stesso.albero.bind("<F2>", lambda e: se_stesso.rinomina())
        se_stesso.albero.bind("<Delete>", lambda e: se_stesso.cancella())
        se_stesso.menu = tk.Menu(se_stesso, tearoff=0)

    # --- albero
    definisci imposta_progetto(se_stesso, progetto):
        se_stesso.progetto = progetto
        se_stesso.etichetta.configure(text=progetto.nome se progetto altrimenti "Nessun progetto")
        se_stesso.aggiorna()

    definisci aggiorna(se_stesso):
        espansi = {r per r, n in se_stesso._nodi.items() se se_stesso.albero.exists(n) e se_stesso.albero.item(n, "open")}
        se_stesso.albero.delete(*se_stesso.albero.get_children())
        se_stesso._nodi = {}
        se non se_stesso.progetto:
            ritorna
        se_stesso._riempi("", "")
        per rel in sorted(espansi, key=lambda r: r.count("/")):
            n = se_stesso._nodi.get(rel)
            se n e se_stesso.albero.exists(n):
                se_stesso.albero.item(n, open=Vero)
                se_stesso._carica_figli(n)

    definisci _inserisci_voce(se_stesso, nodo, relativo, nome_, e_cartella):
        rel = f"{relativo}/{nome_}" se relativo altrimenti nome_
        p = se_stesso.progetto.assoluto(rel)
        se e_cartella:
            icona = ICONE["cartella"]
        altrimenti:
            icona = ICONE.get(tipo_file(p), "📄")
        testo_ = f"{icona}  {nome_}"
        se rel == se_stesso.progetto.principale:
            testo_ += "   ★"
        n = se_stesso.albero.insert(nodo, "end", text=testo_, values=(rel, "d" se e_cartella altrimenti "f"))
        se_stesso._nodi[rel] = n
        se e_cartella:
            se_stesso.albero.insert(n, "end", text="…", values=("", "ph"))
        ritorna n

    definisci _riempi(se_stesso, nodo, relativo):
        elenco = se_stesso.progetto.elenca(relativo)
        file_ = {n per n, c in elenco se non c}
        # una finestra disegnata (disegno + almeno un file di codice) è un solo nodo che si apre sui suoi file
        gruppi = {}
        per n in sorted(file_):
            se n.endswith(".form.json"):
                base = n[:-len(".form.json")]
                membri = [x per x in (base + ".form.json", base + "_ui.pit", base + ".pit") se x in file_]
                se base e lunghezza(membri) >= 2:
                    per x in membri:
                        gruppi[x] = (base, membri)
        fatti = set()
        per nome_, e_cartella in elenco:
            se nome_ in gruppi:
                base, membri = gruppi[nome_]
                se base in fatti:
                    continua
                fatti.add(base)
                rel_json = f"{relativo}/{base}.form.json" se relativo altrimenti base + ".form.json"
                testo_ = f"{ICONE['form']}  {base}"
                se se_stesso.progetto.principale in [f"{relativo}/{x}" se relativo altrimenti x per x in membri]:
                    testo_ += "   ★"
                g = se_stesso.albero.insert(nodo, "end", text=testo_, values=(rel_json, "g"))
                se_stesso._nodi["@" + rel_json] = g
                per x in membri:
                    se_stesso._inserisci_voce(g, relativo, x, Falso)
                continua
            se_stesso._inserisci_voce(nodo, relativo, nome_, e_cartella)

    definisci _carica_figli(se_stesso, nodo):
        figli = se_stesso.albero.get_children(nodo)
        se lunghezza(figli) == 1 e se_stesso.albero.item(figli[0], "values")[1] == "ph":
            se_stesso.albero.delete(figli[0])
            rel = se_stesso.albero.item(nodo, "values")[0]
            se_stesso._riempi(nodo, rel)

    definisci _alla_apertura(se_stesso, e):
        nodo = se_stesso.albero.focus()
        se nodo:
            se_stesso._carica_figli(nodo)

    definisci _selezionato(se_stesso):
        """(relativo, è_cartella) del nodo scelto, oppure ('', Vero) per la radice."""
        nodo = se_stesso.albero.focus()
        se non nodo:
            ritorna "", Vero
        rel, tipo_ = se_stesso.albero.item(nodo, "values")[:2]
        ritorna rel, tipo_ == "d"

    definisci _e_gruppo(se_stesso):
        """Vero se il nodo scelto è una finestra disegnata (il nodo che contiene i suoi tre file)."""
        nodo = se_stesso.albero.focus()
        ritorna bool(nodo) e se_stesso.albero.item(nodo, "values")[1:2] == ("g",)

    definisci _cartella_di_destinazione(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        se e_cartella:
            ritorna rel
        ritorna os.path.dirname(rel).replace("\\", "/")

    definisci _doppio_clic(se_stesso, e=Nessuno):
        rel, e_cartella = se_stesso._selezionato()
        se rel e non e_cartella:
            se_stesso.azioni.apri_file(se_stesso.progetto.assoluto(rel))
            se se_stesso._e_gruppo():
                ritorna "break"            # sul nodo della finestra il doppio clic apre il progettista, non apre né chiude il nodo

    # --- menu contestuale
    definisci _menu_contestuale(se_stesso, e):
        riga = se_stesso.albero.identify_row(e.y)
        se riga:
            se_stesso.albero.selection_set(riga)
            se_stesso.albero.focus(riga)
        se non se_stesso.progetto:
            ritorna
        rel, e_cartella = se_stesso._selezionato()
        gruppo = se_stesso._e_gruppo()
        m = se_stesso.menu
        m.delete(0, "end")
        se gruppo:
            m.add_command(label="Apri nel progettista", command=se_stesso._doppio_clic)
            m.add_separator()
        altrimenti_se rel e non e_cartella:
            m.add_command(label="Apri", command=se_stesso._doppio_clic)
            m.add_command(label="Imposta come file principale ★", command=se_stesso.imposta_principale)
            se rel.lower().endswith(".pit"):
                m.add_command(label="Converti in mattonelle…", command=se_stesso.converti_in_mattonelle)
            se rel.lower().endswith(".py"):
                m.add_command(label="Traduci in pytonIta (.pit)…", command=se_stesso.traduci_in_pit)
            m.add_separator()
        m.add_command(label="Nuovo file…", command=se_stesso.nuovo_file)
        m.add_command(label="Nuova cartella…", command=se_stesso.nuova_cartella)
        m.add_command(label="Nuova finestra (progettista)…", command=se_stesso.nuova_finestra)
        m.add_command(label="Nuovo programma a mattonelle…", command=se_stesso.nuovo_mattonelle)
        m.add_command(label="Aggiungi risorse (immagini, json, …)…", command=se_stesso.aggiungi_risorse)
        se rel:
            m.add_separator()
            m.add_command(label="Rinomina la finestra…   F2" se gruppo altrimenti "Rinomina…   F2", command=se_stesso.rinomina)
            m.add_command(label="Elimina la finestra…   Canc" se gruppo altrimenti "Elimina   Canc", command=se_stesso.cancella)
            m.add_command(label="Mostra in Esplora risorse", command=se_stesso.mostra_in_esplora)
        m.add_separator()
        m.add_command(label="Aggiorna", command=se_stesso.aggiorna)
        m.tk_popup(e.x_root, e.y_root)

    # --- azioni
    definisci nuovo_file(se_stesso, nome_=Nessuno):
        se non se_stesso.progetto:
            ritorna
        cartella = se_stesso._cartella_di_destinazione()
        nome_ = nome_ o simpledialog.askstring("Nuovo file", "Nome del file (es. modulo.pit):", parent=se_stesso)
        se non nome_:
            ritorna
        rel = f"{cartella}/{nome_}" se cartella altrimenti nome_
        prova:
            p = se_stesso.progetto.crea_file(rel, "")
        eccetto (OSError, ErroreDiValore) come errore:
            messagebox.showerror("Errore", testo(errore), parent=se_stesso)
            ritorna
        se_stesso.aggiorna()
        se_stesso.azioni.apri_file(p)

    definisci nuova_cartella(se_stesso):
        se non se_stesso.progetto:
            ritorna
        cartella = se_stesso._cartella_di_destinazione()
        nome_ = simpledialog.askstring("Nuova cartella", "Nome della cartella:", parent=se_stesso)
        se non nome_:
            ritorna
        se_stesso.progetto.crea_cartella(f"{cartella}/{nome_}" se cartella altrimenti nome_)
        se_stesso.aggiorna()

    definisci nuova_finestra(se_stesso):
        se_stesso.azioni.nuovo_form(se_stesso._cartella_di_destinazione())

    definisci traduci_in_pit(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        se rel e non e_cartella:
            se_stesso.azioni.traduci_in_pit(se_stesso.progetto.assoluto(rel))

    definisci converti_in_mattonelle(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        se rel e non e_cartella:
            se_stesso.azioni.converti_in_mattonelle(se_stesso.progetto.assoluto(rel))

    definisci nuovo_mattonelle(se_stesso):
        se_stesso.azioni.nuovo_mattonelle(se_stesso._cartella_di_destinazione())

    definisci aggiungi_risorse(se_stesso):
        se non se_stesso.progetto:
            ritorna
        file = filedialog.askopenfilenames(parent=se_stesso, title="Aggiungi risorse al progetto",
                                           filetypes=[("Tutti i file", "*.*"),
                                                      ("Immagini", "*.png *.jpg *.jpeg *.gif *.bmp *.ico"),
                                                      ("JSON", "*.json"), ("Tabelle", "*.csv *.tsv")])
        se non file:
            ritorna
        se_stesso.progetto.aggiungi_risorse(file)
        se_stesso.aggiorna()
        se_stesso.azioni.info(f"{lunghezza(file)} risorse aggiunte a risorse/")

    definisci rinomina(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        se non rel:
            ritorna
        # sul nodo della finestra si rinominano insieme i tre file; su un file singolo (anche dentro la finestra) solo quello
        gruppo = se_stesso.progetto.gruppo_finestra(rel) se se_stesso._e_gruppo() altrimenti []
        se gruppo:
            se_stesso._rinomina_finestra(rel, gruppo)
            ritorna
        nuovo = simpledialog.askstring("Rinomina", "Nuovo nome:", initialvalue=os.path.basename(rel), parent=se_stesso)
        se non nuovo o nuovo == os.path.basename(rel):
            ritorna
        vecchio = se_stesso.progetto.assoluto(rel)
        prova:
            nuovo_p = se_stesso.progetto.rinomina(rel, nuovo)
        eccetto OSError come errore:
            messagebox.showerror("Errore", testo(errore), parent=se_stesso)
            ritorna
        se_stesso.azioni.file_rinominato(vecchio, nuovo_p)
        se_stesso.aggiorna()

    definisci _rinomina_finestra(se_stesso, rel, gruppo):
        """Rinomina una finestra disegnata: i suoi file cambiano nome insieme, e con loro i nomi che ne dipendono."""
        base = se_stesso.progetto._base_finestra(rel)[1]
        nuovo = simpledialog.askstring("Rinomina finestra", f"Nuovo nome della finestra (rinomino insieme i suoi {lunghezza(gruppo)} file):",
                                       initialvalue=base, parent=se_stesso)
        se non nuovo o nuovo.strip() == base:
            ritorna
        se_stesso.azioni.salva_tutto()
        prova:
            coppie, riscritti = se_stesso.progetto.rinomina_finestra(rel, nuovo)
        eccetto (OSError, ErroreDiValore) come errore:
            messagebox.showerror("Rinomina finestra", testo(errore), parent=se_stesso)
            ritorna
        per v, n in coppie:
            se_stesso.azioni.file_rinominato(v, n)
        per w in lista(se_stesso.azioni.schede.values()):
            se hasattr(w, "ricarica_se_cambiato_su_disco"):
                prova:
                    w.ricarica_se_cambiato_su_disco()
                eccetto Exception:
                    passa
        se_stesso.aggiorna()
        se_stesso.azioni.info(f"Finestra rinominata in «{nuovo.strip()}»: {lunghezza(coppie)} file, {lunghezza(riscritti)} riscritti.")

    definisci cancella(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        se non rel:
            ritorna
        gruppo = se_stesso.progetto.gruppo_finestra(rel) se se_stesso._e_gruppo() altrimenti []
        se gruppo:
            nome = se_stesso.progetto._base_finestra(rel)[1]
            da_eliminare = DialogoGruppoFinestra(se_stesso, nome, gruppo).mostra()
            se non da_eliminare:
                ritorna
        altrimenti:
            se non messagebox.askyesno("Elimina", f"Eliminare definitivamente «{rel}»?", parent=se_stesso):
                ritorna
            da_eliminare = [rel]
        per r in da_eliminare:
            p = se_stesso.progetto.assoluto(r)
            prova:
                se_stesso.progetto.cancella(r)
            eccetto OSError come errore:
                messagebox.showerror("Errore", testo(errore), parent=se_stesso)
                interrompi
            se_stesso.azioni.file_eliminato(p)
        se_stesso.aggiorna()

    definisci imposta_principale(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        se rel e non e_cartella:
            se_stesso.progetto.imposta_principale(rel)
            se_stesso.aggiorna()
            se_stesso.azioni.info(f"File principale: {rel}")

    definisci mostra_in_esplora(se_stesso):
        rel, e_cartella = se_stesso._selezionato()
        p = se_stesso.progetto.assoluto(rel) se rel altrimenti se_stesso.progetto.cartella
        piattaforma.mostra_in_gestore_file(p)
