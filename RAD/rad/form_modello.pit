        f.write(nuova)
    se scritti è non Nessuno:
        scritti.append(destinazione)


MODELLO_GRIGLIA = os.path.join(CARTELLA_MODELLI, "griglia.pit")


definisci copia_griglia(cartella, scritti=Nessuno):
    """Mette nel progetto griglia.pit (il motore della disposizione a griglia); se la copia è diversa da quella di PitStudio la rinnova (la vecchia resta come .bak)."""
