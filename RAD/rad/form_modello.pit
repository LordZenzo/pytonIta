        con open(destinazione, encoding="utf-8", newline="") come f:
            vecchia = f.read().replace("\r\n", chr(10))
        se vecchia == nuova:
            ritorna
        shutil.copyfile(destinazione, destinazione + ".bak")
    con open(destinazione, "w", encoding="utf-8", newline="\n") come f:
        f.write(nuova)
    se scritti è non Nessuno:
        scritti.append(destinazione)


MODELLO_STAMPANTE = os.path.join(CARTELLA_MODELLI, "stampante.pit")


definisci copia_stampante(cartella, scritti=Nessuno):
    """Mette nel progetto stampante.pit (stampa e PDF); se la copia è diversa da quella di PitStudio la rinnova (la vecchia resta come .bak)."""
