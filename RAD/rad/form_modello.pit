definisci e_contenitore(tipo_):
    """True per i componenti che possono contenerne altri (Riquadro e Schede)."""
    ritorna TIPI[tipo_].get("contenitore", Falso)


definisci e_visivo(tipo_):
    """False per i componenti senza aspetto (barra dei menu, timer)."""
    ritorna TIPI[tipo_].get("visivo", Vero)

_RE_NOME = re.compile(r"^[^\W\d]\w*$")
PAROLE_RISERVATE = {"classe", "definisci", "se", "per", "da", "con", "e", "o", "non", "in", "passa",
                    "prova", "mentre", "ritorna", "importa", "lambda", "elimina", "attendi",
                    "asincrono", "Vero", "Falso", "Nessuno"}


definisci nome_valido(nome):
    ritorna bool(_RE_NOME.match(nome)) e nome non in PAROLE_RISERVATE


ALLINEAMENTI_COLONNA = ("w", "center", "e")
LARGHEZZA_COLONNA = 200       # predefinita di Tk


definisci colonne_albero(valori):
    """[(nome, larghezza, ancora)] delle colonne di un Albero; larghezze e allineamenti mancanti prendono i valori predefiniti di Tk."""
    nomi = tipo_lista(valori.get("colonne", []))
    larghezze = tipo_lista(valori.get("larghezze") o [])
    ancore = tipo_lista(valori.get("allineamenti") o [])
    risultato = []
    per i, nome in enumera(nomi):
        larghezza = larghezze[i] se i < lunghezza_di(larghezze) e larghezze[i] altrimenti LARGHEZZA_COLONNA
        ancora = ancore[i] se i < lunghezza_di(ancore) e ancore[i] in ALLINEAMENTI_COLONNA altrimenti "w"
        risultato.append((nome, int(larghezza), ancora))
    ritorna risultato


definisci proprieta_di(tipo_):
    """Proprietà specifiche del tipo + quelle comuni (tranne dove non hanno senso)."""
    p = dict(TIPI[tipo_]["proprieta"])
    se e_visivo(tipo_):
        p["ancoraggio"] = ("ancoraggio", "sa", "Si aggancia ai bordi")
    altrimenti:
        ritorna p
    se tipo_ non in ("Riquadro", "Schede", "Tela", "Separatore", "Immagine", "BarraProgresso", "Albero", "BarraNavigazione", "Grafico"):
        per k, v in COMUNI.items():
            p.setdefault(k, v)
    se tipo_ in ("Riquadro", "Immagine", "BarraProgresso", "Grafico"):
        p.setdefault("sfondo", COMUNI["sfondo"])
    ritorna p


classe Componente:
    definisci __inizializza__(se_stesso, tipo_, nome, x=10, y=10, larghezza=Nessuno, altezza=Nessuno, valori=Nessuno, genitore=""):
        info = TIPI[tipo_]
        se_stesso.tipo = tipo_
        se_stesso.nome = nome
        se_stesso.genitore = genitore        # "" = la finestra; "riquadro1" = dentro un riquadro; "schede1#0" = nella prima pagina di una Schede
        se_stesso.x = x
        se_stesso.y = y
        se_stesso.larghezza = larghezza o info["larghezza"]
        se_stesso.altezza = altezza o info["altezza"]
        se_stesso.valori = {}
        per k, (t, predefinito, d) in proprieta_di(tipo_).items():
            se_stesso.valori[k] = copy.deepcopy(predefinito)
        se valori:
            se_stesso.valori.update(valori)

    definisci a_dizionario(se_stesso):
        d = {"tipo": se_stesso.tipo, "nome": se_stesso.nome, "x": se_stesso.x, "y": se_stesso.y,
             "larghezza": se_stesso.larghezza, "altezza": se_stesso.altezza,
             "valori": copy.deepcopy(se_stesso.valori)}
        se se_stesso.genitore:
            d["genitore"] = se_stesso.genitore
        ritorna d

    @staticmethod
    definisci da_dizionario(d):
        ritorna Componente(d["tipo"], d["nome"], d.get("x", 10), d.get("y", 10),
                           d.get("larghezza"), d.get("altezza"), d.get("valori"), d.get("genitore", ""))


classe Form:
    """Una finestra: titolo, dimensioni e componenti posizionati in modo assoluto."""

    definisci __inizializza__(se_stesso, nome="Principale", titolo=Nessuno):
        se_stesso.nome = nome
        se_stesso.titolo = titolo o nome
        se_stesso.larghezza = 480
        se_stesso.altezza = 320
        se_stesso.sfondo = ""
        se_stesso.componenti = []
        se_stesso.ridimensionabile = Vero
        se_stesso.aspetto = "classico"      # "classico" (tkinter com'è) oppure un tema moderno: chiaro, scuro, verde, viola
        se_stesso.layout = "libero"         # «libero» oppure «griglia» (le posizioni vengono dalle celle)
        se_stesso.colonne = ""              # pesi delle colonne e delle righe della griglia, margine e spazio tra le celle
        se_stesso.righe = ""
        se_stesso.margine = 10
        se_stesso.spazio = 6

    # --- modifica
    definisci nome_libero(se_stesso, tipo_):
        base = tipo_[0].lower() + tipo_[1:]
        usati = {c.nome per c in se_stesso.componenti}
        n = 1
        mentre f"{base}{n}" in usati:
            n += 1
        ritorna f"{base}{n}"

    definisci aggiungi(se_stesso, tipo_, x=10, y=10, **valori):
        se tipo_ non in TIPI:
            solleva ErroreDiValore(f"tipo di componente sconosciuto: {tipo_}")
        genitore = valori.pop("genitore", "")
        c = Componente(tipo_, valori.pop("nome", Nessuno) o se_stesso.nome_libero(tipo_), x, y,
                       valori.pop("larghezza", Nessuno), valori.pop("altezza", Nessuno), valori, genitore)
        se non nome_valido(c.nome) o se_stesso.trova(c.nome):
            c.nome = se_stesso.nome_libero(tipo_)
        se_stesso.componenti.append(c)
        ritorna c

    definisci trova(se_stesso, nome):
        per c in se_stesso.componenti:
            se c.nome == nome:
                ritorna c
        ritorna Nessuno

    definisci figli(se_stesso, nome):
        """I componenti che stanno dentro il contenitore (anche in profondità)."""
        trovati = []
        per c in se_stesso.componenti:
            se c.genitore.split("#")[0] == nome:
                trovati.append(c)
                trovati.extend(se_stesso.figli(c.nome))
        ritorna trovati

    definisci rimuovi(se_stesso, nome):
        """Toglie il componente e tutto quello che contiene."""
        via = {nome} | {c.nome per c in se_stesso.figli(nome)}
        se_stesso.componenti = [c per c in se_stesso.componenti se c.nome non in via]
        per c in se_stesso.componenti:
            se c.valori.get("fonte") in via:
                c.valori["fonte"] = ""
                se "campo" in c.valori:
                    c.valori["campo"] = ""
            se c.tipo == "Stampa" e c.valori.get("sorgente") in via:
                c.valori["sorgente"] = ""

    definisci fonti(se_stesso):
        """I componenti FonteDati della finestra."""
        ritorna [c per c in se_stesso.componenti se c.tipo == "FonteDati"]

    definisci fonte_di(se_stesso, c):
        """La FonteDati a cui è legato il componente (o Nessuno)."""
        f = se_stesso.trova(c.valori.get("fonte") o "") se c.valori.get("fonte") altrimenti Nessuno
        ritorna f se f e f.tipo == "FonteDati" altrimenti Nessuno

    definisci rinomina(se_stesso, vecchio, nuovo):
        se non nome_valido(nuovo) o (se_stesso.trova(nuovo) e nuovo != vecchio):
            ritorna Falso
        c = se_stesso.trova(vecchio)
        se c è Nessuno:
            ritorna Falso
        c.nome = nuovo
        per f in se_stesso.componenti:
            se f.genitore.split("#")[0] == vecchio:
                f.genitore = nuovo + f.genitore[lunghezza_di(vecchio):]
            se c.tipo == "FonteDati" e f.valori.get("fonte") == vecchio:
                f.valori["fonte"] = nuovo
            se f.tipo == "Stampa" e f.valori.get("sorgente") == vecchio:
                f.valori["sorgente"] = nuovo
        ritorna Vero

    # --- serializzazione
    definisci a_dizionario(se_stesso):
        d = {"versione": 1, "nome": se_stesso.nome, "titolo": se_stesso.titolo,
             "larghezza": se_stesso.larghezza, "altezza": se_stesso.altezza,
             "sfondo": se_stesso.sfondo, "ridimensionabile": se_stesso.ridimensionabile, "aspetto": se_stesso.aspetto}
        se e_griglia(se_stesso.layout):                  # i file delle finestre libere restano com'erano
            d.update(layout=se_stesso.layout, colonne=se_stesso.colonne, righe=se_stesso.righe, margine=se_stesso.margine, spazio=se_stesso.spazio)
        d["componenti"] = [c.a_dizionario() per c in se_stesso.componenti]
        ritorna d

    @staticmethod
    definisci da_dizionario(d):
        f = Form(d.get("nome", "Principale"), d.get("titolo"))
        f.larghezza = d.get("larghezza", 480)
        f.altezza = d.get("altezza", 320)
        f.sfondo = d.get("sfondo", "")
        f.ridimensionabile = d.get("ridimensionabile", Vero)
        f.aspetto = d.get("aspetto", "classico")
        f.layout = d.get("layout", "libero") se d.get("layout") in ("libero", "griglia", "riga", "colonna") altrimenti "libero"
        f.colonne = d.get("colonne", "")
        f.righe = d.get("righe", "")
        f.margine = d.get("margine", 10)
        f.spazio = d.get("spazio", 6)
        per cd in d.get("componenti", []):
            se cd.get("tipo") in TIPI:
                f.componenti.append(Componente.da_dizionario(cd))
        ritorna f

    definisci a_json(se_stesso):
        ritorna json.dumps(se_stesso.a_dizionario(), indent=2, ensure_ascii=Falso)

    @staticmethod
    definisci da_json(testo_):
        ritorna Form.da_dizionario(json.loads(testo_))

    definisci eventi(se_stesso):
        """Elenco (componente, proprieta_evento, nome_funzione) dei gestori richiesti."""
        risultato = []
        per c in se_stesso.componenti:
            se c.tipo == "BarraMenu":
                per titolo, voci in voci_menu(c.valori.get("voci", "")):
                    per etichetta, gestore in voci:
                        se gestore e non gestore.startswith("@") e nome_valido(gestore):
                            risultato.append((c, "voci", gestore))
            per k, (t, d, desc) in proprieta_di(c.tipo).items():
                se t == "evento":
                    nome_fn = (c.valori.get(k) o "").strip()
                    se nome_fn e nome_valido(nome_fn):
                        risultato.append((c, k, nome_fn))
        ritorna risultato

    definisci problemi(se_stesso):
        """Controlli di coerenza: nomi duplicati, fuori dalla finestra, gestori non validi."""
        p = []
        visti = set()
        per c in se_stesso.componenti:
            se c.nome in visti:
                p.append(f"nome duplicato: {c.nome}")
            visti.add(c.nome)
            se c.genitore e non se_stesso.trova(c.genitore.split("#")[0]):
                p.append(f"{c.nome}: il contenitore «{c.genitore.split('#')[0]}» non esiste")
            se e_visivo(c.tipo) e non c.genitore e (c.x + c.larghezza > se_stesso.larghezza o c.y + c.altezza > se_stesso.altezza):
                p.append(f"{c.nome} esce dalla finestra")
            per k, (t, d, desc) in proprieta_di(c.tipo).items():
                se t == "evento" e c.valori.get(k) e non nome_valido(c.valori[k]):
                    p.append(f"{c.nome}.{k}: nome di funzione non valido")
            se c.tipo == "FonteDati" e non (c.valori.get("tabella") o "").strip():
                p.append(f"{c.nome}: scegli la tabella")
            se c.tipo == "Riquadro" e c.valori.get("scorrevole") e e_griglia(c.valori.get("layout")):
                p.append(f"{c.nome}: un riquadro scorrevole vuole la disposizione libera (non la griglia)")
            se c.tipo == "Stampa":
                sorgente_ = (c.valori.get("sorgente") o "").strip()
                se non sorgente_:
                    p.append(f"{c.nome}: scegli cosa stampare")
                altrimenti_se se_stesso.trova(sorgente_) è Nessuno:
                    p.append(f"{c.nome}: il componente «{sorgente_}» non esiste")
            se c.tipo != "FonteDati" e c.valori.get("fonte"):
                f = se_stesso.fonte_di(c)
                se f è Nessuno:
                    p.append(f"{c.nome}: la fonte dati «{c.valori['fonte']}» non esiste")
                altrimenti_se "campo" in c.valori e non c.valori.get("campo"):
                    p.append(f"{c.nome}: scegli il campo della tabella")
        ritorna p


# --------------------------------------------------------------------------- generazione
definisci voci_menu(testo_):
    """Legge il testo di una barra dei menu: [(titolo, [(etichetta, gestore)])]. Il gestore vuoto = voce senza azione, «-» = separatore,
    «@Finestra» = apre un'altra finestra del progetto.

        File
          Nuovo = nuovo_clic
          -
          Esci = esci_clic
    """
    menu = []
    per riga in (testo_ o "").split("\n"):
        se non riga.strip():
            continua
        rientro = lunghezza_di(riga) - lunghezza_di(riga.lstrip())
        se rientro == 0:
            menu.append((riga.strip(), []))
        altrimenti_se menu:
            t = riga.strip()
            se t == "-":
                menu[-1][1].append(("-", ""))
            altrimenti_se "=" in t:
                e_, g = t.split("=", 1)
                menu[-1][1].append((e_.strip(), g.strip()))
            altrimenti:
                menu[-1][1].append((t, ""))
    ritorna menu


definisci finestre_aperte(form):
    """I nomi delle finestre che questa finestra apre (da pulsanti e da voci di menu)."""
    nomi = []
    per c in form.componenti:
        se c.tipo == "Pulsante" e (c.valori.get("apre") o "").strip():
            nomi.append(c.valori["apre"].strip())
        se c.tipo == "BarraMenu":
            per titolo, voci in voci_menu(c.valori.get("voci", "")):
                per etichetta, gestore in voci:
                    se gestore.startswith("@") e gestore[1:].strip():
                        nomi.append(gestore[1:].strip())
    ritorna tipo_lista(dict.fromkeys(nomi))


# ---------------------------------------------------------------- layout a griglia
definisci definizione_griglia(form, genitore):
    """Come è fatta la griglia del contenitore `genitore` ('' = la finestra, 'nome' = un riquadro, 'nome#2' = una pagina di schede),
    oppure Nessuno se il contenitore è libero: {colonne, righe (pesi), margine, spazio}."""
    se non genitore:
        se non e_griglia(form.layout):
            ritorna Nessuno
        leggi = lambda k, p: getattr(form, k, p)
    altrimenti:
        c = form.trova(genitore.split("#")[0])
        se c è Nessuno o non e_contenitore(c.tipo) o non e_griglia(c.valori.get("layout")):
            ritorna Nessuno
        leggi = lambda k, p: c.valori.get(k, p)
    ritorna {"colonne": griglia.pesi_da_testo(leggi("colonne", "")), "righe": griglia.pesi_da_testo(leggi("righe", "")),
             "margine": int(leggi("margine", 10) o 0), "spazio": int(leggi("spazio", 6) o 0)}


LAYOUT_SEQUENZA = ("riga", "colonna")


definisci e_griglia(layout):
    """True per le disposizioni che usano le celle: «griglia» e anche «riga» e «colonna» (una griglia di una sola riga o colonna, ordinata da sola)."""
    ritorna layout in ("griglia", "riga", "colonna")


definisci layout_di(form, genitore):
    """La disposizione di un contenitore: '' = la finestra, 'nome' = un riquadro, 'nome#2' = una pagina di schede."""
    se non genitore:
        ritorna form.layout
    c = form.trova(genitore.split("#")[0])
    ritorna (c.valori.get("layout") se c è non Nessuno altrimenti "libero") o "libero"


definisci sequenza_ordinata(form, genitore):
    """I componenti di un contenitore «riga» o «colonna» nell'ordine in cui compaiono (prima per la loro cella, poi come sono nell'elenco)."""
    figli = figli_in_griglia(form, genitore)
    layout = layout_di(form, genitore)
    chiave = (lambda ic: (cella_di(ic[1])["colonna"], cella_di(ic[1])["riga"], ic[0])) se layout == "riga" altrimenti (lambda ic: (cella_di(ic[1])["riga"], cella_di(ic[1])["colonna"], ic[0]))
    ritorna [c per _, c in sorted(enumera(figli), key=chiave)]


definisci posizione_in_sequenza(form, c):
    """Il numero d'ordine di un componente nella riga o colonna che lo contiene."""
    ordine = sequenza_ordinata(form, c.genitore)
    ritorna ordine.index(c) se c in ordine altrimenti 0


definisci sposta_in_sequenza(form, c, indice):
    """Mette un componente alla posizione `indice` (da 0) della riga o colonna che lo contiene; gli altri scorrono."""
    layout = layout_di(form, c.genitore)
    ordine = [x per x in sequenza_ordinata(form, c.genitore) se x è non c]
    indice = max(0, min(lunghezza_di(ordine), indice))
    ordine.insert(indice, c)
    per i, x in enumera(ordine):
        se layout == "riga":
            imposta_cella(x, riga=0, colonna=i)
        altrimenti:
            imposta_cella(x, riga=i, colonna=0)


definisci normalizza_sequenze(form):
    """Per i contenitori «riga» e «colonna»: assegna le celle in ordine e calcola i pesi (chi «si allarga» prende lo spazio che avanza).
    Va chiamata prima di calcolare i rettangoli o generare il codice."""
    contenitori = [""]
    per c in form.componenti:
        se e_contenitore(c.tipo):
            contenitori.extend(pagine_di(c))
    per genitore in contenitori:
        layout = layout_di(form, genitore)
        se layout non in LAYOUT_SEQUENZA:
            continua
        figli = sequenza_ordinata(form, genitore)
        pesi = []
        riempie_traverso = Falso
        per i, c in enumera(figli):
            allinea = cella_di(c)["allinea"]
            espandi = bool(c.valori.get("espandi"))
            asse = "ew" se layout == "riga" altrimenti "ns"
            traverso = "ns" se layout == "riga" altrimenti "ew"
            se espandi e non (asse[0] in allinea e asse[1] in allinea):
                allinea = "".join(sorted(set(allinea) | set(asse)))
            se traverso[0] in allinea e traverso[1] in allinea:
                riempie_traverso = Vero
            imposta_cella(c, riga=0 se layout == "riga" altrimenti i, colonna=i se layout == "riga" altrimenti 0, righe=1, colonne=1, allinea=allinea)
            pesi.append("1" se espandi altrimenti "0")
        principale = ",".join(pesi) se pesi altrimenti "0"
        traverso_pesi = "1" se riempie_traverso altrimenti "0"
        se non genitore:
            form.colonne, form.righe = (principale, traverso_pesi) se layout == "riga" altrimenti (traverso_pesi, principale)
        altrimenti:
            contenitore = form.trova(genitore.split("#")[0])
            contenitore.valori["colonne"], contenitore.valori["righe"] = (principale, traverso_pesi) se layout == "riga" altrimenti (traverso_pesi, principale)


definisci cella_di(c):
    """La cella di un componente in una griglia: riga, colonna, quante righe e colonne occupa, allineamento (n, s, e, w)."""
    v = c.valori
    ritorna {"riga": max(0, int(v.get("g_riga", 0))), "colonna": max(0, int(v.get("g_colonna", 0))),
             "righe": max(1, int(v.get("g_righe", 1))), "colonne": max(1, int(v.get("g_colonne", 1))),
             "allinea": v["g_allinea"] se "g_allinea" in v altrimenti ALLINEA_PREDEFINITO.get(c.tipo, "w")}


definisci imposta_cella(c, riga=Nessuno, colonna=Nessuno, righe=Nessuno, colonne=Nessuno, allinea=Nessuno):
    se riga è non Nessuno:
        c.valori["g_riga"] = max(0, int(riga))
    se colonna è non Nessuno:
        c.valori["g_colonna"] = max(0, int(colonna))
    se righe è non Nessuno:
        c.valori["g_righe"] = max(1, int(righe))
    se colonne è non Nessuno:
        c.valori["g_colonne"] = max(1, int(colonne))
    se allinea è non Nessuno:
        c.valori["g_allinea"] = allinea


definisci figli_in_griglia(form, genitore):
    """I componenti visibili che stanno direttamente nel contenitore."""
    ritorna [c per c in form.componenti se c.genitore == genitore e e_visivo(c.tipo)]


definisci pagine_di(c):
    """Le chiavi dei contenitori interni di un componente: «nome» per un riquadro, «nome#0», «nome#1»… per le pagine di una Schede."""
    se c.tipo == "Schede":
        ritorna [f"{c.nome}#{i}" per i in intervallo_di(max(1, lunghezza_di(tipo_lista(c.valori.get("pagine", [])))))]
    ritorna [c.nome]


definisci rettangoli(form, tracce=Nessuno):
    """{nome: (x, y, larghezza, altezza)} dei componenti che stanno in un contenitore a griglia (gli altri usano le posizioni disegnate).
    Si calcola dall'alto verso il basso: la misura di un riquadro in una griglia dipende dalla sua cella.
    Se passi un dizionario in `tracce` ci scrive, per ogni contenitore a griglia, (inizi x, larghezze, inizi y, altezze) delle sue colonne e righe."""
    rett = {}
    normalizza_sequenze(form)

    definisci disponi(genitore, larghezza, altezza):
        d = definizione_griglia(form, genitore)
        figli = figli_in_griglia(form, genitore) se d è non Nessuno altrimenti []
        se non figli:
            ritorna
        voci = []
        per c in figli:
            k = cella_di(c)
            voci.append((k["riga"], k["colonna"], k["righe"], k["colonne"], k["allinea"], c.larghezza, c.altezza))
        per c, r in zip(figli, griglia.calcola(larghezza, altezza, voci, d["colonne"], d["righe"], d["margine"], d["spazio"])):
            rett[c.nome] = r
        se tracce è non Nessuno:
            tracce[genitore] = griglia.tracce(larghezza, altezza, voci, d["colonne"], d["righe"], d["margine"], d["spazio"])

    disponi("", form.larghezza, form.altezza)
    per c in ordine_creazione(form):
        se non e_contenitore(c.tipo):
            continua
        x, y, w, h = rett.get(c.nome, (c.x, c.y, c.larghezza, c.altezza))
        se c.tipo == "Schede":
            per chiave in pagine_di(c):
                disponi(chiave, w - AREA_PAGINA[0], h - AREA_PAGINA[1])
        altrimenti:
            b = int(c.valori.get("bordo", 0) o 0)
            disponi(c.nome, w - 2 * b, h - 2 * b)
    ritorna rett


definisci usa_griglia(form):
    ritorna e_griglia(form.layout) o any(e_griglia(c.valori.get("layout")) per c in form.componenti se e_contenitore(c.tipo))


definisci congela_celle(form, genitore):
    """Passando da «griglia» a «libero»: ogni componente tiene la posizione e la misura che aveva nella griglia."""
    rett = rettangoli(form)
    per c in figli_in_griglia(form, genitore):
        se c.nome in rett:
            c.x, c.y, c.larghezza, c.altezza = rett[c.nome]


definisci cella_vuota(form, genitore, colonna=Nessuno, escludi=Nessuno):
    """La prima cella libera per un componente nuovo: in `colonna` se c'è posto, altrimenti in una riga nuova. `escludi` = nome di un componente da non contare."""
    figli = [c per c in figli_in_griglia(form, genitore) se c.nome != escludi]
    occupate = set()
    per c in figli:
        k = cella_di(c)
        per r in intervallo_di(k["riga"], k["riga"] + k["righe"]):
            per col in intervallo_di(k["colonna"], k["colonna"] + k["colonne"]):
                occupate.add((r, col))
    se non figli:
        ritorna 0, colonna o 0
    ultima = max(r per r, _ in occupate)
    colonna = colonna o 0
    per r in intervallo_di(0, ultima + 1):
        se (r, colonna) non in occupate:
            ritorna r, colonna
    ritorna ultima + 1, colonna


definisci assegna_celle(form, genitore, tolleranza=12):
    """Passando da «libero» a «griglia»: ogni componente va nella cella che corrisponde alla sua posizione (posizioni di partenza vicine = stessa riga o colonna)."""
    figli = figli_in_griglia(form, genitore)
    definisci gruppi(valori):
        """Una funzione: posizione di partenza -> numero del gruppo (le posizioni entro la tolleranza dall'inizio di un gruppo ne fanno parte)."""
        capi = []
        per v in sorted(set(valori)):
            se non capi o v - capi[-1] > tolleranza:
                capi.append(v)
        ritorna lambda v: max(i per i, k in enumera(capi) se k <= v + tolleranza)
    colonna_di = gruppi([c.x per c in figli])
    riga_di = gruppi([c.y per c in figli])
    per c in figli:
        imposta_cella(c, riga=riga_di(c.y), colonna=colonna_di(c.x), righe=1, colonne=1, allinea=ALLINEA_PREDEFINITO.get(c.tipo, "w"))


definisci _lit(valore):
    """Letterale pytonIta per un valore Python."""
    se valore è Vero:
        ritorna "Vero"
    se valore è Falso:
        ritorna "Falso"
    se valore è Nessuno:
        ritorna "Nessuno"
    ritorna repr(valore)


definisci usa_stampa(form):
    """True se la finestra ha un componente Stampa (serve stampante.pit nel progetto)."""
    ritorna any(c.tipo == "Stampa" per c in form.componenti)


definisci usa_scorrevole(form):
    """True se la finestra ha un riquadro scorrevole (serve scorrevole.pit nel progetto)."""
    ritorna any(c.tipo == "Riquadro" e c.valori.get("scorrevole") per c in form.componenti)


definisci usa_grafico(form):
    """True se la finestra ha un Grafico (serve grafico.pit nel progetto)."""
    ritorna any(c.tipo == "Grafico" per c in form.componenti)


definisci usa_dati(form):
    """True se la finestra ha una fonte dati o una barra di navigazione (serve fonte_dati.pit nel progetto)."""
    ritorna any(c.tipo in ("FonteDati", "BarraNavigazione") per c in form.componenti)


definisci _codice_dati(form):
    """I collegamenti ai dati, in fondo alla costruzione: ogni FonteDati apre la tabella e legge/scrive i componenti che le sono legati."""
    ind = "        "
    r = []
    per f in form.fonti():
        v = f.valori
        opzioni = [f"radice", "se_stesso.cartella", _lit(v.get("dialetto") o "sqlite"), _lit(v.get("database") o ""), _lit(v.get("tabella") o "")]
        se v.get("dialetto") == "mysql":
            opzioni += [f"server={_lit(v.get('server') o 'localhost')}", f"porta={int(v.get('porta') o 3306)}", f"utente={_lit(v.get('utente') o 'root')}"]
        altrimenti_se v.get("dialetto") == "postgres":
            porta_ = int(v.get("porta") o 5432)
            se porta_ == 3306:
                porta_ = 5432                # la porta predefinita di MySQL lasciata per distrazione: per PostgreSQL è la 5432
            opzioni += [f"server={_lit(v.get('server') o 'localhost')}", f"porta={porta_}", f"utente={_lit(v.get('utente') o 'postgres')}"]
        se (v.get("filtro") o "").strip():
            opzioni.append(f"filtro={_lit(v['filtro'].strip())}")
        se v.get("ordina_per"):
            opzioni.append(f"ordina_per={_lit(v['ordina_per'])}")
            se v.get("decrescente"):
                opzioni.append("decrescente=Vero")
        g = (v.get("al_cambio") o "").strip()
        se g e nome_valido(g):
            opzioni.append(f"al_cambio=se_stesso.{g}")
        se non v.get("salva_da_solo", Vero):
            opzioni.append("salva_da_solo=Falso")
        se v.get("transazione"):
            opzioni.append("transazione=Vero")
        r.append(f"{ind}# --- dati: {f.nome} ({v.get('tabella') o 'tabella da scegliere'})")
        r.append(f"{ind}se_stesso.{f.nome} = dati.Collegamento.crea({', '.join(opzioni)})")
        per c in form.componenti:
            se c.tipo == "FonteDati" o c.valori.get("fonte") != f.nome:
                continua
            campo = c.valori.get("campo") o ""
            se c.tipo == "BarraNavigazione":
                r.append(f"{ind}se_stesso.{f.nome}.collega_barra(se_stesso.{c.nome})")
            altrimenti_se c.tipo == "Grafico":
                r.append(f"{ind}se_stesso.{f.nome}.collega_grafico(se_stesso.{c.nome}, {_lit(c.valori.get('colonna_etichette') o '')}, {_lit(c.valori.get('colonna_valori') o '')})")
            altrimenti_se c.tipo == "Albero":
                r.append(f"{ind}se_stesso.{f.nome}.collega_griglia(se_stesso.{c.nome}{', modificabile=Vero' se c.valori.get('modificabile') altrimenti ''})")
            altrimenti_se c.tipo == "Elenco" e campo:
                r.append(f"{ind}se_stesso.{f.nome}.collega_griglia(se_stesso.{c.nome}, {_lit(campo)})")
            altrimenti_se campo:
                r.append(f"{ind}se_stesso.{f.nome}.collega_campo(se_stesso.{c.nome}, {_lit(campo)})")
        se v.get("apri_subito", Vero):
            r.append(f"{ind}se_stesso.{f.nome}.apri()")
    ritorna r


definisci _nome_classe(nome_form):
    ritorna "".join(p[:1].upper() + p[1:] per p in re.split(r"[^\w]+", nome_form) se p) o "Form"


definisci nome_file_ui(nome_form):
    ritorna nome_form.lower() + "_ui"


definisci genera_ui(form):
    """Codice della classe che costruisce la finestra. Si rigenera: non modificarlo a mano."""
    cl = _nome_classe(form.nome)
    r = []
    r.append(f'"""Finestra {form.nome} - generato da PitStudio ({versioni.testo_intestazione()}). NON modificare: i cambi vanno nel progettista."""')
    r.append("importa interfaccia come tk")
    r.append("da interfaccia importa tema")
    r.append("importa os")
    se form.aspetto != "classico":
        r.append("da aspetto importa applica_aspetto")
    se usa_dati(form):
        r.append("importa fonte_dati come dati")
    se usa_griglia(form):
        r.append("importa griglia")
    se usa_grafico(form):
        r.append("importa grafico")
    se usa_scorrevole(form):
        r.append("importa scorrevole")
    se usa_stampa(form):
        r.append("importa stampante")
    r.append("")
    r.append("")
    r.append(f"classe {cl}UI:")
    r.append(f"    definisci costruisci_ui(se_stesso, radice, cartella=Nessuno):")
    r.append('        """Crea tutti i componenti dentro \'radice\'."""')
    r.append("        se_stesso.radice = radice")
    r.append("        radice._interfaccia_ui = se_stesso     # tiene vive le variabili delle caselle anche se nessuno conserva l'oggetto")
    r.append("        se_stesso.cartella = cartella o os.path.dirname(os.path.abspath(__file__))")
    se form.aspetto != "classico":
        r.append(f"        applica_aspetto(radice, {_lit(form.aspetto)})      # prima dei componenti: i colori scritti a mano restano")
    r.append(f"        radice.titolo({_lit(form.titolo)})")
    r.append(f'        radice.geometria("{form.larghezza}x{form.altezza}")')
    r.append('        _pos = os.environ.get("PITSTUDIO_ANTEPRIMA")      # solo con ▶ Prova di PitStudio: la finestra riappare dove l\'avevi lasciata')
    r.append("        se _pos:")
    r.append("            prova:")
    r.append(f'                radice.geometry("{form.larghezza}x{form.altezza}" + open(_pos).read().strip())')
    r.append("            eccetto (OSError, tk.TclError):")
    r.append("                passa")
    r.append("            definisci _ricorda(evento, _pos=_pos):")
    r.append("                se evento.widget è radice e radice.winfo_x() > -10000:")
    r.append("                    prova:")
    r.append('                        con open(_pos, "w") come f:')
    r.append('                            f.write(f"+{radice.winfo_x()}+{radice.winfo_y()}")')
    r.append("                    eccetto OSError:")
    r.append("                        passa")
    r.append('            radice.bind("<Configure>", _ricorda, add="+")')
    r.append(f"        radice.ridimensionabile({_lit(form.ridimensionabile)}, {_lit(form.ridimensionabile)})")
    se form.sfondo:
        r.append(f"        radice.configura(sfondo={_lit(form.sfondo)})")
    r.append("        se_stesso.immagini = []")
    form._rettangoli = rettangoli(form)           # le posizioni dei componenti nelle griglie (si usano in _codice_componente)
    per c in ordine_creazione(form):
        r.extend(_codice_componente(c, form))
    r.extend(_codice_griglie(form))
    r.extend(_codice_scorrevoli(form))
    r.extend(_codice_dati(form))
    r.append("        ritorna radice")
    r.append("")
    # timer: avvia/ferma e il giro che richiama l'evento
    per c in form.componenti:
        se c.tipo == "Timer":
            gestore_t = (c.valori.get("al_tempo") o "").strip()
            r.append(f"    definisci {c.nome}_avvia(se_stesso):")
            r.append(f'        """Fa partire il timer {c.nome} (ogni {c.valori.get("intervallo", 1000)} ms)."""')
            r.append(f"        se non se_stesso._timer_{c.nome}_attivo:")
            r.append(f"            se_stesso._timer_{c.nome}_attivo = Vero")
            r.append(f"            se_stesso.radice.after({int(c.valori.get('intervallo', 1000))}, se_stesso._timer_{c.nome}_passo)")
            r.append("")
            r.append(f"    definisci {c.nome}_ferma(se_stesso):")
            r.append(f"        se_stesso._timer_{c.nome}_attivo = Falso")
            r.append("")
            r.append(f"    definisci _timer_{c.nome}_passo(se_stesso):")
            r.append(f"        se non se_stesso._timer_{c.nome}_attivo:")
            r.append("            ritorna")
            se gestore_t e nome_valido(gestore_t):
                r.append(f"        se_stesso.{gestore_t}()")
            r.append(f"        se se_stesso._timer_{c.nome}_attivo:")
            r.append(f"            se_stesso.radice.after({int(c.valori.get('intervallo', 1000))}, se_stesso._timer_{c.nome}_passo)")
            r.append("")
    # finestre che si aprono da pulsanti e voci di menu
    per nome_f in finestre_aperte(form):
        se non nome_valido(nome_f):
            continua
        come_dialogo = any(c.tipo == "Pulsante" e (c.valori.get("apre") o "").strip() == nome_f e c.valori.get("apre_dialogo") per c in form.componenti)
        chiamate = [c.valori.get("al_clic").strip() per c in form.componenti
                    se c.tipo == "Pulsante" e (c.valori.get("apre") o "").strip() == nome_f e (c.valori.get("al_clic") o "").strip() e nome_valido(c.valori["al_clic"].strip())]
        r.append(f"    definisci _apri_{nome_f}(se_stesso, evento=Nessuno):")
        r.append(f'        """Apre la finestra {nome_f} (disegnata in {nome_f.lower()}.form.json)."""')
        per g in tipo_lista(dict.fromkeys(chiamate)):
            r.append(f"        se_stesso.{g}()")
        r.append(f"        da {nome_f.lower()} importa {_nome_classe(nome_f)}")
        r.append("        finestra = tk.Toplevel(se_stesso.radice)")
        r.append(f"        {_nome_classe(nome_f)}(finestra)")
        se come_dialogo:
            r.append("        finestra.transient(se_stesso.radice)")
            r.append("        finestra.grab_set()")
        r.append("")
    # gestori predefiniti (vuoti): la classe di logica li ridefinisce
    gestori = []
    per comp, k, nome_fn in form.eventi():
        se nome_fn non in gestori:
            gestori.append(nome_fn)
    per nome_fn in gestori:
        r.append(f"    definisci {nome_fn}(se_stesso, evento=Nessuno):")
        r.append("        passa")
        r.append("")
    ritorna "\n".join(r).rstrip() + "\n"


STILI_CARATTERE = ("bold", "italic", "underline", "overstrike")


definisci font_scomponi(testo_):
    """«Segoe UI 11 bold italic» diventa ('Segoe UI', 11, {'bold', 'italic'}). Senza dimensione: (testo, 0, insieme vuoto)."""
    parti = (testo_ o "").split()
    indice = Nessuno
    per i, p in enumera(parti):
        se p.lstrip("-").isdigit():
            indice = i
            interrompi
    se indice è Nessuno:
        ritorna " ".join(parti), 0, set()
    ritorna " ".join(parti[:indice]), int(parti[indice]), {s.lower() per s in parti[indice + 1:] se s.lower() in STILI_CARATTERE}


definisci font_componi(famiglia, dimensione, stili):
    """L'inverso di font_scomponi: ('Segoe UI', 11, {'bold'}) diventa «Segoe UI 11 bold». Con gli stili ma senza dimensione ne mette una, altrimenti Tk non li capirebbe."""
    parti = [famiglia.strip()] se (famiglia o "").strip() altrimenti []
    se stili e non dimensione:
        dimensione = 10
    se dimensione:
        parti.append(tipo_testo(dimensione))
    parti += [s per s in STILI_CARATTERE se s in stili]
    ritorna " ".join(parti)


definisci famiglie_sistema():
    """I caratteri installati nel sistema (ordinati, senza doppioni); lista vuota se non si possono leggere. Serve una finestra Tk già creata."""
    prova:
        da tkinter importa font come tkfont
        ritorna sorted({f per f in tkfont.families() se f e non f.startswith(("@", "."))}, key=lambda f: f.lower())
    eccetto Exception:
        ritorna []


definisci font_tk(testo_):
    """Il carattere come lo vuole Tk: «Segoe UI 14 bold» diventa ('Segoe UI', 14, 'bold') (un nome con spazi non si può scrivere in una stringa semplice)."""
    parti = (testo_ o "").split()
    se non parti:
        ritorna testo_
    indice = Nessuno
    per i, p in enumera(parti):
        se p.lstrip("-").isdigit():
            indice = i
            interrompi
    se indice è Nessuno:
        ritorna (" ".join(parti),)
    famiglia = " ".join(parti[:indice]) o "TkDefaultFont"
    ritorna (famiglia, int(parti[indice])) + tuple(parti[indice + 1:])


definisci _opzioni_comuni(c):
    opzioni = []
    v = c.valori
    se v.get("sfondo"):
        opzioni.append(f"sfondo={_lit(v['sfondo'])}")
    se v.get("primo_piano"):
        opzioni.append(f"primo_piano={_lit(v['primo_piano'])}")
    se v.get("carattere"):
        opzioni.append(f"carattere={_lit(font_tk(v['carattere']))}")
    se v.get("stato") e v["stato"] != "normale":
        opzioni.append(f"stato={_lit('disabled' se v['stato'] == 'disabilitato' altrimenti 'normal')}")
    ritorna opzioni


definisci padre_codice(c):
    """Come si scrive, nel codice generato, il contenitore di un componente."""
    se non c.genitore:
        ritorna "radice"
    nome, _, indice = c.genitore.partition("#")
    se indice:
        ritorna f"se_stesso.{nome}_pagina{int(indice) + 1}"
    ritorna f"se_stesso.{nome}"


definisci ordine_creazione(form):
    """I componenti con i contenitori prima di quello che contengono."""
    fatti = []
    nomi = {c.nome per c in form.componenti}
    in_attesa = tipo_lista(form.componenti)
    mentre in_attesa:
        avanzato = Falso
        per c in tipo_lista(in_attesa):
            padre = c.genitore.split("#")[0]
            se non padre o padre non in nomi o any(f.nome == padre per f in fatti):
                fatti.append(c)
                in_attesa.remove(c)
                avanzato = Vero
        se non avanzato:
            fatti.extend(in_attesa)
            interrompi
    ritorna fatti


definisci _codice_griglie(form):
    """Le chiamate che dispongono a griglia i componenti di ogni contenitore a griglia (e li ridispongono quando la finestra cambia misura)."""
    r = []
    contenitori = [""]
    per c in form.componenti:
        se e_contenitore(c.tipo):
            contenitori.extend(pagine_di(c))
    per genitore in contenitori:
        d = definizione_griglia(form, genitore)
        figli = figli_in_griglia(form, genitore)
        se d è Nessuno o non figli:
            continua
        contenitore = "radice"
        se genitore:
            nome, _, indice = genitore.partition("#")
            contenitore = f"se_stesso.{nome}_pagina{int(indice) + 1}" se indice altrimenti f"se_stesso.{nome}"
        voci = []
        per c in figli:
            k = cella_di(c)
            voci.append(f"            (se_stesso.{c.nome}, {k['riga']}, {k['colonna']}, {k['righe']}, {k['colonne']}, {_lit(k['allinea'])}, {c.larghezza}, {c.altezza})")
        r.append(f"        griglia.disponi({contenitore}, [")
        r.append(",\n".join(voci) + "],")
        r.append(f"            {_lit(d['colonne'])}, {_lit(d['righe'])}, {d['margine']}, {d['spazio']})")
    ritorna r


definisci _codice_scorrevoli(form):
    """Rende scorrevoli i riquadri che lo chiedono: va dopo la creazione dei loro componenti."""
    r = []
    per c in form.componenti:
        se c.tipo == "Riquadro" e c.valori.get("scorrevole"):
            r.append(f"        scorrevole.rendi_scorrevole(se_stesso.{c.nome}, {c.larghezza}, {c.altezza})")
    ritorna r


definisci misure_programma(c):
    """Larghezza e altezza di un componente nel programma: uguali a quelle disegnate, tranne per un riquadro scorrevole (si vede solo la parte «visibile»)."""
    se c.tipo == "Riquadro" e c.valori.get("scorrevole"):
        larg = int(c.valori.get("visibile_larghezza") o 0) o c.larghezza
        alt = int(c.valori.get("visibile_altezza") o 0) o c.altezza
        ritorna min(larg, c.larghezza), min(alt, c.altezza)
    ritorna c.larghezza, c.altezza


definisci _geometria(c, form):
    """Argomenti di posiziona(): posizione fissa oppure legata ai bordi della finestra (ancoraggio: s=sinistra, a=alto, d=destra, b=basso)."""
    larg, alt = misure_programma(c)
    anc = (c.valori.get("ancoraggio") o "sa")
    se form è Nessuno o anc == "sa" o c.genitore:
        ritorna f"x={c.x}, y={c.y}, width={larg}, height={alt}"
    L, H = form.larghezza, form.altezza
    parti = []
    se "s" in anc e "d" in anc:
        parti += [f"x={c.x}", "relwidth=1", f"width={-(L - c.x - larg)}"]
    altrimenti_se "d" in anc:
        parti += ["relx=1", f"x={-(L - c.x)}", f"width={larg}"]
    altrimenti:
        parti += [f"x={c.x}", f"width={larg}"]
    se "a" in anc e "b" in anc:
        parti += [f"y={c.y}", "relheight=1", f"height={-(H - c.y - alt)}"]
    altrimenti_se "b" in anc:
        parti += ["rely=1", f"y={-(H - c.y)}", f"height={alt}"]
    altrimenti:
        parti += [f"y={c.y}", f"height={alt}"]
    ritorna ", ".join(parti)


definisci _codice_componente(c, form=Nessuno):
    v = c.valori
    n = c.nome
    ind = "        "
    nome_att = f"se_stesso.{n}"
    info = TIPI[c.tipo]
    cl = f"{info['modulo']}.{info['classe_tk']}"
    r = []
    ev = lambda chiave: (v.get(chiave) o "").strip()
    gestore = lambda chiave: f"se_stesso.{ev(chiave)}" se ev(chiave) e nome_valido(ev(chiave)) altrimenti Nessuno
    opz = _opzioni_comuni(c)
    se c.tipo == "Pulsante":
        opzioni = [f"testo={_lit(v['testo'])}"] + opz
        apre = (v.get("apre") o "").strip()
        se apre e nome_valido(apre):
            opzioni.append(f"comando=se_stesso._apri_{apre}")
        altrimenti_se gestore("al_clic"):
            opzioni.append(f"comando={gestore('al_clic')}")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
    altrimenti_se c.tipo == "Etichetta":
        opzioni = [f"testo={_lit(v['testo'])}", f"justify={_lit({'sinistra': 'left', 'centro': 'center', 'destra': 'right'}[v['allineamento']])}",
             f"anchor={_lit(v['ancora'])}"] + opz
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
    altrimenti_se c.tipo == "CampoTesto":
        opzioni = opz[:]
        se v.get("nascondi"):
            opzioni.append('show="*"')
        r.append(f"{ind}{nome_att} = {cl}(radice{', ' + ', '.join(opzioni) se opzioni altrimenti ''})")
        se v.get("testo"):
            r.append(f"{ind}{nome_att}.inserisci(0, {_lit(v['testo'])})")
        se gestore("al_invio"):
            r.append(f"{ind}{nome_att}.associa('<Return>', {gestore('al_invio')})")
    altrimenti_se c.tipo == "AreaTesto":
        opzioni = [f"wrap={_lit('word' se v.get('a_capo') altrimenti 'none')}"] + opz
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
        se v.get("testo"):
            r.append(f"{ind}{nome_att}.inserisci('1.0', {_lit(v['testo'])})")
    altrimenti_se c.tipo == "Elenco":
        r.append(f"{ind}{nome_att} = {cl}(radice{', ' + ', '.join(opz) se opz altrimenti ''}, exportselection=Falso)")
        r.append(f"{ind}per voce in {_lit(list(v.get('elementi', [])))}:")
        r.append(f"{ind}    {nome_att}.inserisci('end', voce)")
        se gestore("al_selezione"):
            r.append(f"{ind}{nome_att}.associa('<<ListboxSelect>>', {gestore('al_selezione')})")
    altrimenti_se c.tipo == "CasellaSelezione":
        r.append(f"{ind}se_stesso.var_{n} = tk.VariabileBooleana(value={_lit(bool(v.get('selezionata')))})")
        opzioni = [f"testo={_lit(v['testo'])}", f"variable=se_stesso.var_{n}", "anchor='w'"] + opz
        se gestore("al_clic"):
            opzioni.append(f"comando={gestore('al_clic')}")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
    altrimenti_se c.tipo == "PulsanteOpzione":
        g = v.get("gruppo") o "gruppo1"
        r.append(f"{ind}se non hasattr(se_stesso, 'var_{g}'):")
        r.append(f"{ind}    se_stesso.var_{g} = tk.VariabileTesto(value='')")
        opzioni = [f"testo={_lit(v['testo'])}", f"variable=se_stesso.var_{g}", f"value={_lit(v['valore'])}", "anchor='w'"] + opz
        se gestore("al_clic"):
            opzioni.append(f"comando={gestore('al_clic')}")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
        se v.get("selezionata"):
            r.append(f"{ind}se_stesso.var_{g}.imposta({_lit(v['valore'])})")
    altrimenti_se c.tipo == "Cursore":
        opzioni = [f"from_={v['da']}", f"to={v['a']}",
             f"orient={_lit('horizontal' se v['orientamento'] == 'orizzontale' altrimenti 'vertical')}"] + opz
        se gestore("al_cambio"):
            opzioni.append(f"command=lambda valore: {gestore('al_cambio')}(valore)")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
        r.append(f"{ind}{nome_att}.imposta({v['valore']})")
    altrimenti_se c.tipo == "CasellaCombinata":
        r.append(f"{ind}{nome_att} = {cl}(radice, values={_lit(list(v.get('valori', [])))})")
        se v.get("valore"):
            r.append(f"{ind}{nome_att}.set({_lit(v['valore'])})")
        se gestore("al_selezione"):
            r.append(f"{ind}{nome_att}.associa('<<ComboboxSelected>>', {gestore('al_selezione')})")
    altrimenti_se c.tipo == "BarraProgresso":
        r.append(f"{ind}{nome_att} = {cl}(radice, maximum={v['massimo']}, value={v['valore']})")
    altrimenti_se c.tipo == "Albero":
        colonne = list(v.get("colonne", []))
        r.append(f"{ind}{nome_att} = {cl}(radice, columns={_lit(colonne)}, show='headings')")
        r.append(f"{ind}per colonna in {_lit(colonne)}:")
        r.append(f"{ind}    {nome_att}.heading(colonna, text=colonna)")
        se v.get("larghezze") o v.get("allineamenti"):
            per nome_col, larghezza_col, ancora_col in colonne_albero(v):
                r.append(f"{ind}{nome_att}.column({_lit(nome_col)}, width={larghezza_col}, anchor={_lit(ancora_col)})")
                r.append(f"{ind}{nome_att}.heading({_lit(nome_col)}, anchor={_lit(ancora_col)})")
        se gestore("al_selezione"):
            r.append(f"{ind}{nome_att}.associa('<<TreeviewSelect>>', {gestore('al_selezione')})")
    altrimenti_se c.tipo == "Grafico":
        opzioni = [f"tipo={_lit(v.get('tipo') o 'barre')}", f"titolo={_lit(v.get('titolo') o '')}", f"dati={_lit(tipo_lista(v.get('dati', [])))}",
             f"mostra_valori={_lit(bool(v.get('mostra_valori', Vero)))}"]
        se v.get("colore"):
            opzioni.append(f"colore={_lit(v['colore'])}")
        se v.get("sfondo"):
            opzioni.append(f"sfondo={_lit(v['sfondo'])}")
        se v.get("primo_piano"):
            opzioni.append(f"testo_={_lit(v['primo_piano'])}")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
    altrimenti_se c.tipo == "Tela":
        r.append(f"{ind}{nome_att} = {cl}(radice, background={_lit(v.get('sfondo') o '#ffffff')}, highlightthickness=0)")
    altrimenti_se c.tipo == "Riquadro":
        rilievo = {"piatto": "flat", "rialzato": "raised", "incavato": "sunken", "solido": "solid"}[v["rilievo"]]
        opzioni = [f"relief={_lit(rilievo)}", f"borderwidth={v['bordo']}"]
        se v.get("sfondo"):
            opzioni.append(f"background={_lit(v['sfondo'])}")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})")
    altrimenti_se c.tipo == "Schede":
        r.append(f"{ind}{nome_att} = {cl}(radice)")
        per i, nome_pagina in enumera(tipo_lista(v.get("pagine", [])) o ["Pagina 1"]):
            r.append(f"{ind}{nome_att}_pagina{i + 1} = tk.Riquadro({nome_att})")
            r.append(f"{ind}{nome_att}.add({nome_att}_pagina{i + 1}, text={_lit(nome_pagina)})")
    altrimenti_se c.tipo == "Immagine":
        r.append(f"{ind}{nome_att} = {cl}(radice)")
        se v.get("file"):
            r.append(f"{ind}se_stesso.carica_immagine({nome_att}, {_lit(v['file'])}, {c.larghezza}, {c.altezza})")
    altrimenti_se c.tipo == "Separatore":
        r.append(f"{ind}{nome_att} = {cl}(radice, orient={_lit('horizontal' se v['orientamento'] == 'orizzontale' altrimenti 'vertical')})")
    altrimenti_se c.tipo == "BarraMenu":
        r.append(f"{ind}{nome_att} = tk.Menu(radice)")
        per i, (titolo, voci) in enumera(voci_menu(v.get("voci", ""))):
            m = f"{nome_att}_{i + 1}"
            r.append(f"{ind}{m} = tk.Menu({nome_att}, tearoff=0)")
            per etichetta, g in voci:
                se etichetta == "-":
                    r.append(f"{ind}{m}.add_separator()")
                altrimenti_se g.startswith("@") e nome_valido(g[1:].strip()):
                    r.append(f"{ind}{m}.add_command(label={_lit(etichetta)}, command=se_stesso._apri_{g[1:].strip()})")
                altrimenti_se g e nome_valido(g):
                    r.append(f"{ind}{m}.add_command(label={_lit(etichetta)}, command=se_stesso.{g})")
                altrimenti:
                    r.append(f"{ind}{m}.add_command(label={_lit(etichetta)}, state='disabled')")
            r.append(f"{ind}{nome_att}.add_cascade(label={_lit(titolo)}, menu={m})")
        r.append(f"{ind}radice.config(menu={nome_att})")
        ritorna r
    altrimenti_se c.tipo == "Timer":
        r.append(f"{ind}se_stesso._timer_{n}_attivo = Falso")
        se v.get("attivo"):
            r.append(f"{ind}se_stesso.{n}_avvia()")
        ritorna r
    altrimenti_se c.tipo == "Stampa":
        opzioni = [f"se_stesso", f"{_lit((v.get('sorgente') o '').strip())}", f"titolo={_lit(v.get('titolo') o '')}", f"intestazione={_lit(v.get('intestazione') o '')}",
             f"orientamento={_lit(v.get('orientamento') o 'verticale')}", f"numeri_pagina={_lit(bool(v.get('numeri_pagina', Vero)))}"]
        # le impostazioni di stampa diverse da quelle predefinite
        imp = {}
        per chiave, nome_imp, predefinito in (("stampante", "stampante", ""), ("copie", "copie", 1), ("fascicola", "fascicola", Vero), ("formato", "carta", "A4"),
                                              ("margine", "margine", 15), ("scala", "scala", 100), ("pagine", "pagine", ""), ("fronte_retro", "fronte_retro", "no"),
                                              ("colore", "colore", "colore"), ("qualita", "qualita", "normale")):
            valore = v.get(chiave, predefinito)
            se valore != predefinito e valore è non Nessuno:
                imp[nome_imp] = valore
        se imp:
            opzioni.append("impostazioni={" + ", ".join(f"{_lit(k)}: {_lit(x)}" per k, x in imp.items()) + "}")
        se v.get("chiedi"):
            opzioni.append("chiedi=Vero")
        se v.get("ricorda"):
            opzioni.append(f"nome={_lit(n)}")
            opzioni.append("ricorda=Vero")
        r.append(f"{ind}{nome_att} = {cl}(radice, {', '.join(opzioni)})          # {n}.finestra_stampa(), {n}.stampa(), {n}.anteprima(), {n}.salva_pdf(), {n}.imposta(copie=2)")
        ritorna r
    altrimenti_se c.tipo == "FonteDati":
        ritorna r                     # si crea in fondo (_codice_dati), quando i componenti legati esistono
    altrimenti_se c.tipo == "BarraNavigazione":
        pulsanti = tuple(k per k in PULSANTI_BARRA se v.get(k, k non in PULSANTI_FACOLTATIVI))
        r.append(f"{ind}{nome_att} = dati.BarraDati(radice, pulsanti={_lit(pulsanti)}, posizione={_lit(bool(v.get('posizione', Vero)))}, cerca={_lit(bool(v.get('cerca')))}{'' se v.get('dati', Vero) altrimenti ', dati=Falso'})")
    rett = getattr(form, "_rettangoli", Nessuno) se form è non Nessuno altrimenti Nessuno
    se rett e c.nome in rett:
        x_, y_, w_, h_ = rett[c.nome]          # in una griglia: la posizione di partenza viene dalla cella (poi disponi() la aggiorna)
        r.append(f"{ind}{nome_att}.posiziona(x={x_}, y={y_}, width={w_}, height={h_})")
    altrimenti:
        r.append(f"{ind}{nome_att}.posiziona({_geometria(c, form)})")
    se c.genitore:
        padre = padre_codice(c)
        r = [riga.replace(f"{cl}(radice", f"{cl}({padre}", 1) se f"{cl}(radice" in riga altrimenti riga.replace("dati.BarraDati(radice", f"dati.BarraDati({padre}", 1) per riga in r]
    ritorna r


definisci genera_ui_completa(form):
    """genera_ui + il metodo di supporto per le immagini (se serve)."""
    codice = genera_ui(form)
    se any(c.tipo == "Immagine" per c in form.componenti):
        aiuto = '''
    definisci carica_immagine(se_stesso, etichetta, file, larghezza, altezza):
        """Mostra un'immagine ridimensionata dentro un'etichetta."""
        percorso = file se os.path.isabs(file) altrimenti os.path.join(se_stesso.cartella, file)
        prova:
            da PIL importa Image, ImageTk
            img = Image.open(percorso)
            img.thumbnail((larghezza, altezza))
            foto = ImageTk.PhotoImage(img)
        eccetto Eccezione:
            etichetta.configura(testo="[immagine]")
            ritorna
        se_stesso.immagini.append(foto)
        etichetta.configura(image=foto)
'''
        marca = "        ritorna radice\n"
        punto = codice.index(marca) + lunghezza_di(marca)
        codice = codice[:punto] + aiuto + codice[punto:]
    ritorna codice


definisci genera_logica(form):
    """Classe di logica con i gestori degli eventi (si crea una volta sola)."""
    cl = _nome_classe(form.nome)
    r = []
    r.append(f'"""Logica della finestra {form.nome}. Qui scrivi il codice: PitStudio aggiunge solo i gestori mancanti."""')
    r.append("importa interfaccia come tk")
    r.append(f"da {nome_file_ui(form.nome)} importa {cl}UI")
    se form.aspetto != "classico":
        r.append("da aspetto importa abilita_dpi")
    r.append("")
    r.append("")
    r.append(f"classe {cl}({cl}UI):")
    r.append("    definisci __inizializza__(se_stesso, radice):")
    r.append("        se_stesso.costruisci_ui(radice)")
    r.append("")
    gestori = []
    per comp, k, nome_fn in form.eventi():
        se nome_fn non in gestori:
            gestori.append(nome_fn)
            r.append(f"    definisci {nome_fn}(se_stesso, evento=Nessuno):")
            r.append(f"        # {comp.nome}: {proprieta_di(comp.tipo)[k][2]}")
            r.append("        passa")
            r.append("")
    r.append("")
    r.append('se __nome__ == "__main__":')
    se form.aspetto != "classico":
        r.append("    abilita_dpi()                        # testi nitidi sugli schermi ad alta risoluzione")
    r.append("    radice = tk.Finestra()")
    r.append(f"    finestra = {cl}(radice)")
    r.append("    radice.ciclo_principale()")
    ritorna "\n".join(r).rstrip() + "\n"


definisci aggiorna_logica(form, sorgente):
    """Aggiunge alla logica esistente solo i gestori che mancano."""
    cl = _nome_classe(form.nome)
    presenti = set(re.findall(r"^\s+definisci\s+(\w+)\s*\(", sorgente, re.M))
    nuovi = []
    visti = set()
    per comp, k, nome_fn in form.eventi():
        se nome_fn non in presenti e nome_fn non in visti:
            visti.add(nome_fn)
            nuovi.append(f"    definisci {nome_fn}(se_stesso, evento=Nessuno):\n"
                         f"        # {comp.nome}: {proprieta_di(comp.tipo)[k][2]}\n"
                         f"        passa\n")
    se non nuovi:
        ritorna sorgente
    blocco = "\n" + "\n".join(nuovi)
    m = re.search(r'^se __nome__ == ["\']__main__["\']:', sorgente, re.M)
    se m:
        ritorna sorgente[:m.start()].rstrip() + "\n" + blocco + "\n\n" + sorgente[m.start():]
    ritorna sorgente.rstrip() + "\n" + blocco


# --------------------------------------------------------------------------- file
definisci percorsi_form(cartella, nome_form):
    base = nome_form.lower()
    ritorna {"json": os.path.join(cartella, base + ".form.json"),
             "ui": os.path.join(cartella, nome_file_ui(nome_form) + ".pit"),
             "logica": os.path.join(cartella, base + ".pit")}


CARTELLA_MODELLI = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "modelli_codice")
MODELLO_ASPETTO = os.path.join(CARTELLA_MODELLI, "aspetto.pit")


definisci copia_aspetto(cartella, scritti=Nessuno):
    """Mette nel progetto aspetto.pit (se non c'è): lo usano le finestre con un aspetto moderno."""
    destinazione = os.path.join(cartella, "aspetto.pit")
    se non os.path.exists(destinazione) e os.path.exists(MODELLO_ASPETTO):
        con open(MODELLO_ASPETTO, encoding="utf-8") come sorgente, open(destinazione, "w", encoding="utf-8", newline="\n") come f:
            f.write(sorgente.read())
        se scritti è non Nessuno:
            scritti.append(destinazione)


MODELLO_SCORREVOLE = os.path.join(CARTELLA_MODELLI, "scorrevole.pit")


definisci copia_scorrevole(cartella, scritti=Nessuno):
    """Mette nel progetto scorrevole.pit (i riquadri scorrevoli); se la copia è diversa da quella di PitStudio la rinnova (la vecchia resta come .bak)."""
    destinazione = os.path.join(cartella, "scorrevole.pit")
    se non os.path.exists(MODELLO_SCORREVOLE):
        ritorna
    con open(MODELLO_SCORREVOLE, encoding="utf-8", newline="") come f:
        nuova = f.read().replace("\r\n", chr(10))
    se os.path.exists(destinazione):
        con open(destinazione, encoding="utf-8", newline="") come f:
            vecchia = f.read().replace("\r\n", chr(10))
        se vecchia == nuova:
            ritorna
        shutil.copyfile(destinazione, destinazione + ".bak")
    con open(destinazione, "w", encoding="utf-8", newline="\n") come f:
        f.write(nuova)
    se scritti è non Nessuno:
        scritti.append(destinazione)


MODELLO_GRAFICO = os.path.join(CARTELLA_MODELLI, "grafico.pit")


