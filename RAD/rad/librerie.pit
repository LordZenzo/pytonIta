ORDINE_CATEGORIE = ["Finestre", "Calcolo", "Scienza e dati", "Immagini e documenti", "Data e ora", "Testo", "Dati e file",
                    "Sistema", "Rete", "Parallelismo", "Strutture dati", "Programmazione", "Sicurezza", "Test", "Altre"]


definisci originale_di(nome_it):
    """Nome della libreria originale (es. matematica -> math)."""
    prova:
        da _mappa_moduli importa MAPPA
    eccetto ImportError:
        ritorna nome_it
    per orig, it in MAPPA.items():
        se it == nome_it:
            ritorna orig
    ritorna nome_it


definisci e_installata(nome_it):
    prova:
        ritorna importlib.util.find_spec(originale_di(nome_it).split(".")[0]) è non Nessuno
    eccetto Exception:
        ritorna Vero


definisci elenco(extra=()):
    """Lista di (nome_italiano, categoria, descrizione, originale) per tutte le librerie note.
    extra: altre voci già in questo formato (le librerie solo online, non ancora installate)."""
    risultato = []
    per nome_it in parole.MODULI_PRIMO_LIVELLO:
        categoria, descrizione = CATALOGO.get(nome_it, ("Altre", "Libreria italiana di " + originale_di(nome_it) + "."))
        risultato.append((nome_it, categoria, descrizione, originale_di(nome_it).split(".")[0]))
    noti = {r[0] per r in risultato}
    risultato.extend(r per r in extra se r[0] non in noti)
    risultato.sort(key=lambda r: (ORDINE_CATEGORIE.index(r[1]) se r[1] in ORDINE_CATEGORIE altrimenti 99, r[0]))
    ritorna risultato


_RE_IMPORTA = re.compile(r"^[ \t]*(?:importa|import)[ \t]+([^\n#]+)", re.M)
_RE_DA = re.compile(r"^[ \t]*(?:da|from)[ \t]+([\w.]+)[ \t]+(?:importa|import)\b", re.M)


definisci rileva_importazioni(sorgente, nomi_italiani):
    """Le librerie (nomi italiani del catalogo) che un sorgente importa, con il nome italiano o con quello originale."""
    originali = {}
    per nome_it in nomi_italiani:
        originali.setdefault(originale_di(nome_it).split(".")[0], nome_it)
    trovati = set()
    moduli = []
    per m in _RE_IMPORTA.finditer(sorgente):
        per pezzo in m.group(1).split(","):
            parole_ = pezzo.split()
            se parole_:
                moduli.append(parole_[0])
    per m in _RE_DA.finditer(sorgente):
        moduli.append(m.group(1))
    per modulo in moduli:
        radice = modulo.split(".")[0]
        se radice in nomi_italiani:
            trovati.add(radice)
        altrimenti_se radice in originali:
            trovati.add(originali[radice])
    ritorna trovati


definisci righe_che_importano(sorgente, nome_it, nomi_italiani):
    """[(numero di riga, testo)] delle righe del sorgente che importano la libreria (in qualunque forma)."""
    trovate = []
    per numero, riga in enumera(sorgente.split("\n"), 1):
        se riga.lstrip().startswith(("importa ", "import ", "da ", "from ")) e nome_it in rileva_importazioni(riga, nomi_italiani):
            trovate.append((numero, riga.strip()))
    ritorna trovate


SPUNTATO = "☑"
VUOTO = "☐"


classe PannelloLibrerie(tk.Frame):
    """Lista spuntabile delle librerie: clic sulla casella per attivare, doppio clic per inserire l'importazione nel file aperto."""

    definisci __inizializza__(se_stesso, genitore, app):
        tk.Frame.__init__(se_stesso, genitore)
        se_stesso.app = app
        se_stesso.online = {}             # nome -> voce dell'indice online (dalla cache, poi aggiornato con «Novità»)
        se_stesso.stati = {}              # nome -> "aggiornata" | "aggiornabile" | "nuova"
        se_stesso.tutte = elenco()
        se_stesso._carica_online(online.indice_in_cache())
        se_stesso.spuntate = set()
        se_stesso.in_uso = set()          # librerie importate dal file aperto: risultano spuntate anche se non sono nel progetto
        se_stesso._lavoro_uso = Nessuno
        se_stesso._nodi = {}
        se_stesso.barra = tk.Frame(se_stesso)
        se_stesso.barra.pack(fill="x")
        se_stesso.titolo = tk.Label(se_stesso.barra, text="Librerie", anchor="w", font=semi(10))
        se_stesso.titolo.pack(side="left", padx=8, pady=5)
        se_stesso.contatore = tk.Label(se_stesso.barra, text="", anchor="e", font=(FONT_UI, 9))
        se_stesso.contatore.pack(side="right", padx=8)
        se_stesso.var_cerca = tk.StringVar()
        se_stesso.var_solo = tk.BooleanVar(value=Falso)
        riga = tk.Frame(se_stesso)
        riga.pack(fill="x", padx=6)
        se_stesso.campo = tk.Entry(riga, textvariable=se_stesso.var_cerca, relief="flat", font=(FONT_UI, 10))
        se_stesso.campo.pack(side="left", fill="x", expand=Vero, ipady=3)
        se_stesso.solo = tk.Checkbutton(riga, text="solo spuntate", variable=se_stesso.var_solo, font=(FONT_UI, 9),
                                        command=se_stesso.riempi)
        se_stesso.solo.pack(side="right", padx=(6, 0))
        suggerisci(se_stesso.solo, "Mostra solo le librerie spuntate (scelte per il progetto o usate nel file aperto)")
        suggerisci(se_stesso.campo, "Cerca una libreria per nome o descrizione")
        se_stesso.riga_ricerca = riga
        se_stesso.var_cerca.trace_add("write", lambda *a: se_stesso.riempi())
        se_stesso.descrizione = tk.Label(se_stesso, text="Seleziona una libreria per vederne la descrizione.", anchor="nw", justify="left",
                                         wraplength=240, font=(FONT_UI, 9), height=5)
        se_stesso.descrizione.pack(side="bottom", fill="x", padx=8, pady=6)
        se_stesso.barra_online = tk.Frame(se_stesso)
        se_stesso.barra_online.pack(side="bottom", fill="x", padx=6)
        se_stesso.pulsanti_online = []
        per etichetta, comando, aiuto in (
                ("⟳ Novità", se_stesso.controlla_online, "Cerca online le librerie nuove e le versioni più recenti (cartella «librerie» del repository)"),
                ("Installa / Aggiorna", se_stesso.installa_selezionata, "Scarica la libreria selezionata (⬆ = c'è una versione più recente, ✚ = nuova)"),
                ("Aggiorna tutte", se_stesso.aggiorna_tutte, "Aggiorna tutte le librerie con ⬆"),
                ("Ripristina", se_stesso.ripristina_selezionata, "Toglie la copia scaricata e torna alla libreria inclusa nell'installazione")):
            b = tk.Button(se_stesso.barra_online, text=etichetta, relief="flat", font=(FONT_UI, 9), padx=6, command=comando)
            b.pack(side="left", padx=(0, 4), pady=2)
            suggerisci(b, aiuto)
            se_stesso.pulsanti_online.append(b)
        se_stesso.albero = ttk.Treeview(se_stesso, show="tree", selectmode="browse")
        barra_y = ttk.Scrollbar(se_stesso, orient="vertical", command=se_stesso.albero.yview)
        se_stesso.albero.configure(yscrollcommand=barra_y.set)
        barra_y.pack(side="right", fill="y")
        se_stesso.albero.pack(fill="both", expand=Vero, pady=(6, 0))
        se_stesso.albero.bind("<Button-1>", se_stesso._clic)
        se_stesso.albero.bind("<Double-1>", se_stesso._doppio_clic)
        se_stesso.albero.bind("<space>", se_stesso._spazio)
        se_stesso.albero.bind("<Return>", se_stesso._doppio_clic)
        se_stesso.albero.bind("<<TreeviewSelect>>", se_stesso._selezione)
        se_stesso.albero.bind("<Motion>", se_stesso._muovi)
        se_stesso.albero.bind("<Leave>", lambda evento: se_stesso._nascondi_suggerimento())
        se_stesso._suggerimento = Nessuno
        se_stesso._lavoro_sug = Nessuno
        se_stesso._riga_sug = Nessuno
        se_stesso.albero.tag_configure("categoria", font=semi(9))
        se_stesso.albero.tag_configure("assente", foreground="#9a9a9a")
        se_stesso.bind("<Configure>", lambda elemento: se_stesso.descrizione.configure(wraplength=max(120, elemento.width - 24)))
        se_stesso.riempi()

    # ------------------------------------------------------------ dati del progetto
    definisci imposta_progetto(se_stesso, progetto):
        se_stesso.progetto = progetto
        se_stesso.spuntate = set(progetto.manifesto.get("librerie", [])) se progetto altrimenti set()
        parole.imposta_librerie_attive(se_stesso.spuntate, originale_di)
        se_stesso.riempi()

    definisci _salva(se_stesso):
        p = getattr(se_stesso, "progetto", Nessuno)
        se p:
            p.manifesto["librerie"] = sorted(se_stesso.spuntate)
            p.salva_manifesto()
        parole.imposta_librerie_attive(se_stesso.spuntate, originale_di)

    # ------------------------------------------------------------ lista
    definisci riempi(se_stesso):
        aperte = {c per c, n in se_stesso._nodi.items() se n.startswith("cat:") e se_stesso.albero.exists(n) e se_stesso.albero.item(n, "open")}
        prima_volta = non se_stesso._nodi
        scelta = se_stesso.albero.selection()
        se_stesso.albero.delete(*se_stesso.albero.get_children())
        se_stesso._nodi = {}
        q = se_stesso.var_cerca.get().strip().lower()
        solo = se_stesso.var_solo.get()
        spuntate = se_stesso._attive()
        per categoria in ORDINE_CATEGORIE:
            voci = [v per v in se_stesso.tutte se v[1] == categoria
                    e (non solo o v[0] in spuntate)
                    e (non q o q in v[0].lower() o q in v[2].lower() o q in v[3].lower())]
            se non voci:
                continua
            attive = sum(1 per v in voci se v[0] in spuntate)
            nodo = se_stesso.albero.insert("", "end", iid="cat:" + categoria, text=f"{categoria}  ({attive}/{lunghezza_di(voci)})", tags=("categoria",),
                                           open=Vero se (q o solo o prima_volta o categoria in aperte) altrimenti Falso)
            se_stesso._nodi[categoria] = "cat:" + categoria
            per nome_it, cat, descr, orig in voci:
                simbolo = SPUNTATO se nome_it in spuntate altrimenti VUOTO
                stato_ = se_stesso.stati.get(nome_it)
                presente = stato_ != "nuova" e e_installata(nome_it)
                se stato_ == "aggiornabile":
                    marca = "  ⬆"
                altrimenti_se stato_ == "nuova":
                    marca = "  ✚"
                altrimenti:
                    marca = "" se presente altrimenti "  ⚠"
                tag = () se presente o stato_ == "nuova" altrimenti ("assente",)
                se_stesso.albero.insert(nodo, "end", iid="lib:" + nome_it, text=f"{simbolo}  {nome_it}{marca}  —  {descr}", tags=tag)
        se_stesso.contatore.configure(text=f"{lunghezza_di(spuntate)} attive")
        se scelta e se_stesso.albero.exists(scelta[0]):
            se_stesso.albero.selection_set(scelta[0])      # dopo aver ricostruito la lista la voce resta selezionata

    definisci _attive(se_stesso):
        """Le librerie che risultano spuntate: quelle scelte per il progetto più quelle che il file aperto già importa."""
        ritorna se_stesso.spuntate | se_stesso.in_uso

    definisci _aggiorna_riga(se_stesso, nome_it):
        iid = "lib:" + nome_it
        se se_stesso.albero.exists(iid):
            vecchio = se_stesso.albero.item(iid, "text")
            se_stesso.albero.item(iid, text=(SPUNTATO se nome_it in se_stesso._attive() altrimenti VUOTO) + vecchio[1:])
        se_stesso.contatore.configure(text=f"{lunghezza_di(se_stesso._attive())} attive")

    # ------------------------------------------------------------ librerie già in uso nel file aperto
    definisci aggiorna_uso(se_stesso, subito=Falso):
        """Rilegge le importazioni del file aperto (con un piccolo ritardo, per non farlo a ogni tasto) e aggiorna le spunte."""
        se se_stesso._lavoro_uso:
            prova:
                se_stesso.after_cancel(se_stesso._lavoro_uso)
            eccetto tk.TclError:
                passa
            se_stesso._lavoro_uso = Nessuno
        se subito:
            se_stesso._calcola_uso()
        altrimenti:
            se_stesso._lavoro_uso = se_stesso.after(350, se_stesso._calcola_uso)

    definisci _calcola_uso(se_stesso):
        se_stesso._lavoro_uso = Nessuno
        ed = se_stesso.app._editor_corrente() se hasattr(se_stesso.app, "_editor_corrente") altrimenti Nessuno
        nuovo = set()
        se ed è non Nessuno:
            prova:
                nuovo = rileva_importazioni(ed.contenuto(), {v[0] per v in se_stesso.tutte})
            eccetto Exception:
                nuovo = set()
        se nuovo == se_stesso.in_uso:
            ritorna
        cambiate = nuovo ^ se_stesso.in_uso
        se_stesso.in_uso = nuovo
        se se_stesso.var_solo.get():
            se_stesso.riempi()
        altrimenti:
            per nome_it in cambiate:
                se_stesso._aggiorna_riga(nome_it)

    definisci attiva(se_stesso, nome_it, valore=Nessuno):
        """Spunta una libreria: la sceglie per il progetto E aggiunge «importa» al file aperto.
        Togliere la spunta la toglie dal progetto e cancella la riga «importa» semplice dal file aperto."""
        se valore è Nessuno:
            valore = nome_it non in se_stesso._attive()
        se valore:
            se_stesso.spuntate.add(nome_it)
            se_stesso._salva()
            se_stesso.inserisci_importazione(nome_it)
        altrimenti:
            se_stesso.spuntate.discard(nome_it)
            se_stesso._salva()
            se_stesso.rimuovi_importazione(nome_it)
        se_stesso.aggiorna_uso(subito=Vero)
        se_stesso._aggiorna_riga(nome_it)
        se non valore e nome_it in se_stesso.in_uso:
            # resta spuntata perché il file la importa ancora in una forma che non cancello da solo: lo dico, non sembri un errore
            spiegazione = se_stesso.spiega_uso(nome_it)
            se_stesso.descrizione.configure(text=spiegazione)
            se_stesso.app.info(f"«{nome_it}» resta spuntata: il file aperto la importa ancora (non l'ho tolta perché il codice la usa).")

    definisci spiega_uso(se_stesso, nome_it):
        """Perché una libreria risulta spuntata anche se non è scelta per il progetto: il file aperto la importa."""
        ed = se_stesso.app._editor_corrente() se hasattr(se_stesso.app, "_editor_corrente") altrimenti Nessuno
        righe_ = []
        se ed è non Nessuno:
            prova:
                righe_ = righe_che_importano(ed.contenuto(), nome_it, {v[0] per v in se_stesso.tutte})
            eccetto Exception:
                righe_ = []
        elenco_ = "\n".join(f"   riga {n}:  {r[:60]}" per n, r in righe_[:4])
        ritorna (f"☑ «{nome_it}» è spuntata perché il file aperto la usa, non per una scelta del progetto.\n"
                 f"Per toglierla cancella tu l'importazione dal codice (se il codice la usa smetterebbe di funzionare):\n{elenco_}")

    definisci _nome_di(se_stesso, iid):
        ritorna iid[4:] se iid.startswith("lib:") altrimenti Nessuno

    definisci _clic(se_stesso, evento):
        iid = se_stesso.albero.identify_row(evento.y)
        nome_it = se_stesso._nome_di(iid) se iid altrimenti Nessuno
        se nome_it e se_stesso.albero.identify_element(evento.x, evento.y) == "text" e evento.x < 80:
            se_stesso.attiva(nome_it)
            ritorna "break"

    definisci _spazio(se_stesso, evento=Nessuno):
        sel = se_stesso.albero.selection()
        se sel e se_stesso._nome_di(sel[0]):
            se_stesso.attiva(se_stesso._nome_di(sel[0]))
        ritorna "break"

    definisci _doppio_clic(se_stesso, evento=Nessuno):
        sel = se_stesso.albero.selection()
        se sel e se_stesso._nome_di(sel[0]):
            se_stesso.inserisci_importazione(se_stesso._nome_di(sel[0]))
            ritorna "break"

    definisci _selezione(se_stesso, evento=Nessuno):
        sel = se_stesso.albero.selection()
        nome_it = se_stesso._nome_di(sel[0]) se sel altrimenti Nessuno
        se non nome_it:
            ritorna
        voce = [v per v in se_stesso.tutte se v[0] == nome_it]
        se voce:
            _, cat, descr, orig = voce[0]
            testo_ = f"{nome_it}  (= {orig})\n{descr}"
            stato_ = se_stesso.stati.get(nome_it)
            se stato_ == "nuova":
                testo_ += f"\n✚ Libreria online (versione {se_stesso.online[nome_it]['versione']}): premi «Installa / Aggiorna»."
            altrimenti_se stato_ == "aggiornabile":
                testo_ += f"\n⬆ Versione {se_stesso.online[nome_it]['versione']} disponibile online: premi «Installa / Aggiorna»."
            altrimenti_se non e_installata(nome_it):
                testo_ += "\n⚠ Libreria non installata: serve il componente «librerie scientifiche»."
            altrimenti_se nome_it in se_stesso.in_uso e nome_it non in se_stesso.spuntate:
                testo_ = se_stesso.spiega_uso(nome_it)
            altrimenti:
                testo_ += "\nSpunta per averla sempre nei suggerimenti · doppio clic: inserisce «importa»."
            se_stesso.descrizione.configure(text=testo_)

    # ------------------------------------------------------------ librerie online (installazione e aggiornamenti)
    definisci _carica_online(se_stesso, indice):
        """Memorizza l'indice online, confronta le librerie con quelle presenti e aggiunge all'elenco quelle solo online."""
        se_stesso.online = {v["nome"]: v per v in indice["librerie"]} se indice altrimenti {}
        se_stesso.stati = online.confronta(indice) se indice altrimenti {}
        noti = {r[0] per r in elenco()}
        extra = [(n, v["categoria"], v["descrizione"], v["originale"]) per n, v in se_stesso.online.items()
                 se se_stesso.stati[n] == "nuova" e n non in noti]
        se_stesso.tutte = elenco(extra)

    definisci riassunto_online(se_stesso):
        """«3 da aggiornare, 1 nuove» (testo vuoto se non c'è niente)."""
        aggiornabili = sum(1 per s in se_stesso.stati.values() se s == "aggiornabile")
        nuove = sum(1 per s in se_stesso.stati.values() se s == "nuova")
        pezzi = []
        se aggiornabili:
            pezzi.append(f"{aggiornabili} da aggiornare")
        se nuove:
            pezzi.append(f"{nuove} nuove")
        ritorna ", ".join(pezzi)

    definisci _occupato(se_stesso, si):
        per b in se_stesso.pulsanti_online:
            b.configure(state="disabled" se si altrimenti "normal")

    definisci controlla_online(se_stesso):
        se_stesso._occupato(Vero)
        se_stesso.descrizione.configure(text="Cerco le librerie online…")

        definisci fine(riuscito, risultato):
            se_stesso._occupato(Falso)
            se riuscito:
                se_stesso._carica_online(risultato)
                se_stesso.riempi()
                riassunto = se_stesso.riassunto_online()
                se_stesso.descrizione.configure(text=("Librerie online: " + riassunto + ".") se riassunto altrimenti "Le librerie sono tutte aggiornate.")
                se_stesso.app.info("Librerie: " + (riassunto o "tutte aggiornate"))
            altrimenti:
                se_stesso.descrizione.configure(text=f"Non riesco a controllare le librerie online.\n{risultato}")
                se_stesso.app.info("Librerie online: controllo non riuscito")
        esecuzione.in_secondo_piano(se_stesso, online.scarica_indice, fine)

    definisci _selezionata(se_stesso):
        sel = se_stesso.albero.selection()
        ritorna se_stesso._nome_di(sel[0]) se sel altrimenti Nessuno

    definisci _installa_nomi(se_stesso, nomi):
        voci = [se_stesso.online[n] per n in nomi se n in se_stesso.online]
        se non voci:
            ritorna
        nuove = [v["nome"] per v in voci se se_stesso.stati.get(v["nome"]) == "nuova"]
        se_stesso._occupato(Vero)
        se_stesso.descrizione.configure(text="Scarico " + ", ".join(v["nome"] per v in voci[:4]) + ("…" se lunghezza_di(voci) > 4 altrimenti ""))

        definisci lavoro():
            per v in voci:
                online.installa(v)
            ritorna lunghezza_di(voci)

        definisci fine(riuscito, risultato):
            se_stesso._occupato(Falso)
            se riuscito:
                se_stesso._carica_online(online.indice_in_cache())
                se_stesso.riempi()
                messaggio = f"Installate {risultato} librerie." se risultato > 1 altrimenti f"Installata «{voci[0]['nome']}»."
                se nuove:
                    messaggio += " Le nuove compaiono nei suggerimenti dopo il riavvio di PitStudio; i programmi le vedono subito."
                se_stesso.descrizione.configure(text=messaggio)
                se_stesso.app.info(messaggio)
            altrimenti:
                se_stesso.descrizione.configure(text=f"Installazione non riuscita.\n{risultato}")
                se_stesso.app.info("Librerie online: installazione non riuscita")
        esecuzione.in_secondo_piano(se_stesso, lavoro, fine)

    definisci installa_selezionata(se_stesso):
        nome_it = se_stesso._selezionata()
        se non nome_it:
            se_stesso.descrizione.configure(text="Seleziona una libreria da installare o aggiornare.")
            ritorna
        se non se_stesso.online:
            se_stesso.descrizione.configure(text="Prima premi «⟳ Novità» per leggere l'elenco online.")
            ritorna
        se nome_it non in se_stesso.online:
            se_stesso.descrizione.configure(text=f"«{nome_it}» non è nell'elenco online: è la versione inclusa nell'installazione.")
            ritorna
        se se_stesso.stati.get(nome_it) == "aggiornata":
            se_stesso.descrizione.configure(text=f"«{nome_it}» è già all'ultima versione ({se_stesso.online[nome_it]['versione']}).")
            ritorna
        se_stesso._installa_nomi([nome_it])

    definisci aggiorna_tutte(se_stesso):
        da tkinter importa messagebox
        da_fare = sorted(n per n, s in se_stesso.stati.items() se s == "aggiornabile")
        se non da_fare:
            se_stesso.descrizione.configure(text="Nessuna libreria da aggiornare." se se_stesso.online altrimenti "Prima premi «⟳ Novità» per leggere l'elenco online.")
            ritorna
        domanda = (f"Aggiorno {lunghezza_di(da_fare)} librerie con la versione online?\n\n" + ", ".join(da_fare[:12])
                   + ("…" se lunghezza_di(da_fare) > 12 altrimenti "")
                   + "\n\nLe copie scaricate vanno in ~/.rad/librerie; «Ripristina» riporta quella inclusa.")
        se messagebox.askokcancel("Aggiorna le librerie", domanda, parent=se_stesso):
            se_stesso._installa_nomi(da_fare)

    definisci ripristina_selezionata(se_stesso):
        nome_it = se_stesso._selezionata()
        voce = se_stesso.online.get(nome_it) se nome_it altrimenti Nessuno
        se non voce o non online.e_scaricata(voce):
            se_stesso.descrizione.configure(text="Per questa libreria non c'è una copia scaricata: usi già quella inclusa nell'installazione.")
            ritorna
        online.ripristina(voce)
        se_stesso._carica_online(online.indice_in_cache())
        se_stesso.riempi()
        se_stesso.descrizione.configure(text=f"«{nome_it}»: tolta la copia scaricata, torna quella inclusa.")
        se_stesso.app.info(f"Libreria «{nome_it}» ripristinata")

    # ------------------------------------------------------------ suggerimento al passaggio del mouse
    definisci _muovi(se_stesso, evento):
        iid = se_stesso.albero.identify_row(evento.y)
        se iid == se_stesso._riga_sug:
            ritorna
        se_stesso._nascondi_suggerimento()
        se_stesso._riga_sug = iid
        se iid e iid.startswith("lib:"):
            se_stesso._lavoro_sug = se_stesso.after(550, lambda: se_stesso._mostra_suggerimento(iid, evento.x_root, evento.y_root))

    definisci _mostra_suggerimento(se_stesso, iid, x, y):
        voce = [v per v in se_stesso.tutte se v[0] == iid[4:]]
        se non voce:
            ritorna
        _, cat, descr, orig = voce[0]
        w = tk.Toplevel(se_stesso)
        w.wm_overrideredirect(Vero)
        c = getattr(se_stesso, "_colori", Nessuno)
        sfondo = c["chat_strumento"] se c altrimenti "#ffffe0"
        primo = c["primo_piano"] se c altrimenti "#000000"
        tk.Label(w, text=f"{iid[4:]}  (= {orig})\n{descr}", justify="left", background=sfondo, foreground=primo, borderwidth=1,
                 relief="solid", padx=8, pady=5, font=(FONT_UI, 9)).pack()
        w.update_idletasks()
        px, py = posizione_fumetto(se_stesso, w.winfo_reqwidth(), w.winfo_reqheight())
        w.geometry(f"+{px}+{py}")
        se_stesso._suggerimento = w

    definisci _nascondi_suggerimento(se_stesso):
        se se_stesso._lavoro_sug:
            prova:
                se_stesso.after_cancel(se_stesso._lavoro_sug)
            eccetto tk.TclError:
                passa
            se_stesso._lavoro_sug = Nessuno
        se se_stesso._suggerimento è non Nessuno:
            prova:
                se_stesso._suggerimento.destroy()
            eccetto tk.TclError:
                passa
            se_stesso._suggerimento = Nessuno
        se_stesso._riga_sug = Nessuno

    # ------------------------------------------------------------ inserimento nel file
    definisci inserisci_importazione(se_stesso, nome_it):
        """Aggiunge «importa nome» in testa al file aperto (se non c'è già). Ritorna True se ha inserito."""
        ed = se_stesso.app._editor_corrente() se hasattr(se_stesso.app, "_editor_corrente") altrimenti Nessuno
        se ed è Nessuno:
            se_stesso.app.info("Apri un file di codice per inserirvi l'importazione.")
            ritorna Falso
        py = ed.linguaggio == "py"
        riga = f"import {originale_di(nome_it)}" se py altrimenti f"importa {nome_it}"
        sorgente = ed.contenuto()
        se riga in sorgente.splitlines():
            se_stesso.app.info(f"«{riga}» è già nel file.")
            ritorna Falso
        ritorna ed.inserisci_importazione(riga)

    definisci rimuovi_importazione(se_stesso, nome_it):
        """Cancella dal file aperto le righe «importa nome» (o «import originale») semplici; ritorna quante ne ha tolte."""
        ed = se_stesso.app._editor_corrente() se hasattr(se_stesso.app, "_editor_corrente") altrimenti Nessuno
        se ed è Nessuno:
            ritorna 0
        righe_ = {f"importa {nome_it}", f"import {originale_di(nome_it)}", f"import {nome_it}", f"importa {originale_di(nome_it)}"}
        tolte = 0
        per numero in tipo_lista(intervallo_di(1, lunghezza_di(ed.contenuto().split("\n")) + 1))[::-1]:
            riga = ed.t.get(f"{numero}.0", f"{numero}.0 lineend")
            se riga.strip() in righe_ e non riga.startswith((" ", "\t")):
                ed.t.delete(f"{numero}.0", f"{numero + 1}.0")
                tolte += 1
        se tolte:
            ed.evidenzia()
            se_stesso.app.info(f"Tolta l'importazione di «{nome_it}» dal file aperto (Ctrl+Z per annullare).")
        ritorna tolte

    # ------------------------------------------------------------ colori
    definisci applica_colori(se_stesso, c):
        se_stesso._colori = c
        per w in (se_stesso, se_stesso.barra, se_stesso.riga_ricerca):
            w.configure(background=c["pannello"])
        per w in (se_stesso.titolo, se_stesso.contatore, se_stesso.descrizione):
            w.configure(background=c["pannello"], foreground=c["tenue"] se w è non se_stesso.titolo altrimenti c["primo_piano"])
        se_stesso.solo.configure(background=c["pannello"], foreground=c["tenue"], activebackground=c["pannello"],
                                 activeforeground=c["primo_piano"])
        se_stesso.barra_online.configure(background=c["pannello"])
        per b in se_stesso.pulsanti_online:
            b.configure(background=c["pulsante"], foreground=c["primo_piano"], activebackground=c["pulsante_attivo"], activeforeground=c["primo_piano"])
        se_stesso.campo.configure(background=c["sfondo"], foreground=c["primo_piano"], insertbackground=c["primo_piano"])
        se_stesso.albero.tag_configure("assente", foreground=c["tenue"])
