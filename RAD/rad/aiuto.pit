"""La guida di PitStudio: argomenti in Markdown, visualizzatore con ricerca e F1 contestuale, esportazione in HTML."""
importa html
importa json
importa os
importa re
importa shutil
importa time
importa tkinter come tk
importa webbrowser
da tkinter importa ttk

da PIL importa Image, ImageTk

da rad importa NOME, VERSIONE, markdown_mini, stile
da rad.piattaforma importa FONT_MONO, FONT_SIMBOLI, FONT_UI, semi

CARTELLA_AIUTO = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "aiuto")
CARTELLA_HTML = os.path.join(CARTELLA_AIUTO, "html")

# --------------------------------------------------------------------------- riferimento delle parole
KEYWORDS = {
    "se": ("if", "Esegue il blocco solo se la condizione è vera.", "se età >= 18:\n    stampa(\"maggiorenne\")"),
    "altrimenti_se": ("elif", "Un'altra condizione da provare se le precedenti sono false.", "se x < 0:\n    stampa(\"negativo\")\naltrimenti_se x == 0:\n    stampa(\"zero\")"),
    "altrimenti": ("else", "Il blocco da eseguire se nessuna condizione è vera (anche dopo `per` e `mentre`).", "se piove:\n    stampa(\"ombrello\")\naltrimenti:\n    stampa(\"occhiali da sole\")"),
    "per": ("for", "Ripete il blocco per ogni elemento di una sequenza.", "per nome in [\"Anna\", \"Luca\"]:\n    stampa(nome)"),
    "mentre": ("while", "Ripete il blocco finché la condizione è vera.", "n = 3\nmentre n > 0:\n    stampa(n)\n    n -= 1"),
    "interrompi": ("break", "Esce subito dal ciclo.", "per i in intervallo_di(10):\n    se i == 3:\n        interrompi"),
    "continua": ("continue", "Salta al prossimo giro del ciclo.", "per i in intervallo_di(5):\n    se i % 2:\n        continua\n    stampa(i)"),
    "definisci": ("def", "Crea una funzione.", "definisci saluta(nome):\n    stampa(\"Ciao\", nome)"),
    "ritorna": ("return", "Termina la funzione restituendo un valore.", "definisci doppio(n):\n    ritorna n * 2"),
    "produci": ("yield", "Fa produrre alla funzione un valore alla volta (generatore).", "definisci conta(n):\n    per i in intervallo_di(n):\n        produci i"),
    "classe": ("class", "Crea una classe.", "classe Cane:\n    definisci __inizializza__(se_stesso, nome):\n        se_stesso.nome = nome"),
    "importa": ("import", "Usa un modulo.", "importa matematica\nstampa(matematica.radice_quadrata(9))"),
    "da": ("from", "Importa solo alcuni nomi da un modulo (`da modulo importa nome`).", "da percorso importa Percorso"),
    "come": ("as", "Dà un altro nome a ciò che importi o a un errore/file aperto.", "importa interfaccia come tk\ncon apri(\"a.txt\") come f:\n    stampa(f.leggi_tutto())"),
    "prova": ("try", "Prova a eseguire il blocco; se c'è un errore passa a `eccetto`.", "prova:\n    n = tipo_intero(leggi_tastiera())\neccetto ErroreDiValore:\n    stampa(\"non è un numero\")"),
    "eccetto": ("except", "Gestisce un errore sollevato nel blocco `prova`.", "prova:\n    1 / 0\neccetto DivisionePerZero come errore:\n    stampa(errore)"),
    "infine": ("finally", "Si esegue sempre, con o senza errori.", "prova:\n    lavora()\ninfine:\n    stampa(\"fatto\")"),
    "solleva": ("raise", "Provoca un errore.", "se età < 0:\n    solleva ErroreDiValore(\"età negativa\")"),
    "con": ("with", "Usa una risorsa e la chiude da sola alla fine (file, blocchi…).", "con apri(\"dati.txt\") come f:\n    righe = f.leggi_righe()"),
    "e": ("and", "Vero se entrambe le condizioni sono vere.", "se età >= 18 e patente:\n    stampa(\"può guidare\")"),
    "o": ("or", "Vero se almeno una condizione è vera.", "se sabato o domenica:\n    stampa(\"weekend\")"),
    "non": ("not", "Inverte una condizione (`non in` e `è non` sono le forme composte).", "se non pieno:\n    riempi()"),
    "è": ("is", "Verifica che due nomi siano lo stesso oggetto (tipico: `è Nessuno`).", "se risultato è Nessuno:\n    stampa(\"niente\")"),
    "in": ("in", "Appartenenza (`x in lista`) e anche parte di `per … in …`.", "se \"a\" in \"banana\":\n    stampa(\"c'è\")"),
    "Vero": ("True", "La costante vero.", "attivo = Vero"),
    "Falso": ("False", "La costante falso.", "attivo = Falso"),
    "Nessuno": ("None", "Il valore «niente».", "risultato = Nessuno"),
    "passa": ("pass", "Non fa nulla (serve dove la sintassi vuole un blocco).", "se Vero:\n    passa"),
    "globale": ("global", "Dice che una variabile è quella globale del programma.", "contatore = 0\ndefinisci incrementa():\n    globale contatore\n    contatore += 1"),
    "nonlocale": ("nonlocal", "Come `globale`, ma per una variabile della funzione che contiene questa.", "definisci esterna():\n    n = 0\n    definisci interna():\n        nonlocale n\n        n += 1"),
    "lambda": ("lambda", "Funzione breve senza nome.", "doppio = lambda x: x * 2"),
    "asserisci": ("assert", "Verifica una condizione e segnala un errore se è falsa.", "asserisci n > 0, \"n deve essere positivo\""),
    "elimina": ("del", "Elimina un nome, un elemento di lista o una chiave di dizionario.", "elimina elenco[0]"),
    "asincrono": ("async", "Dichiara una funzione asincrona.", "asincrono definisci scarica():\n    passa"),
    "attendi": ("await", "Aspetta il risultato di un'operazione asincrona.", "asincrono definisci principale():\n    risultato = attendi scarica()"),
    "confronta": ("match", "Confronta un valore con vari schemi (usato con `caso`).", "confronta comando:\n    caso \"via\":\n        stampa(\"parto\")\n    caso _:\n        stampa(\"?\")"),
    "caso": ("case", "Uno degli schemi di un `confronta`.", "confronta punto:\n    caso [x, y]:\n        stampa(x, y)"),
    "tipo": ("type", "Definisce un alias di tipo (`tipo Punto = tipo_tupla`); `tipo_di(x)` dice di che tipo è x.", "tipo Numeri = tipo_lista[tipo_intero]"),
}

