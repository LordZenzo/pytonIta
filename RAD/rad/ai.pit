    {"name": "esegui_programma",
     "description": "Esegue un file .pit del progetto con pitonit e restituisce codice di uscita, output ed errori. "
                    "Senza 'file' esegue il file principale. I programmi con finestra grafica vengono chiusi allo scadere del tempo.",
     "input_schema": {"type": "object", "properties": {
         "file": {"type": "string"}, "argomenti": {"type": "array", "items": {"type": "string"}},
         "ingresso": {"type": "string", "description": "testo fornito allo standard input"},
         "tempo_massimo": {"type": "integer", "description": "secondi (predefinito 30)"}}}},
    {"name": "apri_file",
     "description": "Apre un file nell'editor dell'utente (opzionalmente alla riga indicata).",
     "input_schema": {"type": "object", "properties": {
