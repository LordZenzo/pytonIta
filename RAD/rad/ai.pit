"""Assistente AI (Claude): client dell'API Messages, strumenti che agiscono sull'ambiente, ciclo dell'agente."""
importa json
importa os
importa threading
importa time
importa urllib.request
importa urllib.error

da rad importa esecuzione, parole, form_modello, mattonelle_modello

LIMITE_RISULTATO = 24000

DEFINIZIONI = [
    {"name": "stato_ide",
     "description": "Stato dell'ambiente: progetto aperto, file principale, schede aperte (con eventuali modifiche non salvate), "
                    "file attivo, riga del cursore, testo selezionato e ultime righe della console.",
     "input_schema": {"type": "object", "properties": {}}},
    {"name": "elenca_file",
     "description": "Elenca i file del progetto (percorsi relativi). Senza argomenti elenca tutto il progetto.",
     "input_schema": {"type": "object", "properties": {
         "cartella": {"type": "string", "description": "Sottocartella relativa (opzionale)"},
         "estensioni": {"type": "array", "items": {"type": "string"}, "description": "es. ['.pit', '.json']"}}}},
    {"name": "leggi_file",
     "description": "Legge un file del progetto. Se il file è aperto nell'editor restituisce il testo attuale (anche non salvato). "
