classe ErroreAI(Eccezione):
    """Errore nella comunicazione con l'AI."""


definisci stima_token(messaggi):
    """Stima grossolana dei token di una conversazione (circa 4 caratteri per token)."""
    testo_ = json.dumps(messaggi, ensure_ascii=Falso)
    immagini = 0
    per m in messaggi:
        se isinstance(m.get("content"), tipo_lista):
            per b in m["content"]:
                se isinstance(b, dict) e isinstance(b.get("content"), tipo_lista):
                    per x in b["content"]:
                        se isinstance(x, dict) e x.get("type") == "image":
                            immagini += 1
                            testo_ = testo_.replace(x.get("source", {}).get("data", "@@"), "", 1)
    ritorna lunghezza_di(testo_) // 4 + immagini * 1500          # un'immagine costa all'incirca 1500 token


definisci togli_immagini_vecchie(messaggi, mantieni=2):
    """Le immagini dei vecchi risultati degli strumenti diventano una nota: pesano molto e il modello le ha già viste.
    Restano quelle degli ultimi `mantieni` messaggi. Ritorna quante ne ha tolte."""
    tolte = 0
    per m in messaggi[:max(0, lunghezza_di(messaggi) - mantieni)]:
        se isinstance(m.get("content"), tipo_lista):
            per b in m["content"]:
                se isinstance(b, dict) e b.get("type") == "tool_result" e isinstance(b.get("content"), tipo_lista):
                    nuovo = []
                    per x in b["content"]:
                        se isinstance(x, dict) e x.get("type") == "image":
                            nuovo.append({"type": "text", "text": "[immagine omessa: era già stata vista]"})
                            tolte += 1
                        altrimenti:
                            nuovo.append(x)
                    b["content"] = nuovo
    ritorna tolte


definisci compatta(messaggi, soglia_token, mantieni=6):
    """Accorcia i vecchi risultati degli strumenti e i grandi contenuti già scritti su disco.

    Quando la conversazione supera la soglia si riducono (sul posto) i messaggi più vecchi: i risultati lunghi degli strumenti
    diventano un'anteprima, i testi dei file scritti vengono omessi (sono nel progetto) e i vecchi contesti dell'editor spariscono.
    Gli ultimi `mantieni` messaggi restano intatti. Ritorna i caratteri risparmiati (0 se non serviva)."""
    se soglia_token <= 0 o stima_token(messaggi) <= soglia_token:
        ritorna 0
    prima = lunghezza_di(json.dumps(messaggi, ensure_ascii=Falso))
    obiettivo = int(soglia_token * 0.7)
    per i in intervallo_di(max(0, lunghezza_di(messaggi) - mantieni)):
        m = messaggi[i]
        contenuto = m.get("content")
        se non isinstance(contenuto, tipo_lista):
            continua
        per b in contenuto:
            tipo_ = b.get("type")
            se tipo_ == "tool_result" e isinstance(b.get("content"), tipo_testo) e lunghezza_di(b["content"]) > 400:
                b["content"] = b["content"][:300] + f"\n… [risultato accorciato per risparmiare token: {lunghezza_di(b['content'])} caratteri]"
            altrimenti_se tipo_ == "tool_use" e isinstance(b.get("input"), dict):
                per chiave, valore in tipo_lista(b["input"].items()):
                    se isinstance(valore, tipo_testo) e lunghezza_di(valore) > 400:
                        b["input"][chiave] = f"[omesso: {lunghezza_di(valore)} caratteri]"
            altrimenti_se tipo_ == "text" e m.get("role") == "user" e b.get("text", "").startswith("<contesto_ide>") e lunghezza_di(b["text"]) > 400:
                b["text"] = "<contesto_ide>[omesso per risparmiare token]</contesto_ide>"
        se stima_token(messaggi) <= obiettivo:
            interrompi
    ritorna max(0, prima - lunghezza_di(json.dumps(messaggi, ensure_ascii=Falso)))


definisci con_cache(messaggi):
    """Copia dei messaggi con il segno di cache sull'ultimo blocco.

    La conversazione cresce a ogni passo dell'assistente e verrebbe pagata per intero ogni volta: con il segno di cache
    l'API riusa ciò che ha già letto (costa una frazione). I messaggi originali, che si salvano su disco, non cambiano."""
    se non messaggi:
        ritorna messaggi
    copia = tipo_lista(messaggi)
    ultimo = dict(copia[-1])
    contenuto = ultimo.get("content")
    se isinstance(contenuto, tipo_testo):
        contenuto = [{"type": "text", "text": contenuto}]
    altrimenti:
        contenuto = [dict(b) per b in (contenuto o [])]
    se contenuto:
        contenuto[-1]["cache_control"] = {"type": "ephemeral"}
    ultimo["content"] = contenuto
    copia[-1] = ultimo
    ritorna copia


definisci pulisci_per_claude(messaggi):
    """Copia della conversazione senza ciò che Claude non accetta: le firme di Gemini («firma») e il ragionamento di DeepSeek.
    Serve quando si cambia fornitore a metà conversazione."""
    risultato = []
    per m in messaggi:
        c = m.get("content")
        se isinstance(c, tipo_lista):
            blocchi = [{k: v per k, v in b.items() se k != "firma"} per b in c se b.get("type") != "ragionamento"]
            se non blocchi:
                continua
            m = dict(m, content=blocchi)
        risultato.append(m)
    ritorna risultato


FORNITORI = {"claude": "Claude (Anthropic)", "gemini": "Gemini (Google)", "deepseek": "DeepSeek"}


classe ClienteBase:
    """Parte comune dei clienti: scelta del modello e della chiave, invio della richiesta HTTP. Le sottoclassi traducono il formato."""
    nome = ""
    chiave_config = ""                 # dove sta la chiave nella configurazione
    variabili_ambiente = ()            # alternative: variabili d'ambiente con la chiave
    chiave_modello = ""                # dove sta il modello scelto
    chiave_economico = ""
    modello_predefinito = ""
    economico_predefinito = ""

    definisci __inizializza__(se_stesso, config):
        se_stesso.config_ = config
        se_stesso.modello_forzato = Nessuno       # se impostato vale al posto del modello scelto (modello economico)

    definisci supporta_immagini(se_stesso):
        """True se il fornitore (e il modello scelto) accetta immagini dai risultati degli strumenti."""
        ritorna Falso

    definisci senza_strumenti(se_stesso):
        """True se il modello non usa gli strumenti: l'agente non li offre e la chat allega il testo dei file."""
        ritorna Falso

    definisci modello(se_stesso):
        ritorna se_stesso.modello_forzato o se_stesso.config_.ottieni(se_stesso.chiave_modello, se_stesso.modello_predefinito)

    definisci modello_economico(se_stesso):
        ritorna se_stesso.config_.ottieni(se_stesso.chiave_economico, se_stesso.economico_predefinito) o se_stesso.modello_predefinito

    definisci chiave(se_stesso):
        k = (se_stesso.config_.ottieni(se_stesso.chiave_config, "") o "").strip()
        per v in se_stesso.variabili_ambiente:
            se k:
                interrompi
            k = os.environ.get(v, "").strip()
        ritorna k

    definisci _chiave_o_errore(se_stesso):
        k = se_stesso.chiave()
        se non k:
            ambiente = " o ".join(se_stesso.variabili_ambiente)
            solleva ErroreAI(f"Manca la chiave API di {se_stesso.nome}. Inseriscila in Impostazioni → Assistente AI"
                             + (f" (oppure nella variabile d'ambiente {ambiente})." se ambiente altrimenti "."))
        ritorna k

    definisci _invia(se_stesso, url, corpo, intestazioni):
        """Spedisce la richiesta JSON e ritorna la risposta già letta; gli errori diventano ErroreAI."""
        richiesta = urllib.request.Request(url, data=json.dumps(corpo).encode("utf-8"), method="POST",
                                           headers=dict(intestazioni, **{"content-type": "application/json"}))
        prova:
            con urllib.request.urlopen(richiesta, timeout=180) come r:
                ritorna json.loads(r.read().decode("utf-8"))
        eccetto urllib.error.HTTPError come eccezione:
            prova:
                dettaglio = json.loads(eccezione.read().decode("utf-8")).get("error", {}).get("message", "")
            eccetto Eccezione:
                dettaglio = ""
            solleva ErroreAI(f"Errore {eccezione.code} dall'API: {dettaglio o eccezione.reason}")
        eccetto urllib.error.URLError come eccezione:
            solleva ErroreAI(f"Connessione non riuscita: {eccezione.reason}")
        eccetto (TimeoutError, OSError) come eccezione:
            solleva ErroreAI(f"Errore di rete: {eccezione}")


classe ClienteClaude(ClienteBase):
    """Client minimale dell'API Messages di Anthropic (urllib, nessuna dipendenza)."""
    nome = "Claude"
    chiave_config = "ai.chiave_api"
    variabili_ambiente = ("ANTHROPIC_API_KEY",)
    chiave_modello = "ai.modello"
    chiave_economico = "ai.modello_economico"
    modello_predefinito = "claude-sonnet-5-5"
    economico_predefinito = "claude-haiku-5-5"

    definisci supporta_immagini(se_stesso):
        ritorna Vero

    definisci chiama(se_stesso, messaggi, sistema, strumenti):
        chiave = se_stesso._chiave_o_errore()
        messaggi = pulisci_per_claude(messaggi)
        se se_stesso.config_.ottieni("ai.cache_cronologia", Vero):
            messaggi = con_cache(messaggi)
        corpo = {"model": se_stesso.modello(),
                 "max_tokens": int(se_stesso.config_.ottieni("ai.max_token", 4096)),
                 "system": [{"type": "text", "text": sistema, "cache_control": {"type": "ephemeral"}}],
                 "messages": messaggi, "tools": strumenti}
        ritorna se_stesso._invia(se_stesso.config_.ottieni("ai.url", "https://api.anthropic.com/v1/messages"), corpo,
                                 {"x-api-key": chiave, "anthropic-version": se_stesso.config_.ottieni("ai.versione_api", "2023-06-01")})


# ---------------------------------------------------------------- DeepSeek (formato «chat completions», come OpenAI)
definisci messaggi_a_openai(messaggi, sistema, immagini=Falso):
    """La conversazione interna nel formato chat completions: system, user, assistant (con tool_calls) e tool."""
    r = [{"role": "system", "content": sistema}]
    per m in messaggi:
        c = m.get("content")
        se isinstance(c, tipo_testo):
            c = [{"type": "text", "text": c}]
        se m.get("role") == "assistant":
            testi = [b["text"] per b in c se b.get("type") == "text"]
            ragionamenti = [b["text"] per b in c se b.get("type") == "ragionamento"]
            chiamate = [{"id": b["id"], "type": "function", "function": {"name": b["name"], "arguments": json.dumps(b.get("input", {}), ensure_ascii=Falso)}}
                        per b in c se b.get("type") == "tool_use"]
            voce = {"role": "assistant", "content": "\n".join(testi) se (testi o non chiamate) altrimenti Nessuno}
            se chiamate:
                voce["tool_calls"] = chiamate
            se ragionamenti:
                voce["reasoning_content"] = "\n".join(ragionamenti)
            r.append(voce)
        altrimenti:
            per b in c:
                se b.get("type") == "tool_result":
                    esito = b.get("content")
                    se isinstance(esito, tipo_lista):
                        # testo e immagini: il testo va nel risultato, le immagini (se il modello le accetta) in un messaggio a parte
                        pezzi_testo = [x.get("text", "") per x in esito se isinstance(x, dict) e x.get("type") == "text"]
                        r.append({"role": "tool", "tool_call_id": b["tool_use_id"], "content": "\n".join(pezzi_testo)})
                        immagini_ = [x per x in esito se isinstance(x, dict) e x.get("type") == "image"]
                        se immagini_ e immagini:
                            r.append({"role": "user", "content": [{"type": "text", "text": "Immagine del risultato dello strumento:"}] +
                                      [{"type": "image_url", "image_url": {"url": "data:" + x["source"]["media_type"] + ";base64," + x["source"]["data"]}} per x in immagini_]})
                        continua
                    r.append({"role": "tool", "tool_call_id": b["tool_use_id"],
                              "content": esito se isinstance(esito, tipo_testo) altrimenti json.dumps(esito, ensure_ascii=Falso)})
            testi = [b["text"] per b in c se b.get("type") == "text"]
            se testi:
                r.append({"role": "user", "content": "\n".join(testi)})
    ritorna r


definisci risposta_da_openai(r):
    """La risposta di chat completions nel formato interno (content, stop_reason, usage)."""
    scelte = r.get("choices") o []
    se non scelte:
        solleva ErroreAI("Risposta vuota dall'API.")
    m = scelte[0].get("message") o {}
    blocchi = []
    se m.get("reasoning_content"):
        blocchi.append({"type": "ragionamento", "text": m["reasoning_content"]})
    se (m.get("content") o "").strip():
        blocchi.append({"type": "text", "text": m["content"]})
    chiamate = 0
    per t in (m.get("tool_calls") o []):
        funzione = t.get("function") o {}
        prova:
            argomenti = json.loads(funzione.get("arguments") o "{}")
        eccetto ValueError:
            argomenti = {}
        blocchi.append({"type": "tool_use", "id": t.get("id") o ("ds_" + uuid.uuid4().hex[:10]), "name": funzione.get("name", ""),
                        "input": argomenti se isinstance(argomenti, dict) altrimenti {}})
        chiamate += 1
    fine = scelte[0].get("finish_reason")
    stop = "tool_use" se chiamate altrimenti ("max_tokens" se fine == "length" altrimenti "end_turn")
    u = r.get("usage") o {}
    letti = u.get("prompt_cache_hit_tokens", 0) o 0
    nuovi = u.get("prompt_cache_miss_tokens")
    se nuovi è Nessuno:
        nuovi = max(0, (u.get("prompt_tokens", 0) o 0) - letti)
    ritorna {"content": blocchi, "stop_reason": stop,
             "usage": {"input_tokens": nuovi, "output_tokens": u.get("completion_tokens", 0) o 0, "cache_read_input_tokens": letti}}


classe ClienteDeepSeek(ClienteBase):
    """DeepSeek (API compatibile con chat completions)."""
    nome = "DeepSeek"
    chiave_config = "ai.chiave_deepseek"
    variabili_ambiente = ("DEEPSEEK_API_KEY",)
    chiave_modello = "ai.modello_deepseek"
    chiave_economico = "ai.modello_economico_deepseek"
    modello_predefinito = "deepseek-chat"
    economico_predefinito = "deepseek-chat"

    definisci supporta_immagini(se_stesso):
        """Solo i modelli «flash» di DeepSeek leggono le immagini (nei messaggi dell'utente); deepseek-chat no."""
        ritorna "flash" in se_stesso.modello().lower() o "vision" in se_stesso.modello().lower()

    definisci chiama(se_stesso, messaggi, sistema, strumenti):
        chiave = se_stesso._chiave_o_errore()
        massimo = int(se_stesso.config_.ottieni("ai.max_token", 4096))
        se "reasoner" non in se_stesso.modello():
            massimo = min(massimo, 8192)          # tetto di deepseek-chat
        corpo = {"model": se_stesso.modello(), "max_tokens": massimo, "messages": messaggi_a_openai(messaggi, sistema, immagini=se_stesso.supporta_immagini()),
                 "tools": [{"type": "function", "function": {"name": s["name"], "description": s.get("description", ""), "parameters": s["input_schema"]}}
                           per s in strumenti]}
        base = se_stesso.config_.ottieni("ai.url_deepseek", "https://api.deepseek.com").rstrip("/")
        ritorna risposta_da_openai(se_stesso._invia(base + "/chat/completions", corpo, {"authorization": "Bearer " + chiave}))


# ---------------------------------------------------------------- altri fornitori con il formato «chat completions»: OpenAI, OpenRouter, modelli locali (Ollama)
classe ClienteChat(ClienteBase):
    """Parte comune dei fornitori che parlano come OpenAI (/chat/completions). Le sottoclassi dicono dove e con quale chiave."""
    suffisso = ""                      # nelle chiavi di configurazione: ai.chiave_<suffisso>, ai.modello_<suffisso>, ai.url_<suffisso>
    url_predefinito = ""
    richiede_chiave = Vero
    campo_massimo = "max_tokens"       # OpenAI ora vuole «max_completion_tokens»
    intestazioni_extra = {}
    con_immagini = Vero

    definisci supporta_immagini(se_stesso):
        ritorna se_stesso.con_immagini

    definisci chiama(se_stesso, messaggi, sistema, strumenti):
        chiave = se_stesso._chiave_o_errore() se se_stesso.richiede_chiave altrimenti se_stesso.chiave()
        corpo = {"model": se_stesso.modello(), se_stesso.campo_massimo: int(se_stesso.config_.ottieni("ai.max_token", 4096)),
                 "messages": messaggi_a_openai(messaggi, sistema, immagini=se_stesso.supporta_immagini())}
        se strumenti:
            corpo["tools"] = [{"type": "function", "function": {"name": s["name"], "description": s.get("description", ""), "parameters": s["input_schema"]}}
                              per s in strumenti]
        base = se_stesso.config_.ottieni("ai.url_" + se_stesso.suffisso, se_stesso.url_predefinito).rstrip("/")
        intestazioni = dict(se_stesso.intestazioni_extra)
        se chiave:
            intestazioni["authorization"] = "Bearer " + chiave
        ritorna risposta_da_openai(se_stesso._invia(base + "/chat/completions", corpo, intestazioni))


classe ClienteOpenAI(ClienteChat):
    """OpenAI (chat completions)."""
    nome = "OpenAI"
    suffisso = "openai"
    chiave_config = "ai.chiave_openai"
    variabili_ambiente = ("OPENAI_API_KEY",)
    chiave_modello = "ai.modello_openai"
    chiave_economico = "ai.modello_economico_openai"
    modello_predefinito = "gpt-4.1"
    economico_predefinito = "gpt-4.1-mini"
    url_predefinito = "https://api.openai.com/v1"
    campo_massimo = "max_completion_tokens"


classe ClienteOpenRouter(ClienteChat):
    """OpenRouter: una sola chiave per molti modelli di fornitori diversi (nomi come «anthropic/claude-sonnet-4.5»)."""
    nome = "OpenRouter"
    suffisso = "openrouter"
    chiave_config = "ai.chiave_openrouter"
    variabili_ambiente = ("OPENROUTER_API_KEY",)
    chiave_modello = "ai.modello_openrouter"
    chiave_economico = "ai.modello_economico_openrouter"
    modello_predefinito = "anthropic/claude-sonnet-4.5"
    economico_predefinito = "anthropic/claude-haiku-4.5"
    url_predefinito = "https://openrouter.ai/api/v1"
    intestazioni_extra = {"x-title": "PitStudio"}


classe ClienteOllama(ClienteChat):
    """Modelli sul tuo computer con Ollama (o qualunque server compatibile): nessuna chiave, nessun costo, i dati non escono dal PC."""
    nome = "Ollama (locale)"
    suffisso = "ollama"
    chiave_config = "ai.chiave_ollama"
    variabili_ambiente = ()
    chiave_modello = "ai.modello_ollama"
    chiave_economico = "ai.modello_economico_ollama"
    modello_predefinito = "qwen2.5-coder:7b"
    economico_predefinito = "qwen2.5-coder:7b"
    url_predefinito = "http://localhost:11434/v1"
    richiede_chiave = Falso

    definisci supporta_immagini(se_stesso):
        ritorna bool(se_stesso.config_.ottieni("ai.immagini_ollama", Falso))          # solo i modelli «vision» (llava, qwen2.5-vl…): lo decide l'utente

    definisci senza_strumenti(se_stesso):
        """I modelli piccoli non sanno chiamare strumenti: l'utente lo dice nelle impostazioni, e allora gli si allega il testo dei file."""
        ritorna non se_stesso.config_.ottieni("ai.ollama_strumenti", Vero)

    definisci _invia(se_stesso, url, corpo, intestazioni):
        prova:
            ritorna ClienteBase._invia(se_stesso, url, corpo, intestazioni)
        eccetto ErroreAI come errore:
            testo_ = tipo_testo(errore)
            se "Connessione non riuscita" in testo_ o "Errore di rete" in testo_:
                solleva ErroreAI("Non trovo Ollama su questo computer. Avvialo (ollama serve) e controlla l'indirizzo in Impostazioni → Assistente AI. "
                                 "Dettaglio: " + testo_)
            se "404" in testo_ e "model" in testo_.lower():
                solleva ErroreAI(f"Il modello «{corpo.get('model')}» non è installato in Ollama: scaricalo con  ollama pull {corpo.get('model')}")
            solleva


definisci modelli_installati_ollama(config, tempo=2):
    """I nomi dei modelli che Ollama ha scaricato (lista vuota se Ollama non risponde)."""
    base = config.ottieni("ai.url_ollama", ClienteOllama.url_predefinito).rstrip("/")
    se base.endswith("/v1"):
        base = base[:-3]
    prova:
        con urllib.request.urlopen(base + "/api/tags", timeout=tempo) come r:
            dati = json.loads(r.read().decode("utf-8"))
        ritorna sorted(m.get("name", "") per m in dati.get("models", []) se m.get("name"))
    eccetto Exception:
        ritorna []


# ---------------------------------------------------------------- Gemini (generateContent)
definisci strumenti_a_gemini(strumenti):
    """Le dichiarazioni delle funzioni per Gemini. Gemini non accetta un «object» senza campi: quei parametri diventano testo JSON.
    Ritorna (dichiarazioni, {strumento: [parametri da rileggere come JSON]})."""
    dichiarazioni = []
    da_json = {}
    per s in strumenti:
        schema = s.get("input_schema") o {}
        proprieta = {}
        per nome_p, p in (schema.get("properties") o {}).items():
            p = dict(p)
            se p.get("type") == "object" e non p.get("properties"):
                p["type"] = "string"
                p["description"] = (p.get("description", "") + " Scrivi un oggetto JSON come testo.").strip()
                da_json.setdefault(s["name"], []).append(nome_p)
            proprieta[nome_p] = p
        d = {"name": s["name"], "description": s.get("description", "")}
        se proprieta:
            d["parameters"] = {"type": "object", "properties": proprieta}
            se schema.get("required"):
                d["parameters"]["required"] = schema["required"]
        dichiarazioni.append(d)
    ritorna dichiarazioni, da_json


definisci messaggi_a_gemini(messaggi, immagini=Falso):
    """La conversazione interna nel formato di Gemini (contents con parts). Le firme del ragionamento (thoughtSignature) tornano indietro."""
    nomi = {}
    contenuti = []
    per m in messaggi:
        c = m.get("content")
        se isinstance(c, tipo_testo):
            c = [{"type": "text", "text": c}]
        parti = []
        immagini_turno = []
        per b in c:
            t = b.get("type")
            se t == "text":
                p = {"text": b["text"]}
                se b.get("firma"):
                    p["thoughtSignature"] = b["firma"]
                parti.append(p)
            altrimenti_se t == "tool_use":
                nomi[b["id"]] = b["name"]
                p = {"functionCall": {"name": b["name"], "args": b.get("input", {})}}
                se b.get("firma"):
                    p["thoughtSignature"] = b["firma"]
                parti.append(p)
            altrimenti_se t == "tool_result":
                esito = b.get("content")
                se isinstance(esito, tipo_lista):
                    se immagini:
                        immagini_turno += [{"inlineData": {"mimeType": x["source"]["media_type"], "data": x["source"]["data"]}}
                                           per x in esito se isinstance(x, dict) e x.get("type") == "image"]
                    esito = "\n".join(x.get("text", "") per x in esito se isinstance(x, dict) e x.get("type") == "text")
                se non isinstance(esito, tipo_testo):
                    esito = json.dumps(esito, ensure_ascii=Falso)
                parti.append({"functionResponse": {"name": nomi.get(b["tool_use_id"], "strumento"),
                                                   "response": {("error" se b.get("is_error") altrimenti "result"): esito}}})
        se immagini_turno:
            # le immagini seguono tutte le risposte degli strumenti, nello stesso turno dell'utente
            parti += [{"text": "Immagine del risultato dello strumento:"}] + immagini_turno
        se non parti:
            continua
        ruolo = "model" se m.get("role") == "assistant" altrimenti "user"
        se contenuti e contenuti[-1]["role"] == ruolo:
            contenuti[-1]["parts"] += parti
        altrimenti:
            contenuti.append({"role": ruolo, "parts": parti})
    ritorna contenuti


definisci risposta_da_gemini(r, da_json=Nessuno):
    """La risposta di generateContent nel formato interno (content, stop_reason, usage)."""
    da_json = da_json o {}
    candidati = r.get("candidates") o []
    se non candidati:
        motivo = (r.get("promptFeedback") o {}).get("blockReason", "")
        solleva ErroreAI("Gemini non ha risposto" + (f" (richiesta bloccata: {motivo})." se motivo altrimenti "."))
    parti = (candidati[0].get("content") o {}).get("parts") o []
    blocchi = []
    chiamate = 0
    per p in parti:
        se "functionCall" in p:
            f = p["functionCall"]
            argomenti = dict(f.get("args") o {})
            per nome_p in da_json.get(f.get("name"), []):
                se isinstance(argomenti.get(nome_p), tipo_testo):
                    prova:
                        argomenti[nome_p] = json.loads(argomenti[nome_p])
                    eccetto ValueError:
                        passa
            b = {"type": "tool_use", "id": "gem_" + uuid.uuid4().hex[:10], "name": f.get("name", ""), "input": argomenti}
            se p.get("thoughtSignature"):
                b["firma"] = p["thoughtSignature"]
            blocchi.append(b)
            chiamate += 1
        altrimenti_se p.get("thought"):
            continua                                # riassunto del ragionamento: non è la risposta
        altrimenti_se (p.get("text") o "").strip():
            b = {"type": "text", "text": p["text"]}
            se p.get("thoughtSignature"):
                b["firma"] = p["thoughtSignature"]
            blocchi.append(b)
    fine = candidati[0].get("finishReason", "")
    se non blocchi:
        solleva ErroreAI(f"Risposta vuota da Gemini (motivo: {fine o 'sconosciuto'}).")
    u = r.get("usageMetadata") o {}
    letti = u.get("cachedContentTokenCount", 0) o 0
    ritorna {"content": blocchi,
             "stop_reason": "tool_use" se chiamate altrimenti ("max_tokens" se fine == "MAX_TOKENS" altrimenti "end_turn"),
             "usage": {"input_tokens": max(0, (u.get("promptTokenCount", 0) o 0) - letti),
                       "output_tokens": (u.get("candidatesTokenCount", 0) o 0) + (u.get("thoughtsTokenCount", 0) o 0),
                       "cache_read_input_tokens": letti}}


# i modelli 2.5 non sono più disponibili per i nuovi utenti: chi li ha ancora salvati nella configurazione passa ai successori
MODELLI_GEMINI_RITIRATI = {"gemini-2.5-flash": "gemini-3.6-flash", "gemini-2.5-pro": "gemini-3.6-flash", "gemini-2.5-flash-lite": "gemini-3.5-flash-lite"}


classe ClienteGemini(ClienteBase):
    """Gemini di Google (API generateContent)."""
    nome = "Gemini"
    chiave_config = "ai.chiave_gemini"
    variabili_ambiente = ("GEMINI_API_KEY", "GOOGLE_API_KEY")
    chiave_modello = "ai.modello_gemini"
    chiave_economico = "ai.modello_economico_gemini"
    modello_predefinito = "gemini-3.6-flash"
    economico_predefinito = "gemini-3.5-flash-lite"

    definisci modello(se_stesso):
        m = ClienteBase.modello(se_stesso)
        ritorna MODELLI_GEMINI_RITIRATI.get(m, m)

    definisci modello_economico(se_stesso):
        m = ClienteBase.modello_economico(se_stesso)
        ritorna MODELLI_GEMINI_RITIRATI.get(m, m)

    immagini_rifiutate = Falso

    definisci supporta_immagini(se_stesso):
        ritorna non se_stesso.immagini_rifiutate

    definisci chiama(se_stesso, messaggi, sistema, strumenti):
        chiave = se_stesso._chiave_o_errore()
        dichiarazioni, da_json = strumenti_a_gemini(strumenti)
        base = se_stesso.config_.ottieni("ai.url_gemini", "https://generativelanguage.googleapis.com/v1beta").rstrip("/")
        indirizzo = f"{base}/models/{se_stesso.modello()}:generateContent"
        definisci corpo_con(immagini):
            ritorna {"systemInstruction": {"parts": [{"text": sistema}]}, "contents": messaggi_a_gemini(messaggi, immagini=immagini),
                     "tools": [{"functionDeclarations": dichiarazioni}],
                     "generationConfig": {"maxOutputTokens": int(se_stesso.config_.ottieni("ai.max_token", 4096))}}
        prova:
            ritorna risposta_da_gemini(se_stesso._invia(indirizzo, corpo_con(se_stesso.supporta_immagini()), {"x-goog-api-key": chiave}), da_json)
        eccetto ErroreAI come errore:
            # se Gemini rifiuta la richiesta con le immagini (la forma accettata dipende dal modello), si riprova senza e non se ne mandano più
            se se_stesso.supporta_immagini() e "400" in tipo_testo(errore) e "inlineData" in json.dumps(corpo_con(Vero)):
                risposta = risposta_da_gemini(se_stesso._invia(indirizzo, corpo_con(Falso), {"x-goog-api-key": chiave}), da_json)
                ClienteGemini.immagini_rifiutate = Vero          # il ripiego ha funzionato: era colpa delle immagini (vale finché PitStudio resta aperto)
                ritorna risposta
            solleva


CLIENTI = {"claude": ClienteClaude, "gemini": ClienteGemini, "deepseek": ClienteDeepSeek, "openai": ClienteOpenAI, "openrouter": ClienteOpenRouter, "ollama": ClienteOllama}


definisci fornitore_di(config):
    """Il fornitore scelto nelle Impostazioni (claude se manca o non è valido)."""
    f = config.ottieni("ai.fornitore", "claude")
    ritorna f se f in CLIENTI altrimenti "claude"


definisci crea_cliente(config):
    """Il cliente del fornitore scelto nelle Impostazioni."""
    ritorna CLIENTI[fornitore_di(config)](config)


definisci chiave_modello(config):
    """Dove sta, nella configurazione, il modello del fornitore scelto («ai.modello» per Claude)."""
    ritorna CLIENTI[fornitore_di(config)].chiave_modello


definisci modelli_di(config):
    """I modelli suggeriti per il fornitore scelto (elenco della casella nella chat)."""
    f = fornitore_di(config)
    chiave = {"claude": "ai.modelli", "gemini": "ai.modelli_gemini", "deepseek": "ai.modelli_deepseek", "openai": "ai.modelli_openai",
              "openrouter": "ai.modelli_openrouter", "ollama": "ai.modelli_ollama"}[f]
    elenco = config.ottieni(chiave, [])
    se f == "ollama":
        elenco = modelli_installati_ollama(config) o elenco          # quelli davvero scaricati, se Ollama risponde
    se f == "gemini":
        elenco = [MODELLI_GEMINI_RITIRATI.get(m, m) per m in elenco]
        elenco = [m per i, m in enumera(elenco) se m non in elenco[:i]]
    ritorna elenco


# ---------------------------------------------------------------- ricerca dei modelli davvero disponibili (con la chiave dell'utente)
# Dove l'API lo dice (OpenRouter) c'è anche il prezzo; per gli altri fornitori solo la pagina dei prezzi: nessuna tabella scritta a mano che invecchia.
PAGINE_PREZZI = {"claude": "https://docs.anthropic.com/en/docs/about-claude/pricing", "gemini": "https://ai.google.dev/gemini-api/docs/pricing",
                 "deepseek": "https://api-docs.deepseek.com/quick_start/pricing", "openai": "https://platform.openai.com/docs/pricing",
                 "openrouter": "https://openrouter.ai/models", "ollama": ""}
_NON_CHAT_OPENAI = ("embedding", "whisper", "tts", "dall-e", "image", "audio", "realtime", "moderation", "transcribe", "search", "davinci", "babbage", "instruct", "sora", "computer-use")


definisci _leggi_json(url, intestazioni, tempo=15):
    """GET con risposta JSON; gli errori diventano ErroreAI con un messaggio comprensibile."""
    richiesta = urllib.request.Request(url, headers=dict(intestazioni, **{"user-agent": "PitStudio"}))
    prova:
        con urllib.request.urlopen(richiesta, timeout=tempo) come r:
            ritorna json.loads(r.read().decode("utf-8"))
    eccetto urllib.error.HTTPError come eccezione:
        se eccezione.code in (401, 403):
            solleva ErroreAI("La chiave API non è accettata dal fornitore (controllala nelle Impostazioni).")
        solleva ErroreAI(f"Errore {eccezione.code} dal fornitore: {eccezione.reason}")
    eccetto urllib.error.URLError come eccezione:
        solleva ErroreAI(f"Connessione non riuscita: {eccezione.reason}")
    eccetto (ErroreDiTimeout, ErroreDiSistema, ErroreDiValore) come eccezione:
        solleva ErroreAI(f"Errore di rete: {eccezione}")


definisci _prezzo_milione(valore):
    """Prezzo per token (testo, come lo dà OpenRouter) -> dollari per milione di token; None se manca o non è un numero."""
    prova:
        ritorna round(float(valore) * 1000000, 4)
    eccetto (ErroreDiTipo, ErroreDiValore):
        ritorna Nessuno


definisci cerca_modelli(config, fornitore=Nessuno, chiave=Nessuno):
    """I modelli che il fornitore offre adesso: [{"id", "nome", "ingresso", "uscita"}] (prezzi in $ per milione di token, None = non indicato dall'API).
    `chiave` (se data) vale al posto di quella salvata. Solleva ErroreAI se la chiave manca o il fornitore non risponde."""
    fornitore = fornitore o fornitore_di(config)
    cliente = CLIENTI[fornitore](config)
    se chiave è non Nessuno e fornitore != "ollama":
        cliente.chiave = lambda: chiave.strip()
    k = cliente.chiave() se fornitore in ("ollama", "openrouter") altrimenti cliente._chiave_o_errore()          # Ollama non vuole chiave; l'elenco di OpenRouter è pubblico
    elenco = []
    se fornitore == "claude":
        base = config.ottieni("ai.url", "https://api.anthropic.com/v1/messages")
        base = (base[:-len("/messages")] se base.endswith("/messages") altrimenti base.rstrip("/")) + "/models?limit=100"
        dati = _leggi_json(base, {"x-api-key": k, "anthropic-version": config.ottieni("ai.versione_api", "2023-06-01")})
        elenco = [{"id": m["id"], "nome": m.get("display_name", ""), "ingresso": Nessuno, "uscita": Nessuno} per m in dati.get("data", [])]
    altrimenti_se fornitore == "gemini":
        base = config.ottieni("ai.url_gemini", "https://generativelanguage.googleapis.com/v1beta").rstrip("/")
        dati = _leggi_json(base + "/models?pageSize=200", {"x-goog-api-key": k})
        per m in dati.get("models", []):
            se "generateContent" in m.get("supportedGenerationMethods", ["generateContent"]):
                elenco.append({"id": m["name"].split("/", 1)[-1], "nome": m.get("displayName", ""), "ingresso": Nessuno, "uscita": Nessuno})
    altrimenti_se fornitore == "deepseek":
        base = config.ottieni("ai.url_deepseek", "https://api.deepseek.com").rstrip("/")
        dati = _leggi_json(base + "/models", {"authorization": "Bearer " + k})
        elenco = [{"id": m["id"], "nome": "", "ingresso": Nessuno, "uscita": Nessuno} per m in dati.get("data", [])]
    altrimenti_se fornitore == "openai":
        base = config.ottieni("ai.url_openai", ClienteOpenAI.url_predefinito).rstrip("/")
        dati = _leggi_json(base + "/models", {"authorization": "Bearer " + k})
        per m in dati.get("data", []):
            nome_m = m["id"]
            se (nome_m.startswith(("gpt-", "chatgpt", "o1", "o3", "o4", "o5")) o nome_m.startswith("o")) e non almeno_uno_vero(x in nome_m per x in _NON_CHAT_OPENAI):
                elenco.append({"id": nome_m, "nome": "", "ingresso": Nessuno, "uscita": Nessuno})
    altrimenti_se fornitore == "openrouter":
        base = config.ottieni("ai.url_openrouter", ClienteOpenRouter.url_predefinito).rstrip("/")
        dati = _leggi_json(base + "/models", {})          # l'elenco di OpenRouter è pubblico, con i prezzi
        per m in dati.get("data", []):
            se "tools" in (m.get("supported_parameters") o ["tools"]):          # l'assistente ha bisogno degli strumenti
                p = m.get("pricing") o {}
                elenco.append({"id": m["id"], "nome": m.get("name", ""), "ingresso": _prezzo_milione(p.get("prompt")), "uscita": _prezzo_milione(p.get("completion"))})
    altrimenti:
        elenco = [{"id": n, "nome": "", "ingresso": 0.0, "uscita": 0.0} per n in modelli_installati_ollama(config, tempo=5)]
        se non elenco:
            solleva ErroreAI("Non trovo Ollama su questo computer, o non ha nessun modello scaricato. Avvialo e scarica un modello con  ollama pull <nome>.")
    ritorna sorted(elenco, key=lambda m: m["id"])


definisci salva_modelli_trovati(config, fornitore, elenco):
    """Mette gli identificatori trovati nell'elenco della casella dei modelli del fornitore (ai.modelli…)."""
    chiave = {"claude": "ai.modelli", "gemini": "ai.modelli_gemini", "deepseek": "ai.modelli_deepseek", "openai": "ai.modelli_openai",
              "openrouter": "ai.modelli_openrouter", "ollama": "ai.modelli_ollama"}[fornitore]
    config.imposta(chiave, [m["id"] per m in elenco], notifica=Falso)


definisci testo_prezzo(modello):
    """«$3 / $15 al milione di token» (ingresso / uscita), «gratis» o «prezzo non indicato»."""
    i, u = modello.get("ingresso"), modello.get("uscita")
    se i è Nessuno o u è Nessuno:
        ritorna "non indicato"
    se i == 0 e u == 0:
        ritorna "gratis"
    ritorna f"${i:g} / ${u:g}"


definisci _tronca(testo_, limite=LIMITE_RISULTATO):
    se lunghezza_di(testo_) <= limite:
        ritorna testo_
    meta = limite // 2
    ritorna testo_[:meta] + f"\n… [troncato: {lunghezza_di(testo_) - limite} caratteri] …\n" + testo_[-meta:]


classe Strumenti:
    """Esegue gli strumenti richiesti dall'AI. Le azioni sull'interfaccia passano dal ponte UI."""
    nomi_ammessi = Nessuno                # se è una lista, solo quegli strumenti (modalità professore)

    definisci __inizializza__(se_stesso, ambiente, config, ponte):
        se_stesso.ambiente = ambiente
        se_stesso.config_ = config
        se_stesso.ponte = ponte
        se_stesso.registro = Nessuno          # RegistroAI (facoltativo)
        se_stesso.id_richiesta = ""
        se_stesso.tentativi = {}              # file -> scritture rifiutate per errori di sintassi in questa richiesta
        se_stesso.storia = Nessuno            # Storia del progetto (per annullare le modifiche dell'assistente)
        se_stesso.descrizione = ""
        se_stesso.spiegazione = ""            # ultimo testo dell'assistente: è il «Perché» della finestra prima/dopo

    definisci _registra(se_stesso, tipo_, **dati):
        se se_stesso.registro:
            se_stesso.registro.scrivi(tipo_, richiesta=se_stesso.id_richiesta, **dati)

    @property
    definisci progetto(se_stesso):
        p = se_stesso.ambiente.progetto
        se p è Nessuno:
            solleva ErroreDiValore("nessun progetto aperto: chiedi all'utente di aprirne o crearne uno")
        ritorna p

    definisci esegui(se_stesso, nome, parametri):
        """Ritorna (testo_risultato, è_errore)."""
        se se_stesso.nomi_ammessi è non Nessuno e nome non in se_stesso.nomi_ammessi:
            ritorna f"Lo strumento «{nome}» non è disponibile nella modalità professore: guida l'allievo a scrivere il codice da solo.", Vero
        funzione = getattr(se_stesso, "s_" + nome, Nessuno)
        se funzione è Nessuno:
            ritorna f"Strumento sconosciuto: {nome}", Vero
        se nome in STRUMENTI_CHE_MODIFICANO e se_stesso.storia è non Nessuno:
            prova:
                se_stesso.storia.prima_di_modificare(se_stesso.id_richiesta, se_stesso.descrizione)
            eccetto OSError:
                passa           # senza copia di sicurezza l'assistente lavora lo stesso
        prova:
            ritorna _tronca(tipo_testo(funzione(**(parametri o {})))), Falso
        eccetto ErroreDiValore come eccezione:
            ritorna tipo_testo(eccezione), Vero
        eccetto (OSError, KeyError, ErroreDiTipo, ErroreDiAttributo, TimeoutError) come eccezione:
            ritorna f"{tipo_di(eccezione).__name__}: {eccezione}", Vero

    # --- lettura
    definisci s_stato_ide(se_stesso):
        stato = se_stesso.ponte.esegui(se_stesso.ambiente.stato_ide)
        # un progetto della 1.x non va corretto a mano: lo si dice subito, in testa, perché anche i modelli piccoli non lo perdano
        prova:
            da rad importa aggiorna_1x, versioni
            se isinstance(stato, dict) e se_stesso.ambiente.progetto:
                manifesto = se_stesso.progetto.manifesto
                del_progetto, in_uso = versioni.generazione_del_progetto(manifesto), versioni.generazione_interprete()
                stato["versioni"] = {"progetto": {"pitstudio": manifesto.get("pitstudio", "non dichiarata"), "interprete": manifesto.get("interprete", "non dichiarato (progetto della 1.x o precedente)")},
                                     "in_uso": versioni.versioni_attuali()}
                se del_progetto è non Nessuno e del_progetto > in_uso:
                    stato = {"ATTENZIONE": f"Il progetto è scritto per un interprete di generazione {del_progetto}, ma quello in uso è {in_uso}: va aggiornato l'interprete (reinstalla pytonIta), non il progetto.", **stato}
            se isinstance(stato, dict) e se_stesso.ambiente.progetto e del_progetto != in_uso e aggiorna_1x.serve_aggiornamento(se_stesso.progetto.cartella):
                stato = {"ATTENZIONE": "Questo progetto è della versione 1.x o ha file generati vecchi (finestre, programmi a mattonelle, nomi come leggi, lunghezza, testo, e, o). "
                                       "NON correggerli a mano e NON rifare mattonelle o finestre: chiama subito lo strumento aggiorna_da_1x (senza argomenti per vedere il rapporto, poi con applica=true).", **stato}
        eccetto Eccezione:
            passa
        ritorna json.dumps(stato, indent=1, ensure_ascii=Falso)

    definisci s_elenca_file(se_stesso, cartella="", estensioni=Nessuno):
        p = se_stesso.progetto
        prefisso = cartella.strip("/").replace("\\", "/")
        file = p.tutti_i_file([elemento.lower() per elemento in estensioni] se estensioni altrimenti Nessuno)
        se prefisso:
            file = [f per f in file se f == prefisso o f.startswith(prefisso + "/")]
        ritorna "\n".join(file) o "(nessun file)"

    definisci _contenuto(se_stesso, percorso):
        """Testo attuale: dall'editor se aperto (anche non salvato), altrimenti dal disco."""
        p = se_stesso.progetto
        assoluto = p.assoluto(percorso)
        aperto = se_stesso.ponte.esegui(lambda: se_stesso.ambiente.contenuto_aperto(assoluto))
        se aperto è non Nessuno:
            ritorna aperto
        ritorna p.leggi(percorso).replace("\r\n", "\n")

    definisci s_leggi_file(se_stesso, percorso, da_riga=1, a_riga=Nessuno):
        righe = se_stesso._contenuto(percorso).split("\n")
        a_riga = a_riga o lunghezza_di(righe)
        da_riga = max(1, da_riga)
        ritorna "\n".join(f"{n}: {r}" per n, r in enumera(righe[da_riga - 1:a_riga], da_riga))

    definisci s_cerca_nel_progetto(se_stesso, testo, estensioni=Nessuno):
        trovati = se_stesso.progetto.cerca(testo, [elemento.lower() per elemento in estensioni] se estensioni altrimenti Nessuno)
        se non trovati:
            ritorna "nessun risultato"
        ritorna "\n".join(f"{f}:{n}: {r}" per f, n, r in trovati)

    definisci s_vedi_anteprima(se_stesso, form=""):
        if_non_ammesse = "Questo fornitore o modello non riceve immagini: descrivi il form leggendo i suoi dati (ottieni_form)."
        se non getattr(se_stesso, "immagini_ammesse", Falso):
            ritorna if_non_ammesse
        png = se_stesso.ponte.esegui(lambda: se_stesso.ambiente.anteprima_png(form))
        se_stesso.immagine_pendente = base64.b64encode(png).decode("ascii")
        ritorna f"Schermata della finestra «{form o 'aperta ora'}» ({lunghezza_di(png) // 1024} KB), allegata come immagine."

    definisci s_controlla_sintassi(se_stesso, percorso=Nessuno, codice=Nessuno):
        se codice è Nessuno:
            se non percorso:
                solleva ErroreDiValore("indica 'percorso' o 'codice'")
            codice = se_stesso._contenuto(percorso)
        linguaggio = "py" se (percorso o "").lower().endswith((".py", ".pyw")) altrimenti "pit"
        r = esecuzione.controlla_sintassi(codice, percorso o "<codice>", linguaggio)
        se r è non Nessuno:
            ritorna f"errore di sintassi alla riga {r[0]}, colonna {r[1]}: {r[2]}"
        # il controllo prima dell'esecuzione: questi errori gravi impedirebbero al programma di partire
        gravi = [q per q in controllo.trova(codice, linguaggio) se q["grave"]]
        se gravi:
            ritorna "sintassi ok, ma il programma non partirebbe (errori gravi del controllo):\n" + "\n".join(f"riga {q['riga']}: {q['motivo']}" per q in gravi[:20])
        ritorna "ok"

    definisci s_membri_modulo(se_stesso, modulo, prefisso=""):
        cartelle = [se_stesso.progetto.cartella] se se_stesso.ambiente.progetto altrimenti []
        voci = parole.membri_di(modulo, f"importa {modulo.split('.')[0]}\n", cartelle)
        voci = [v per v in voci se v[0].lower().startswith(prefisso.lower())]
        se non voci:
            ritorna "nessun membro trovato (modulo non importabile o prefisso errato)"
        ritorna "\n".join(f"{n}  ({t})" per n, t in voci[:300])

    # --- scrittura (con conferma)
    definisci _conferma_scrittura(se_stesso, percorso, nuovo, vecchio):
        se non se_stesso.config_.ottieni("ai.conferma_scrittura", Vero):
            ritorna
        se hasattr(se_stesso.ambiente, "chiedi_modifica"):
            se non se_stesso.ponte.esegui(lambda: se_stesso.ambiente.chiedi_modifica(percorso, vecchio, nuovo, se_stesso.spiegazione), 600):
                solleva ErroreDiValore("l'utente ha rifiutato la scrittura del file")
            ritorna
        righe_n = nuovo.count("\n") + 1
        righe_v = (vecchio.count("\n") + 1) se vecchio è non Nessuno altrimenti 0
        dettaglio = (f"L'assistente vuole {'modificare' se vecchio è non Nessuno altrimenti 'creare'} il file:\n\n  {percorso}\n\n"
                     f"Righe: {righe_v} → {righe_n}\n\nAnteprima:\n" + "\n".join(nuovo.split("\n")[:12]))
        se non se_stesso.ponte.esegui(lambda: se_stesso.ambiente.chiedi_conferma("Scrittura file", dettaglio), 600):
            solleva ErroreDiValore("l'utente ha rifiutato la scrittura del file")

    definisci _scrivi(se_stesso, percorso, contenuto, vecchio):
        se percorso.endswith("_ui.pit"):
            solleva ErroreDiValore("i file *_ui.pit sono generati dal progettista: modifica il form con imposta_form")
        p = se_stesso.progetto
        assoluto = p.assoluto(percorso)
        errore = se_stesso._errore_di_sintassi(percorso, contenuto, vecchio)
        precedenti = se_stesso.tentativi.get(percorso, 0)
        linguaggio = "py" se percorso.lower().endswith((".py", ".pyw")) altrimenti ("pit" se percorso.lower().endswith(".pit") altrimenti "altro")
        se errore:
            consentiti = int(se_stesso.config_.ottieni("ai.correzioni_automatiche", 2))
            se_stesso.tentativi[percorso] = precedenti + 1
            se precedenti < consentiti:
                # il codice sbagliato non arriva all'utente: lo si rimanda all'assistente perché lo corregga
                se_stesso._registra("scrittura", file=percorso, linguaggio=linguaggio, esito="sintassi", tentativo=precedenti + 1, errore=tipo_testo(errore[2])[:200])
                solleva ErroreDiValore(f"NON SCRITTO: il codice ha un errore di sintassi alla riga {errore[0]}, colonna {errore[1]}: {errore[2]}. "
                                       f"Il file non è stato modificato. Correggi e riprova (tentativo {precedenti + 1} di {consentiti + 1}).")
            # troppi tentativi: decide l'utente
            dettaglio = (f"L'assistente non è riuscito a produrre codice valido per:\n\n  {percorso}\n\n"
                         f"Errore alla riga {errore[0]}: {errore[2]}\n\nVuoi salvarlo comunque, per correggerlo a mano?")
            se non se_stesso.ponte.esegui(lambda: se_stesso.ambiente.chiedi_conferma("Codice con errori", dettaglio), 600):
                se_stesso._registra("scrittura", file=percorso, linguaggio=linguaggio, esito="rifiutato", tentativo=precedenti + 1)
                solleva ErroreDiValore("l'utente ha rifiutato di salvare codice con errori di sintassi")
            se_stesso.ponte.esegui(lambda: se_stesso.ambiente.scrivi_file(assoluto, contenuto))
            se_stesso._registra("scrittura", file=percorso, linguaggio=linguaggio, esito="forzato", tentativo=precedenti + 1)
            ritorna
        se_stesso._conferma_scrittura(percorso, contenuto, vecchio)
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.scrivi_file(assoluto, contenuto))
        se_stesso.tentativi[percorso] = 0
        se_stesso._registra("scrittura", file=percorso, linguaggio=linguaggio, esito="valido", tentativo=precedenti + 1)

    definisci _errore_di_sintassi(se_stesso, percorso, nuovo, vecchio):
        """(riga, colonna, messaggio) se il nuovo contenuto di un file .pit/.py non è valido, altrimenti Nessuno.

        Se il file era già sbagliato prima della modifica non si blocca nulla (può servire una correzione in più passi)."""
        se non percorso.lower().endswith((".pit", ".py", ".pyw")):
            ritorna Nessuno
        errore = esecuzione.controlla_sintassi(nuovo, percorso)
        se errore è Nessuno:
            # sintassi giusta: ma il programma partirebbe? (parole chiave come nomi, funzioni predefinite nascoste)
            se percorso.lower().endswith(".pit"):
                gravi = [q per q in controllo.trova(nuovo, "pit") se q["grave"]]
                gravi_prima = [q per q in controllo.trova(vecchio, "pit") se q["grave"]] se vecchio è non Nessuno altrimenti []
                se gravi e non gravi_prima:
                    ritorna (gravi[0]["riga"], gravi[0]["inizio"], "errore grave: " + gravi[0]["motivo"])
            ritorna Nessuno
        se vecchio è non Nessuno e esecuzione.controlla_sintassi(vecchio, percorso) è non Nessuno:
            ritorna Nessuno
        ritorna errore

    definisci s_scrivi_file(se_stesso, percorso, contenuto):
        p = se_stesso.progetto
        esiste = os.path.exists(p.assoluto(percorso))
        vecchio = se_stesso._contenuto(percorso) se esiste altrimenti Nessuno
        se_stesso._scrivi(percorso, contenuto, vecchio)
        ritorna f"scritto {percorso} ({contenuto.count(chr(10)) + 1} righe)"

    definisci s_modifica_file(se_stesso, percorso, vecchio, nuovo, tutte=Falso):
        attuale = se_stesso._contenuto(percorso)
        n = attuale.count(vecchio)
        se n == 0:
            solleva ErroreDiValore("il testo 'vecchio' non è presente nel file (controlla spazi e rientri)")
        se n > 1 e non tutte:
            solleva ErroreDiValore(f"il testo 'vecchio' compare {n} volte: aggiungi contesto o usa tutte=true")
        risultato = attuale.replace(vecchio, nuovo) se tutte altrimenti attuale.replace(vecchio, nuovo, 1)
        se_stesso._scrivi(percorso, risultato, attuale)
        ritorna f"modificato {percorso} ({n se tutte altrimenti 1} sostituzioni)"

    definisci s_elimina_file(se_stesso, percorso):
        p = se_stesso.progetto
        assoluto = p.assoluto(percorso)
        se non os.path.exists(assoluto):
            solleva ErroreDiValore("il file non esiste")
        se non se_stesso.ponte.esegui(lambda: se_stesso.ambiente.chiedi_conferma(
                "Elimina", f"L'assistente vuole ELIMINARE:\n\n  {percorso}\n\nL'operazione non è annullabile."), 600):
            solleva ErroreDiValore("l'utente ha rifiutato l'eliminazione")
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.elimina_percorso(assoluto))
        ritorna f"eliminato {percorso}"

    definisci s_apri_file(se_stesso, percorso, riga=Nessuno):
        assoluto = se_stesso.progetto.assoluto(percorso)
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.apri_file_a_riga(assoluto, riga o 1))
        ritorna "aperto"

    # --- esecuzione
    definisci s_esegui_programma(se_stesso, file=Nessuno, argomenti=Nessuno, ingresso=Nessuno, tempo_massimo=30):
        p = se_stesso.progetto
        percorso = p.assoluto(file) se file altrimenti p.percorso_principale()
        se non percorso o non os.path.exists(percorso):
            solleva ErroreDiValore("file da eseguire non trovato (imposta il file principale o passa 'file')")
        se se_stesso.config_.ottieni("ai.conferma_esecuzione", Vero):
            se non se_stesso.ponte.esegui(lambda: se_stesso.ambiente.chiedi_conferma(
                    "Esecuzione", f"L'assistente vuole eseguire:\n\n  {p.relativo(percorso)} {' '.join(argomenti o [])}"), 600):
                solleva ErroreDiValore("l'utente ha rifiutato l'esecuzione")
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.salva_tutto())
        comando = [se_stesso.config_.interprete(), "-u", percorso] + tipo_lista(argomenti o [])
        r = esecuzione.esegui_sincrono(comando, p.cartella, max(1, min(int(tempo_massimo), 300)), ingresso,
                                      limiti.da_configurazione(se_stesso.config_, "ai"))
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.mostra_in_console(p.relativo(percorso), r))
        se_stesso._registra("esecuzione", file=p.relativo(percorso), codice=r["codice"], scaduto=bool(r["scaduto"]), secondi=r["secondi"])
        parti = [f"codice di uscita: {r['codice']}" + (" (scaduto il tempo massimo: processo terminato)" se r["scaduto"] altrimenti "")
                 + f"  durata: {r['secondi']} s"]
        se r["uscita"]:
            parti.append("--- output ---\n" + r["uscita"])
        se r["errori"]:
            parti.append("--- errori ---\n" + r["errori"])
        ritorna "\n".join(parti)

    # --- progettista
    definisci s_ottieni_form(se_stesso, nome=Nessuno):
        p = se_stesso.progetto
        se non nome:
            ritorna "\n".join(p.forms()) o "(nessuna finestra disegnata)"
        ritorna se_stesso.ponte.esegui(lambda: se_stesso.ambiente.json_form(nome))

    definisci s_aggiorna_da_1x(se_stesso, applica=Falso):
        da rad importa aggiorna_1x
        cartella = se_stesso.progetto.cartella
        rapporto = aggiorna_1x.aggiorna_progetto(cartella)
        testo_ = aggiorna_1x.testo_rapporto(rapporto)
        se non applica:
            ritorna "RAPPORTO (nulla è stato modificato; per farlo richiama lo strumento con applica: true):\n" + testo_
        se non aggiorna_1x.ha_modifiche(rapporto):
            ritorna testo_
        se se_stesso.config_.ottieni("ai.conferma_scrittura", Vero):
            se non se_stesso.ponte.esegui(lambda: se_stesso.ambiente.chiedi_conferma("Aggiorna dalla 1.x", "L'assistente vuole aggiornare il progetto dalla versione 1.x:\n\n" + testo_ + "\n\nSi può annullare con «Annulla»."), 600):
                solleva ErroreDiValore("l'utente ha rifiutato l'aggiornamento")
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.salva_tutto())
        rapporto = aggiorna_1x.aggiorna_progetto(cartella, applica=Vero)
        se_stesso.progetto.carica_manifesto()
        se_stesso.ponte.esegui(lambda: se_stesso.ambiente.ricarica_file_cambiati())
        ritorna "AGGIORNATO:\n" + aggiorna_1x.testo_rapporto(rapporto, Vero)

    definisci s_converti_in_mattonelle(se_stesso, file, nome=Nessuno):
        assoluto = se_stesso.progetto.assoluto(file)
        risultato = se_stesso.ponte.esegui(lambda: se_stesso.ambiente.converti_in_mattonelle(assoluto, nome, Vero), 180)
        percorsi, rapporto = risultato
        ritorna "convertito: " + ", ".join(percorsi) + "\n" + rapporto

    definisci s_tipi_mattonelle(se_stesso):
        ritorna mattonelle_modello.catalogo_tipi()

    definisci s_ottieni_mattonelle(se_stesso, nome=Nessuno):
        p = se_stesso.progetto
        se non nome:
            ritorna "\n".join(f per f in p.tutti_i_file() se f.endswith(".mattonelle.json")) o "(nessun programma a mattonelle)"
        ritorna se_stesso.ponte.esegui(lambda: se_stesso.ambiente.json_mattonelle(nome))

    definisci s_imposta_mattonelle(se_stesso, nome, programma):
        se_stesso.progetto
        se non mattonelle_modello.nome_variabile_valido(nome):
            solleva ErroreDiValore(f"nome non valido: {nome}")
        problemi = mattonelle_modello.valida_dizionario(programma)
        se problemi:
            solleva ErroreDiValore("programma non valido:\n- " + "\n- ".join(problemi[:15]))
        scritti, avvisi = se_stesso.ponte.esegui(lambda: se_stesso.ambiente.imposta_mattonelle(nome, programma), 120)
        messaggio = "programma a mattonelle salvato: " + ", ".join(scritti)
        se avvisi:
            messaggio += "\navvisi: " + "; ".join(avvisi[:10])
        ritorna messaggio

    definisci s_imposta_form(se_stesso, form):
        se_stesso.progetto
        f = form_modello.Form.da_dizionario(form)
        se non form_modello.nome_valido(f.nome):
            solleva ErroreDiValore(f"nome della finestra non valido: {f.nome}")
        problemi = f.problemi()
        scritti = se_stesso.ponte.esegui(lambda: se_stesso.ambiente.imposta_form(f), 120)
        messaggio = "finestra salvata: " + ", ".join(scritti)
        se problemi:
            messaggio += "\navvisi: " + "; ".join(problemi)
        ritorna messaggio


classe Agente:
    """Ciclo: messaggio → (strumenti → risultati)* → risposta finale."""
    definizioni = Nessuno                 # elenco degli strumenti offerti all'AI (DEFINIZIONI se Nessuno)

    definisci __inizializza__(se_stesso, cliente, strumenti, config, su_evento):
        se_stesso.cliente = cliente
        se_stesso.strumenti = strumenti
        se_stesso.config_ = config
        se_stesso.su_evento = su_evento
        se_stesso.arresto = threading.Event()
        se_stesso.registro = Nessuno          # RegistroAI (facoltativo)
        se_stesso.id_richiesta = ""

    definisci esegui(se_stesso, messaggi, sistema):
        """Elabora finché l'AI ha finito. 'messaggi' viene aggiornato sul posto."""
        inizio = time.time()
        se_stesso._passi = 0
        prova:
            se_stesso._ciclo(messaggi, sistema)
        infine:
            se_stesso._concludi_storia()
            se se_stesso.registro:
                se_stesso.registro.scrivi("fine", richiesta=se_stesso.id_richiesta, passi=se_stesso._passi,
                                          durata_s=round(time.time() - inizio, 1))

    definisci _concludi_storia(se_stesso):
        """Chiude il gruppo di modifiche della richiesta e avvisa l'interfaccia se qualcosa è cambiato."""
        storia = getattr(se_stesso.strumenti, "storia", Nessuno)
        se storia è Nessuno:
            ritorna
        prova:
            gruppo = storia.concludi()
        eccetto OSError:
            gruppo = Nessuno
        se gruppo:
            se_stesso.su_evento("modifiche", {"id": gruppo["id"], "file": lunghezza_di(gruppo["modifiche"])})
            se se_stesso.registro:
                se_stesso.registro.scrivi("modifiche", richiesta=se_stesso.id_richiesta, file=lunghezza_di(gruppo["modifiche"]))

    definisci _ciclo(se_stesso, messaggi, sistema):
        massimo = int(se_stesso.config_.ottieni("ai.passi_massimi", 25))
        per passo in intervallo_di(massimo):
            se se_stesso.arresto.is_set():
                se_stesso.su_evento("info", "Interrotto.")
                ritorna
            risparmiati = compatta(messaggi, int(se_stesso.config_.ottieni("ai.compatta_oltre_token", 30000)))
            se risparmiati:
                se_stesso.su_evento("info", f"Conversazione lunga: accorciati i vecchi risultati (circa {risparmiati // 4} token in meno).")
                se se_stesso.registro:
                    se_stesso.registro.scrivi("compattazione", richiesta=se_stesso.id_richiesta, token_risparmiati=risparmiati // 4)
            togli_immagini_vecchie(messaggi)
            offerti = [] se getattr(se_stesso.cliente, "senza_strumenti", lambda: Falso)() altrimenti (DEFINIZIONI se se_stesso.definizioni è Nessuno altrimenti se_stesso.definizioni)
            risposta = se_stesso.cliente.chiama(messaggi, sistema, offerti)
            se_stesso._passi = passo + 1
            blocchi = risposta.get("content", [])
            messaggi.append({"role": "assistant", "content": blocchi})
            uso = risposta.get("usage", {})
            se_stesso.su_evento("uso", dict(uso, modello=se_stesso.cliente.modello()))
            se se_stesso.registro:
                se_stesso.registro.scrivi("chiamata", richiesta=se_stesso.id_richiesta, passo=passo + 1,
                                          modello=se_stesso.cliente.modello(),
                                          input=uso.get("input_tokens", 0), output=uso.get("output_tokens", 0),
                                          cache_lettura=uso.get("cache_read_input_tokens", 0),
                                          cache_scrittura=uso.get("cache_creation_input_tokens", 0))
            richieste = []
            per b in blocchi:
                se b.get("type") == "text" e b.get("text", "").strip():
                    se_stesso.su_evento("testo", b["text"])
                    se_stesso.strumenti.spiegazione = b["text"]
                altrimenti_se b.get("type") == "tool_use":
                    richieste.append(b)
            se risposta.get("stop_reason") != "tool_use" o non richieste:
                se risposta.get("stop_reason") == "max_tokens":
                    se_stesso.su_evento("info", "La risposta è stata tagliata (max_token). Aumenta il limite nelle impostazioni.")
                ritorna
            risultati = []
            per b in richieste:
                se se_stesso.arresto.is_set():
                    risultati.append({"type": "tool_result", "tool_use_id": b["id"],
                                      "content": "interrotto dall'utente", "is_error": Vero})
                    continua
                se_stesso.su_evento("strumento", {"nome": b["name"], "parametri": b.get("input", {})})
                inizio = time.time()
                se_stesso.strumenti.immagine_pendente = Nessuno
                esito, errore = se_stesso.strumenti.esegui(b["name"], b.get("input", {}))
                se_stesso.su_evento("risultato", {"nome": b["name"], "testo": esito, "errore": errore,
                                                  "secondi": round(time.time() - inizio, 2)})
                contenuto = esito
                immagine = getattr(se_stesso.strumenti, "immagine_pendente", Nessuno)
                se immagine e non errore:
                    contenuto = [{"type": "text", "text": esito}, {"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": immagine}}]
                risultati.append({"type": "tool_result", "tool_use_id": b["id"], "content": contenuto, "is_error": errore})
            messaggi.append({"role": "user", "content": risultati})
        se_stesso.su_evento("info", f"Raggiunto il limite di {massimo} passi per richiesta.")


definisci prompt_di_sistema(config, progetto, compatto=Falso):
    """Manuale + informazioni sul progetto + istruzioni aggiuntive dell'utente. `compatto`: solo le regole del linguaggio e le librerie
    (circa un terzo): per i modelli locali senza strumenti, che hanno poco spazio e non usano il resto del manuale."""
    percorso = os.path.join(os.path.dirname(os.path.abspath(__file__)), "manuale.md")
    prova:
        con open(percorso, encoding="utf-8") come f:
            manuale = f.read()
    eccetto OSError:
        manuale = "Sei l'assistente di PitStudio, ambiente di sviluppo per pytonIta."
    se compatto:
        fine = manuale.find("## Progetti e finestre disegnate")
        se fine > 0:
            manuale = manuale[:fine]
    info = "\n\n## Progetto corrente\n"
    se progetto:
        info += f"Nome: {progetto.nome}\nFile principale: {progetto.principale o '(non impostato)'}\n"
    altrimenti:
        info += "Nessun progetto aperto.\n"
    extra = config.ottieni("ai.istruzioni_extra", "").strip()
    se extra:
        info += "\n## Istruzioni dell'utente\n" + extra + "\n"
    ritorna manuale + info


# ---------------------------------------------------------------- modelli senza strumenti (Ollama piccoli): il testo dei file viene allegato alla domanda
ESTENSIONI_ALLEGABILI = (".pit", ".py", ".md", ".txt", ".json", ".html", ".css", ".js", ".sql", ".csv", ".cfg", ".ini", ".toml", ".bat", ".sh", ".xml", ".yaml", ".yml")
INIZIO_ALLEGATI = "<file_del_progetto>"

ISTRUZIONI_SENZA_STRUMENTI = """

## SENZA STRUMENTI
In questa conversazione NON hai strumenti: non puoi leggere, cercare, scrivere o eseguire nulla. Ignora tutto ciò che il manuale dice sugli strumenti.
Il testo dei file che servono ti viene dato dentro <file_del_progetto>, scritto dall'ambiente prima della domanda. Rispondi usando solo quello.
Per proporre una modifica scrivi il codice corretto in un blocco di codice e dì in quale file va (e dopo quale riga o funzione): sarà l'utente a copiarlo.
Se ti manca un file, chiedi all'utente di scrivere il suo nome nella domanda: così gli si allega.
"""


definisci contesto_file(ambiente, domanda, massimo=12000):
    """Il testo dei file da allegare alla domanda per un modello senza strumenti: prima il file attivo, poi le altre schede aperte,
    poi i file del progetto che la domanda nomina. Si ferma a `massimo` caratteri (il resto è troncato). Testo vuoto se non c'è un progetto."""
    progetto = ambiente.progetto
    se non progetto:
        ritorna ""
    stato = ambiente.stato_ide()
    candidati = []
    se stato.get("file_attivo"):
        candidati.append(stato["file_attivo"])
    per scheda in stato.get("schede_aperte", []):
        candidati.append(scheda["file"])
    minuscola = domanda.lower()
    per relativo in progetto.tutti_i_file(Nessuno):
        base = os.path.basename(relativo).lower()
        se (lunghezza_di(base) >= 4 e base in minuscola) o relativo.lower() in minuscola:
            candidati.append(relativo)
    visti = set()
    parti = []
    usati = 0
    per relativo in candidati:
        se relativo in visti o non relativo.lower().endswith(ESTENSIONI_ALLEGABILI):
            continua
        visti.add(relativo)
        prova:
            assoluto = progetto.assoluto(relativo)
            testo_ = ambiente.contenuto_aperto(assoluto)
            se testo_ è Nessuno:
                testo_ = progetto.leggi(relativo)
        eccetto (OSError, ValueError):
            continua
        testo_ = testo_.replace("\r\n", "\n")
        spazio = massimo - usati
        se spazio < 200:
            interrompi
        se lunghezza_di(testo_) > spazio:
            testo_ = testo_[:spazio] + "\n… (file troncato: troppo lungo)"
        parti.append(f"### {relativo}\n```\n{testo_}\n```")
        usati += lunghezza_di(testo_)
    ritorna "\n\n".join(parti)


definisci togli_allegati_vecchi(messaggi):
    """Toglie dalle domande precedenti il testo dei file allegato allora (si rimanda aggiornato a ogni domanda): la conversazione non cresce a ogni giro."""
    per m in messaggi:
        se m.get("role") == "user" e isinstance(m.get("content"), list):
            m["content"] = [b per b in m["content"] se non (isinstance(b, dict) e b.get("type") == "text" e b.get("text", "").startswith(INIZIO_ALLEGATI))]


definisci prompt_professore(config, progetto, lezione):
    """Il prompt di sistema del professore: l'assistente di sempre, ma che insegna la lezione dell'allievo senza fargli i compiti."""
    lezione_testo = (lezione.get("testo") o "")[:14000]
    ritorna (prompt_di_sistema(config, progetto) + f"""

## MODALITÀ PROFESSORE
Adesso sei il PROFESSORE di programmazione di un allievo che sta studiando la lezione {lezione.get('numero')} «{lezione.get('titolo')}» del percorso di PitStudio.
Regole:
- Rispondi sempre in italiano, con parole semplici, frasi brevi, un passo alla volta. L'allievo è un principiante.
- Spiega con piccoli esempi (al massimo 5-6 righe) scritti in pytonIta, con le parole chiave italiane. Non usare Python inglese.
- NON scrivere la soluzione completa degli esercizi e non riscrivere il programma dell'allievo: dai un indizio alla volta, fai domande per farlo ragionare («cosa pensi che stampi questa riga?»), e solo se è bloccato da molto mostra un frammento.
- Puoi leggere i file dell'allievo (leggi_file, stato_ide), controllare la sintassi, eseguire il programma e aprire un file nell'editor. Non puoi scrivere né modificare file: lo fa l'allievo.
- Se c'è un errore, spiega cosa significa il messaggio e dove guardare, non correggerlo al posto suo.
- Resta sull'argomento della lezione; se l'allievo chiede altro, rispondi in breve e riporta il discorso alla lezione.
- Incoraggia: sbagliare serve a imparare.

## INDIZI A LIVELLI
Quando l'allievo scrive «Indizio livello N» (N da 1 a 4) rispondi SOLO con quel livello, in poche righe, e non anticipare i livelli successivi:
- Livello 1: una domanda che lo fa ragionare, o il richiamo del concetto da usare. Nessun codice.
- Livello 2: dove guardare (quale riga, quale parte del programma) e quale regola vale lì. Nessun codice.
- Livello 3: un esempio piccolo e DIVERSO dal suo problema, scritto in pytonIta, da cui può copiare l'idea.
- Livello 4: la riga (o le due righe) che mancano, spiegate; mai il programma intero.
La soluzione completa la dai solo se l'allievo dice chiaramente che si arrende, e dopo avergli spiegato cosa imparerebbe provandoci ancora. Se l'indizio richiesto è oltre il quarto, ripeti il livello 4 con parole diverse.

Il testo della lezione che l'allievo sta studiando:

{lezione_testo}
""")
