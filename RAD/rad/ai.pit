     "input_schema": {"type": "object", "properties": {"nome": {"type": "string"}, "programma": {"type": "object"}},
                      "required": ["nome", "programma"]}},
    {"name": "membri_modulo",
     "description": "Elenca i nomi pubblici di un modulo (italiano o inglese), con gli alias italiani, filtrabili per prefisso. "
                    "Serve per scoprire i nomi esatti delle librerie in italiano.",
     "input_schema": {"type": "object", "properties": {
