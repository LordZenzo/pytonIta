"""Assistente AI (Claude, Gemini, DeepSeek): client delle API, strumenti che agiscono sull'ambiente, ciclo dell'agente.

La conversazione ha sempre il formato dell'API Messages di Anthropic (blocchi text, tool_use, tool_result): ogni cliente la traduce
nel formato del proprio fornitore e traduce la risposta di nuovo in quel formato, così l'agente e gli strumenti non cambiano."""
importa json
importa os
importa threading
importa time
importa uuid
importa urllib.request
importa urllib.error

da rad importa esecuzione, parole, form_modello, mattonelle_modello, limiti

LIMITE_RISULTATO = 24000

