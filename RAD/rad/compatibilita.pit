    "winsound": "Per i suoni usa il modulo «suono» di pytonIta, che funziona anche su Linux.",
    "wmi": "WMI è solo Windows: per le informazioni sul sistema usa os, platform o shutil.",
    "win32api": "pywin32 è solo Windows.", "win32con": "pywin32 è solo Windows.", "win32gui": "pywin32 è solo Windows.",
    "win32com": "pywin32 è solo Windows.", "win32file": "pywin32 è solo Windows.", "win32process": "pywin32 è solo Windows.",
    "win32service": "pywin32 è solo Windows.", "win32clipboard": "Per gli appunti usa tkinter: clipboard_clear e clipboard_append.",
    "pythoncom": "pywin32 è solo Windows.", "pywintypes": "pywin32 è solo Windows.", "comtypes": "COM è solo Windows.",
}
