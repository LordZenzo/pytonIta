    "termios": "Su Windows non c'è: per leggere un tasto senza invio usa msvcrt (solo Windows) con un ripiego.",
    "tty": "Su Windows non c'è.", "pty": "Su Windows non c'è.",
    "pwd": "Su Windows non c'è: per il nome utente usa getpass.getuser().",
    "grp": "Su Windows non c'è.", "resource": "Su Windows non c'è: i limiti di memoria si gestiscono da PitStudio.",
    "syslog": "Su Windows non c'è: usa il modulo logging.", "crypt": "Su Windows non c'è.", "spwd": "Su Windows non c'è.",
    "posix": "Su Windows non c'è: usa il modulo os.", "curses": "Su Windows non c'è di serie: per un'interfaccia usa tkinter.",
}

# ---- funzioni e costanti: (modulo, nome) -> spiegazione
ATTRIBUTI_SOLO_WINDOWS = {
    ("os", "startfile"): "Per aprire un file con il suo programma su Linux serve xdg-open: usa PitStudio.piattaforma.apri oppure subprocess.run([\"xdg-open\", percorso]).",
    ("ctypes", "windll"): "windll non esiste su Linux: metti l'uso dentro «se sys.platform == \"win32\":».",
    ("ctypes", "WinDLL"): "WinDLL non esiste su Linux.", ("ctypes", "oledll"): "oledll non esiste su Linux.",
    ("ctypes", "WinError"): "WinError non esiste su Linux.",
    ("ctypes", "GetLastError"): "GetLastError non esiste su Linux.", ("ctypes", "FormatError"): "FormatError non esiste su Linux.",
