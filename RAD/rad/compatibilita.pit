    ("os", "O_BINARY"): "È solo Windows: usa getattr(os, \"O_BINARY\", 0).",
    ("sys", "getwindowsversion"): "È solo Windows.",
    ("asyncio", "WindowsSelectorEventLoopPolicy"): "È solo Windows.", ("asyncio", "ProactorEventLoop"): "È solo Windows.",
