"""Galleria di icone di PitStudio: oltre cento icone originali (cartella RAD/icone), ognuna in due colori (scuro per i fondi chiari, chiaro per i fondi scuri).
Si usa da qualunque punto del programma:

    da rad importa galleria_icone
    nome = galleria_icone.scegli_icona(finestra, colori)          # apre la finestra; restituisce il nome (es. «salva»), "" per «nessuna», Nessuno se si annulla
    percorso = galleria_icone.file_icona("salva")                 # il file .png scuro; con chiaro=Vero quello chiaro; «salva_colore» quello a colori
    rel = galleria_icone.copia_nel_progetto(cartella_risorse, "salva")      # copia le due versioni e dà il percorso del file scuro
"""
importa json
importa os
importa shutil
importa tkinter come tk
da tkinter importa ttk

da rad.piattaforma importa FONT_UI, lega_rotella

CARTELLA_ICONE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "icone")
TUTTE = "Tutte"
STILI = ("Monocromatico", "A colori")
SUFFISSO_COLORE = "_colore"
_ricordo = {"stile": STILI[0]}          # lo stile scelto l'ultima volta resta quello proposto
_cache_indice = []


definisci elenco_icone():
    """[{nome, categoria, parole}] di tutte le icone della galleria."""
    se non _cache_indice:
        prova:
            con open(os.path.join(CARTELLA_ICONE, "indice.json"), encoding="utf-8") come f:
                _cache_indice.extend(json.load(f))
        eccetto (OSError, ValueError):
            passa
    ritorna list(_cache_indice)


definisci categorie():
    ritorna sorted({i["categoria"] per i in elenco_icone()})


definisci file_icona(nome, chiaro=Falso):
    """Il percorso del file .png di un'icona (Nessuno se non esiste). «salva» è la versione scura (con chiaro=Vero quella chiara, per i fondi scuri),
    «salva_colore» quella a colori, che va bene su qualunque fondo."""
    percorso = os.path.join(CARTELLA_ICONE, nome + ("_chiaro" se chiaro e non nome.endswith(SUFFISSO_COLORE) altrimenti "") + ".png")
    ritorna percorso se os.path.isfile(percorso) altrimenti Nessuno


definisci e_della_galleria(percorso):
    """True se il percorso è di un'icona copiata dalla galleria (nome e nome_chiaro nella cartella icone)."""
    base = os.path.basename(percorso o "")
    ritorna base.endswith(".png") e any(i["nome"] == base[:-4].removesuffix(SUFFISSO_COLORE) per i in elenco_icone())


definisci copia_nel_progetto(cartella_risorse, nome):
    """Copia l'icona in <cartella_risorse>/icone e restituisce il percorso del file. Per le icone monocromatiche copia le due versioni (scura e chiara):
    la seconda sta accanto alla prima e il menu moderno sceglie da solo quella giusta per il tema. Quella «a colori» è un file solo."""
    destinazione = os.path.join(cartella_risorse, "icone")
    os.makedirs(destinazione, exist_ok=Vero)
    per chiaro in ((Falso,) se nome.endswith(SUFFISSO_COLORE) altrimenti (Falso, Vero)):
        origine = file_icona(nome, chiaro)
        se origine:
            shutil.copy2(origine, os.path.join(destinazione, os.path.basename(origine)))
    ritorna os.path.join(destinazione, nome + ".png")


definisci _luminosa(colore):
    prova:
        r, g, b = (int(colore.lstrip("#")[i:i + 2], 16) per i in (0, 2, 4))
        ritorna 0.299 * r + 0.587 * g + 0.114 * b > 128
    eccetto (ValueError, IndexError):
        ritorna Vero


classe DialogoIcone(tk.Toplevel):
    """La galleria: una ricerca, un filtro per categoria e le icone da scegliere con un clic (o doppio clic)."""
    COLONNE = 9
    LATO = 46

    definisci __inizializza__(se_stesso, genitore, colori, corrente="", permetti_nessuna=Vero):
        tk.Toplevel.__init__(se_stesso, genitore)
        se_stesso.title("Galleria di icone")
        se_stesso.transient(genitore.winfo_toplevel())
        se_stesso.configure(background=colori["pannello"])
        se_stesso.geometry("560x520")
        se_stesso.minsize(420, 320)
        se_stesso.c = colori
        se_stesso.risultato = Nessuno
        se_stesso.a_colori = corrente.endswith(SUFFISSO_COLORE) se corrente altrimenti _ricordo["stile"] == STILI[1]
        se_stesso.scelta = (corrente o "").removesuffix(SUFFISSO_COLORE)
        se_stesso._chiaro = non _luminosa(colori["pannello"])          # fondo scuro: icone chiare
        se_stesso._immagini = {}
        se_stesso.icone = elenco_icone()
        c = colori
        alto = tk.Frame(se_stesso, background=c["pannello"])
        alto.pack(fill="x", padx=12, pady=(10, 4))
        se_stesso.var_cerca = tk.StringVar()
        campo = tk.Entry(alto, textvariable=se_stesso.var_cerca, background=c["campo"], foreground=c["primo_piano"], insertbackground=c["cursore"],
                         relief="flat", highlightthickness=1, highlightbackground=c["bordo"], font=(FONT_UI, 10))
        campo.pack(side="left", fill="x", expand=Vero, ipady=3)
        se_stesso.var_stile = tk.StringVar(value=STILI[1] se se_stesso.a_colori altrimenti STILI[0])
        stile = ttk.Combobox(alto, textvariable=se_stesso.var_stile, values=list(STILI), state="readonly", width=14)
        stile.pack(side="left", padx=(8, 0))
        stile.bind("<<ComboboxSelected>>", se_stesso._cambia_stile)
        se_stesso.var_categoria = tk.StringVar(value=TUTTE)
        categoria = ttk.Combobox(alto, textvariable=se_stesso.var_categoria, values=[TUTTE] + categorie(), state="readonly", width=18)
        categoria.pack(side="left", padx=(8, 0))
        se_stesso.var_cerca.trace_add("write", lambda *a: se_stesso._riempi())
        categoria.bind("<<ComboboxSelected>>", lambda evento: se_stesso._riempi())

        corpo = tk.Frame(se_stesso, background=c["pannello"])
        corpo.pack(fill="both", expand=Vero, padx=12, pady=4)
        se_stesso.tela = tk.Canvas(corpo, background=c["campo"], highlightthickness=1, highlightbackground=c["bordo"])
        barra = ttk.Scrollbar(corpo, orient="vertical", command=se_stesso.tela.yview)
        se_stesso.tela.configure(yscrollcommand=barra.set)
        barra.pack(side="right", fill="y")
        se_stesso.tela.pack(side="left", fill="both", expand=Vero)
        se_stesso.griglia = tk.Frame(se_stesso.tela, background=c["campo"])
        se_stesso.tela.create_window(0, 0, window=se_stesso.griglia, anchor="nw")
        se_stesso.griglia.bind("<Configure>", lambda evento: se_stesso.tela.configure(scrollregion=se_stesso.tela.bbox("all")))
        lega_rotella(se_stesso.tela, lambda evento: se_stesso.tela.yview_scroll(-1 se evento.delta > 0 altrimenti 1, "units"))

        se_stesso.var_nome = tk.StringVar(value="")
        tk.Label(se_stesso, textvariable=se_stesso.var_nome, background=c["pannello"], foreground=c["tenue"], anchor="w").pack(fill="x", padx=14)
        fondo = tk.Frame(se_stesso, background=c["pannello"])
        fondo.pack(fill="x", padx=12, pady=10)
        tk.Button(fondo, text="Annulla", command=se_stesso.destroy, background=c["pulsante"], foreground=c["primo_piano"], relief="flat", padx=12).pack(side="right", padx=4)
        se_stesso.b_ok = tk.Button(fondo, text="Scegli", command=se_stesso.conferma, background=c["accento"], foreground="#ffffff", relief="flat", padx=12)
        se_stesso.b_ok.pack(side="right", padx=4)
        se permetti_nessuna:
            tk.Button(fondo, text="Nessuna icona", command=se_stesso.nessuna, background=c["pulsante"], foreground=c["primo_piano"], relief="flat", padx=12).pack(side="left")
        se_stesso.bind("<Escape>", lambda evento: se_stesso.destroy())
        se_stesso.bind("<Return>", lambda evento: se_stesso.conferma())
        se_stesso._riempi()
        campo.focus_set()

    definisci _immagine(se_stesso, nome):
        chiave = (nome, se_stesso.a_colori)
        se chiave non in se_stesso._immagini:
            percorso = file_icona(nome + SUFFISSO_COLORE, Falso) se se_stesso.a_colori altrimenti file_icona(nome, se_stesso._chiaro)
            se_stesso._immagini[chiave] = tk.PhotoImage(file=percorso) se percorso altrimenti Nessuno
        ritorna se_stesso._immagini[chiave]

    definisci _cambia_stile(se_stesso, evento=Nessuno):
        se_stesso.a_colori = se_stesso.var_stile.get() == STILI[1]
        _ricordo["stile"] = se_stesso.var_stile.get()
        se_stesso._riempi()

    definisci visibili(se_stesso):
        """Le icone che passano la ricerca (nel nome o nelle parole chiave) e il filtro per categoria."""
        parole = se_stesso.var_cerca.get().lower().split()
        categoria = se_stesso.var_categoria.get()
        trovate = []
        per i in se_stesso.icone:
            se categoria != TUTTE e i["categoria"] != categoria:
                continua
            testo_ = (i["nome"] + " " + i["parole"]).lower()
            se all(p in testo_ per p in parole):
                trovate.append(i)
        ritorna trovate

    definisci _riempi(se_stesso):
        per figlio in se_stesso.griglia.winfo_children():
            figlio.destroy()
        se_stesso.bottoni = {}
        c = se_stesso.c
        per k, i in enumera(se_stesso.visibili()):
            nome = i["nome"]
            b = tk.Label(se_stesso.griglia, image=se_stesso._immagine(nome), background=c["campo"], width=se_stesso.LATO, height=se_stesso.LATO,
                         relief="flat", cursor="hand2")
            b.grid(row=k // se_stesso.COLONNE, column=k % se_stesso.COLONNE, padx=2, pady=2)
            b.bind("<Button-1>", lambda evento, n=nome: se_stesso.scegli(n))
            b.bind("<Double-Button-1>", lambda evento, n=nome: (se_stesso.scegli(n), se_stesso.conferma()))
            b.bind("<Enter>", lambda evento, n=nome: se_stesso.var_nome.set(n.replace("_", " ")))
            b.bind("<Leave>", lambda evento: se_stesso.var_nome.set(se_stesso.scelta.replace("_", " ")))
            se_stesso.bottoni[nome] = b
        se_stesso.scegli(se_stesso.scelta, solo_evidenza=Vero)

    definisci scegli(se_stesso, nome, solo_evidenza=Falso):
        se non solo_evidenza:
            se_stesso.scelta = nome
        per n, b in se_stesso.bottoni.items():
            b.configure(background=se_stesso.c["accento"] se n == se_stesso.scelta altrimenti se_stesso.c["campo"])
        se_stesso.var_nome.set(se_stesso.scelta.replace("_", " "))

    definisci conferma(se_stesso):
        se non se_stesso.scelta:
            ritorna
        se_stesso.risultato = se_stesso.scelta + (SUFFISSO_COLORE se se_stesso.a_colori altrimenti "")
        se_stesso.destroy()

    definisci nessuna(se_stesso):
        se_stesso.risultato = ""
        se_stesso.destroy()

    definisci mostra(se_stesso):
        se_stesso.grab_set()
        se_stesso.wait_window()
        ritorna se_stesso.risultato


definisci scegli_icona(genitore, colori, corrente="", permetti_nessuna=Vero):
    """Apre la galleria. Restituisce il nome dell'icona («salva», oppure «salva_colore» se si è scelto lo stile a colori), "" se si sceglie
    «Nessuna icona», Nessuno se si annulla."""
    ritorna DialogoIcone(genitore, colori, corrente, permetti_nessuna).mostra()
