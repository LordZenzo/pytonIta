"""Aspetto professionale di PitStudio: icone, pulsanti piatti con suggerimenti, schede con pulsante di chiusura, logo."""
importa os
importa tkinter come tk
importa tkinter.font come tkfont
da tkinter importa ttk

da PIL importa Image, ImageDraw, ImageTk
da rad.piattaforma importa FONT_MONO, FONT_SIMBOLI, FONT_UI, semi

CARTELLA_RISORSE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "risorse")

# punti di codice di "Segoe Fluent Icons" / "Segoe MDL2 Assets" (presenti in Windows 10/11)
ICONE = {
    "apri": "", "nuovo": "", "salva": "", "esegui": "", "ferma": "",
    "finestra": "", "mattonelle": "", "cerca": "", "chat": "", "impostazioni": "",
    "aiuto": "", "annulla": "", "ripeti": "", "zoom_piu": "", "zoom_meno": "",
    "codice": "", "cartella": "", "file": "", "elimina": "", "aggiorna": "",
    "chiudi": "", "info": "", "casa": "", "foto": "", "tastiera": "",
    "libro": "", "modulo": "", "funzione": "", "duplica": "", "stella": "",
}
# se il carattere non c'è si ripiega su simboli di Unicode
ICONE["debug"] = chr(0xEBE8)
ICONE["console"] = chr(0xE756)          # «prompt dei comandi» di Segoe Fluent Icons / MDL2
RIPIEGO = {
    "debug": "🐞", "apri": "📁", "nuovo": "＋", "salva": "💾", "esegui": "▶", "ferma": "■", "finestra": "🪟", "mattonelle": "▦",
    "cerca": "🔍", "chat": "💬", "impostazioni": "⚙", "aiuto": "?", "annulla": "↶", "ripeti": "↷",
    "zoom_piu": "＋", "zoom_meno": "－", "codice": "‹›", "cartella": "📁", "file": "📄", "elimina": "🗑",
    "aggiorna": "⟳", "chiudi": "✕", "info": "ⓘ", "casa": "⌂", "foto": "🖼", "tastiera": "⌨", "libro": "📖",
    "modulo": "⚙", "funzione": "ƒ", "duplica": "⧉", "stella": "★", "console": "▤",
}
_famiglia = [Nessuno]


definisci famiglia_icone():
    """Il carattere delle icone disponibile in questo computer (o stringa vuota)."""
    se _famiglia[0] è Nessuno:
        trovati = set(tkfont.families())
        _famiglia[0] = ""
        per nome in ("Segoe Fluent Icons", "Segoe MDL2 Assets"):
            se nome in trovati:
                _famiglia[0] = nome
                interrompi
    ritorna _famiglia[0]


definisci glifo(nome):
    ritorna ICONE[nome] se famiglia_icone() altrimenti RIPIEGO[nome]


# --------------------------------------------------------------------------- suggerimenti
definisci area_monitor(widget, x, y):
    """(sinistra, alto, destra, basso) dell'area di lavoro del monitor che contiene il punto (x, y).
    Con più monitor winfo_screenwidth() descrive solo quello principale: i fumetti finivano su un altro schermo."""
    se os.name == "nt":
        prova:
            importa ctypes
            da ctypes importa wintypes

            classe InfoMonitor(ctypes.Structure):
                _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT), ("rcWork", wintypes.RECT), ("dwFlags", wintypes.DWORD)]
            u = ctypes.windll.user32
            u.MonitorFromPoint.restype = wintypes.HANDLE
            u.MonitorFromPoint.argtypes = [wintypes.POINT, wintypes.DWORD]
            u.GetMonitorInfoW.argtypes = [wintypes.HANDLE, ctypes.POINTER(InfoMonitor)]
            monitor = u.MonitorFromPoint(wintypes.POINT(int(x), int(y)), 2)      # MONITOR_DEFAULTTONEAREST
            info = InfoMonitor()
            info.cbSize = ctypes.sizeof(InfoMonitor)
            se monitor e u.GetMonitorInfoW(monitor, ctypes.byref(info)):
                r = info.rcWork
                ritorna (r.left, r.top, r.right, r.bottom)
        eccetto Exception:
            passa
    ritorna (0, 0, widget.winfo_screenwidth(), widget.winfo_screenheight())


definisci posizione_fumetto(widget, larghezza, altezza):
    """Dove mettere un fumetto: accanto al puntatore, dentro il monitor in cui si trova il mouse."""
    px, py = widget.winfo_pointerx(), widget.winfo_pointery()
    sinistra, alto, destra, basso = area_monitor(widget, px, py)
    x = px + 12
    y = py + 20
    se x + larghezza > destra - 4:
        x = px - larghezza - 8
    se y + altezza > basso - 4:
        y = py - altezza - 10
    ritorna max(sinistra, x), max(alto, y)


classe Suggerimento:
    """Piccolo fumetto che compare quando si resta fermi su un widget."""

    definisci __inizializza__(se_stesso, widget, testo_, colori, ritardo=550, automatico=Vero):
        se_stesso.widget = widget
        se_stesso.testo = testo_
        se_stesso.colori = colori
        se_stesso.ritardo = ritardo
        se_stesso._finestra = Nessuno
        se_stesso._lavoro = Nessuno
        se automatico:       # altrimenti è il widget a dire quando mostrarlo (parti interne, come la X delle schede)
            widget.bind("<Enter>", se_stesso._programma, add="+")
        widget.bind("<Leave>", se_stesso._nascondi, add="+")
        widget.bind("<ButtonPress>", se_stesso._nascondi, add="+")

    definisci _programma(se_stesso, evento=Nessuno):
        se_stesso._nascondi()
        se_stesso._lavoro = se_stesso.widget.after(se_stesso.ritardo, se_stesso._mostra)

    definisci _mostra(se_stesso):
        se non se_stesso.testo:
            ritorna
        c = se_stesso.colori o {"pulsante": "#2b303b", "primo_piano": "#f2f4f8"}
        f = tk.Toplevel(se_stesso.widget)
        f.wm_overrideredirect(Vero)
        f.attributes("-topmost", Vero)
        tk.Label(f, text=se_stesso.testo, background=c["pulsante"], foreground=c["primo_piano"], padx=8, pady=3,
                 relief="solid", borderwidth=1, font=(FONT_UI, 9), justify="left").pack()
        f.update_idletasks()
        x, y = posizione_fumetto(se_stesso.widget, f.winfo_reqwidth(), f.winfo_reqheight())
        f.wm_geometry(f"+{x}+{y}")
        se_stesso._finestra = f

    definisci _nascondi(se_stesso, evento=Nessuno):
        se se_stesso._lavoro:
            prova:
                se_stesso.widget.after_cancel(se_stesso._lavoro)
            eccetto tk.TclError:
                passa
            se_stesso._lavoro = Nessuno
        se se_stesso._finestra:
            prova:
                se_stesso._finestra.destroy()
            eccetto tk.TclError:
                passa
            se_stesso._finestra = Nessuno

    definisci imposta_testo(se_stesso, testo_):
        se_stesso.testo = testo_


definisci crea_fumetto(widget, testo_, colori=Nessuno):
    """Un fumetto (finestrella) con il testo, vicino al puntatore; ritorna la finestra (da distruggere quando non serve)."""
    c = colori o {"pulsante": "#2b303b", "primo_piano": "#f2f4f8"}
    f = tk.Toplevel(widget)
    f.wm_overrideredirect(Vero)
    f.attributes("-topmost", Vero)
    tk.Label(f, text=testo_, background=c["pulsante"], foreground=c["primo_piano"], padx=8, pady=4, relief="solid", borderwidth=1,
             font=(FONT_MONO, 9), justify="left", anchor="w", wraplength=520).pack()
    f.update_idletasks()
    x, y = posizione_fumetto(widget, f.winfo_reqwidth(), f.winfo_reqheight())
    f.wm_geometry(f"+{x}+{y}")
    ritorna f


definisci suggerisci(widget, testo_, colori=Nessuno):
    """Aggiunge un suggerimento (fumetto) a un widget qualsiasi; ritorna il widget."""
    se testo_:
        widget._suggerimento = Suggerimento(widget, testo_, colori)
    ritorna widget


# --------------------------------------------------------------------------- pulsanti
classe PulsanteIcona(tk.Frame):
    """Pulsante piatto con icona e (facoltativo) testo; evidenziato al passaggio del mouse."""

    definisci __inizializza__(se_stesso, genitore, icona, testo_, comando, colori, accento=Falso, aiuto=""):
        tk.Frame.__init__(se_stesso, genitore, cursor="hand2")
        se_stesso.comando = comando
        se_stesso.accento = accento
        se_stesso.colori = colori
        se_stesso._attivo = Vero
        se_stesso.colore_testo = Nessuno          # colore fisso dell'icona e del testo (per i pulsanti che mostrano uno stato, come «acceso»)
        # senza icona (comandi dei menu che non ne hanno una) il pulsante mostra solo il testo
        se_stesso.icona = tk.Label(se_stesso, text=glifo(icona) se icona altrimenti "", font=(famiglia_icone() o FONT_SIMBOLI, 12))
        se icona:
            se_stesso.icona.pack(side="left", padx=(9, 4 se testo_ altrimenti 9), pady=5)
        se_stesso.etichetta = Nessuno
        se testo_:
            se_stesso.etichetta = tk.Label(se_stesso, text=testo_, font=semi(9))
            se_stesso.etichetta.pack(side="left", padx=(0 se icona altrimenti 10, 10), pady=5)
        per w in (se_stesso, se_stesso.icona, se_stesso.etichetta):
            se w:
                w.bind("<Enter>", se_stesso._entra)
                w.bind("<Leave>", se_stesso._esci)
                w.bind("<ButtonPress-1>", se_stesso._premi)
                w.bind("<ButtonRelease-1>", se_stesso._rilascia)
        se_stesso.suggerimento = Suggerimento(se_stesso, aiuto, colori) se aiuto altrimenti Nessuno
        se_stesso.applica_colori(colori)

    definisci applica_colori(se_stesso, c):
        se_stesso.colori = c
        se_stesso._colora(c["accento"] se se_stesso.accento altrimenti c["sfondo"],
                          "#ffffff" se se_stesso.accento altrimenti (se_stesso.colore_testo o c["primo_piano"]))
        se se_stesso.suggerimento:
            se_stesso.suggerimento.colori = c

    definisci imposta_colore_testo(se_stesso, colore):
        """Colore fisso di icona e testo (Nessuno = quello del tema)."""
        se_stesso.colore_testo = colore
        se_stesso.applica_colori(se_stesso.colori)

    definisci _colora(se_stesso, sfondo, primo):
        se_stesso.configure(background=sfondo)
        se_stesso.icona.configure(background=sfondo, foreground=primo se se_stesso._attivo altrimenti se_stesso.colori["tenue"])
        se se_stesso.etichetta:
            se_stesso.etichetta.configure(background=sfondo, foreground=primo se se_stesso._attivo altrimenti se_stesso.colori["tenue"])

    definisci imposta_attivo(se_stesso, attivo):
        se_stesso._attivo = attivo
        se_stesso.configure(cursor="hand2" se attivo altrimenti "arrow")
        se_stesso.applica_colori(se_stesso.colori)

    definisci _entra(se_stesso, evento=Nessuno):
        se se_stesso._attivo:
            c = se_stesso.colori
            se_stesso._colora(c["accento"] se se_stesso.accento altrimenti c["pulsante_attivo"], "#ffffff" se se_stesso.accento altrimenti (se_stesso.colore_testo o c["primo_piano"]))

    definisci _esci(se_stesso, evento=Nessuno):
        se_stesso.applica_colori(se_stesso.colori)

    definisci _premi(se_stesso, evento=Nessuno):
        se se_stesso._attivo:
            se_stesso._colora(se_stesso.colori["accento"], "#ffffff")

    definisci _rilascia(se_stesso, evento=Nessuno):
        se_stesso._entra()
        se se_stesso._attivo e se_stesso.comando e evento è non Nessuno:
            se 0 <= evento.x_root - se_stesso.winfo_rootx() <= se_stesso.winfo_width() e 0 <= evento.y_root - se_stesso.winfo_rooty() <= se_stesso.winfo_height():
                se_stesso.comando()


classe Separatore(tk.Frame):
    """Linea verticale sottile tra gruppi di pulsanti."""

    definisci __inizializza__(se_stesso, genitore, colori):
        tk.Frame.__init__(se_stesso, genitore, width=1)
        se_stesso.applica_colori(colori)

    definisci applica_colori(se_stesso, c):
        se_stesso.configure(background=c["bordo"])


# --------------------------------------------------------------------------- logo e icona dell'applicazione
definisci _sfumatura(dim, a, b):
    """Quadrato con sfumatura diagonale da colore a a colore b."""
    img = Image.new("RGB", (dim, dim))
    px = img.load()
    per y in intervallo_di(dim):
        per x in intervallo_di(dim):
            t = (x + y) / (2 * dim - 2)
            px[x, y] = tuple(int(a[i] + (b[i] - a[i]) * t) per i in intervallo_di(3))
    ritorna img


definisci crea_logo(dim=256):
    """Il logo di PitStudio: tre mattonelle colorate incastrate su un fondo arrotondato."""
    s = 4
    D = dim * s
    fondo = _sfumatura(D, (43, 47, 66), (24, 26, 36)).convert("RGBA")
    maschera = Image.new("L", (D, D), 0)
    ImageDraw.Draw(maschera).rounded_rectangle([0, 0, D - 1, D - 1], radius=int(D * 0.22), fill=255)
    fondo.putalpha(maschera)
    d = ImageDraw.Draw(fondo)
    u = D / 16
    colori = [(232, 185, 35), (233, 138, 43), (61, 174, 90)]
    # tre mattonelle impilate, ognuna con la sua "linguetta"
    for_pos = [(2.4, 3.0, 11.6, 3.2), (3.4, 6.6, 10.6, 3.2), (2.4, 10.2, 11.6, 3.2)]
    per (x, y, w, h), col in zip(for_pos, colori):
        d.rounded_rectangle([x * u, y * u, (x + w) * u, (y + h) * u], radius=int(u * 0.55), fill=col)
        d.rounded_rectangle([(x + 1.4) * u, (y + h - 0.2) * u, (x + 3.6) * u, (y + h + 0.55) * u], radius=int(u * 0.2), fill=col)
        d.rounded_rectangle([(x + 1.4) * u, y * u, (x + 3.6) * u, (y + 0.55) * u], radius=int(u * 0.2), fill=(24, 26, 36))
        d.rounded_rectangle([(x + 6.2) * u, (y + 0.9) * u, (x + w - 1.2) * u, (y + h - 0.9) * u], radius=int(u * 0.35), fill=(255, 255, 255, 70))
    ritorna fondo.resize((dim, dim), Image.LANCZOS)


definisci assicura_icone():
    """Crea rad.png e rad.ico se mancano. Ritorna il percorso del PNG."""
    os.makedirs(CARTELLA_RISORSE, exist_ok=Vero)
    png = os.path.join(CARTELLA_RISORSE, "rad.png")
    ico = os.path.join(CARTELLA_RISORSE, "rad.ico")
    se non os.path.exists(png) o non os.path.exists(ico):
        grande = crea_logo(256)
        grande.save(png)
        grande.save(ico, sizes=[(16, 16), (24, 24), (32, 32), (48, 48), (64, 64), (128, 128), (256, 256)])
    ritorna png


definisci imposta_icona_finestra(radice):
    prova:
        png = assicura_icone()
        foto = tk.PhotoImage(file=png)
        radice._icona = foto
        radice.iconphoto(Vero, foto)
        se os.name == "nt":
            radice.iconbitmap(os.path.join(CARTELLA_RISORSE, "rad.ico"))
    eccetto Eccezione:
        passa


definisci logo_tk(dim):
    """PhotoImage del logo a una certa dimensione (da tenere in vita!)."""
    ritorna ImageTk.PhotoImage(crea_logo(dim))


# --------------------------------------------------------------------------- schede con pulsante di chiusura
definisci _immagine_x(colore, sfondo, dim=14):
    img = Image.new("RGBA", (dim * 4, dim * 4), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    se sfondo:
        d.ellipse([0, 0, dim * 4 - 1, dim * 4 - 1], fill=sfondo)
    m = dim * 4 * 0.3
    d.line([m, m, dim * 4 - m, dim * 4 - m], fill=colore, width=int(dim * 0.5))
    d.line([m, dim * 4 - m, dim * 4 - m, m], fill=colore, width=int(dim * 0.5))
    ritorna ImageTk.PhotoImage(img.resize((dim, dim), Image.LANCZOS))


classe SchedeChiudibili(ttk.Notebook):
    """ttk.Notebook con una X su ogni linguetta. Chiama 'quando_chiudi(widget)' al clic sulla X."""
    _versione = 0

    definisci __inizializza__(se_stesso, genitore, colori, quando_chiudi=Nessuno, **opzioni):
        ttk.Notebook.__init__(se_stesso, genitore, style="SchedeX.TNotebook", **opzioni)
        se_stesso.quando_chiudi = quando_chiudi
        se_stesso._premuta = Nessuno
        se_stesso.colori = colori
        se_stesso._sul_x = Falso
        se_stesso._suggerimento_x = Suggerimento(se_stesso, "Chiudi la scheda  (Ctrl+W)", colori, automatico=Falso)
        se_stesso.applica_stile(colori)
        se_stesso.bind("<Motion>", se_stesso._movimento, "+")
        se_stesso.bind("<ButtonPress-1>", se_stesso._premi, Vero)
        se_stesso.bind("<ButtonRelease-1>", se_stesso._rilascia)

    definisci applica_stile(se_stesso, c):
        """(Ri)crea immagini ed elementi per i colori del tema."""
        se_stesso.colori = c
        se hasattr(se_stesso, "_suggerimento_x"):
            se_stesso._suggerimento_x.colori = c
        SchedeChiudibili._versione += 1
        n = SchedeChiudibili._versione
        se_stesso._img = (_immagine_x(c["tenue"], Nessuno), _immagine_x("#ffffff", c["errore"]), _immagine_x("#ffffff", scurisci_colore(c["errore"])))
        s = ttk.Style(se_stesso)
        el = f"chiudi{n}"
        s.element_create(el, "image", se_stesso._img[0], ("active", "pressed", "!disabled", se_stesso._img[2]),
                         ("active", "!disabled", se_stesso._img[1]), border=6, sticky="")
        s.layout("SchedeX.TNotebook", [("SchedeX.TNotebook.client", {"sticky": "nswe"})])
        s.layout("SchedeX.TNotebook.Tab", [("SchedeX.TNotebook.tab", {"sticky": "nswe", "children": [
            ("SchedeX.TNotebook.padding", {"side": "top", "sticky": "nswe", "children": [
                ("SchedeX.TNotebook.focus", {"side": "top", "sticky": "nswe", "children": [
                    ("SchedeX.TNotebook.label", {"side": "left", "sticky": ""}),
                    (el, {"side": "left", "sticky": ""})]})]})]})])
        s.configure("SchedeX.TNotebook", background=c["sfondo"], borderwidth=0, tabmargins=(4, 6, 4, 0))
        s.configure("SchedeX.TNotebook.Tab", background=c["pannello"], foreground=c["tenue"], padding=(14, 6, 8, 6),
                    borderwidth=0, font=(FONT_UI, 9))
        s.map("SchedeX.TNotebook.Tab", background=[("selected", c["editor"]), ("active", c["pulsante"])],
              foreground=[("selected", c["primo_piano"]), ("active", c["primo_piano"])])

    definisci _movimento(se_stesso, evento):
        """Suggerimento sulla X delle linguette: compare solo quando il mouse è sopra la X."""
        sopra = "chiudi" in se_stesso.identify(evento.x, evento.y)
        se sopra e non se_stesso._sul_x:
            se_stesso._sul_x = Vero
            se_stesso._suggerimento_x._programma()
        altrimenti_se non sopra e se_stesso._sul_x:
            se_stesso._sul_x = Falso
            se_stesso._suggerimento_x._nascondi()

    definisci _premi(se_stesso, evento):
        elemento = se_stesso.identify(evento.x, evento.y)
        se "chiudi" in elemento:
            prova:
                se_stesso._premuta = se_stesso.index(f"@{evento.x},{evento.y}")
            eccetto tk.TclError:
                se_stesso._premuta = Nessuno
                ritorna Nessuno
            se_stesso.state(["pressed"])
            ritorna "break"

    definisci _rilascia(se_stesso, evento):
        se non se_stesso.instate(["pressed"]):
            ritorna
        se_stesso.state(["!pressed"])
        elemento = se_stesso.identify(evento.x, evento.y)
        se "chiudi" non in elemento:
            se_stesso._premuta = Nessuno
            ritorna
        prova:
            indice = se_stesso.index(f"@{evento.x},{evento.y}")
        eccetto tk.TclError:
            ritorna
        se indice == se_stesso._premuta e se_stesso.quando_chiudi:
            se_stesso.quando_chiudi(se_stesso.nametowidget(se_stesso.tabs()[indice]))
        se_stesso._premuta = Nessuno


# --------------------------------------------------------------------------- gruppo di schede che scorre
LARGHEZZA_MINIMA_SCHEDA = 130
LARGHEZZA_MASSIMA_SCHEDA = 240


classe SchedeScorrevoli(tk.Frame):
    """Gruppo di schede come ttk.Notebook, ma con le linguette che non scendono sotto una larghezza minima: se non ci stanno tutte scorrono
    (frecce ◀ ▶, rotella del mouse, e la scheda scelta viene portata in vista). Ogni linguetta ha la sua X. I contenuti delle schede NON sono figli
    di questo gruppo ma di un genitore comune (`area`): così una scheda si può spostare in un altro gruppo senza ricrearla.

    Metodi come quelli di ttk.Notebook: add, forget, select, tab, tabs, index («@x,y», «end», una scheda), nametowidget, bind (anche i clic
    centrale e destro sulle linguette). Quando la scheda scelta cambia genera <<NotebookTabChanged>>."""

    definisci __inizializza__(se_stesso, genitore, colori, quando_chiudi=Nessuno, quando_attivato=Nessuno):
        tk.Frame.__init__(se_stesso, genitore, borderwidth=0, highlightthickness=0)
        se_stesso.colori = colori
        se_stesso.quando_chiudi = quando_chiudi
        se_stesso.quando_attivato = quando_attivato       # chiamata quando l'utente clicca sulle linguette di questo gruppo
        se_stesso._schede = []                            # [{"widget", "titolo", "tab", "etichetta", "x"}]
        se_stesso._selezionata = Nessuno
        se_stesso._legami = {}                            # sequenza -> funzione (clic centrale e destro)
        se_stesso._totale = 0
        se_stesso._font = tkfont.Font(family=FONT_UI, size=9)
        se_stesso.attivo = Falso
        se_stesso.linea = tk.Frame(se_stesso, height=2, borderwidth=0)
        se_stesso.linea.pack(side="top", fill="x")
        se_stesso.barra = tk.Frame(se_stesso, height=30, borderwidth=0)
        se_stesso.barra.pack(side="top", fill="x")
        se_stesso.barra.pack_propagate(Falso)
        se_stesso.freccia_sx = tk.Label(se_stesso.barra, text="◀", cursor="hand2", padx=6, borderwidth=0)
        se_stesso.freccia_dx = tk.Label(se_stesso.barra, text="▶", cursor="hand2", padx=6, borderwidth=0)
        se_stesso.striscia = tk.Canvas(se_stesso.barra, width=1, height=30, highlightthickness=0, borderwidth=0, xscrollincrement=40)
        se_stesso.striscia.pack(side="left", fill="both", expand=Vero)
        se_stesso.contenuto = tk.Frame(se_stesso, borderwidth=0, highlightthickness=0)
        se_stesso.contenuto.pack(side="top", fill="both", expand=Vero)
        se_stesso.freccia_sx.bind("<Button-1>", lambda evento: se_stesso._scorri(-3))
        se_stesso.freccia_dx.bind("<Button-1>", lambda evento: se_stesso._scorri(3))
        per w in (se_stesso.striscia, se_stesso.barra, se_stesso.freccia_sx, se_stesso.freccia_dx):
            w.bind("<MouseWheel>", se_stesso._rotella)
            w.bind("<Button-4>", lambda evento: se_stesso._scorri(-3))
            w.bind("<Button-5>", lambda evento: se_stesso._scorri(3))
        se_stesso.striscia.bind("<Configure>", lambda evento: se_stesso._ridisponi())
        se_stesso.applica_stile(colori)

    # ------------------------------------------------------------ aspetto
    definisci applica_stile(se_stesso, c):
        se_stesso.colori = c
        se_stesso.configure(background=c["sfondo"])
        se_stesso.barra.configure(background=c["sfondo"])
        se_stesso.striscia.configure(background=c["sfondo"])
        se_stesso.contenuto.configure(background=c["editor"])
        se_stesso.segna_attivo(se_stesso.attivo)
        per f in (se_stesso.freccia_sx, se_stesso.freccia_dx):
            f.configure(background=c["pannello"], foreground=c["primo_piano"])
        per voce in se_stesso._schede:
            se_stesso._colora(voce)

    definisci segna_attivo(se_stesso, attivo):
        """Una sottile riga colorata in cima dice qual è il gruppo in cui si sta scrivendo."""
        se_stesso.attivo = attivo
        se_stesso.linea.configure(background=se_stesso.colori["accento"] se attivo altrimenti se_stesso.colori["sfondo"])

    definisci _colora(se_stesso, voce, sopra=Falso):
        c = se_stesso.colori
        scelta = voce["widget"] è se_stesso._selezionata
        sfondo = c["editor"] se scelta altrimenti (c["pulsante"] se sopra altrimenti c["pannello"])
        testo_ = c["primo_piano"] se (scelta o sopra) altrimenti c["tenue"]
        voce["tab"].configure(background=sfondo)
        voce["etichetta"].configure(background=sfondo, foreground=testo_)
        voce["x"].configure(background=sfondo, foreground=c["tenue"])

    # ------------------------------------------------------------ schede
    definisci tabs(se_stesso):
        ritorna tuple(str(v["widget"]) per v in se_stesso._schede)

    definisci _voce(se_stesso, widget):
        per v in se_stesso._schede:
            se v["widget"] è widget o str(v["widget"]) == str(widget):
                ritorna v
        solleva tk.TclError(f"la scheda {widget} non è in questo gruppo")

    definisci _testo_adattato(se_stesso, titolo):
        """Il titolo accorciato con «…» se supera la larghezza massima della linguetta."""
        disponibile = LARGHEZZA_MASSIMA_SCHEDA - 44
        se se_stesso._font.measure(titolo) <= disponibile:
            ritorna titolo
        mentre titolo e se_stesso._font.measure(titolo + "…") > disponibile:
            titolo = titolo[:-1]
        ritorna titolo + "…"

    definisci add(se_stesso, widget, text="", **altro):
        tab = tk.Frame(se_stesso.striscia, borderwidth=0, highlightthickness=0, cursor="arrow")
        etichetta = tk.Label(tab, text=se_stesso._testo_adattato(text), font=(FONT_UI, 9), borderwidth=0, anchor="w")
        x = tk.Label(tab, text="✕", font=(FONT_UI, 9), borderwidth=0, cursor="hand2", padx=4)
        etichetta.pack(side="left", padx=(12, 4), pady=5)
        x.pack(side="right", padx=(0, 6))
        voce = {"widget": widget, "titolo": text, "tab": tab, "etichetta": etichetta, "x": x, "id": Nessuno}
        se_stesso._schede.append(voce)
        per w in (tab, etichetta):
            w.bind("<ButtonPress-1>", lambda evento, v=voce: se_stesso._clic(v))
            w.bind("<Enter>", lambda evento, v=voce: se_stesso._colora(v, Vero))
            w.bind("<Leave>", lambda evento, v=voce: se_stesso._colora(v))
        x.bind("<ButtonRelease-1>", lambda evento, v=voce: se_stesso._chiudi(v))
        x.bind("<Enter>", lambda evento, v=voce: v["x"].configure(background=se_stesso.colori["errore"], foreground="#ffffff"))
        x.bind("<Leave>", lambda evento, v=voce: se_stesso._colora(v))
        suggerisci(x, "Chiudi la scheda  (Ctrl+W)", se_stesso.colori)
        per w in (tab, etichetta, x):
            w.bind("<MouseWheel>", se_stesso._rotella)
        per sequenza, funzione in se_stesso._legami.items():
            se_stesso._lega_tab(voce, sequenza, funzione)
        se_stesso._colora(voce)
        se_stesso._ridisponi()
        se se_stesso._selezionata è Nessuno:
            se_stesso.select(widget)

    definisci forget(se_stesso, widget):
        voce = se_stesso._voce(widget)
        indice = se_stesso._schede.index(voce)
        era_scelta = voce["widget"] è se_stesso._selezionata
        se_stesso._schede.remove(voce)
        voce["tab"].destroy()
        prova:
            voce["widget"].place_forget()
        eccetto tk.TclError:
            passa
        se era_scelta:
            se_stesso._selezionata = Nessuno
            se se_stesso._schede:
                se_stesso.select(se_stesso._schede[min(indice, lunghezza_di(se_stesso._schede) - 1)]["widget"])
            altrimenti:
                se_stesso.event_generate("<<NotebookTabChanged>>")
        se_stesso._ridisponi()

    definisci select(se_stesso, widget=Nessuno):
        """Senza argomenti dà il percorso della scheda scelta («» se non ce n'è); con una scheda la sceglie."""
        se widget è Nessuno:
            ritorna str(se_stesso._selezionata) se se_stesso._selezionata è non Nessuno altrimenti ""
        voce = se_stesso._voce(widget)
        cambiata = voce["widget"] è non se_stesso._selezionata
        se cambiata e se_stesso._selezionata è non Nessuno:
            prova:
                se_stesso._selezionata.place_forget()
            eccetto tk.TclError:
                passa
        se_stesso._selezionata = voce["widget"]
        voce["widget"].place(in_=se_stesso.contenuto, x=0, y=0, relwidth=1, relheight=1)
        voce["widget"].lift()
        per v in se_stesso._schede:
            se_stesso._colora(v)
        se_stesso._porta_in_vista(voce)
        se cambiata:
            se_stesso.event_generate("<<NotebookTabChanged>>")

    definisci tab(se_stesso, widget, opzione=Nessuno, **opzioni):
        voce = se_stesso._voce(widget)
        se "text" in opzioni:
            voce["titolo"] = opzioni["text"]
            voce["etichetta"].configure(text=se_stesso._testo_adattato(opzioni["text"]))
            se_stesso._ridisponi()
        se opzione == "text":
            ritorna voce["titolo"]
        ritorna Nessuno

    definisci index(se_stesso, quale):
        se quale == "end":
            ritorna lunghezza_di(se_stesso._schede)
        se isinstance(quale, tipo_testo) e quale.startswith("@"):
            x_, y_ = quale[1:].split(",")
            assoluta_x = se_stesso.winfo_rootx() + int(x_)
            assoluta_y = se_stesso.winfo_rooty() + int(y_)
            per i, v in enumera(se_stesso._schede):
                t = v["tab"]
                se t.winfo_ismapped() e t.winfo_rootx() <= assoluta_x < t.winfo_rootx() + t.winfo_width() e t.winfo_rooty() <= assoluta_y < t.winfo_rooty() + t.winfo_height():
                    ritorna i
            solleva tk.TclError("nessuna scheda sotto il mouse")
        ritorna se_stesso._schede.index(se_stesso._voce(quale))

    # ------------------------------------------------------------ eventi
    definisci bind(se_stesso, sequenza=Nessuno, funzione=Nessuno, add=Nessuno):
        se sequenza in ("<Button-2>", "<Button-3>"):
            se_stesso._legami[sequenza] = funzione
            se_stesso._lega_barra(sequenza, funzione)
            per v in se_stesso._schede:
                se_stesso._lega_tab(v, sequenza, funzione)
            ritorna Nessuno
        ritorna tk.Frame.bind(se_stesso, sequenza, funzione, add)

    definisci _evento_relativo(se_stesso, evento):
        """Lo stesso evento con le coordinate rispetto a questo gruppo (come le avrebbe date ttk.Notebook)."""
        nuovo = tk.Event()
        nuovo.__dict__.update(evento.__dict__)
        nuovo.x = evento.x_root - se_stesso.winfo_rootx()
        nuovo.y = evento.y_root - se_stesso.winfo_rooty()
        nuovo.widget = se_stesso
        ritorna nuovo

    definisci _lega_barra(se_stesso, sequenza, funzione):
        per w in (se_stesso.striscia, se_stesso.barra):
            w.bind(sequenza, lambda evento: funzione(se_stesso._evento_relativo(evento)))

    definisci _lega_tab(se_stesso, voce, sequenza, funzione):
        per w in (voce["tab"], voce["etichetta"], voce["x"]):
            w.bind(sequenza, lambda evento: funzione(se_stesso._evento_relativo(evento)))

    definisci _clic(se_stesso, voce):
        se se_stesso.quando_attivato:
            se_stesso.quando_attivato(se_stesso)
        se_stesso.select(voce["widget"])

    definisci _chiudi(se_stesso, voce):
        se se_stesso.quando_chiudi e voce in se_stesso._schede:
            se_stesso.quando_chiudi(voce["widget"])

    # ------------------------------------------------------------ disposizione e scorrimento
    definisci _ridisponi(se_stesso):
        """Mette le linguette una dopo l'altra, ciascuna larga quanto il suo testo ma non meno del minimo, e mostra le frecce se servono."""
        x = 2
        per v in se_stesso._schede:
            larghezza = se_stesso._font.measure(v["etichetta"].cget("text")) + 44
            larghezza = max(LARGHEZZA_MINIMA_SCHEDA, min(LARGHEZZA_MASSIMA_SCHEDA, larghezza))
            v["tab"].configure(width=larghezza, height=28)
            v["tab"].pack_propagate(Falso)
            se v["id"] è Nessuno:
                v["id"] = se_stesso.striscia.create_window(x, 2, window=v["tab"], anchor="nw")
            altrimenti:
                se_stesso.striscia.coords(v["id"], x, 2)
            x += larghezza + 2
        se_stesso._totale = x
        se_stesso.striscia.configure(scrollregion=(0, 0, x, 30))
        servono = x > se_stesso.striscia.winfo_width() > 1
        se servono e non se_stesso.freccia_sx.winfo_ismapped():
            se_stesso.freccia_sx.pack(side="left", fill="y", before=se_stesso.striscia)
            se_stesso.freccia_dx.pack(side="right", fill="y", before=se_stesso.striscia)
        altrimenti_se non servono e se_stesso.freccia_sx.winfo_ismapped():
            se_stesso.freccia_sx.pack_forget()
            se_stesso.freccia_dx.pack_forget()
            se_stesso.striscia.xview_moveto(0)

    definisci _scorri(se_stesso, passi):
        se se_stesso._totale > se_stesso.striscia.winfo_width():
            se_stesso.striscia.xview_scroll(passi, "units")

    definisci _rotella(se_stesso, evento):
        se_stesso._scorri(-3 se evento.delta > 0 altrimenti 3)
        ritorna "break"

    definisci _porta_in_vista(se_stesso, voce):
        """Fa scorrere la striscia perché la linguetta scelta si veda per intero."""
        se_stesso.update_idletasks()
        se voce["id"] è Nessuno:
            ritorna
        x0, y0 = se_stesso.striscia.coords(voce["id"])
        x1 = x0 + voce["tab"].winfo_reqwidth()
        visibile = se_stesso.striscia.winfo_width()
        se visibile <= 1:
            ritorna
        sinistra = se_stesso.striscia.canvasx(0)
        se x0 < sinistra:
            se_stesso.striscia.xview_moveto(max(0, (x0 - 4) / max(1, se_stesso._totale)))
        altrimenti_se x1 > sinistra + visibile:
            se_stesso.striscia.xview_moveto(min(1.0, (x1 - visibile + 4) / max(1, se_stesso._totale)))


definisci scurisci_colore(colore, f=0.75):
    colore = colore.lstrip("#")
    r, g, b = int(colore[0:2], 16), int(colore[2:4], 16), int(colore[4:6], 16)
    ritorna "#%02x%02x%02x" % (int(r * f), int(g * f), int(b * f))
