"""Progettista grafico delle finestre: palette, superficie di disegno, ispettore delle proprietà."""
importa copy
importa json
importa os
importa shutil
importa sys
importa tkinter come tk
da tkinter importa ttk, messagebox, colorchooser, filedialog, simpledialog

da rad importa form_modello, schema_dati
da rad.stile importa suggerisci come stile_suggerisci
da rad.form_modello importa Form, TIPI, ORDINE_PALETTE, proprieta_di, nome_valido, colonne_albero, e_visivo, voci_menu, e_contenitore
da rad.piattaforma importa FONT_MONO, FONT_UI, cursore, lega_rotella

GRIGLIA = 8
MANIGLIE = {  # nome: (cursore, ancora_x, ancora_y)
    "no": (cursore("size_nw_se"), 0, 0), "n": (cursore("size_ns"), 0.5, 0), "ne": (cursore("size_ne_sw"), 1, 0),
    "o": (cursore("size_we"), 0, 0.5), "e": (cursore("size_we"), 1, 0.5),
    "so": (cursore("size_ne_sw"), 0, 1), "s": (cursore("size_ns"), 0.5, 1), "se": (cursore("size_nw_se"), 1, 1),
}


_stili_pronti = set()


definisci _stili_anteprima(genitore):
    """Stili ttk chiari (aspetto di Windows) per l'anteprima: il tema scuro di PitStudio non deve cambiarla.
    Il programma vero usa i colori predefiniti di Tk, quindi l'anteprima deve imitarli."""
    s = ttk.Style(genitore)
    chiave = id(s.master)
    se chiave in _stili_pronti:
        ritorna s
    _stili_pronti.add(chiave)
    carattere = (FONT_UI, 9)
    s.configure("Anteprima.TCombobox", fieldbackground="#ffffff", background="#ffffff", foreground="#000000",
                arrowcolor="#555555", bordercolor="#7a7a7a", lightcolor="#ffffff", darkcolor="#ffffff", padding=2,
                font=carattere)
    s.map("Anteprima.TCombobox", fieldbackground=[("readonly", "#ffffff")], foreground=[("readonly", "#000000")])
    s.configure("Anteprima.Horizontal.TProgressbar", background="#06b025", troughcolor="#e6e6e6", bordercolor="#bcbcbc",
                lightcolor="#06b025", darkcolor="#06b025")
    s.configure("Anteprima.Treeview", background="#ffffff", fieldbackground="#ffffff", foreground="#000000",
                bordercolor="#828790", lightcolor="#ffffff", darkcolor="#ffffff", rowheight=20, font=carattere)
    s.map("Anteprima.Treeview", background=[("selected", "#0078d7")], foreground=[("selected", "#ffffff")])
    s.configure("Anteprima.Treeview.Heading", background="#ffffff", foreground="#000000", relief="flat",
                bordercolor="#e5e5e5", lightcolor="#ffffff", darkcolor="#ffffff", font=carattere)
    ritorna s


definisci crea_widget_di_progetto(c, genitore, cartella):
    """Un widget vero (ma inerte) che rappresenta il componente durante il disegno."""
    _stili_anteprima(genitore)
    v = c.valori
    t = c.tipo
    stato = "disabled" se v.get("stato") == "disabilitato" altrimenti "normal"
    colori_ = {}
    se v.get("sfondo"):
        colori_["background"] = v["sfondo"]
    se v.get("primo_piano"):
        colori_["foreground"] = v["primo_piano"]
    carattere = v.get("carattere") o Nessuno
    prova:
        se t == "Pulsante":
            w = tk.Button(genitore, text=v["testo"], **colori_)
        altrimenti_se t == "Etichetta":
            w = tk.Label(genitore, text=v["testo"], justify={"sinistra": "left", "centro": "center", "destra": "right"}[v["allineamento"]],
                         anchor=v["ancora"], **colori_)
        altrimenti_se t == "CampoTesto":
            w = tk.Entry(genitore, show="*" se v.get("nascondi") altrimenti "")
            w.insert(0, v.get("testo", ""))
            se v.get("sfondo"):
                w.configure(background=v["sfondo"])
        altrimenti_se t == "AreaTesto":
            w = tk.Text(genitore, wrap="word" se v.get("a_capo") altrimenti "none")
            w.insert("1.0", v.get("testo", ""))
        altrimenti_se t == "Elenco":
            w = tk.Listbox(genitore, exportselection=Falso)
            per voce in v.get("elementi", []):
                w.insert("end", voce)
        altrimenti_se t == "CasellaSelezione":
            w = tk.Checkbutton(genitore, text=v["testo"], anchor="w")      # (il codice generato usa lo stesso anchor)
            se v.get("selezionata"):
                w.select()
        altrimenti_se t == "PulsanteOpzione":
            w = tk.Radiobutton(genitore, text=v["testo"], anchor="w", value=1)
            se v.get("selezionata"):
                w.select()
        altrimenti_se t == "Cursore":
            w = tk.Scale(genitore, from_=v["da"], to=v["a"], orient="horizontal" se v["orientamento"] == "orizzontale" altrimenti "vertical")
            w.set(v["valore"])
        altrimenti_se t == "CasellaCombinata":
            w = ttk.Combobox(genitore, values=list(v.get("valori", [])), style="Anteprima.TCombobox")
            w.set(v.get("valore", ""))
        altrimenti_se t == "BarraProgresso":
            w = ttk.Progressbar(genitore, maximum=max(1, v["massimo"]), value=v["valore"], style="Anteprima.Horizontal.TProgressbar")
        altrimenti_se t == "Albero":
            colonne = list(v.get("colonne", []))
            w = ttk.Treeview(genitore, columns=colonne, show="headings", style="Anteprima.Treeview")
            per col in colonne:
                w.heading(col, text=col)
            se v.get("larghezze") o v.get("allineamenti"):
                per nome_col, larghezza_col, ancora_col in colonne_albero(v):
                    w.column(nome_col, width=larghezza_col, anchor=ancora_col)
                    w.heading(nome_col, anchor=ancora_col)
        altrimenti_se t == "Tela":
            w = tk.Canvas(genitore, background=v.get("sfondo") o "#ffffff", highlightthickness=0)
        altrimenti_se t == "Riquadro":
            rilievo = {"piatto": "flat", "rialzato": "raised", "incavato": "sunken", "solido": "solid"}[v["rilievo"]]
            w = tk.Frame(genitore, relief=rilievo, borderwidth=v["bordo"], **({"background": v["sfondo"]} se v.get("sfondo") altrimenti {}))
        altrimenti_se t == "Immagine":
            w = tk.Label(genitore, text="🖼", relief="groove")
            percorso = v.get("file") o ""
            se percorso:
                p = percorso se os.path.isabs(percorso) altrimenti os.path.join(cartella o "", percorso)
                se os.path.exists(p):
                    prova:
                        da PIL importa Image, ImageTk
                        img = Image.open(p)
                        img.thumbnail((c.larghezza, c.altezza))
                        foto = ImageTk.PhotoImage(img)
                        w.configure(image=foto, text="", relief="flat")
                        w._foto = foto
                    eccetto Eccezione:
                        passa
        altrimenti_se t == "Separatore":
            # come il separatore di Windows: una linea grigia e una bianca affiancate, in alto (o a sinistra)
            w = tk.Canvas(genitore, background="#f0f0f0", highlightthickness=0)
            orizzontale = v["orientamento"] == "orizzontale"

            definisci _linee(e, w=w, orizzontale=orizzontale):
                w.delete("riga")
                se orizzontale:
                    w.create_line(0, 0, e.width, 0, fill="#a0a0a0", tags="riga")
                    w.create_line(0, 1, e.width, 1, fill="#ffffff", tags="riga")
                altrimenti:
                    w.create_line(0, 0, 0, e.height, fill="#a0a0a0", tags="riga")
                    w.create_line(1, 0, 1, e.height, fill="#ffffff", tags="riga")
            w.bind("<Configure>", _linee)
        altrimenti_se t == "Schede":
            w = ttk.Notebook(genitore)
            w._pagine = []
            per nome_pagina in (lista(v.get("pagine", [])) o ["Pagina 1"]):
                pagina = tk.Frame(w, background="#ffffff")
                w.add(pagina, text=nome_pagina)
                w._pagine.append(pagina)
        altrimenti_se t == "BarraNavigazione":
            w = tk.Canvas(genitore, background="#f0f0f0", highlightthickness=0)
            _disegna_barra(w, v)
            w.bind("<Configure>", lambda e, w=w, v=v: _disegna_barra(w, v))
        altrimenti_se non e_visivo(t):
            w = tk.Label(genitore, text=f"{TIPI[t]['icona']} {c.nome}", relief="raised", borderwidth=1, background="#fff3bf", foreground="#4a3b00",
                         anchor="w", font=(FONT_UI, 8))
        altrimenti:
            w = tk.Label(genitore, text=t)
        se carattere e t in ("Pulsante", "Etichetta", "CampoTesto", "AreaTesto", "Elenco", "CasellaSelezione", "PulsanteOpzione"):
            prova:
                w.configure(font=form_modello.font_tk(carattere))
            eccetto tk.TclError:
                passa
        se t in ("Pulsante", "CampoTesto", "CasellaSelezione", "PulsanteOpzione", "Etichetta", "Cursore") e stato == "disabled":
            prova:
                w.configure(state="disabled")
            eccetto tk.TclError:
                passa
    eccetto tk.TclError:
        w = tk.Label(genitore, text=f"{c.tipo}?", background="#ffdddd")
    ritorna w


definisci _disegna_barra(w, v):
    """Anteprima della barra di navigazione uguale a quella in esecuzione: le misure si prendono da pulsanti veri (stesso font, stessi margini).
    Pulsanti e «1 / 25» a sinistra, la ricerca (casella, Cerca, Tutti) a destra."""
    w.delete("all")
    altezza = max(w.winfo_height(), 34)

    definisci misura(widget):
        widget.update_idletasks()
        misure = (widget.winfo_reqwidth(), widget.winfo_reqheight(), widget.cget("font") se widget.winfo_class() != "Entry" altrimenti "")
        widget.destroy()
        ritorna misure

    definisci pulsante(x, testo_, larghezza, h, font):
        y = (altezza - h) / 2
        w.create_rectangle(x, y, x + larghezza - 1, y + h - 1, fill="#e1e1e1", outline="#adadad")
        w.create_text(x + larghezza / 2, altezza / 2, text=testo_, font=font, fill="#000000")

    x = 0
    per k in form_modello.PULSANTI_BARRA:
        se non v.get(k, k non in form_modello.PULSANTI_FACOLTATIVI):
            continua
        testo_ = form_modello.TESTI_BARRA[k]
        lw, h, font = misura(tk.Button(w, text=testo_, width=3 se k in ("primo", "precedente", "successivo", "ultimo") altrimenti 0, padx=8, pady=3))
        pulsante(x, testo_, lw, h, font)
        x += lw + 4
    se v.get("posizione", Vero):
        lw, h, font = misura(tk.Label(w, text="1 / 25", anchor="w"))
        w.create_text(x + 6, altezza / 2, text="1 / 25", anchor="w", font=font, fill="#000000")
    se v.get("cerca"):
        fine = max(w.winfo_width(), x + 200)
        per testo_ in ("Tutti", "Cerca"):
            lw, h, font = misura(tk.Button(w, text=testo_, padx=8, pady=3))
            pulsante(fine - lw, testo_, lw, h, font)
            fine -= lw + 4
        lw, h, _f = misura(tk.Entry(w, width=14))
        w.create_rectangle(fine - lw, (altezza - h) / 2, fine - 1, (altezza + h) / 2 - 1, fill="#ffffff", outline="#7a7a7a")


NOMI_ALLINEAMENTO = {"w": "sinistra", "center": "centro", "e": "destra"}
ANCORE_DA_NOME = {v: k per k, v in NOMI_ALLINEAMENTO.items()}


classe DialogoColonne(tk.Toplevel):
    """Le colonne di un albero: nome, larghezza in pixel e allineamento, con aggiunta, rimozione e ordine."""

    definisci __inizializza__(se_stesso, genitore, colori, colonne):
        tk.Toplevel.__init__(se_stesso, genitore)
        c = colori
        se_stesso.title("Colonne dell'albero")
        se_stesso.transient(genitore.winfo_toplevel())
        se_stesso.configure(background=c["pannello"])
        se_stesso.minsize(520, 300)
        se_stesso.risultato = Nessuno
        se_stesso.colori = c
        se_stesso.righe = [lista(r) per r in colonne]           # [nome, larghezza, ancora]
        se_stesso._corrente = Nessuno
        se_stesso._aggiorna = Falso

        sinistra = tk.Frame(se_stesso, background=c["pannello"])
        sinistra.pack(side="left", fill="both", expand=Vero, padx=(10, 4), pady=10)
        se_stesso.elenco = tk.Listbox(sinistra, activestyle="none", exportselection=Falso, background=c["campo"], foreground=c["primo_piano"],
                                      selectbackground=c["accento"], selectforeground="#ffffff", relief="flat", highlightthickness=1,
                                      highlightbackground=c["bordo"], font=(FONT_UI, 10), height=9)
        se_stesso.elenco.pack(fill="both", expand=Vero)
        se_stesso.elenco.bind("<<ListboxSelect>>", se_stesso._scelta)
        sotto = tk.Frame(sinistra, background=c["pannello"])
        sotto.pack(fill="x", pady=(6, 0))
        per testo_, comando, aiuto in (("＋", se_stesso.aggiungi, "Aggiunge una colonna"), ("－", se_stesso.rimuovi, "Toglie la colonna scelta"),
                                       ("▲", lambda: se_stesso.sposta(-1), "Sposta la colonna a sinistra"),
                                       ("▼", lambda: se_stesso.sposta(1), "Sposta la colonna a destra")):
            b = tk.Button(sotto, text=testo_, command=comando, width=3, relief="flat", background=c["pulsante"], foreground=c["primo_piano"])
            b.pack(side="left", padx=(0, 4))
            stile_suggerisci(b, aiuto, c)

        destra = tk.Frame(se_stesso, background=c["pannello"])
        destra.pack(side="right", fill="y", padx=(4, 10), pady=10)
        se_stesso.var_nome = tk.StringVar()
        se_stesso.var_larghezza = tk.StringVar()
        se_stesso.var_allineamento = tk.StringVar()
        per n, (etichetta, widget) in enumera((
                ("Nome", tk.Entry(destra, textvariable=se_stesso.var_nome, width=22)),
                ("Larghezza (pixel)", tk.Spinbox(destra, from_=20, to=2000, increment=10, textvariable=se_stesso.var_larghezza, width=8,
                                                 command=se_stesso._applica)),
                ("Allineamento", ttk.Combobox(destra, textvariable=se_stesso.var_allineamento, values=lista(NOMI_ALLINEAMENTO.values()),
                                              state="readonly", width=10)))):
            tk.Label(destra, text=etichetta, anchor="w", background=c["pannello"], foreground=c["tenue"]).grid(row=n * 2, column=0, sticky="w", pady=(0 se n == 0 altrimenti 10, 0))
            widget.grid(row=n * 2 + 1, column=0, sticky="w")
            se widget.winfo_class() in ("Entry", "Spinbox"):       # (il Combobox ttk è anch'esso un'Entry per isinstance)
                widget.configure(background=c["campo"], foreground=c["primo_piano"], insertbackground=c["cursore"], relief="flat",
                                 highlightthickness=1, highlightbackground=c["bordo"], highlightcolor=c["accento"])
                widget.bind("<Return>", lambda e: se_stesso._applica())
                widget.bind("<FocusOut>", lambda e: se_stesso._applica())
            altrimenti:
                widget.bind("<<ComboboxSelected>>", lambda e: se_stesso._applica())
        se_stesso.campo_nome = destra.grid_slaves(row=1, column=0)[0]
        se_stesso.campo_larghezza = destra.grid_slaves(row=3, column=0)[0]
        se_stesso.campo_allineamento = destra.grid_slaves(row=5, column=0)[0]
        riga = tk.Frame(destra, background=c["pannello"])
        riga.grid(row=7, column=0, sticky="se", pady=(24, 0))
        destra.grid_rowconfigure(6, weight=1)
        tk.Button(riga, text="Annulla", width=9, relief="flat", background=c["pulsante"], foreground=c["primo_piano"],
                  command=se_stesso.destroy).pack(side="left", padx=4)
        tk.Button(riga, text="OK", width=9, relief="flat", background=c["accento"], foreground="#ffffff",
                  command=se_stesso.conferma).pack(side="left")
        se_stesso.riempi()
        se se_stesso.righe:
            se_stesso.seleziona(0)
        se_stesso.bind("<Escape>", lambda e: se_stesso.destroy())

    definisci riempi(se_stesso):
        se_stesso.elenco.delete(0, "end")
        per nome, larghezza, ancora in se_stesso.righe:
            se_stesso.elenco.insert("end", f"{nome}   ·   {larghezza} px   ·   {NOMI_ALLINEAMENTO[ancora]}")

    definisci seleziona(se_stesso, i):
        se_stesso._applica()
        se non se_stesso.righe:
            se_stesso._corrente = Nessuno
            ritorna
        i = max(0, min(lunghezza(se_stesso.righe) - 1, i))
        se_stesso._corrente = i
        se_stesso.elenco.selection_clear(0, "end")
        se_stesso.elenco.selection_set(i)
        nome, larghezza, ancora = se_stesso.righe[i]
        se_stesso.var_nome.set(nome)
        se_stesso.var_larghezza.set(testo(larghezza))
        se_stesso.var_allineamento.set(NOMI_ALLINEAMENTO[ancora])

    definisci _scelta(se_stesso, e=Nessuno):
        sel = se_stesso.elenco.curselection()
        se sel e sel[0] != se_stesso._corrente:
            se_stesso.seleziona(sel[0])

    definisci _applica(se_stesso):
        """Riporta nei dati della riga scelta quello che c'è nei campi."""
        i = se_stesso._corrente
        se i è Nessuno o i >= lunghezza(se_stesso.righe):
            ritorna
        nome = se_stesso.var_nome.get().strip() o se_stesso.righe[i][0]
        prova:
            larghezza = max(20, min(2000, int(float(se_stesso.var_larghezza.get()))))
        eccetto ValueError:
            larghezza = se_stesso.righe[i][1]
        ancora = ANCORE_DA_NOME.get(se_stesso.var_allineamento.get(), "w")
        se se_stesso.righe[i] != [nome, larghezza, ancora]:
            se_stesso.righe[i] = [nome, larghezza, ancora]
            se_stesso.elenco.delete(i)
            se_stesso.elenco.insert(i, f"{nome}   ·   {larghezza} px   ·   {NOMI_ALLINEAMENTO[ancora]}")
            se_stesso.elenco.selection_set(i)

    definisci aggiungi(se_stesso):
        se_stesso._applica()
        usati = {r[0] per r in se_stesso.righe}
        n = lunghezza(se_stesso.righe) + 1
        mentre f"Colonna{n}" in usati:
            n += 1
        se_stesso.righe.append([f"Colonna{n}", 120, "w"])
        se_stesso.riempi()
        se_stesso.seleziona(lunghezza(se_stesso.righe) - 1)

    definisci rimuovi(se_stesso):
        i = se_stesso._corrente
        se i è Nessuno:
            ritorna
        se_stesso._corrente = Nessuno
        elimina se_stesso.righe[i]
        se_stesso.riempi()
        se se_stesso.righe:
            se_stesso.seleziona(min(i, lunghezza(se_stesso.righe) - 1))

    definisci sposta(se_stesso, passo):
        se_stesso._applica()
        i = se_stesso._corrente
        se i è Nessuno o non (0 <= i + passo < lunghezza(se_stesso.righe)):
            ritorna
        se_stesso.righe[i], se_stesso.righe[i + passo] = se_stesso.righe[i + passo], se_stesso.righe[i]
        se_stesso.riempi()
        se_stesso._corrente = Nessuno
        se_stesso.seleziona(i + passo)

    definisci conferma(se_stesso):
        se_stesso._applica()
        nomi = [r[0] per r in se_stesso.righe]
        se lunghezza(set(nomi)) != lunghezza(nomi):
            messagebox.showwarning("Colonne", "I nomi delle colonne devono essere tutti diversi.", parent=se_stesso)
            ritorna
        se_stesso.risultato = [tuple(r) per r in se_stesso.righe]
        se_stesso.destroy()

    definisci mostra(se_stesso):
        se_stesso.update_idletasks()
        se_stesso.grab_set()
        se_stesso.wait_window()
        ritorna se_stesso.risultato


classe DialogoMenu(tk.Toplevel):
    """Modifica il testo di una barra dei menu: i titoli a margine, le voci rientrate («Etichetta = gestore»), «-» per un separatore."""

    definisci __inizializza__(se_stesso, genitore, colori, testo_):
        tk.Toplevel.__init__(se_stesso, genitore)
        se_stesso.title("Barra dei menu")
        se_stesso.transient(genitore.winfo_toplevel())
        se_stesso.configure(background=colori["pannello"])
        se_stesso.geometry("560x460")
        se_stesso.risultato = Nessuno
        c = colori
        tk.Label(se_stesso, background=c["pannello"], foreground=c["tenue"], justify="left", anchor="w", wraplength=520,
                 text="Scrivi i titoli dei menu senza rientro e le voci con un rientro (due spazi).\n"
                      "«Etichetta = nome_funzione» collega la voce a un gestore; «-» è un separatore; «Etichetta = @NomeFinestra» apre un'altra finestra "
                      "del progetto; senza «=» la voce resta spenta.").pack(fill="x", padx=12, pady=(10, 4))
        se_stesso.testo = tk.Text(se_stesso, font=(FONT_MONO, 11), undo=Vero, background=c["campo"], foreground=c["primo_piano"],
                                  insertbackground=c["cursore"], relief="flat", highlightthickness=1, highlightbackground=c["bordo"])
        se_stesso.testo.pack(fill="both", expand=Vero, padx=12, pady=4)
        se_stesso.testo.insert("1.0", testo_ o "")
        fondo = tk.Frame(se_stesso, background=c["pannello"])
        fondo.pack(fill="x", padx=12, pady=10)
        tk.Button(fondo, text="Annulla", command=se_stesso.destroy, background=c["pulsante"], foreground=c["primo_piano"], relief="flat", padx=12).pack(side="right", padx=4)
        tk.Button(fondo, text="Applica", command=se_stesso.conferma, background=c["accento"], foreground="#ffffff", relief="flat", padx=12).pack(side="right", padx=4)
        se_stesso.bind("<Escape>", lambda e: se_stesso.destroy())
        se_stesso.testo.focus_set()

    definisci conferma(se_stesso):
        se_stesso.risultato = se_stesso.testo.get("1.0", "end").rstrip() + ""
        se_stesso.destroy()

    definisci mostra(se_stesso):
        se_stesso.grab_set()
        se_stesso.wait_window()
        ritorna se_stesso.risultato


classe DialogoOrdine(tk.Toplevel):
    """Ordine dei componenti: è anche l'ordine in cui si passa dall'uno all'altro con il tasto Tab (e chi sta più in basso nell'elenco sta sopra agli altri)."""

    definisci __inizializza__(se_stesso, genitore, colori, nomi):
        tk.Toplevel.__init__(se_stesso, genitore)
        se_stesso.title("Ordine di tabulazione")
        se_stesso.transient(genitore.winfo_toplevel())
        se_stesso.configure(background=colori["pannello"])
        se_stesso.geometry("360x480")
        se_stesso.risultato = Nessuno
        c = colori
        se_stesso.nomi = lista(nomi)
        tk.Label(se_stesso, text="Il tasto Tab passa dai componenti in questo ordine, dall'alto in basso.", background=c["pannello"], foreground=c["tenue"],
                 anchor="w", wraplength=330, justify="left").pack(fill="x", padx=12, pady=(10, 4))
        centro = tk.Frame(se_stesso, background=c["pannello"])
        centro.pack(fill="both", expand=Vero, padx=12)
        se_stesso.elenco = tk.Listbox(centro, activestyle="none", exportselection=Falso, background=c["campo"], foreground=c["primo_piano"],
                                      selectbackground=c["accento"], selectforeground="#ffffff", relief="flat", highlightthickness=1, highlightbackground=c["bordo"])
        se_stesso.elenco.pack(side="left", fill="both", expand=Vero)
        colonna = tk.Frame(centro, background=c["pannello"])
        colonna.pack(side="left", padx=8)
        per testo_, passo in (("▲ Su", -1), ("▼ Giù", 1)):
            tk.Button(colonna, text=testo_, command=lambda p=passo: se_stesso.sposta(p), width=8, relief="flat", background=c["pulsante"],
                      foreground=c["primo_piano"]).pack(pady=3)
        fondo = tk.Frame(se_stesso, background=c["pannello"])
        fondo.pack(fill="x", padx=12, pady=10)
        tk.Button(fondo, text="Annulla", command=se_stesso.destroy, background=c["pulsante"], foreground=c["primo_piano"], relief="flat", padx=12).pack(side="right", padx=4)
        tk.Button(fondo, text="Applica", command=se_stesso.conferma, background=c["accento"], foreground="#ffffff", relief="flat", padx=12).pack(side="right", padx=4)
        se_stesso.riempi()
        se_stesso.bind("<Escape>", lambda e: se_stesso.destroy())

    definisci riempi(se_stesso, scelta=Nessuno):
        se_stesso.elenco.delete(0, "end")
        per i, n in enumera(se_stesso.nomi, 1):
            se_stesso.elenco.insert("end", f"{i:>3}   {n}")
        se scelta è non Nessuno:
            se_stesso.elenco.selection_set(scelta)
            se_stesso.elenco.see(scelta)

    definisci sposta(se_stesso, passo):
        sel = se_stesso.elenco.curselection()
        se non sel:
            ritorna
        i = sel[0]
        j = i + passo
        se 0 <= j < lunghezza(se_stesso.nomi):
            se_stesso.nomi[i], se_stesso.nomi[j] = se_stesso.nomi[j], se_stesso.nomi[i]
            se_stesso.riempi(j)

    definisci conferma(se_stesso):
        se_stesso.risultato = lista(se_stesso.nomi)
        se_stesso.destroy()

    definisci mostra(se_stesso):
        se_stesso.grab_set()
        se_stesso.wait_window()
        ritorna se_stesso.risultato


classe Progettista(tk.Frame):
    """Scheda di progettazione di una finestra (un file .form.json)."""

    definisci __inizializza__(se_stesso, genitore, percorso_json, form, colori, config, azioni):
        tk.Frame.__init__(se_stesso, genitore)
        se_stesso.percorso = percorso_json
        se_stesso.cartella = os.path.dirname(percorso_json)
        se_stesso.form = form
        se_stesso.colori = colori
        se_stesso.config_ = config
        se_stesso.azioni = azioni
        se_stesso.modificato = Falso
        se_stesso.selezione_ = []          # nomi dei componenti selezionati
        se_stesso.widget = {}              # nome -> widget tk
        se_stesso.maniglie = []
        se_stesso.da_aggiungere = Nessuno  # tipo scelto in palette
        se_stesso.cronologia = [form.a_json()]
        se_stesso.indice_cronologia = 0
        se_stesso.appunti = []
        se_stesso.griglia_attiva = tk.BooleanVar(value=Vero)
        se_stesso._trascinamento = Nessuno
        se_stesso._costruisci()
        se_stesso.applica_colori(colori)
        se_stesso.ricostruisci()
        se_stesso.seleziona([])

    # ------------------------------------------------------------ struttura
    definisci _costruisci(se_stesso):
        barra = tk.Frame(se_stesso)
        barra.pack(fill="x")
        se_stesso.barra = barra
        se_stesso.titolo = tk.Label(barra, text="", anchor="w")
        se_stesso.titolo.pack(side="left", padx=8)
        per testo_, comando, aiuto in (("💾 Salva", se_stesso.salva, "Salva la finestra e rigenera il codice"),
                                       ("▶ Prova", se_stesso.esegui, "Prova la finestra così com'è"),
                                       ("‹/› Codice", se_stesso.vai_al_codice, "Apre il file con la tua logica"),
                                       ("↶", se_stesso.annulla, "Annulla (Ctrl+Z)"), ("↷", se_stesso.ripeti, "Ripeti (Ctrl+Y)"),
                                       ("⧉", se_stesso.duplica, "Duplica i componenti selezionati (Ctrl+D)"),
                                       ("🗑", se_stesso.elimina_selezionati, "Elimina i componenti selezionati (Canc)")):
            b = tk.Button(barra, text=testo_, command=comando)
            b.pack(side="left", padx=2, pady=3)
            stile_suggerisci(b, aiuto)
        casella = tk.Checkbutton(barra, text="Griglia", variable=se_stesso.griglia_attiva,
                                 command=se_stesso._disegna_griglia)
        casella.pack(side="left", padx=8)
        stile_suggerisci(casella, "Mostra la griglia e fa agganciare i componenti")
        se_stesso.menu_allinea = tk.Menubutton(barra, text="Allinea ▾", relief="flat")
        stile_suggerisci(se_stesso.menu_allinea, "Allinea o distribuisce i componenti selezionati")
        m = tk.Menu(se_stesso.menu_allinea, tearoff=0)
        per etichetta, modo in (("A sinistra", "sinistra"), ("A destra", "destra"), ("In alto", "alto"),
                                ("In basso", "basso"), ("Centra in orizzontale", "centro_x"),
                                ("Centra in verticale", "centro_y"), ("Stessa larghezza", "stessa_larghezza"),
                                ("Stessa altezza", "stessa_altezza"), ("Distribuisci in orizzontale", "distribuisci_x"),
                                ("Distribuisci in verticale", "distribuisci_y")):
            m.add_command(label=etichetta, command=lambda md=modo: se_stesso.allinea(md))
        se_stesso.menu_allinea.configure(menu=m)
        se_stesso.menu_allinea.pack(side="left", padx=4)
        b_ordine = tk.Button(barra, text="⇅ Ordine…", command=se_stesso.modifica_ordine)
        b_ordine.pack(side="left", padx=2, pady=3)
        stile_suggerisci(b_ordine, "Cambia l'ordine dei componenti: è l'ordine del tasto Tab")
        se_stesso.stato = tk.Label(barra, text="", anchor="e")
        se_stesso.stato.pack(side="right", padx=8)

        corpo = tk.PanedWindow(se_stesso, orient="horizontal", sashwidth=5, borderwidth=0)
        corpo.pack(fill="both", expand=Vero)
        se_stesso.corpo = corpo
        # palette
        palette = tk.Frame(corpo)
        se_stesso.palette = palette
        tk.Label(palette, text="COMPONENTI", anchor="w").pack(fill="x", padx=8, pady=(8, 2))
        cornice_palette = tk.Frame(palette)
        cornice_palette.pack(fill="x", padx=6, pady=4)
        se_stesso.elenco_palette = tk.Listbox(cornice_palette, activestyle="none", exportselection=Falso, width=24, height=12, font=(FONT_MONO, 10))
        scorri_palette = ttk.Scrollbar(cornice_palette, orient="vertical", command=se_stesso.elenco_palette.yview)
        se_stesso.elenco_palette.configure(yscrollcommand=scorri_palette.set)
        scorri_palette.pack(side="right", fill="y")
        per t in ORDINE_PALETTE:
            se_stesso.elenco_palette.insert("end", f"{TIPI[t]['icona']:>3}   {t}")
        se_stesso.elenco_palette.pack(side="left", fill="x", expand=Vero)
        se_stesso.elenco_palette.bind("<<ListboxSelect>>", se_stesso._palette_scelta)
        se_stesso.elenco_palette.bind("<Double-Button-1>", se_stesso._palette_doppio)
        se_stesso.suggerimento = tk.Label(palette, wraplength=150, justify="left", anchor="nw",
                                          text="Scegli un componente e clicca sulla finestra, oppure fai doppio clic.")
        se_stesso.suggerimento.pack(fill="x", padx=8, pady=6)
        # struttura: la gerarchia dei componenti (finestra, riquadri, pagine di schede); si seleziona e si trascina in un altro contenitore
        tk.Label(palette, text="STRUTTURA", anchor="w").pack(fill="x", padx=8, pady=(4, 2))
        cornice_albero = tk.Frame(palette)
        cornice_albero.pack(fill="both", expand=Vero, padx=6, pady=(0, 6))
        se_stesso.albero = ttk.Treeview(cornice_albero, show="tree", selectmode="extended", height=6)
        scorri_albero = ttk.Scrollbar(cornice_albero, orient="vertical", command=se_stesso.albero.yview)
        se_stesso.albero.configure(yscrollcommand=scorri_albero.set)
        scorri_albero.pack(side="right", fill="y")
        se_stesso.albero.pack(side="left", fill="both", expand=Vero)
        se_stesso._albero_trascina = Nessuno
        se_stesso.albero.bind("<<TreeviewSelect>>", se_stesso._albero_selezione)
        se_stesso.albero.bind("<Double-Button-1>", se_stesso._albero_doppio)
        se_stesso.albero.bind("<ButtonPress-1>", se_stesso._albero_premi, add="+")
        se_stesso.albero.bind("<B1-Motion>", se_stesso._albero_muovi)
        se_stesso.albero.bind("<ButtonRelease-1>", se_stesso._albero_rilascia)
        se_stesso.albero.bind("<Button-3>", se_stesso._albero_menu)
        corpo.add(palette, minsize=150, width=200)
        # area di disegno scorrevole
        centro = tk.Frame(corpo)
        se_stesso.area = tk.Canvas(centro, highlightthickness=0)
        se_stesso.area._tema_proprio = Vero
        bx = ttk.Scrollbar(centro, orient="horizontal", command=se_stesso.area.xview)
        by = ttk.Scrollbar(centro, orient="vertical", command=se_stesso.area.yview)
        se_stesso.area.configure(xscrollcommand=bx.set, yscrollcommand=by.set)
        bx.pack(side="bottom", fill="x")
        by.pack(side="right", fill="y")
        se_stesso.area.pack(fill="both", expand=Vero)
        # maniglie per ridimensionare la finestra stessa (destra, sotto, angolo): elementi della tela, quindi non vengono distrutti
        se_stesso._ridim_finestra = Nessuno
        se_stesso._rett = {}              # rettangoli dei componenti in un contenitore a griglia
        se_stesso._tracce = {}
        se_stesso._evid = Nessuno
        per etichetta_, lato_, cursore_ in (("mf_e", "e", cursore("size_we")), ("mf_s", "s", cursore("size_ns")), ("mf_se", "se", cursore("size_nw_se"))):
            se_stesso.area.tag_bind(etichetta_, "<ButtonPress-1>", lambda e, l=lato_: se_stesso._inizia_finestra(e, l))
            se_stesso.area.tag_bind(etichetta_, "<Enter>", lambda e, k=cursore_: se_stesso.area.configure(cursor=k))
            se_stesso.area.tag_bind(etichetta_, "<Leave>", lambda e: se_stesso.area.configure(cursor=""))
        se_stesso.area.bind("<B1-Motion>", se_stesso._muovi_finestra, add="+")
        se_stesso.area.bind("<ButtonRelease-1>", se_stesso._fine_finestra, add="+")
        se_stesso.superficie = tk.Canvas(se_stesso.area, highlightthickness=0, cursor="arrow")
        se_stesso.superficie._tema_proprio = Vero
        se_stesso.superficie._anteprima = Vero      # i colori del tema di PitStudio non la toccano
        se_stesso.finestra_superficie = se_stesso.area.create_window(30, 30, anchor="nw", window=se_stesso.superficie)
        se_stesso.superficie.bind("<ButtonPress-1>", se_stesso._clic_superficie)
        se_stesso.superficie.bind("<B1-Motion>", se_stesso._trascina_lazo)
        se_stesso.superficie.bind("<ButtonRelease-1>", se_stesso._fine_lazo)
        se_stesso._lazo = Nessuno
        se_stesso.superficie.bind("<Button-3>", lambda e: se_stesso._menu(e, Nessuno))
        corpo.add(centro, minsize=300, stretch="always")
        # ispettore
        ispettore = tk.Frame(corpo)
        se_stesso.ispettore = ispettore
        tk.Label(ispettore, text="PROPRIETÀ", anchor="w").pack(fill="x", padx=8, pady=(8, 2))
        se_stesso.intestazione_ispettore = tk.Label(ispettore, anchor="w", font=(FONT_UI, 10, "bold"))
        se_stesso.intestazione_ispettore.pack(fill="x", padx=8, pady=2)
        contenitore = tk.Frame(ispettore)
        contenitore.pack(fill="both", expand=Vero)
        se_stesso.tela_ispettore = tk.Canvas(contenitore, highlightthickness=0, width=260)
        se_stesso.tela_ispettore._tema_proprio = Vero
        by2 = ttk.Scrollbar(contenitore, orient="vertical", command=se_stesso.tela_ispettore.yview)
        se_stesso.tela_ispettore.configure(yscrollcommand=by2.set)
        by2.pack(side="right", fill="y")
        se_stesso.tela_ispettore.pack(side="left", fill="both", expand=Vero)
        se_stesso.righe_ispettore = tk.Frame(se_stesso.tela_ispettore)
        se_stesso.tela_ispettore.create_window(0, 0, anchor="nw", window=se_stesso.righe_ispettore, tags="righe")
        se_stesso.righe_ispettore.bind("<Configure>", lambda e: se_stesso.tela_ispettore.configure(
            scrollregion=se_stesso.tela_ispettore.bbox("all")))
        se_stesso.tela_ispettore.bind("<Configure>", lambda e: se_stesso.tela_ispettore.itemconfigure("righe", width=e.width))
        corpo.add(ispettore, minsize=240, width=290)
        se_stesso.area.bind("<Configure>", lambda e: Nessuno)
        se_stesso.bind_all("<Delete>", se_stesso._tasto_elimina, add="+")
        se_stesso.configure(takefocus=1)
        per tasto, dx, dy in (("Left", -1, 0), ("Right", 1, 0), ("Up", 0, -1), ("Down", 0, 1)):
            se_stesso.bind(f"<{tasto}>", lambda e, dx=dx, dy=dy: se_stesso.sposta_selezione(dx, dy))
            se_stesso.bind(f"<Shift-{tasto}>", lambda e, dx=dx, dy=dy: se_stesso.sposta_selezione(dx * 10, dy * 10))
        se_stesso.bind("<Control-d>", lambda e: se_stesso.duplica())
        se_stesso.bind("<Control-c>", lambda e: se_stesso.copia())
        se_stesso.bind("<Control-v>", lambda e: se_stesso.incolla())
        se_stesso.bind("<Control-z>", lambda e: se_stesso.annulla())
        se_stesso.bind("<Control-y>", lambda e: se_stesso.ripeti())
        se_stesso.bind("<Control-a>", lambda e: se_stesso.seleziona([c.nome per c in se_stesso.form.componenti]))

    definisci applica_colori(se_stesso, c):
        se_stesso.colori = c
        se_stesso.configure(background=c["pannello"])
        per w in (se_stesso.barra, se_stesso.palette, se_stesso.ispettore, se_stesso.righe_ispettore):
            w.configure(background=c["pannello"])
        se_stesso.corpo.configure(background=c["sfondo"])
        per w in se_stesso.corpo.winfo_children():
            w.configure(background=c["pannello"])
        se_stesso.area.configure(background=c["editor"])
        se_stesso.tela_ispettore.configure(background=c["pannello"])
        se_stesso.titolo.configure(background=c["pannello"], foreground=c["primo_piano"])
        se_stesso.stato.configure(background=c["pannello"], foreground=c["tenue"])
        se_stesso.intestazione_ispettore.configure(background=c["pannello"], foreground=c["accento"])
        se_stesso.suggerimento.configure(background=c["pannello"], foreground=c["tenue"])
        se_stesso.elenco_palette.configure(background=c["campo"], foreground=c["primo_piano"],
                                           selectbackground=c["accento"], selectforeground="#ffffff",
                                           relief="flat", highlightthickness=0, font=(FONT_MONO, 11))
        per w in se_stesso.palette.winfo_children() + se_stesso.ispettore.winfo_children():
            se w.winfo_class() == "Label" e w non in (se_stesso.suggerimento, se_stesso.intestazione_ispettore):
                w.configure(background=c["pannello"], foreground=c["tenue"])
        per w in se_stesso.barra.winfo_children():
            cl = w.winfo_class()
            se cl == "Button":
                w.configure(background=c["pulsante"], foreground=c["primo_piano"], relief="flat",
                            activebackground=c["pulsante_attivo"], padx=8)
            altrimenti_se cl in ("Checkbutton", "Menubutton"):
                w.configure(background=c["pannello"], foreground=c["primo_piano"],
                            activebackground=c["pannello"], activeforeground=c["primo_piano"])
        se_stesso._disegna_griglia()
        se_stesso._riempi_ispettore()

    # ------------------------------------------------------------ superficie
    definisci _disegna_griglia(se_stesso):
        s = se_stesso.superficie
        s.delete("griglia")
        s.configure(background=se_stesso.form.sfondo o se_stesso._sfondo_aspetto(), width=se_stesso.form.larghezza, height=se_stesso.form.altezza)
        # bordo della finestra, disegnato fuori dalla superficie così i componenti restano alle posizioni vere
        se_stesso.area.delete("bordo_finestra")
        se_stesso.area.create_rectangle(29, 29, 31 + se_stesso.form.larghezza, 31 + se_stesso.form.altezza,
                                        outline=se_stesso.colori["bordo"], tags="bordo_finestra")
        se_stesso.area.tag_lower("bordo_finestra")
        se_stesso.area.delete("mf")
        L, A = se_stesso.form.larghezza, se_stesso.form.altezza
        per etichetta_, cx, cy in (("mf_e", 35 + L, 30 + A // 2), ("mf_s", 30 + L // 2, 35 + A), ("mf_se", 35 + L, 35 + A)):
            se_stesso.area.create_rectangle(cx - 4, cy - 4, cx + 4, cy + 4, fill=se_stesso.colori["accento"],
                                            outline=se_stesso.colori["bordo"], tags=("mf", etichetta_))
        se se_stesso.griglia_attiva.get():
            colore = "#c8c8c8" se (se_stesso.form.sfondo o se_stesso._sfondo_aspetto()) >= "#808080" altrimenti "#555555"
            per x in intervallo(0, se_stesso.form.larghezza, GRIGLIA * 2):
                per y in intervallo(0, se_stesso.form.altezza, GRIGLIA * 2):
                    s.create_rectangle(x, y, x, y, outline=colore, tags="griglia")
        se_stesso.area.configure(scrollregion=(0, 0, se_stesso.form.larghezza + 80, se_stesso.form.altezza + 80))
        se_stesso.titolo.configure(text=f"{se_stesso.form.nome}  —  {se_stesso.form.larghezza}×{se_stesso.form.altezza}")
        se form_modello.usa_griglia(se_stesso.form) o getattr(se_stesso, "_rett", Nessuno):
            se_stesso._rilayout()

    definisci _modulo_aspetto(se_stesso):
        """Il modulo aspetto (modelli_codice/aspetto.pit), o Nessuno se non si trova."""
        prova:
            se form_modello.CARTELLA_MODELLI non in sys.path:
                sys.path.append(form_modello.CARTELLA_MODELLI)
            importa aspetto
            ritorna aspetto
        eccetto ImportError:
            ritorna Nessuno

    definisci _sfondo_aspetto(se_stesso):
        """Colore di fondo della finestra: quello del tema scelto (o il grigio classico)."""
        se se_stesso.form.aspetto != "classico":
            m = se_stesso._modulo_aspetto()
            se m:
                ritorna m.colori_del_tema(se_stesso.form.aspetto)["sfondo"]
        ritorna "#f0f0f0"

    definisci _rivesti(se_stesso, w, c):
        """Anteprima fedele: dà al componente l'aspetto del tema, poi rimette i colori e il carattere scelti a mano."""
        m = se_stesso._modulo_aspetto()
        se non m o se_stesso.form.aspetto == "classico":
            ritorna
        m.rivesti(w, se_stesso.form.aspetto)
        v = c.valori
        per chiave, opzione in (("sfondo", "background"), ("primo_piano", "foreground")):
            se v.get(chiave):
                prova:
                    w.configure(**{opzione: v[chiave]})
                eccetto tk.TclError:
                    passa
        se v.get("carattere"):
            prova:
                w.configure(font=form_modello.font_tk(v["carattere"]))
            eccetto tk.TclError:
                passa

    # ------------------------------------------------------------ dimensioni della finestra (maniglie fuori dalla superficie)
    definisci _inizia_finestra(se_stesso, e, lato):
        f = se_stesso.form
        se_stesso._ridim_finestra = {"lato": lato, "x": e.x_root, "y": e.y_root, "w": f.larghezza, "h": f.altezza}
        ritorna "break"

    definisci _muovi_finestra(se_stesso, e):
        r = se_stesso._ridim_finestra
        se non r:
            ritorna
        f = se_stesso.form
        se "e" in r["lato"]:
            f.larghezza = max(60, min(4000, se_stesso._aggancia(r["w"] + e.x_root - r["x"])))
        se "s" in r["lato"]:
            f.altezza = max(60, min(4000, se_stesso._aggancia(r["h"] + e.y_root - r["y"])))
        se_stesso._disegna_griglia()
        ritorna "break"

    definisci _fine_finestra(se_stesso, e=Nessuno):
        se se_stesso._ridim_finestra:
            se_stesso._ridim_finestra = Nessuno
            se_stesso.area.configure(cursor="")
            se_stesso._registra()
            se_stesso._riempi_ispettore()

    # ------------------------------------------------------------ layout a griglia
    definisci _geom(se_stesso, c):
        """(x, y, larghezza, altezza) con cui è disegnato il componente: quelli della sua cella se sta in una griglia, altrimenti i suoi."""
        r = getattr(se_stesso, "_rett", {}).get(c.nome)
        ritorna r se r altrimenti (c.x, c.y, c.larghezza, c.altezza)

    definisci _rilayout(se_stesso):
        """Ricalcola le celle (stesso calcolo del programma generato) e rimette al loro posto i componenti disegnati."""
        vecchi = getattr(se_stesso, "_rett", {})
        tracce = {}
        se_stesso._rett = form_modello.rettangoli(se_stesso.form, tracce)
        se_stesso._tracce = tracce
        se non se_stesso.widget:
            ritorna
        per nome in set(vecchi) | set(se_stesso._rett):
            c = se_stesso.form.trova(nome)
            w = se_stesso.widget.get(nome)
            se c e w:
                x, y, l, a = se_stesso._geom(c)
                w.place_configure(x=x, y=y, width=l, height=a)
        se_stesso._riposiziona_maniglie()
        se_stesso._aggiorna_stato()

    definisci _cella_a(se_stesso, genitore, x, y):
        """(riga, colonna) della cella della griglia `genitore` che contiene il punto (x, y); oltre l'ultima riga o colonna è quella nuova."""
        t = getattr(se_stesso, "_tracce", {}).get(genitore)
        se non t:
            ritorna 0, 0

        definisci indice(p, inizi, misure):
            ultima = -1
            per i in intervallo(lunghezza(inizi)):
                se misure[i] <= 0:
                    continua
                ultima = i
                se p < inizi[i] + misure[i] + 3:
                    ritorna i
            ritorna ultima + 1
        ritorna indice(y, t[2], t[3]), indice(x, t[0], t[1])

    definisci _riquadro_cella(se_stesso, genitore, riga, colonna):
        """(x, y, larghezza, altezza) della cella: se è una riga o colonna nuova sta dopo l'ultima."""
        t = getattr(se_stesso, "_tracce", {}).get(genitore)
        d = form_modello.definizione_griglia(se_stesso.form, genitore)
        se non t o d è Nessuno o non t[0]:
            ritorna 10, 10, 60, 24
        definisci tratto(indice, inizi, misure):
            se indice < lunghezza(inizi):
                ritorna inizi[indice], max(6, misure[indice])
            ritorna inizi[-1] + misure[-1] + d["spazio"], 60
        x, l = tratto(colonna, t[0], t[1])
        y, a = tratto(riga, t[2], t[3])
        ritorna x, y, l, a

    definisci _evidenzia_cella(se_stesso, genitore, riga, colonna, padre):
        x, y, l, a = se_stesso._riquadro_cella(genitore, riga, colonna)
        ev = getattr(se_stesso, "_evid", Nessuno)
        se ev è non Nessuno e ev.master è non padre:
            se_stesso._togli_evidenza()
            ev = Nessuno
        se ev è Nessuno:
            ev = tk.Frame(padre, background=se_stesso.colori["accento"])
            se_stesso._evid = ev
        ev.place(x=x, y=y, width=l, height=a)
        ev.tk.call("lower", ev._w)

    definisci _togli_evidenza(se_stesso):
        ev = getattr(se_stesso, "_evid", Nessuno)
        se ev è non Nessuno:
            prova:
                ev.destroy()
            eccetto tk.TclError:
                passa
        se_stesso._evid = Nessuno

    definisci _cella_nuova(se_stesso, c, x, y=Nessuno):
        """Un componente nuovo in un contenitore a griglia: nella cella sotto il puntatore se è libera, altrimenti nella prima libera."""
        f = se_stesso.form
        se form_modello.definizione_griglia(f, c.genitore) è Nessuno:
            ritorna
        occupate = set()
        per a in form_modello.figli_in_griglia(f, c.genitore):
            se a.nome != c.nome:
                k = form_modello.cella_di(a)
                per r in intervallo(k["riga"], k["riga"] + k["righe"]):
                    per col in intervallo(k["colonna"], k["colonna"] + k["colonne"]):
                        occupate.add((r, col))
        se x è non Nessuno:
            r, col = se_stesso._cella_a(c.genitore, x, y)
        altrimenti:
            r, col = form_modello.cella_di(c)["riga"], form_modello.cella_di(c)["colonna"]
        se (r, col) in occupate o x è Nessuno:
            r, col = form_modello.cella_vuota(f, c.genitore, col, escludi=c.nome)
        form_modello.imposta_cella(c, riga=r, colonna=col, righe=1, colonne=1, allinea=form_modello.ALLINEA_PREDEFINITO.get(c.tipo, "w"))
        se_stesso._rilayout()

    definisci _imposta_cella(se_stesso, c, campo, valore):
        prova:
            valore = valore se campo == "allinea" altrimenti int(float(valore))
        eccetto ValueError:
            ritorna
        form_modello.imposta_cella(c, **{campo: valore})
        se_stesso._rilayout()
        se_stesso._registra()

    definisci _campi_cella(se_stesso, aggiungi_riga, c):
        """Le righe dell'ispettore per un componente che sta in una griglia: cella, quante celle occupa, allineamento."""
        k = form_modello.cella_di(c)
        per etichetta, chiave in (("Riga", "riga"), ("Colonna", "colonna"), ("Righe occupate", "righe"), ("Colonne occupate", "colonne")):
            aggiungi_riga(etichetta, lambda p, ch=chiave: se_stesso._spin(
                p, k[ch], lambda v, ch=ch: se_stesso._imposta_cella(c, ch, v), 0 se ch in ("riga", "colonna") altrimenti 1, 99))
        nomi = [n per n, _ in form_modello.ALLINEAMENTI_CELLA]
        corrente = k["allinea"]
        per n, s in form_modello.ALLINEAMENTI_CELLA:
            se s == k["allinea"]:
                corrente = n

        definisci crea(p):
            cb = ttk.Combobox(p, values=nomi, state="readonly", width=10)
            cb.set(corrente)
            cb.bind("<<ComboboxSelected>>", lambda ev: se_stesso._imposta_cella(c, "allinea", dict(form_modello.ALLINEAMENTI_CELLA)[cb.get()]))
            ritorna cb
        aggiungi_riga("Allineamento", crea)

    definisci ricostruisci(se_stesso):
        """Ricrea tutti i widget di disegno a partire dal modello."""
        per w in se_stesso.widget.values():
            w.destroy()
        se_stesso.widget = {}
        se_stesso._disegna_griglia()
        per c in form_modello.ordine_creazione(se_stesso.form):
            se_stesso._crea(c)
        se_stesso._aggiorna_maniglie()
        se_stesso._aggiorna_albero()

    # ------------------------------------------------------------ struttura (albero dei componenti)
    definisci _aggiorna_albero(se_stesso):
        """Ridisegna la gerarchia: finestra, componenti, riquadri con i loro figli, pagine di schede."""
        a = getattr(se_stesso, "albero", Nessuno)
        se a è Nessuno:
            ritorna
        prova:
            a.delete(*a.get_children())
            radice_ = a.insert("", "end", iid="__finestra__", text=f"▣  {se_stesso.form.nome}", open=Vero)
            messi = set()

            definisci aggiungi(chiave_padre, iid_padre):
                per c in se_stesso.form.componenti:
                    se c.genitore != chiave_padre o c.nome in messi:
                        continua
                    messi.add(c.nome)
                    a.insert(iid_padre, "end", iid=c.nome, text=f"{TIPI[c.tipo]['icona']}  {c.nome}", open=Vero)
                    se c.tipo == "Schede":
                        titoli = lista(c.valori.get("pagine", []))
                        per i, chiave in enumera(form_modello.pagine_di(c)):
                            a.insert(c.nome, "end", iid=chiave, text="▤  " + (titoli[i] se i < lunghezza(titoli) altrimenti f"Pagina {i + 1}"), open=Vero)
                            aggiungi(chiave, chiave)
                    altrimenti_se e_contenitore(c.tipo):
                        aggiungi(c.nome, c.nome)
            aggiungi("", radice_)
            per c in se_stesso.form.componenti:          # componenti il cui contenitore non esiste più: si vedono comunque
                se c.nome non in messi:
                    a.insert(radice_, "end", iid=c.nome, text=f"{TIPI[c.tipo]['icona']}  {c.nome}")
        eccetto tk.TclError:
            passa
        se_stesso._sincronizza_albero()

    definisci _sincronizza_albero(se_stesso):
        a = getattr(se_stesso, "albero", Nessuno)
        se a è Nessuno:
            ritorna
        prova:
            presenti = [n per n in se_stesso.selezione_ se a.exists(n)]
            se set(a.selection()) != set(presenti):
                a.selection_set(presenti)
            se presenti:
                a.see(presenti[0])
        eccetto tk.TclError:
            passa

    definisci _albero_selezione(se_stesso, ev=Nessuno):
        scelti = [i per i in se_stesso.albero.selection() se se_stesso.form.trova(i)]
        se set(scelti) != set(se_stesso.selezione_):
            se_stesso.seleziona(scelti)

    definisci _albero_doppio(se_stesso, ev):
        i = se_stesso.albero.identify_row(ev.y)
        se i e se_stesso.form.trova(i):
            se_stesso._doppio(ev, i)
        ritorna "break"

    definisci _albero_menu(se_stesso, ev):
        i = se_stesso.albero.identify_row(ev.y)
        se i e se_stesso.form.trova(i):
            se i non in se_stesso.selezione_:
                se_stesso.seleziona([i])
            se_stesso._menu(ev, i)
        altrimenti_se i == "__finestra__":
            se_stesso._menu(ev, Nessuno)

    definisci _albero_premi(se_stesso, ev):
        i = se_stesso.albero.identify_row(ev.y)
        se_stesso._albero_trascina = {"item": i, "mosso": Falso} se i e se_stesso.form.trova(i) altrimenti Nessuno

    definisci _chiave_contenitore(se_stesso, iid):
        """Dove finisce un componente rilasciato sulla riga `iid` dell'albero: la finestra, un riquadro, una pagina; su un componente normale, il suo contenitore."""
        se iid == "__finestra__":
            ritorna ""
        se "#" in iid:
            ritorna iid
        c = se_stesso.form.trova(iid)
        se c è Nessuno:
            ritorna Nessuno
        se c.tipo == "Schede":
            ritorna f"{iid}#0"
        se e_contenitore(c.tipo):
            ritorna iid
        ritorna c.genitore

    definisci _albero_muovi(se_stesso, ev):
        d = se_stesso._albero_trascina
        se non d:
            ritorna
        d["mosso"] = Vero
        se_stesso.albero.configure(cursor="hand2")
        chiave = se_stesso._chiave_contenitore(se_stesso.albero.identify_row(ev.y))
        c = se_stesso.form.trova(d["item"])
        se chiave è non Nessuno e c è non Nessuno e chiave != c.genitore:
            se_stesso.stato.configure(text="Rilascia per spostarlo " + ("nella finestra" se chiave == "" altrimenti f"dentro «{chiave.split('#')[0]}»"))

    definisci _albero_rilascia(se_stesso, ev):
        d = se_stesso._albero_trascina
        se_stesso._albero_trascina = Nessuno
        se_stesso.albero.configure(cursor="")
        se non d o non d["mosso"]:
            ritorna
        chiave = se_stesso._chiave_contenitore(se_stesso.albero.identify_row(ev.y))
        se chiave è Nessuno:
            ritorna
        nomi = lista(se_stesso.selezione_) se d["item"] in se_stesso.selezione_ altrimenti [d["item"]]
        se_stesso.sposta_in(nomi, chiave)

    definisci _con_discendenti(se_stesso, nomi):
        esclusi = set(nomi)
        cambiato = Vero
        mentre cambiato:
            cambiato = Falso
            per c in se_stesso.form.componenti:
                se c.nome non in esclusi e c.genitore.split("#")[0] in esclusi:
                    esclusi.add(c.nome)
                    cambiato = Vero
        ritorna esclusi

    definisci sposta_in(se_stesso, nomi, chiave):
        """Mette i componenti nel contenitore `chiave` ('' = finestra, 'riquadro1', 'schede1#0') tenendo, per quanto entra, la posizione che avevano
        (se il contenitore è a griglia vanno nella prima cella libera). Ritorna Falso se non si può (un riquadro dentro se stesso)."""
        f = se_stesso.form
        se chiave.split("#")[0] in se_stesso._con_discendenti(nomi):
            ritorna Falso
        se chiave:
            padre = f.trova(chiave.split("#")[0])
            se padre è Nessuno:
                ritorna Falso
            L, H = padre.larghezza, padre.altezza
            se padre.tipo == "Schede":
                L, H = L - form_modello.AREA_PAGINA[0], H - form_modello.AREA_PAGINA[1]
            altrimenti:
                b = int(padre.valori.get("bordo", 0) o 0)
                L, H = L - 2 * b, H - 2 * b
        altrimenti:
            L, H = f.larghezza, f.altezza
        spostati = []
        per n in nomi:
            c = f.trova(n)
            se c è Nessuno o c.genitore == chiave:
                continua
            c.genitore = chiave
            c.x = max(0, min(c.x, L - c.larghezza))
            c.y = max(0, min(c.y, H - c.altezza))
            se_stesso._cella_nuova(c, Nessuno)
            spostati.append(n)
        se non spostati:
            ritorna Falso
        se_stesso.ricostruisci()
        se_stesso.seleziona(spostati)
        se_stesso._registra()
        ritorna Vero

    definisci _padre_widget(se_stesso, c):
        """Il widget dentro cui sta il componente: la superficie, un riquadro o la pagina di una Schede."""
        se non c.genitore:
            ritorna se_stesso.superficie
        nome, _, indice = c.genitore.partition("#")
        w = se_stesso.widget.get(nome)
        se w è Nessuno:
            ritorna se_stesso.superficie
        se indice e hasattr(w, "_pagine") e int(indice) < lunghezza(w._pagine):
            ritorna w._pagine[int(indice)]
        ritorna w

    definisci _crea(se_stesso, c):
        w = crea_widget_di_progetto(c, se_stesso._padre_widget(c), se_stesso.cartella)
        x_, y_, l_, a_ = se_stesso._geom(c)
        w.place(x=x_, y=y_, width=l_, height=a_)
        se_stesso._rivesti(w, c)
        per sequenza, funzione in (("<ButtonPress-1>", se_stesso._premi), ("<B1-Motion>", se_stesso._trascina),
                                   ("<ButtonRelease-1>", se_stesso._rilascia), ("<Double-Button-1>", se_stesso._doppio),
                                   ("<Button-3>", se_stesso._menu_widget)):
            w.bind(sequenza, lambda e, n=c.nome, f=funzione: f(e, n))
            per pagina in getattr(w, "_pagine", []):
                pagina.bind(sequenza, lambda e, n=c.nome, f=funzione: f(e, n))
        se_stesso.widget[c.nome] = w
        ritorna w

    definisci _aggiorna_widget(se_stesso, c):
        se e_contenitore(c.tipo):
            se_stesso.ricostruisci()          # i componenti dentro vanno ricreati insieme al contenitore
            ritorna
        vecchio = se_stesso.widget.pop(c.nome, Nessuno)
        se vecchio:
            vecchio.destroy()
        se_stesso._crea(c)
        se_stesso._aggiorna_maniglie()

    # ------------------------------------------------------------ selezione e maniglie
    definisci seleziona(se_stesso, nomi, aggiungi=Falso):
        se aggiungi:
            nomi = lista(dict.fromkeys(se_stesso.selezione_ + lista(nomi)))
        se_stesso.selezione_ = [n per n in nomi se se_stesso.form.trova(n)]
        se_stesso._sincronizza_albero()
        se_stesso._aggiorna_maniglie()
        se_stesso._riempi_ispettore()
        se_stesso._aggiorna_stato()

    definisci _riposiziona_maniglie(se_stesso):
        """Sposta contorno e maniglie senza ricrearli: durante il trascinamento la maniglia afferrata deve restare viva,
        altrimenti il mouse non le manda più i movimenti e il ridimensionamento si ferma dopo il primo passo."""
        bordi = getattr(se_stesso, "_bordi", {})
        pomelli = getattr(se_stesso, "_pomelli", {})
        se lista(bordi) != lista(se_stesso.selezione_) o (lunghezza(se_stesso.selezione_) == 1 e lunghezza(pomelli) != lunghezza(MANIGLIE)):
            se_stesso._aggiorna_maniglie()
            ritorna
        per nome, bordo in bordi.items():
            c = se_stesso.form.trova(nome)
            se c:
                x_, y_, l_, a_ = se_stesso._geom(c)
                bordo.place_configure(x=x_ - 1, y=y_ - 1, width=l_ + 2, height=a_ + 2)
        se pomelli e lunghezza(se_stesso.selezione_) == 1:
            c = se_stesso.form.trova(se_stesso.selezione_[0])
            x_, y_, l_, a_ = se_stesso._geom(c)
            per chiave, (cursore, ax, ay) in MANIGLIE.items():
                pomelli[chiave].place_configure(x=x_ + int(l_ * ax) - 4, y=y_ + int(a_ * ay) - 4)

    definisci _aggiorna_maniglie(se_stesso):
        per m in se_stesso.maniglie:
            m.destroy()
        se_stesso.maniglie = []
        se_stesso._bordi = {}
        se_stesso._pomelli = {}
        per nome in se_stesso.selezione_:
            c = se_stesso.form.trova(nome)
            w = se_stesso.widget.get(nome)
            se non c o non w:
                continua
            x_, y_, l_, a_ = se_stesso._geom(c)
            # contorno di selezione
            bordo = tk.Frame(se_stesso._padre_widget(c), background=se_stesso.colori["accento"])
            per lato in ("n", "s", "e", "o"):
                passa
            se_stesso.maniglie.append(bordo)
            se_stesso._bordi[nome] = bordo
            bordo.place(x=x_ - 1, y=y_ - 1, width=l_ + 2, height=a_ + 2)
            bordo.tk.call("lower", bordo._w, w._w)
            w.tk.call("raise", w._w)
            se lunghezza(se_stesso.selezione_) == 1:
                per chiave, (cursore, ax, ay) in MANIGLIE.items():
                    m = tk.Frame(se_stesso._padre_widget(c), background=se_stesso.colori["accento"], width=8, height=8,
                                 cursor=cursore, borderwidth=1, relief="solid")
                    m.place(x=x_ + int(l_ * ax) - 4, y=y_ + int(a_ * ay) - 4)
                    m.bind("<ButtonPress-1>", lambda e, k=chiave, n=nome: se_stesso._inizia_ridimensiona(e, k, n))
                    m.bind("<B1-Motion>", se_stesso._ridimensiona)
                    m.bind("<ButtonRelease-1>", se_stesso._fine_ridimensiona)
                    se_stesso.maniglie.append(m)
                    se_stesso._pomelli[chiave] = m
                    m.tk.call("raise", m._w)

    definisci _aggiorna_stato(se_stesso):
        se non se_stesso.selezione_:
            se_stesso.stato.configure(text=f"{lunghezza(se_stesso.form.componenti)} componenti")
        altrimenti_se lunghezza(se_stesso.selezione_) == 1:
            c = se_stesso.form.trova(se_stesso.selezione_[0])
            x_, y_, l_, a_ = se_stesso._geom(c)
            se c.nome in getattr(se_stesso, "_rett", {}):
                k = form_modello.cella_di(c)
                se_stesso.stato.configure(text=f"{c.nome}  riga={k['riga']} colonna={k['colonna']}  {l_}×{a_}")
            altrimenti:
                se_stesso.stato.configure(text=f"{c.nome}  x={c.x} y={c.y}  {c.larghezza}×{c.altezza}")
        altrimenti:
            se_stesso.stato.configure(text=f"{lunghezza(se_stesso.selezione_)} selezionati")

    # ------------------------------------------------------------ palette
    definisci _palette_scelta(se_stesso, e=Nessuno):
        sel = se_stesso.elenco_palette.curselection()
        se sel:
            se_stesso.da_aggiungere = ORDINE_PALETTE[sel[0]]
            se_stesso.superficie.configure(cursor="crosshair")
            se_stesso.suggerimento.configure(text=f"Clicca sulla finestra per inserire: {se_stesso.da_aggiungere}")

    definisci _palette_doppio(se_stesso, e=Nessuno):
        sel = se_stesso.elenco_palette.curselection()
        se sel:
            n = lunghezza(se_stesso.form.componenti)
            se_stesso.aggiungi_componente(ORDINE_PALETTE[sel[0]], 20 + (n % 8) * 16, 20 + (n % 8) * 16)
            se_stesso._annulla_aggiunta()

    definisci _annulla_aggiunta(se_stesso):
        se_stesso.da_aggiungere = Nessuno
        se_stesso.superficie.configure(cursor="arrow")
        se_stesso.elenco_palette.selection_clear(0, "end")
        se_stesso.suggerimento.configure(text="Scegli un componente e clicca sulla finestra, oppure fai doppio clic.")

    definisci aggiungi_componente(se_stesso, tipo_, x, y, **valori):
        c = se_stesso.form.aggiungi(tipo_, se_stesso._aggancia(x), se_stesso._aggancia(y), **valori)
        se_stesso._cella_nuova(c, x, y)
        se_stesso._crea(c)
        se_stesso._registra()
        se_stesso.seleziona([c.nome])
        ritorna c

    definisci _destinazione(se_stesso, e, nome):
        """(genitore, x, y) dove inserire un nuovo componente cliccando sul componente «nome»."""
        c = se_stesso.form.trova(nome)
        w = se_stesso.widget.get(nome)
        se c è non Nessuno e w è non Nessuno e e_contenitore(c.tipo):
            se c.tipo == "Schede":
                pagine = getattr(w, "_pagine", [])
                prova:
                    indice = w.index(w.select())
                eccetto tk.TclError:
                    indice = 0
                se pagine:
                    pagina = pagine[min(indice, lunghezza(pagine) - 1)]
                    ritorna f"{nome}#{min(indice, lunghezza(pagine) - 1)}", e.x_root - pagina.winfo_rootx(), e.y_root - pagina.winfo_rooty()
            altrimenti:
                ritorna nome, e.x_root - w.winfo_rootx(), e.y_root - w.winfo_rooty()
        se c è non Nessuno e c.genitore:
            padre = se_stesso._padre_widget(c)
            ritorna c.genitore, e.x_root - padre.winfo_rootx(), e.y_root - padre.winfo_rooty()
        ritorna "", e.x_root - se_stesso.superficie.winfo_rootx(), e.y_root - se_stesso.superficie.winfo_rooty()

    definisci _aggancia(se_stesso, v):
        se se_stesso.griglia_attiva.get():
            ritorna int(round(v / GRIGLIA) * GRIGLIA)
        ritorna int(v)

    # ------------------------------------------------------------ mouse
    definisci _clic_superficie(se_stesso, e):
        se_stesso.focus_set()
        se se_stesso.da_aggiungere:
            se_stesso.aggiungi_componente(se_stesso.da_aggiungere, e.x, e.y)
            se_stesso._annulla_aggiunta()
        altrimenti:
            base = lista(se_stesso.selezione_) se e.state & 0x1 altrimenti []       # Maiusc: il rettangolo si aggiunge alla selezione
            se non base:
                se_stesso.seleziona([])
            se_stesso._lazo = {"x": e.x, "y": e.y, "base": base, "ultimi": Nessuno}

    definisci _trascina_lazo(se_stesso, e):
        """Rettangolo di selezione: trascinando su uno spazio vuoto si selezionano i componenti (della finestra) che il rettangolo tocca."""
        z = se_stesso._lazo
        se non z:
            ritorna
        s = se_stesso.superficie
        s.delete("lazo")
        s.create_rectangle(z["x"], z["y"], e.x, e.y, outline=se_stesso.colori["accento"], dash=(3, 3), tags="lazo")
        x0, x1 = sorted((z["x"], e.x))
        y0, y1 = sorted((z["y"], e.y))
        toccati = []
        per c in se_stesso.form.componenti:
            se c.genitore o c.nome non in se_stesso.widget:
                continua
            x, y, l, a = se_stesso._geom(c)
            se x < x1 e x + l > x0 e y < y1 e y + a > y0:
                toccati.append(c.nome)
        nuovi = lista(dict.fromkeys(z["base"] + toccati))
        se nuovi != z["ultimi"]:
            z["ultimi"] = nuovi
            se_stesso.seleziona(nuovi)

    definisci _fine_lazo(se_stesso, e=Nessuno):
        se_stesso.superficie.delete("lazo")
        se_stesso._lazo = Nessuno

    definisci _premi(se_stesso, e, nome):
        se_stesso.focus_set()
        se se_stesso.da_aggiungere:
            # inserisce nella posizione del puntatore: dentro il contenitore cliccato (o accanto al componente cliccato)
            genitore, x, y = se_stesso._destinazione(e, nome)
            se_stesso.aggiungi_componente(se_stesso.da_aggiungere, x, y, genitore=genitore)
            se_stesso._annulla_aggiunta()
            ritorna "break"
        se e.state & 0x1:       # Maiusc: aggiunge/toglie dalla selezione
            se nome in se_stesso.selezione_:
                se_stesso.seleziona([n per n in se_stesso.selezione_ se n != nome])
            altrimenti:
                se_stesso.seleziona([nome], aggiungi=Vero)
        altrimenti_se nome non in se_stesso.selezione_:
            se_stesso.seleziona([nome])
        se_stesso._trascinamento = {
            "x": e.x_root, "y": e.y_root,
            "inizio": {n: (se_stesso.form.trova(n).x, se_stesso.form.trova(n).y) per n in se_stesso.selezione_},
            "schermo": {n: (se_stesso.widget[n].winfo_rootx(), se_stesso.widget[n].winfo_rooty()) per n in se_stesso.selezione_ se n in se_stesso.widget},
            "mosso": Falso}
        ritorna "break"

    definisci _trascina(se_stesso, e, nome):
        d = se_stesso._trascinamento
        se non d:
            ritorna "break"
        dx, dy = e.x_root - d["x"], e.y_root - d["y"]
        se abs(dx) + abs(dy) < 3 e non d["mosso"]:
            ritorna "break"
        d["mosso"] = Vero
        se nome in getattr(se_stesso, "_rett", {}):
            # in una griglia non si sposta in pixel: si sceglie la cella (evidenziata) e si lascia il mouse
            c = se_stesso.form.trova(nome)
            padre = se_stesso._padre_widget(c)
            prova:
                bordo = int(str(padre.cget("borderwidth")))
            eccetto (tk.TclError, ValueError):
                bordo = 0
            riga, colonna = se_stesso._cella_a(c.genitore, e.x_root - padre.winfo_rootx() - bordo, e.y_root - padre.winfo_rooty() - bordo)
            d["cella"] = (riga, colonna)
            se_stesso._evidenzia_cella(c.genitore, riga, colonna, padre)
            se_stesso._suggerisci_rilascio(e, d)
            ritorna "break"
        per n, (x0, y0) in d["inizio"].items():
            c = se_stesso.form.trova(n)
            se n in getattr(se_stesso, "_rett", {}):
                continua
            c.x = max(0, se_stesso._aggancia(x0 + dx))
            c.y = max(0, se_stesso._aggancia(y0 + dy))
            se_stesso.widget[n].place_configure(x=c.x, y=c.y)
        se_stesso._riposiziona_maniglie()
        se_stesso._aggiorna_stato()
        se_stesso._suggerisci_rilascio(e, d)
        ritorna "break"

    # ------------------------------------------------------------ spostare un componente dentro o fuori da un contenitore
    definisci _contenitore_sotto(se_stesso, e, spostati):
        """Il contenitore sotto il puntatore: ('', widget) = la finestra, ('riquadro1', widget) = un riquadro, ('schede1#0', pagina) = una pagina di schede;
        Nessuno se il puntatore è fuori dalla finestra. Non vale un componente che si sta spostando né quelli dentro di lui."""
        s = se_stesso.superficie
        se non (s.winfo_rootx() <= e.x_root < s.winfo_rootx() + s.winfo_width() e s.winfo_rooty() <= e.y_root < s.winfo_rooty() + s.winfo_height()):
            ritorna Nessuno
        esclusi = se_stesso._con_discendenti(spostati)
        per c in reversed(form_modello.ordine_creazione(se_stesso.form)):
            w = se_stesso.widget.get(c.nome)
            se non e_contenitore(c.tipo) o c.nome in esclusi o w è Nessuno:
                continua
            chiave, area = c.nome, w
            se c.tipo == "Schede":
                pagine = getattr(w, "_pagine", [])
                se non pagine:
                    continua
                prova:
                    indice = min(w.index(w.select()), lunghezza(pagine) - 1)
                eccetto tk.TclError:
                    indice = 0
                chiave, area = f"{c.nome}#{indice}", pagine[indice]
            prova:
                dentro = area.winfo_ismapped() e area.winfo_rootx() <= e.x_root < area.winfo_rootx() + area.winfo_width() e area.winfo_rooty() <= e.y_root < area.winfo_rooty() + area.winfo_height()
            eccetto tk.TclError:
                dentro = Falso
            se dentro:
                ritorna chiave, area
        ritorna "", s

    definisci _suggerisci_rilascio(se_stesso, e, d):
        """Durante il trascinamento: nella barra di stato dice dove finirà il componente se cambia contenitore."""
        c = se_stesso.form.trova(se_stesso.selezione_[0]) se se_stesso.selezione_ altrimenti Nessuno
        bersaglio = se_stesso._contenitore_sotto(e, d["inizio"])
        se c è non Nessuno e bersaglio è non Nessuno e bersaglio[0] != c.genitore:
            se_stesso.stato.configure(text="Rilascia per spostarlo " + ("nella finestra" se bersaglio[0] == "" altrimenti f"dentro «{bersaglio[0].split('#')[0]}»"))

    definisci sposta_in_contenitore(se_stesso, nomi, chiave, x_puntatore, y_puntatore, schermo, dx, dy):
        """Mette i componenti nel contenitore `chiave` ('' = finestra, 'riquadro1', 'schede1#0'), mantenendoli dov'erano sullo schermo (o nella cella sotto il puntatore, se il contenitore è a griglia)."""
        bersaglio = se_stesso.superficie se non chiave altrimenti (se_stesso.widget[chiave] se chiave in se_stesso.widget altrimenti Nessuno)
        se "#" in chiave:
            pagine = getattr(se_stesso.widget.get(chiave.split("#")[0]), "_pagine", [])
            bersaglio = pagine[int(chiave.split("#")[1])] se pagine altrimenti Nessuno
        se bersaglio è Nessuno:
            ritorna Falso
        prova:
            bordo = 0 se non chiave altrimenti int(str(bersaglio.cget("borderwidth")))
        eccetto (tk.TclError, ValueError):
            bordo = 0
        per n in nomi:
            c = se_stesso.form.trova(n)
            sx, sy = schermo.get(n, (bersaglio.winfo_rootx(), bersaglio.winfo_rooty()))
            c.genitore = chiave
            c.x = max(0, se_stesso._aggancia(sx + dx - bersaglio.winfo_rootx() - bordo))
            c.y = max(0, se_stesso._aggancia(sy + dy - bersaglio.winfo_rooty() - bordo))
            se_stesso._cella_nuova(c, x_puntatore - bersaglio.winfo_rootx() - bordo, y_puntatore - bersaglio.winfo_rooty() - bordo)
        se_stesso.ricostruisci()
        se_stesso.seleziona(lista(nomi))
        se_stesso._registra()
        ritorna Vero

    definisci _rilascia(se_stesso, e, nome):
        d = se_stesso._trascinamento
        se_stesso._trascinamento = Nessuno
        se_stesso._togli_evidenza()
        se d e d["mosso"]:
            c_ = se_stesso.form.trova(nome)
            bersaglio = se_stesso._contenitore_sotto(e, d["inizio"])
            se c_ è non Nessuno e bersaglio è non Nessuno e bersaglio[0] != c_.genitore:
                se_stesso.sposta_in_contenitore(lista(d["inizio"]), bersaglio[0], e.x_root, e.y_root, d["schermo"], e.x_root - d["x"], e.y_root - d["y"])
                se_stesso._riempi_ispettore()
                ritorna "break"
            se d.get("cella") e nome in getattr(se_stesso, "_rett", {}):
                form_modello.imposta_cella(se_stesso.form.trova(nome), riga=d["cella"][0], colonna=d["cella"][1])
                se_stesso._rilayout()
            se_stesso._registra()
            se_stesso._riempi_ispettore()
        ritorna "break"

    definisci _doppio(se_stesso, e, nome):
        c = se_stesso.form.trova(nome)
        per k, (t, d, desc) in proprieta_di(c.tipo).items():
            se t == "evento":
                se_stesso.vai_al_gestore(c, k)
                ritorna "break"
        ritorna "break"

    definisci _inizia_ridimensiona(se_stesso, e, maniglia, nome):
        c = se_stesso.form.trova(nome)
        se_stesso._ridim = {"m": maniglia, "nome": nome, "x": e.x_root, "y": e.y_root,
                            "geom": se_stesso._geom(c)}
        ritorna "break"

    definisci _ridimensiona(se_stesso, e):
        r = getattr(se_stesso, "_ridim", Nessuno)
        se non r:
            ritorna "break"
        c = se_stesso.form.trova(r["nome"])
        x, y, w, h = r["geom"]
        dx, dy = e.x_root - r["x"], e.y_root - r["y"]
        m = r["m"]
        se "e" in m:
            w = max(8, se_stesso._aggancia(w + dx))
        se "o" in m:
            nuovo_x = se_stesso._aggancia(x + dx)
            w = max(8, w + (x - nuovo_x))
            x = x + (r["geom"][2] - w)
        se "s" in m:
            h = max(4, se_stesso._aggancia(h + dy))
        altrimenti_se "n" in m:
            nuovo_y = se_stesso._aggancia(y + dy)
            h = max(4, h + (y - nuovo_y))
            y = y + (r["geom"][3] - h)
        se c.nome in getattr(se_stesso, "_rett", {}):
            # in una griglia la misura disegnata è quella propria del componente (conta se non riempie la cella)
            c.larghezza, c.altezza = w, h
            se_stesso._rilayout()
            ritorna "break"
        c.x, c.y, c.larghezza, c.altezza = max(0, x), max(0, y), w, h
        se_stesso.widget[c.nome].place_configure(x=c.x, y=c.y, width=c.larghezza, height=c.altezza)
        se_stesso._riposiziona_maniglie()
        se_stesso._aggiorna_stato()
        ritorna "break"

    definisci _fine_ridimensiona(se_stesso, e):
        se getattr(se_stesso, "_ridim", Nessuno):
            se_stesso._ridim = Nessuno
            se_stesso._registra()
            se_stesso._riempi_ispettore()
        ritorna "break"

    # ------------------------------------------------------------ tastiera
    definisci _tasto_elimina(se_stesso, e):
        prova:
            se non se_stesso.winfo_exists() o non se_stesso.winfo_ismapped():
                ritorna
            f = se_stesso.focus_get()
            se f è non Nessuno e f.winfo_class() non in ("Entry", "Text", "TEntry", "TCombobox", "Listbox"):
                se_stesso.elimina_selezionati()
        eccetto (tk.TclError, KeyError):
            passa

    definisci sposta_selezione(se_stesso, dx, dy):
        per n in se_stesso.selezione_:
            c = se_stesso.form.trova(n)
            se n in getattr(se_stesso, "_rett", {}):
                k = form_modello.cella_di(c)
                form_modello.imposta_cella(c, riga=k["riga"] + (dy > 0) - (dy < 0), colonna=k["colonna"] + (dx > 0) - (dx < 0))
                continua
            c.x = max(0, c.x + dx)
            c.y = max(0, c.y + dy)
            se_stesso.widget[n].place_configure(x=c.x, y=c.y)
        se_stesso._rilayout()
        se_stesso._aggiorna_maniglie()
        se_stesso._aggiorna_stato()
        se_stesso._registra()
        se_stesso._riempi_ispettore()

    # ------------------------------------------------------------ menu
    definisci _menu_widget(se_stesso, e, nome):
        se nome non in se_stesso.selezione_:
            se_stesso.seleziona([nome])
        se_stesso._menu(e, nome)
        ritorna "break"

    definisci _menu(se_stesso, e, nome):
        m = tk.Menu(se_stesso, tearoff=0)
        se nome:
            c = se_stesso.form.trova(nome)
            m.add_command(label=f"Vai al gestore dell'evento", command=lambda: se_stesso._doppio(e, nome))
            m.add_command(label="Duplica", command=se_stesso.duplica)
            m.add_command(label="Porta in primo piano", command=lambda: se_stesso.ordine(Vero))
            m.add_command(label="Porta in secondo piano", command=lambda: se_stesso.ordine(Falso))
            m.add_separator()
            m.add_command(label="Elimina", command=se_stesso.elimina_selezionati)
        altrimenti:
            m.add_command(label="Incolla", command=se_stesso.incolla)
            m.add_command(label="Proprietà della finestra", command=lambda: se_stesso.seleziona([]))
        m.tk_popup(e.x_root, e.y_root)

    # ------------------------------------------------------------ operazioni sul modello
    definisci _registra(se_stesso):
        """Salva uno stato nella cronologia (per annulla/ripeti) e segna il form modificato."""
        stato_ = se_stesso.form.a_json()
        se stato_ == se_stesso.cronologia[se_stesso.indice_cronologia]:
            ritorna
        elimina se_stesso.cronologia[se_stesso.indice_cronologia + 1:]
        se_stesso.cronologia.append(stato_)
        se lunghezza(se_stesso.cronologia) > 120:
            se_stesso.cronologia.pop(0)
        se_stesso.indice_cronologia = lunghezza(se_stesso.cronologia) - 1
        se_stesso._segna_modificato(Vero)
        se_stesso._aggiorna_albero()
        se_stesso._anteprima_dal_vivo()

    definisci _anteprima_dal_vivo(se_stesso):
        """Se la finestra è in prova (▶ Prova) la riavvia poco dopo l'ultima modifica, così l'anteprima segue il progettista."""
        se non getattr(se_stesso.azioni, "prova_in_corso", Nessuno) o non se_stesso.azioni.prova_in_corso(se_stesso.percorso_logica()):
            ritorna
        se getattr(se_stesso, "_lavoro_prova", Nessuno):
            se_stesso.after_cancel(se_stesso._lavoro_prova)
        se_stesso._lavoro_prova = se_stesso.after(800, se_stesso._riavvia_prova)

    definisci _riavvia_prova(se_stesso):
        se_stesso._lavoro_prova = Nessuno
        prova:
            se se_stesso.azioni.prova_in_corso(se_stesso.percorso_logica()):
                se_stesso.salva()
                se_stesso.azioni.riavvia_prova(se_stesso.percorso_logica())
        eccetto (tk.TclError, OSError):
            passa

    definisci _segna_modificato(se_stesso, valore):
        se se_stesso.modificato != valore:
            se_stesso.modificato = valore
            se_stesso.azioni.scheda_modificata(se_stesso)

    definisci annulla(se_stesso):
        se se_stesso.indice_cronologia > 0:
            se_stesso.indice_cronologia -= 1
            se_stesso._ripristina()

    definisci ripeti(se_stesso):
        se se_stesso.indice_cronologia < lunghezza(se_stesso.cronologia) - 1:
            se_stesso.indice_cronologia += 1
            se_stesso._ripristina()

    definisci _ripristina(se_stesso):
        nomi = lista(se_stesso.selezione_)
        se_stesso.form = Form.da_json(se_stesso.cronologia[se_stesso.indice_cronologia])
        se_stesso.ricostruisci()
        se_stesso.seleziona([n per n in nomi se se_stesso.form.trova(n)])
        se_stesso._segna_modificato(Vero)
        se_stesso._aggiorna_albero()
        se_stesso._anteprima_dal_vivo()

    definisci elimina_selezionati(se_stesso):
        se non se_stesso.selezione_:
            ritorna
        per n in lista(se_stesso.selezione_):
            se_stesso.form.rimuovi(n)
            w = se_stesso.widget.pop(n, Nessuno)
            se w:
                prova:
                    w.destroy()
                eccetto tk.TclError:
                    passa
        se_stesso.widget = {k: v per k, v in se_stesso.widget.items() se se_stesso.form.trova(k)}      # tolti anche i componenti che stavano dentro
        se_stesso.selezione_ = []
        se_stesso._rilayout()
        se_stesso._registra()
        se_stesso.seleziona([])

    definisci duplica(se_stesso):
        nuovi = []
        per n in se_stesso.selezione_:
            c = se_stesso.form.trova(n)
            d = c.a_dizionario()
            d["nome"] = se_stesso.form.nome_libero(c.tipo)
            d["x"] += 16
            d["y"] += 16
            nuovo = form_modello.Componente.da_dizionario(d)
            se_stesso.form.componenti.append(nuovo)
            se_stesso._cella_nuova(nuovo, Nessuno)
            se_stesso._crea(nuovo)
            nuovi.append(nuovo.nome)
        se nuovi:
            se_stesso._registra()
            se_stesso.seleziona(nuovi)

    definisci copia(se_stesso):
        se_stesso.appunti = [se_stesso.form.trova(n).a_dizionario() per n in se_stesso.selezione_]

    definisci incolla(se_stesso):
        nuovi = []
        per d in se_stesso.appunti:
            d = copy.deepcopy(d)
            d["nome"] = se_stesso.form.nome_libero(d["tipo"])
            d["x"] += 16
            d["y"] += 16
            nuovo = form_modello.Componente.da_dizionario(d)
            se_stesso.form.componenti.append(nuovo)
            se_stesso._cella_nuova(nuovo, Nessuno)
            se_stesso._crea(nuovo)
            nuovi.append(nuovo.nome)
        se nuovi:
            se_stesso._registra()
            se_stesso.seleziona(nuovi)

    definisci ordine(se_stesso, avanti):
        per n in se_stesso.selezione_:
            c = se_stesso.form.trova(n)
            se_stesso.form.componenti.remove(c)
            se avanti:
                se_stesso.form.componenti.append(c)
                w_ = se_stesso.widget[n]
                w_.tk.call("raise", w_._w)
            altrimenti:
                se_stesso.form.componenti.insert(0, c)
                w_ = se_stesso.widget[n]
                w_.tk.call("lower", w_._w)
        se_stesso._aggiorna_maniglie()
        se_stesso._registra()

    definisci modifica_ordine(se_stesso):
        """Finestra per cambiare l'ordine dei componenti (e quindi del tasto Tab)."""
        nuovo = DialogoOrdine(se_stesso, se_stesso.colori, [c.nome per c in se_stesso.form.componenti]).mostra()
        se nuovo:
            se_stesso.imposta_ordine(nuovo)

    definisci imposta_ordine(se_stesso, nomi):
        """Rimette i componenti nell'ordine dato (lista di nomi) e ridisegna la finestra."""
        per_nome = {c.nome: c per c in se_stesso.form.componenti}
        se set(nomi) != set(per_nome):
            ritorna
        se_stesso.form.componenti = [per_nome[n] per n in nomi]
        se_stesso.ricostruisci()
        se_stesso._registra()

    definisci allinea(se_stesso, modo):
        comp = [se_stesso.form.trova(n) per n in se_stesso.selezione_]
        se lunghezza(comp) < 1:
            ritorna
        se modo in ("centro_x", "centro_y") e lunghezza(comp) == 1:
            c = comp[0]
            se modo == "centro_x":
                c.x = (se_stesso.form.larghezza - c.larghezza) // 2
            altrimenti:
                c.y = (se_stesso.form.altezza - c.altezza) // 2
        altrimenti_se lunghezza(comp) >= 2:
            se modo == "sinistra":
                x = min(c.x per c in comp)
                per c in comp: c.x = x
            altrimenti_se modo == "destra":
                x = max(c.x + c.larghezza per c in comp)
                per c in comp: c.x = x - c.larghezza
            altrimenti_se modo == "alto":
                y = min(c.y per c in comp)
                per c in comp: c.y = y
            altrimenti_se modo == "basso":
                y = max(c.y + c.altezza per c in comp)
                per c in comp: c.y = y - c.altezza
            altrimenti_se modo == "centro_x":
                m = sum(c.x + c.larghezza / 2 per c in comp) / lunghezza(comp)
                per c in comp: c.x = int(m - c.larghezza / 2)
            altrimenti_se modo == "centro_y":
                m = sum(c.y + c.altezza / 2 per c in comp) / lunghezza(comp)
                per c in comp: c.y = int(m - c.altezza / 2)
            altrimenti_se modo == "stessa_larghezza":
                per c in comp: c.larghezza = comp[0].larghezza
            altrimenti_se modo == "stessa_altezza":
                per c in comp: c.altezza = comp[0].altezza
            altrimenti_se modo == "distribuisci_x" e lunghezza(comp) >= 3:
                ordinati = sorted(comp, key=lambda c: c.x)
                spazio = (ordinati[-1].x - ordinati[0].x) / (lunghezza(ordinati) - 1)
                per i, c in enumera(ordinati): c.x = int(ordinati[0].x + i * spazio)
            altrimenti_se modo == "distribuisci_y" e lunghezza(comp) >= 3:
                ordinati = sorted(comp, key=lambda c: c.y)
                spazio = (ordinati[-1].y - ordinati[0].y) / (lunghezza(ordinati) - 1)
                per i, c in enumera(ordinati): c.y = int(ordinati[0].y + i * spazio)
        per c in comp:
            se_stesso.widget[c.nome].place_configure(x=c.x, y=c.y, width=c.larghezza, height=c.altezza)
        se_stesso._aggiorna_maniglie()
        se_stesso._registra()
        se_stesso._riempi_ispettore()

    # ------------------------------------------------------------ ispettore
    definisci _svuota_ispettore(se_stesso):
        per w in se_stesso.righe_ispettore.winfo_children():
            w.destroy()

    definisci _aggiorna_limiti_geometria(se_stesso, c):
        """Quando cambia una misura, i limiti delle altre (x dipende dalla larghezza...) si aggiornano senza ricreare i campi."""
        per attributo, sp in getattr(se_stesso, "_spin_geometria", {}).items():
            prova:
                minimo, massimo = se_stesso.limiti_geometria(c, attributo)
                sp.configure(from_=minimo, to=massimo)
            eccetto tk.TclError:
                passa

    definisci _riempi_ispettore(se_stesso):
        se_stesso._svuota_ispettore()
        se_stesso._spin_geometria = {}
        c_ = se_stesso.colori
        riga = [0]

        definisci aggiungi_riga(etichetta, costruttore):
            tk.Label(se_stesso.righe_ispettore, text=etichetta, anchor="w", background=c_["pannello"],
                     foreground=c_["tenue"], wraplength=96, justify="left").grid(row=riga[0], column=0, sticky="we", padx=(8, 4), pady=2)
            w = costruttore(se_stesso.righe_ispettore)
            w.grid(row=riga[0], column=1, sticky="we", padx=(0, 8), pady=2)
            riga[0] += 1
            ritorna w

        se_stesso.righe_ispettore.grid_columnconfigure(1, weight=1)
        se non se_stesso.selezione_:
            se_stesso.intestazione_ispettore.configure(text=f"Finestra: {se_stesso.form.nome}")
            se_stesso._campo_form(aggiungi_riga, "Titolo", "titolo", "testo")
            se_stesso._campo_form(aggiungi_riga, "Larghezza", "larghezza", "numero")
            se_stesso._campo_form(aggiungi_riga, "Altezza", "altezza", "numero")
            se_stesso._campo_form(aggiungi_riga, "Sfondo", "sfondo", "colore")
            se_stesso._campo_form(aggiungi_riga, "Ridimensionabile", "ridimensionabile", "si_no")
            se_stesso._campo_form(aggiungi_riga, "Aspetto", "aspetto", "scelta:classico,chiaro,scuro,verde,viola")
            se_stesso._campo_form(aggiungi_riga, "Disposizione", "layout", "scelta:libero,griglia")
            se se_stesso.form.layout == "griglia":
                se_stesso._campo_form(aggiungi_riga, "Colonne (pesi)", "colonne", "testo")
                se_stesso._campo_form(aggiungi_riga, "Righe (pesi)", "righe", "testo")
                se_stesso._campo_form(aggiungi_riga, "Margine", "margine", "numero")
                se_stesso._campo_form(aggiungi_riga, "Spazio tra le celle", "spazio", "numero")
            problemi = se_stesso.form.problemi()
            se problemi:
                aggiungi_riga("Attenzione", lambda p: tk.Label(p, text="\n".join(problemi[:6]), justify="left",
                                                                 anchor="w", background=c_["pannello"],
                                                                 foreground=c_["avviso"], wraplength=160))
            ritorna
        se lunghezza(se_stesso.selezione_) > 1:
            se_stesso.intestazione_ispettore.configure(text=f"{lunghezza(se_stesso.selezione_)} componenti")
            aggiungi_riga("", lambda p: tk.Label(p, text="Usa «Allinea» per disporli.\nCanc per eliminarli.",
                                                  justify="left", anchor="w", background=c_["pannello"],
                                                  foreground=c_["tenue"]))
            ritorna
        c = se_stesso.form.trova(se_stesso.selezione_[0])
        se_stesso.intestazione_ispettore.configure(text=f"{c.tipo}")
        e = aggiungi_riga("Nome", lambda p: se_stesso._entry(p, c.nome, lambda v: se_stesso._rinomina(c, v)))
        in_griglia = form_modello.definizione_griglia(se_stesso.form, c.genitore) è non Nessuno e e_visivo(c.tipo)
        se in_griglia:
            se_stesso._campi_cella(aggiungi_riga, c)
        per etichetta, attributo in ((("Larghezza propria", "larghezza"), ("Altezza propria", "altezza")) se in_griglia
                                     altrimenti (("X", "x"), ("Y", "y"), ("Larghezza", "larghezza"), ("Altezza", "altezza"))):
            minimo, massimo = se_stesso.limiti_geometria(c, attributo)
            se_stesso._spin_geometria[attributo] = aggiungi_riga(etichetta, lambda p, a=attributo, mn=minimo, mx=massimo: se_stesso._spin(
                p, getattr(c, a), lambda v, a=a: se_stesso._imposta_geometria(c, a, v), mn, mx))
        per chiave, (tipo_, predefinito, descrizione) in proprieta_di(c.tipo).items():
            se tipo_ == "nascosta":
                continua
            se c.tipo == "FonteDati" e chiave in ("server", "porta", "utente") e c.valori.get("dialetto") != "mysql":
                continua
            se e_contenitore(c.tipo) e chiave in form_modello.PROPRIETA_LAYOUT_DIPENDENTI e c.valori.get("layout") != "griglia":
                continua
            aggiungi_riga(descrizione, lambda p, k=chiave, t=tipo_: se_stesso._editor_valore(p, c, k, t))

    definisci _entry(se_stesso, genitore, valore, alla_conferma, larghezza=8):
        c_ = se_stesso.colori
        e = tk.Entry(genitore, width=larghezza, background=c_["campo"], foreground=c_["primo_piano"],
                     insertbackground=c_["cursore"], relief="flat", highlightthickness=1,
                     highlightbackground=c_["bordo"], highlightcolor=c_["accento"])
        e.insert(0, valore)
        e.bind("<Return>", lambda ev: alla_conferma(e.get()))
        e.bind("<FocusOut>", lambda ev: alla_conferma(e.get()))
        ritorna e

    definisci _spin(se_stesso, genitore, valore, alla_conferma, minimo, massimo, larghezza=8):
        """Campo numerico con le freccette su/giù (anche rotella e tasti freccia), dentro i limiti naturali del valore."""
        c_ = se_stesso.colori
        sp = tk.Spinbox(genitore, from_=minimo, to=massimo, increment=1, width=larghezza, background=c_["campo"],
                        foreground=c_["primo_piano"], insertbackground=c_["cursore"], relief="flat", highlightthickness=1,
                        highlightbackground=c_["bordo"], highlightcolor=c_["accento"], buttonbackground=c_["pulsante"],
                        command=lambda: alla_conferma(sp.get()))
        sp.delete(0, "end")
        sp.insert(0, testo(valore))
        sp.bind("<Return>", lambda ev: alla_conferma(sp.get()))
        sp.bind("<FocusOut>", lambda ev: alla_conferma(sp.get()))

        definisci rotella(ev):
            # rotella in su = aumenta, in giù = diminuisce (come le freccette, dentro i limiti); non fa scorrere il pannello sotto
            sp.invoke("buttonup" se ev.delta > 0 altrimenti "buttondown")
            ritorna "break"
        lega_rotella(sp, rotella)
        sp.bind("<Button-4>", lambda ev: (sp.invoke("buttonup"), "break")[1])
        sp.bind("<Button-5>", lambda ev: (sp.invoke("buttondown"), "break")[1])
        ritorna sp

    definisci limiti_geometria(se_stesso, c, attributo):
        """Minimo e massimo naturali per x, y, larghezza e altezza di un componente: restano dentro la finestra."""
        f = se_stesso.form
        se c.genitore:
            padre = f.trova(c.genitore.split("#")[0])
            se padre è non Nessuno:
                L, H = padre.larghezza, padre.altezza - (30 se "#" in c.genitore altrimenti 0)
                se attributo == "x":
                    ritorna 0, max(L - c.larghezza, c.x, 0)
                se attributo == "y":
                    ritorna 0, max(H - c.altezza, c.y, 0)
                se attributo == "larghezza":
                    ritorna 4, max(L - c.x, c.larghezza, 4)
                ritorna 4, max(H - c.y, c.altezza, 4)
        se attributo == "x":
            ritorna 0, max(f.larghezza - c.larghezza, c.x, 0)
        se attributo == "y":
            ritorna 0, max(f.altezza - c.altezza, c.y, 0)
        se attributo == "larghezza":
            ritorna 4, max(f.larghezza - c.x, c.larghezza, 4)
        ritorna 4, max(f.altezza - c.y, c.altezza, 4)

    @staticmethod
    definisci limiti_proprieta(c, chiave):
        """Minimo e massimo naturali di una proprietà numerica (il cursore sta tra «da» e «a», la barra tra 0 e il massimo...)."""
        v = c.valori
        grande = 1000000
        se c.tipo == "Cursore":
            se chiave == "da":
                ritorna -grande, v.get("a", grande)
            se chiave == "a":
                ritorna v.get("da", -grande), grande
            se chiave == "valore":
                ritorna v.get("da", 0), v.get("a", 100)
        se c.tipo == "BarraProgresso":
            se chiave == "massimo":
                ritorna 1, grande
            se chiave == "valore":
                ritorna 0, max(1, v.get("massimo", 100))
        se c.tipo == "Riquadro" e chiave == "bordo":
            ritorna 0, 20
        se e_contenitore(c.tipo) e chiave in ("margine", "spazio"):
            ritorna 0, 200
        ritorna -grande, grande

    definisci _campo_form(se_stesso, aggiungi_riga, etichetta, attributo, tipo_):
        f = se_stesso.form
        minimo_, massimo_ = (0, 200) se attributo in ("margine", "spazio") altrimenti (60, 4000)

        definisci cambia(valore):
            prova:
                nuovo = int(valore) se tipo_ == "numero" altrimenti valore
            eccetto ValueError:
                ritorna
            se tipo_ == "numero":
                nuovo = max(minimo_, min(massimo_, nuovo))
            se getattr(f, attributo) != nuovo:
                se attributo == "layout" e nuovo != "griglia":
                    form_modello.congela_celle(f, "")          # i componenti tengono la posizione che avevano nelle celle
                setattr(f, attributo, nuovo)
                se attributo == "layout" e nuovo == "griglia":
                    form_modello.assegna_celle(f, "")          # ognuno nella cella che corrisponde alla sua posizione
                se_stesso._disegna_griglia()
                se_stesso._registra()
                se attributo == "layout":
                    se_stesso._riempi_ispettore()
        se tipo_ == "si_no":
            var = tk.BooleanVar(value=getattr(f, attributo))
            aggiungi_riga(etichetta, lambda p: tk.Checkbutton(p, variable=var, command=lambda: cambia(var.get()),
                                                               background=se_stesso.colori["pannello"],
                                                               selectcolor=se_stesso.colori["casella"],
                                                               activebackground=se_stesso.colori["pannello"]))
        altrimenti_se tipo_.startswith("scelta:"):
            def_ = tipo_.split(":", 1)[1].split(",")

            definisci scelto(ev=Nessuno, cb=Nessuno):
                cambia(cb.get())
                se attributo == "aspetto":
                    se_stesso.ricostruisci()          # l'anteprima prende i colori del tema
            definisci crea_cb(p):
                cb = ttk.Combobox(p, values=def_, state="readonly", width=10)
                cb.set(getattr(f, attributo))
                cb.bind("<<ComboboxSelected>>", lambda ev: scelto(cb=cb))
                ritorna cb
            aggiungi_riga(etichetta, crea_cb)
        altrimenti_se tipo_ == "colore":
            aggiungi_riga(etichetta, lambda p: se_stesso._campo_colore(p, getattr(f, attributo), cambia))
        altrimenti_se tipo_ == "numero":
            aggiungi_riga(etichetta, lambda p: se_stesso._spin(p, getattr(f, attributo), cambia, minimo_, massimo_))
        altrimenti:
            aggiungi_riga(etichetta, lambda p: se_stesso._entry(p, testo(getattr(f, attributo)), cambia))

    definisci _campo_colore(se_stesso, genitore, valore, alla_conferma):
        cornice = tk.Frame(genitore, background=se_stesso.colori["pannello"])
        e = se_stesso._entry(cornice, valore, alla_conferma, larghezza=6)
        e.pack(side="left", fill="x", expand=Vero)

        definisci scegli():
            scelto = colorchooser.askcolor(color=e.get() o Nessuno, parent=se_stesso)
            se scelto e scelto[1]:
                e.delete(0, "end")
                e.insert(0, scelto[1])
                alla_conferma(scelto[1])
        b1 = tk.Button(cornice, text="…", command=scegli, width=3, relief="flat",
                       background=se_stesso.colori["pulsante"], foreground=se_stesso.colori["primo_piano"])
        b1.pack(side="left", padx=2)
        stile_suggerisci(b1, "Sceglie il colore", se_stesso.colori)
        b2 = tk.Button(cornice, text="✕", command=lambda: (e.delete(0, "end"), alla_conferma("")), width=2, relief="flat",
                       background=se_stesso.colori["pulsante"], foreground=se_stesso.colori["primo_piano"])
        b2.pack(side="left")
        stile_suggerisci(b2, "Toglie il colore (usa quello predefinito)", se_stesso.colori)
        ritorna cornice

    definisci _campo_carattere(se_stesso, genitore, valore, alla_conferma):
        """Il carattere in parti: famiglia (tra quelle installate, o scritta a mano), dimensione, grassetto, corsivo, sottolineato, barrato."""
        c_ = se_stesso.colori
        famiglia, dimensione, stili = form_modello.font_scomponi(valore)
        installati = form_modello.famiglie_sistema()
        prova:
            da tkinter importa font come tkfont
            predefinita = int(tkfont.nametofont("TkDefaultFont").cget("size"))
        eccetto Exception:
            predefinita = 9
        predefinita = abs(predefinita) o 9
        cornice = tk.Frame(genitore, background=c_["pannello"])
        cb = ttk.Combobox(cornice, values=installati, width=16)
        cb.set(famiglia)
        cb.grid(row=0, column=0, columnspan=5, sticky="ew")
        cornice.columnconfigure(0, weight=1)
        stile_suggerisci(cb, "Il carattere: scegli tra quelli installati o scrivi il nome", c_)
        variabili = {}
        stato = {"corrente": valore}

        definisci applica(ev=Nessuno):
            f = cb.get().strip()
            prova:
                d = abs(int(sp.get()))
            eccetto ValueError:
                d = 0
            s = {k per k, v in variabili.items() se v.get()}
            se non valore e non stato["corrente"] e non f e non s e d in (0, predefinita):
                ritorna
            nuovo = form_modello.font_componi(f, d, s)
            se nuovo != stato["corrente"] e nuovo != form_modello.font_componi(*form_modello.font_scomponi(stato["corrente"])):
                stato["corrente"] = nuovo
                alla_conferma(nuovo)

        sp = se_stesso._spin(cornice, abs(dimensione) o predefinita, lambda v: applica(), 1, 200, larghezza=4)
        sp.grid(row=1, column=0, sticky="w", pady=(3, 0))
        cb.bind("<<ComboboxSelected>>", applica)
        cb.bind("<Return>", applica)
        cb.bind("<FocusOut>", applica)
        colonna = 1
        per stile_, lettera, aiuto in (("bold", "G", "Grassetto"), ("italic", "C", "Corsivo"),
                                       ("underline", "S", "Sottolineato"), ("overstrike", "B", "Barrato")):
            variabili[stile_] = tk.BooleanVar(value=(stile_ in stili))
            b = tk.Checkbutton(cornice, text=lettera, variable=variabili[stile_], indicatoron=Falso, width=2, relief="flat",
                               background=c_["pulsante"], foreground=c_["primo_piano"], selectcolor=c_["accento"],
                               activebackground=c_["pulsante"], command=applica)
            b.grid(row=1, column=colonna, padx=(2, 0), pady=(3, 0))
            stile_suggerisci(b, aiuto, c_)
            colonna += 1

        definisci azzera():
            cb.set("")
            sp.delete(0, "end")
            sp.insert(0, testo(predefinita))
            per v in variabili.values():
                v.set(Falso)
            stato["corrente"] = ""
            alla_conferma("")
        x = tk.Button(cornice, text="✕", command=azzera, width=2, relief="flat",
                      background=c_["pulsante"], foreground=c_["primo_piano"])
        x.grid(row=1, column=colonna, padx=(2, 0), pady=(3, 0))
        stile_suggerisci(x, "Toglie il carattere scelto (usa quello predefinito)", c_)
        ritorna cornice

    definisci _editor_valore(se_stesso, genitore, c, chiave, tipo_):
        c_ = se_stesso.colori
        valore = c.valori.get(chiave)
        se tipo_ == "si_no":
            var = tk.BooleanVar(value=bool(valore))
            ritorna tk.Checkbutton(genitore, variable=var, background=c_["pannello"], selectcolor=c_["casella"],
                                   activebackground=c_["pannello"],
                                   command=lambda: se_stesso._modifica(c, chiave, var.get()))
        se tipo_.startswith("scelta:"):
            opzioni = tipo_.split(":", 1)[1].split(",")
            cb = ttk.Combobox(genitore, values=opzioni, state="readonly", width=10)
            cb.set(valore)

            definisci scelto_(ev=Nessuno):
                se_stesso._modifica(c, chiave, cb.get())
                se chiave == "dialetto":
                    se_stesso.after_idle(se_stesso._riempi_ispettore)          # server, porta e utente compaiono solo per MySQL
            cb.bind("<<ComboboxSelected>>", scelto_)
            ritorna cb
        se tipo_ == "colore":
            ritorna se_stesso._campo_colore(genitore, valore o "", lambda v: se_stesso._modifica(c, chiave, v))
        se tipo_ == "carattere":
            ritorna se_stesso._campo_carattere(genitore, valore o "", lambda v: se_stesso._modifica(c, chiave, v))
        se tipo_ == "colonne_albero":
            cornice = tk.Frame(genitore, background=c_["pannello"])
            riassunto = ", ".join(f"{n} ({l})" per n, l, a in colonne_albero(c.valori))
            tk.Label(cornice, text=riassunto o "nessuna colonna", anchor="w", background=c_["pannello"], foreground=c_["primo_piano"],
                     wraplength=130, justify="left").pack(side="left", fill="x", expand=Vero)
            b = tk.Button(cornice, text="Modifica…", relief="flat", background=c_["pulsante"], foreground=c_["primo_piano"],
                          command=lambda: se_stesso.modifica_colonne(c))
            b.pack(side="right", padx=2)
            stile_suggerisci(b, "Nomi, larghezza e allineamento delle colonne", c_)
            ritorna cornice
        se tipo_ == "ancoraggio":
            cornice = tk.Frame(genitore, background=c_["pannello"])
            variabili = {}

            definisci cambia_ancoraggio():
                v = "".join(k per k in "sadb" se variabili[k].get())
                se_stesso._modifica(c, chiave, v o "sa")
            per k, etichetta_, aiuto in (("s", "◀", "Resta a distanza fissa dal bordo sinistro"), ("a", "▲", "Resta a distanza fissa dal bordo alto"),
                                         ("d", "▶", "Resta a distanza fissa dal bordo destro (se anche sinistra: si allarga con la finestra)"),
                                         ("b", "▼", "Resta a distanza fissa dal bordo basso (se anche alto: si allunga con la finestra)")):
                variabili[k] = tk.BooleanVar(value=(k in (valore o "sa")))
                cb = tk.Checkbutton(cornice, text=etichetta_, variable=variabili[k], command=cambia_ancoraggio, background=c_["pannello"], foreground=c_["primo_piano"],
                                    selectcolor=c_["casella"], activebackground=c_["pannello"])
                cb.pack(side="left")
                stile_suggerisci(cb, aiuto, c_)
            ritorna cornice
        se tipo_ == "finestra":
            altre = sorted(f[:-len(".form.json")] per f in os.listdir(se_stesso.cartella) se f.endswith(".form.json") e f[:-len(".form.json")].lower() != se_stesso.form.nome.lower())
            cb = ttk.Combobox(genitore, values=[""] + altre, state="readonly", width=12)
            cb.set(valore o "")
            cb.bind("<<ComboboxSelected>>", lambda ev: se_stesso._modifica(c, chiave, cb.get()))
            stile_suggerisci(cb, "Il pulsante apre questa finestra del progetto", c_)
            ritorna cb
        se tipo_ == "menu":
            cornice = tk.Frame(genitore, background=c_["pannello"])
            titoli = ", ".join(t per t, _ in voci_menu(valore o ""))
            tk.Label(cornice, text=titoli o "vuota", anchor="w", background=c_["pannello"], foreground=c_["primo_piano"], wraplength=120, justify="left").pack(side="left", fill="x", expand=Vero)

            definisci apri_menu():
                nuovo = DialogoMenu(se_stesso, c_, valore o "").mostra()
                se nuovo è non Nessuno:
                    se_stesso._modifica(c, chiave, nuovo)
                    se_stesso._riempi_ispettore()
            b = tk.Button(cornice, text="Modifica…", relief="flat", background=c_["pulsante"], foreground=c_["primo_piano"], command=apri_menu)
            b.pack(side="right", padx=2)
            stile_suggerisci(b, "Scrivi i menu e le loro voci", c_)
            ritorna cornice
        se tipo_ == "elenco":
            ritorna se_stesso._entry(genitore, ", ".join(testo(x) per x in (valore o [])),
                                     lambda v: se_stesso._modifica(c, chiave, [x.strip() per x in v.split(",") se x.strip()]))
        se tipo_ == "numero":
            minimo, massimo = se_stesso.limiti_proprieta(c, chiave)

            definisci cambia(v):
                n = se_stesso._numero(v, valore)
                se_stesso._modifica(c, chiave, max(minimo, min(massimo, n)))
            ritorna se_stesso._spin(genitore, valore, cambia, minimo, massimo)
        se tipo_ in ("fonte", "campo", "tabella", "campo_fonte"):
            ritorna se_stesso._combo_dati(genitore, c, chiave, tipo_)
        se tipo_ == "database":
            ritorna se_stesso._campo_database(genitore, c, chiave)
        se tipo_ == "file":
            cornice = tk.Frame(genitore, background=c_["pannello"])
            e = se_stesso._entry(cornice, valore o "", lambda v: se_stesso._modifica(c, chiave, v), larghezza=6)
            e.pack(side="left", fill="x", expand=Vero)

            definisci scegli():
                p = filedialog.askopenfilename(parent=se_stesso, initialdir=se_stesso.cartella,
                                               filetypes=[("Immagini", "*.png *.jpg *.jpeg *.gif *.bmp"), ("Tutti", "*.*")])
                se non p:
                    ritorna
                radice_progetto = se_stesso.azioni.cartella_progetto() o se_stesso.cartella
                se non os.path.abspath(p).startswith(os.path.abspath(radice_progetto)):
                    cartella_risorse = os.path.join(radice_progetto, "risorse")
                    os.makedirs(cartella_risorse, exist_ok=Vero)
                    nuovo = os.path.join(cartella_risorse, os.path.basename(p))
                    shutil.copy2(p, nuovo)
                    p = nuovo
                    se_stesso.azioni.info("Immagine copiata in risorse/")
                rel = os.path.relpath(p, se_stesso.cartella).replace("\\", "/")
                e.delete(0, "end")
                e.insert(0, rel)
                se_stesso._modifica(c, chiave, rel)
            b = tk.Button(cornice, text="…", command=scegli, width=3, relief="flat",
                          background=c_["pulsante"], foreground=c_["primo_piano"])
            b.pack(side="left", padx=2)
            stile_suggerisci(b, "Sceglie il file dell'immagine", c_)
            ritorna cornice
        se tipo_ == "evento":
            cornice = tk.Frame(genitore, background=c_["pannello"])
            e = se_stesso._entry(cornice, valore o "", lambda v: se_stesso._modifica(c, chiave, v.strip()), larghezza=6)
            e.pack(side="left", fill="x", expand=Vero)

            definisci crea_gestore():
                se non e.get().strip():
                    e.insert(0, f"{chiave}_{c.nome}")
                se_stesso._modifica(c, chiave, e.get().strip())
                se_stesso.vai_al_gestore(c, chiave)
            b = tk.Button(cornice, text="⏎", command=crea_gestore, width=3, relief="flat",
                          background=c_["pulsante"], foreground=c_["primo_piano"])
            b.pack(side="left", padx=2)
            stile_suggerisci(b, "Crea il gestore nel file della logica e ci va", c_)
            ritorna cornice
        ritorna se_stesso._entry(genitore, testo(valore se valore è non Nessuno altrimenti ""),
                                 lambda v: se_stesso._modifica(c, chiave, v))

    # ------------------------------------------------------------ dati: fonte, tabella, campo
    definisci _chiedi_password(se_stesso, messaggio):
        ritorna simpledialog.askstring("MySQL", messaggio, show="*", parent=se_stesso)

    definisci _combo_dati(se_stesso, genitore, c, chiave, tipo_):
        """Scelta di fonte dati, tabella o campo: gli elenchi vengono dal database vero (si leggono quando apri la lista)."""
        valore = c.valori.get(chiave) o ""
        cb = ttk.Combobox(genitore, width=12, state="readonly" se tipo_ == "fonte" altrimenti "normal")
        cb.set(valore)

        definisci riempi():
            se tipo_ == "fonte":
                cb["values"] = [""] + [f.nome per f in se_stesso.form.fonti()]
                ritorna
            f = c se tipo_ in ("tabella", "campo_fonte") altrimenti se_stesso.form.fonte_di(c)
            se f è Nessuno:
                cb["values"] = [""]
                se_stesso.azioni.info("Scegli prima la «Fonte dati» di questo componente.")
                ritorna
            se tipo_ == "tabella":
                elenco, errore = schema_dati.elenco_tabelle(f.valori, se_stesso.cartella, se_stesso._chiedi_password)
            altrimenti:
                elenco, errore = schema_dati.elenco_colonne(f.valori, se_stesso.cartella, se_stesso._chiedi_password)
            se errore:
                se_stesso.azioni.info(errore)
            cb["values"] = [""] + lista(elenco)

        definisci scelto(ev=Nessuno):
            nuovo = cb.get().strip()
            se_stesso._modifica(c, chiave, nuovo)
            se chiave == "fonte" e c.tipo == "Albero" e nuovo:
                se_stesso.colonne_albero_da_tabella(c)
        cb.configure(postcommand=riempi)
        riempi() se tipo_ == "fonte" altrimenti Nessuno
        cb.bind("<<ComboboxSelected>>", scelto)
        cb.bind("<Return>", scelto)
        cb.bind("<FocusOut>", scelto)
        stile_suggerisci(cb, {"fonte": "La tabella da cui prende i dati", "campo": "La colonna della tabella che questo componente mostra e modifica",
                              "tabella": "La tabella del database", "campo_fonte": "La colonna con cui ordinare i record"}[tipo_], se_stesso.colori)
        ritorna cb

    definisci colonne_albero_da_tabella(se_stesso, c):
        """Un Albero appena collegato a una tabella prende le colonne della tabella (se non ne mostra già qualcuna)."""
        f = se_stesso.form.fonte_di(c)
        se f è Nessuno:
            ritorna Falso
        elenco, errore = schema_dati.elenco_colonne(f.valori, se_stesso.cartella, se_stesso._chiedi_password)
        se errore o non elenco o any(n in elenco per n in c.valori.get("colonne", [])):
            ritorna Falso
        nomi = lista(elenco)[:8]
        larghezza = max(60, min(200, (c.larghezza - 30) // lunghezza(nomi)))
        c.valori["colonne"] = nomi
        c.valori["larghezze"] = [larghezza] * lunghezza(nomi)
        c.valori["allineamenti"] = ["w"] * lunghezza(nomi)
        se_stesso._aggiorna_widget(c)
        se_stesso._registra()
        se_stesso.after_idle(se_stesso._riempi_ispettore)
        ritorna Vero

    definisci _campo_database(se_stesso, genitore, c, chiave):
        """Il file SQLite (relativo al progetto se ci sta dentro) oppure il nome del database MySQL."""
        c_ = se_stesso.colori
        cornice = tk.Frame(genitore, background=c_["pannello"])
        e = se_stesso._entry(cornice, c.valori.get(chiave) o "", lambda v: se_stesso._modifica(c, chiave, v.strip()), larghezza=6)
        e.pack(side="left", fill="x", expand=Vero)
        se c.valori.get("dialetto") == "mysql":
            ritorna cornice

        definisci scegli():
            percorso = filedialog.askopenfilename(parent=se_stesso, initialdir=se_stesso.cartella,
                                                  filetypes=[("Database SQLite", "*.db *.sqlite *.sqlite3 *.db3"), ("Tutti", "*.*")])
            se non percorso:
                ritorna
            radice_progetto = os.path.abspath(se_stesso.azioni.cartella_progetto() o se_stesso.cartella)
            se os.path.abspath(percorso).startswith(radice_progetto):
                valore = os.path.relpath(percorso, se_stesso.cartella).replace("\\", "/")
            altrimenti:
                valore = percorso
                se_stesso.azioni.info("Il database sta fuori dal progetto: il programma lo cercherà in quel percorso. Meglio tenerlo nella cartella del progetto.")
            e.delete(0, "end")
            e.insert(0, valore)
            se_stesso._modifica(c, chiave, valore)
        b = tk.Button(cornice, text="…", command=scegli, width=3, relief="flat", background=c_["pulsante"], foreground=c_["primo_piano"])
        b.pack(side="left", padx=2)
        stile_suggerisci(b, "Sceglie il file del database SQLite", c_)
        ritorna cornice

    @staticmethod
    definisci _numero(testo_, predefinito):
        prova:
            n = float(testo_)
            ritorna int(n) se n == int(n) altrimenti n
        eccetto ValueError:
            ritorna predefinito

    definisci _rinomina(se_stesso, c, nuovo):
        nuovo = nuovo.strip()
        se nuovo == c.nome:
            ritorna
        vecchio = c.nome
        se se_stesso.form.rinomina(vecchio, nuovo):
            se_stesso.widget[nuovo] = se_stesso.widget.pop(vecchio)
            se_stesso.selezione_ = [nuovo se n == vecchio altrimenti n per n in se_stesso.selezione_]
            w = se_stesso.widget[nuovo]
            per sequenza, funzione in (("<ButtonPress-1>", se_stesso._premi), ("<B1-Motion>", se_stesso._trascina),
                                       ("<ButtonRelease-1>", se_stesso._rilascia), ("<Double-Button-1>", se_stesso._doppio),
                                       ("<Button-3>", se_stesso._menu_widget)):
                w.bind(sequenza, lambda ev, n=nuovo, f=funzione: f(ev, n))
            se_stesso._registra()
            se_stesso._aggiorna_stato()
        altrimenti:
            se_stesso.azioni.info(f"Nome non valido o già usato: {nuovo}")
            se_stesso._riempi_ispettore()

    definisci _imposta_geometria(se_stesso, c, attributo, valore):
        prova:
            n = int(float(valore))
        eccetto ValueError:
            ritorna
        n = max(0 se attributo in ("x", "y") altrimenti 4, min(4000, n))
        se getattr(c, attributo) != n:
            setattr(c, attributo, n)
            se_stesso._rilayout()
            x_, y_, l_, a_ = se_stesso._geom(c)
            se_stesso.widget[c.nome].place_configure(x=x_, y=y_, width=l_, height=a_)
            se_stesso._aggiorna_maniglie()
            se_stesso._aggiorna_stato()
            se_stesso._registra()
            se_stesso._aggiorna_limiti_geometria(c)

    definisci modifica_colonne(se_stesso, c):
        """Apre la finestra delle colonne di un Albero e applica il risultato (nomi, larghezze e allineamenti insieme)."""
        risultato = DialogoColonne(se_stesso, se_stesso.colori, colonne_albero(c.valori)).mostra()
        se risultato è non Nessuno:
            se_stesso.imposta_colonne(c, risultato)

    definisci imposta_colonne(se_stesso, c, colonne):
        """colonne: [(nome, larghezza, ancora)]. Usato dalla finestra e dall'assistente."""
        c.valori["colonne"] = [r[0] per r in colonne]
        c.valori["larghezze"] = [int(r[1]) per r in colonne]
        c.valori["allineamenti"] = [r[2] per r in colonne]
        se_stesso._aggiorna_widget(c)
        se_stesso._registra()
        se_stesso._riempi_ispettore()

    definisci _modifica(se_stesso, c, chiave, valore):
        se c.valori.get(chiave) == valore:
            ritorna
        se chiave.startswith("g_"):          # la cella in una griglia
            c.valori[chiave] = valore
            se_stesso._rilayout()
            se_stesso._registra()
            ritorna
        se chiave == "layout" e e_contenitore(c.tipo):
            se c.valori.get("layout") == "griglia" e valore != "griglia":
                per k in form_modello.pagine_di(c):
                    form_modello.congela_celle(se_stesso.form, k)
            c.valori[chiave] = valore
            se valore == "griglia":
                per k in form_modello.pagine_di(c):
                    form_modello.assegna_celle(se_stesso.form, k)
            se_stesso._aggiorna_widget(c)
            se_stesso._registra()
            se_stesso._riempi_ispettore()
            ritorna
        c.valori[chiave] = valore
        se_stesso._aggiorna_widget(c)
        se_stesso._registra()

    definisci imposta_proprieta(se_stesso, nome, chiave, valore):
        """Per l'AI e per il codice: cambia una proprietà di un componente."""
        c = se_stesso.form.trova(nome)
        se non c:
            ritorna Falso
        se chiave in ("x", "y", "larghezza", "altezza"):
            se_stesso._imposta_geometria(c, chiave, valore)
        altrimenti:
            se_stesso._modifica(c, chiave, valore)
        se_stesso._riempi_ispettore()
        ritorna Vero

    # ------------------------------------------------------------ file e collegamenti al codice
    definisci contenuto(se_stesso):
        ritorna se_stesso.form.a_json()

    definisci imposta_form(se_stesso, nuovo_form):
        """Sostituisce l'intero form (usato dall'AI)."""
        se_stesso.form = nuovo_form
        se_stesso.ricostruisci()
        se_stesso.seleziona([])
        se_stesso._registra()

    definisci salva(se_stesso, percorso=Nessuno):
        problemi = se_stesso.form.problemi()
        scritti = form_modello.salva_form(se_stesso.form, se_stesso.cartella)
        se_stesso.percorso = form_modello.percorsi_form(se_stesso.cartella, se_stesso.form.nome)["json"]
        se_stesso._segna_modificato(Falso)
        se_stesso.azioni.file_scritti(scritti)
        se_stesso.azioni.info("Salvato: " + ", ".join(os.path.basename(p) per p in scritti)
                              + (f"   ⚠ {lunghezza(problemi)} avvisi" se problemi altrimenti ""))
        ritorna Vero

    definisci ricarica_se_cambiato_su_disco(se_stesso):
        se se_stesso.modificato o non os.path.exists(se_stesso.percorso):
            ritorna Falso
        prova:
            su_disco = open(se_stesso.percorso, encoding="utf-8").read()
            nuovo = Form.da_json(su_disco)
        eccetto (OSError, ValueError, KeyError):
            ritorna Falso
        se nuovo.a_json() != se_stesso.form.a_json():
            nomi = lista(se_stesso.selezione_)
            se_stesso.form = nuovo
            se_stesso.cronologia = [nuovo.a_json()]
            se_stesso.indice_cronologia = 0
            se_stesso.ricostruisci()
            se_stesso.seleziona([n per n in nomi se nuovo.trova(n)])
            ritorna Vero
        ritorna Falso

    definisci percorso_logica(se_stesso):
        ritorna form_modello.percorsi_form(se_stesso.cartella, se_stesso.form.nome)["logica"]

    definisci vai_al_codice(se_stesso):
        se_stesso.salva()
        se_stesso.azioni.apri_file(se_stesso.percorso_logica())

    definisci vai_al_gestore(se_stesso, c, chiave):
        se_stesso.salva()
        nome_fn = (c.valori.get(chiave) o "").strip()
        se_stesso.azioni.apri_file_a_funzione(se_stesso.percorso_logica(), nome_fn)

    definisci esegui(se_stesso):
        se_stesso.salva()
        se_stesso.azioni.esegui_file(se_stesso.percorso_logica())

    definisci chiudi(se_stesso):
        passa
