"""Esecuzione dei programmi con pitonit e console di output."""
importa json
importa os
importa queue
importa re
importa shlex
importa subprocess
importa sys
importa threading
importa time
importa tkinter come tk

da rad importa diagnosi, stile
da rad importa limiti come limiti_mod
da tkinter importa ttk
da rad.piattaforma importa FONT_MONO
da rad importa piattaforma

_RE_LINK = re.compile(r'File "([^"]+)", (?:riga|line) (\d+)')
_FLAG_NASCONDI = getattr(subprocess, "CREATE_NO_WINDOW", 0)


PERCORSI_PROGETTO = []        # cartelle dei pacchetti del progetto (.pacchetti): i programmi lanciati da PitStudio le vedono (via sitecustomize di pitonit)


definisci ambiente_base():
    """L'ambiente dei programmi lanciati: UTF-8, output subito, e i pacchetti del progetto in PITONIT_PERCORSI."""
    ambiente = dict(os.environ, PYTHONIOENCODING="utf-8", PYTHONUNBUFFERED="1")
    se PERCORSI_PROGETTO:
        ambiente["PITONIT_PERCORSI"] = os.pathsep.join(PERCORSI_PROGETTO)
    altrimenti:
        ambiente.pop("PITONIT_PERCORSI", Nessuno)
    ritorna ambiente


definisci controlla_sintassi(sorgente, nome_file="<editor>", linguaggio=Nessuno):
    """None se il codice è valido, altrimenti (riga, colonna, messaggio).

    linguaggio: 'pit' (pytonIta), 'py' (Python classico) o Nessuno = lo si ricava dall'estensione del file."""
    se linguaggio è Nessuno:
        linguaggio = "py" se nome_file.lower().endswith((".py", ".pyw")) altrimenti "pit"
    prova:
        se linguaggio == "py":
            compile(sorgente, nome_file, "exec", 0, Vero)       # senza ereditare le parole chiave italiane
        altrimenti:
            compile(sorgente, nome_file, "exec")
    eccetto SyntaxError come eccezione:
        da _italiano importa traduci_errore
        messaggio = traduci_errore(tipo_testo(eccezione.msg))
        righe = sorgente.split(chr(10))
        riga_errore = righe[(eccezione.lineno o 1) - 1] se 0 < (eccezione.lineno o 1) <= lunghezza_di(righe) altrimenti ""
        prova:
            aiuto = diagnosi.aiuto_sintassi(messaggio, riga_errore, linguaggio == "py")
        eccetto Exception:
            aiuto = Nessuno
        se aiuto:
            messaggio = messaggio + " — " + aiuto
        ritorna (eccezione.lineno o 1, eccezione.offset o 0, messaggio)
    eccetto (ErroreDiValore, ValueError) come eccezione:
        ritorna (1, 0, tipo_testo(eccezione))
    ritorna Nessuno


definisci esegui_sincrono(argomenti, cartella=Nessuno, tempo_massimo=60, ingresso=Nessuno, limiti=Nessuno):
    """Esegue un comando e ne cattura l'output. Ritorna un dizionario.

    limiti: (memoria_mb, processi) oppure Nessuno (vedi rad.limiti)."""
    ambiente = ambiente_base()
    inizio = time.time()
    prova:
        p = subprocess.Popen(argomenti, cwd=cartella, stdin=subprocess.PIPE se ingresso è non Nessuno altrimenti subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=ambiente, creationflags=_FLAG_NASCONDI,
                             start_new_session=piattaforma.NUOVA_SESSIONE)
    eccetto OSError come eccezione:
        ritorna {"codice": -1, "uscita": "", "errori": tipo_testo(eccezione), "scaduto": Falso, "secondi": 0}
    limite = limiti_mod.applica(p, *limiti) se limiti altrimenti Nessuno
    prova:
        prova:
            out, err = p.communicate(input=ingresso.encode("utf-8") se ingresso è non Nessuno altrimenti Nessuno, timeout=tempo_massimo)
            ritorna {"codice": p.returncode, "uscita": (out o b"").decode("utf-8", "replace"),
                     "errori": (err o b"").decode("utf-8", "replace"),
                     "scaduto": Falso, "secondi": round(time.time() - inizio, 2)}
        eccetto subprocess.TimeoutExpired:
            termina_albero(p)
            out, err = p.communicate()
            ritorna {"codice": -1, "uscita": (out o b"").decode("utf-8", "replace"),
                     "errori": (err o b"").decode("utf-8", "replace"),
                     "scaduto": Vero, "secondi": tempo_massimo}
    infine:
        se limite:
            limite.chiudi()


definisci in_secondo_piano(widget, funzione, quando_finito):
    """Esegue funzione() in un thread senza bloccare la grafica; poi chiama quando_finito(riuscito, risultato_o_errore) nel thread della grafica."""
    coda = queue.Queue()

    definisci lavora():
        prova:
            coda.put((Vero, funzione()))
        eccetto Exception come errore:
            coda.put((Falso, errore))

    definisci controlla():
        prova:
            riuscito, risultato = coda.get_nowait()
        eccetto queue.Empty:
            prova:
                widget.after(80, controlla)
            eccetto tk.TclError:
                passa
            ritorna
        prova:
            quando_finito(riuscito, risultato)
        eccetto tk.TclError:
            passa           # il pannello è stato chiuso nel frattempo

    threading.Thread(target=lavora, daemon=Vero).start()
    widget.after(80, controlla)


definisci termina_albero(p):
    """Ferma un processo e quelli che ha avviato."""
    prova:
        se sys.platform == "win32":
            subprocess.run(["taskkill", "/T", "/F", "/PID", tipo_testo(p.pid)], capture_output=Vero, creationflags=_FLAG_NASCONDI)
        altrimenti:
            p.kill()
    eccetto OSError:
        passa


classe Esecutore:
    """Avvia un programma in un processo separato e ne raccoglie l'output senza bloccare la grafica."""

    definisci __inizializza__(se_stesso):
        se_stesso.processo = Nessuno
        se_stesso.coda = queue.Queue()
        se_stesso.inizio = 0
        se_stesso.limite = Nessuno
        se_stesso.generazione = 0         # numero dell'ultimo avvio: gli eventi di un processo vecchio non devono toccare quello nuovo

    @property
    definisci in_esecuzione(se_stesso):
        ritorna se_stesso.processo è non Nessuno e se_stesso.processo.poll() è Nessuno

    definisci avvia(se_stesso, argomenti, cartella=Nessuno, limiti=Nessuno):
        se se_stesso.in_esecuzione:
            solleva ErroreDiEsecuzione("un programma è già in esecuzione")
        ambiente = ambiente_base()
        se_stesso.generazione += 1
        generazione = se_stesso.generazione
        se_stesso.processo = subprocess.Popen(argomenti, cwd=cartella, stdin=subprocess.PIPE,
                                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                              env=ambiente, creationflags=_FLAG_NASCONDI, start_new_session=piattaforma.NUOVA_SESSIONE)
        se_stesso.inizio = time.time()
        p = se_stesso.processo
        se_stesso.limite = limiti_mod.applica(p, *limiti) se limiti altrimenti Nessuno
        t_out = threading.Thread(target=se_stesso._leggi, args=(p.stdout, "out", generazione), daemon=Vero)
        t_err = threading.Thread(target=se_stesso._leggi, args=(p.stderr, "err", generazione), daemon=Vero)
        t_out.start()
        t_err.start()
        threading.Thread(target=se_stesso._attendi_fine, args=(p, t_out, t_err, generazione), daemon=Vero).start()

    definisci _leggi(se_stesso, flusso, canale, generazione):
        prova:
            mentre Vero:
                blocco = flusso.read1(4096) se hasattr(flusso, "read1") altrimenti flusso.read(4096)
                se non blocco:
                    interrompi
                se_stesso.coda.put((canale, blocco.decode("utf-8", "replace"), generazione))
        eccetto (OSError, ValueError):
            passa

    definisci _attendi_fine(se_stesso, p, t_out, t_err, generazione):
        codice = p.wait()
        se se_stesso.limite:
            se_stesso.limite.chiudi()
            se_stesso.limite = Nessuno
        t_out.join(1)
        t_err.join(1)
        se_stesso.coda.put(("fine", (codice, round(time.time() - se_stesso.inizio, 2)), generazione))

    definisci ferma(se_stesso):
        p = se_stesso.processo
        se p è Nessuno o p.poll() è non Nessuno:
            ritorna
        prova:
            se sys.platform == "win32":
                subprocess.run(["taskkill", "/T", "/F", "/PID", tipo_testo(p.pid)], capture_output=Vero,
                               creationflags=_FLAG_NASCONDI)
            altrimenti:
                piattaforma.termina_gruppo(p)
        eccetto OSError:
            passa
        prova:
            p.wait(3)                     # così, quando ferma() torna, il processo è davvero finito e si può riavviare subito
        eccetto subprocess.TimeoutExpired:
            passa

    definisci invia(se_stesso, riga):
        p = se_stesso.processo
        se p è non Nessuno e p.poll() è Nessuno:
            prova:
                p.stdin.write((riga + "\n").encode("utf-8"))
                p.stdin.flush()
            eccetto (OSError, ValueError):
                passa

    definisci eventi(se_stesso):
        """Eventi in attesa: [('out', testo) | ('err', testo) | ('fine', (codice, secondi))]. Si scartano quelli dei processi vecchi
        (fermati e subito riavviati): la loro fine non deve fermare il programma nuovo."""
        risultato = []
        mentre Vero:
            prova:
                tipo_, dati, generazione = se_stesso.coda.get_nowait()
            eccetto queue.Empty:
                interrompi
            se generazione == se_stesso.generazione:
                risultato.append((tipo_, dati))
        ritorna risultato


classe Console(tk.Frame):
    """Console: output colorato, link agli errori, riga di input per il programma."""

    definisci __inizializza__(se_stesso, genitore, config, colori, azioni):
        tk.Frame.__init__(se_stesso, genitore)
        se_stesso.config_ = config
        se_stesso.colori = colori
        se_stesso.azioni = azioni
        se_stesso.esecutore = Esecutore()
        se_stesso.gestore_debug = Nessuno         # funzione che riceve gli eventi del debugger (dizionari)
        se_stesso._buffer_debug = ""
        se_stesso._lavoro = Nessuno
        se_stesso._costruisci()
        se_stesso.applica_colori(colori)

    definisci _costruisci(se_stesso):
        barra = tk.Frame(se_stesso)
        barra.pack(fill="x")
        se_stesso.barra = barra
        se_stesso.titolo = tk.Label(barra, text="CONSOLE", anchor="w")
        se_stesso.titolo.pack(side="left", padx=8, pady=3)
        se_stesso.stato = tk.Label(barra, text="", anchor="w")
        se_stesso.stato.pack(side="left", padx=8)
        per testo_, comando, aiuto in (("Pulisci", se_stesso.pulisci, "Svuota la console"),
                                        ("■ Ferma", se_stesso.ferma, "Ferma il programma in esecuzione (Maiusc+F5)")):
            b = tk.Button(barra, text=testo_, command=comando)
            b.pack(side="right", padx=3, pady=2)
            stile.suggerisci(b, aiuto)
        se_stesso.t = tk.Text(se_stesso, wrap="word", height=8, borderwidth=0, highlightthickness=0,
                              padx=8, pady=4, state="disabled")
        se_stesso.t._tema_proprio = Vero
        barra_y = ttk.Scrollbar(se_stesso, orient="vertical", command=se_stesso.t.yview)
        se_stesso.t.configure(yscrollcommand=barra_y.set)
        riga_input = tk.Frame(se_stesso)
        riga_input.pack(side="bottom", fill="x")
        se_stesso.riga_input = riga_input
        se_stesso.prompt = tk.Label(riga_input, text="›")
        se_stesso.prompt.pack(side="left", padx=(8, 2))
        se_stesso.ingresso = tk.Entry(riga_input)
        se_stesso.ingresso.pack(side="left", fill="x", expand=Vero, padx=4, pady=3)
        se_stesso.ingresso.bind("<Return>", se_stesso._invia)
        barra_y.pack(side="right", fill="y")
        se_stesso.t.pack(fill="both", expand=Vero)
        se_stesso.t.tag_bind("link", "<Button-1>", se_stesso._clic_link)
        se_stesso.t.tag_bind("link", "<Enter>", lambda evento_tk: se_stesso.t.configure(cursor="hand2"))
        se_stesso.t.tag_bind("link", "<Leave>", lambda evento_tk: se_stesso.t.configure(cursor=""))

    definisci applica_colori(se_stesso, c):
        se_stesso.colori = c
        se_stesso.configure(background=c["pannello"])
        se_stesso.t.configure(background=c["editor"], foreground=c["editor_testo"],
                              font=(se_stesso.config_.ottieni("editor.carattere", FONT_MONO),
                                    max(9, se_stesso.config_.ottieni("editor.dimensione", 11) - 1)))
        se_stesso.t.tag_configure("out", foreground=c["editor_testo"])
        se_stesso.t.tag_configure("err", foreground=c["errore"])
        se_stesso.t.tag_configure("info", foreground=c["tenue"])
        se_stesso.t.tag_configure("ok", foreground=c["ok"])
        se_stesso.t.tag_configure("suggerimento", foreground=c["avviso"], lmargin1=4, lmargin2=22, spacing1=4, spacing3=4)
        se_stesso.t.tag_configure("link", foreground=c["accento"], underline=Vero)
        se_stesso.t.tag_configure("utente", foreground=c["avviso"])
        per w in (se_stesso.barra, se_stesso.riga_input):
            w.configure(background=c["pannello"])
        per w in (se_stesso.titolo, se_stesso.stato, se_stesso.prompt):
            w.configure(background=c["pannello"], foreground=c["tenue"])
        se_stesso.ingresso.configure(background=c["campo"], foreground=c["primo_piano"],
                                     insertbackground=c["cursore"], relief="flat")
        per b in se_stesso.barra.winfo_children():
            se b.winfo_class() == "Button":
                b.configure(background=c["pulsante"], foreground=c["primo_piano"],
                            activebackground=c["pulsante_attivo"], relief="flat", borderwidth=0, padx=8)

    # --- output
    definisci scrivi(se_stesso, testo_, tag="out"):
        t = se_stesso.t
        t.configure(state="normal")
        inizio = t.index("end-1c")
        t.insert("end", testo_, tag)
        # link ai file negli errori
        per m in _RE_LINK.finditer(testo_):
            a = f"{inizio}+{m.start()}c"
            b = f"{inizio}+{m.end()}c"
            t.tag_add("link", a, b)
        t.configure(state="disabled")
        t.see("end")

    definisci pulisci(se_stesso):
        se_stesso.t.configure(state="normal")
        se_stesso.t.delete("1.0", "end")
        se_stesso.t.configure(state="disabled")

    definisci _clic_link(se_stesso, evento_tk):
        t = se_stesso.t
        indice = t.index(f"@{evento_tk.x},{evento_tk.y}")
        intervalli = t.tag_ranges("link")
        per i in intervallo_di(0, lunghezza_di(intervalli), 2):
            se t.compare(intervalli[i], "<=", indice) e t.compare(indice, "<", intervalli[i + 1]):
                m = _RE_LINK.search(t.get(intervalli[i], intervalli[i + 1]))
                se m:
                    se_stesso.azioni.apri_file_a_riga(m.group(1), int(m.group(2)))
                ritorna

    # --- esecuzione
    definisci esegui(se_stesso, argomenti, cartella, descrizione=""):
        se se_stesso.esecutore.in_esecuzione:
            se_stesso.scrivi("Un programma è già in esecuzione.\n", "err")
            ritorna Falso
        se se_stesso.config_.ottieni("esecuzione.pulisci_console", Vero):
            se_stesso.pulisci()
        se se_stesso._lavoro è non Nessuno:          # l'attesa dell'esecuzione precedente (se ancora attiva) non serve più: ne parte una nuova
            prova:
                se_stesso.after_cancel(se_stesso._lavoro)
            eccetto tk.TclError:
                passa
            se_stesso._lavoro = Nessuno
        se_stesso._errori_recenti = ""
        se_stesso._visto_output = Falso
        se_stesso._cartella_esecuzione = cartella
        se_stesso._e_python = any(tipo_testo(a).lower().endswith((".py", ".pyw")) per a in argomenti)
        se_stesso.scrivi(f"▶ {descrizione o ' '.join(argomenti)}\n", "info")
        prova:
            se_stesso.esecutore.avvia(argomenti, cartella, limiti_mod.da_configurazione(se_stesso.config_, "esecuzione"))
        eccetto OSError come errore:
            se_stesso.scrivi(f"Impossibile avviare: {errore}\n", "err")
            ritorna Falso
        se_stesso.stato.configure(text="in esecuzione…")
        se_stesso._aspetta()
        se_stesso.azioni.stato_esecuzione(Vero)
        ritorna Vero

    definisci _estrai_eventi_debug(se_stesso, dati):
        """Toglie dall'output gli eventi del debugger (racchiusi tra caratteri di controllo), li passa al gestore e ritorna il testo normale."""
        inizio_ev, fine_ev = chr(1) + "DBG", chr(2)
        buf = se_stesso._buffer_debug + dati
        se_stesso._buffer_debug = ""
        visibile = []
        mentre Vero:
            i = buf.find(inizio_ev)
            se i < 0:
                visibile.append(buf)
                interrompi
            j = buf.find(fine_ev, i)
            se j < 0:                          # evento incompleto: si aspetta il resto
                visibile.append(buf[:i])
                se_stesso._buffer_debug = buf[i:]
                interrompi
            visibile.append(buf[:i])
            prova:
                evento = json.loads(buf[i + len(inizio_ev):j])
            eccetto ValueError:
                evento = Nessuno
            se evento e se_stesso.gestore_debug:
                se_stesso.gestore_debug(evento)
            buf = buf[j + 1:]
        ritorna "".join(visibile)

    definisci _aspetta(se_stesso):
        per tipo_, dati in se_stesso.esecutore.eventi():
            se tipo_ == "out" e se_stesso.gestore_debug:
                dati = se_stesso._estrai_eventi_debug(dati)
            se tipo_ in ("out", "err") e dati:
                se_stesso._visto_output = Vero
                se_stesso.scrivi(dati, tipo_)
                se tipo_ == "err":
                    se_stesso._errori_recenti = (getattr(se_stesso, "_errori_recenti", "") + dati)[-6000:]
            altrimenti_se tipo_ == "fine":
                se se_stesso.gestore_debug:
                    gestore = se_stesso.gestore_debug
                    se_stesso.gestore_debug = Nessuno
                    gestore({"evento": "fine_processo"})
                codice, secondi = dati
                se codice == 0:
                    se_stesso.scrivi(f"\n✔ terminato in {secondi} s\n", "ok")
                    se non getattr(se_stesso, "_visto_output", Vero):
                        se_stesso.scrivi("💡 Il programma non ha stampato nulla. Se il file contiene solo funzioni o classi (un modulo, una libreria), "
                                         "non c'è niente da eseguire: lancia il file che le usa, per esempio uno di prova, oppure imposta come principale "
                                         "il file giusto (clic destro sul file → Imposta come principale).\n", "suggerimento")
                altrimenti:
                    se_stesso.scrivi(f"\n✖ terminato con codice {codice} ({secondi} s)\n", "err")
                    aiuto = Nessuno
                    prova:
                        aiuto = diagnosi.analizza(getattr(se_stesso, "_errori_recenti", ""), getattr(se_stesso, "_cartella_esecuzione", Nessuno),
                                                  getattr(se_stesso, "_e_python", Falso))
                    eccetto Exception:
                        aiuto = Nessuno
                    se aiuto:
                        se_stesso.scrivi(aiuto + "\n", "suggerimento")
                se_stesso.stato.configure(text="")
                se_stesso.azioni.stato_esecuzione(Falso)
                se_stesso.azioni.esecuzione_finita(codice)
                ritorna
        se_stesso._lavoro = se_stesso.after(40, se_stesso._aspetta)

    definisci ferma(se_stesso):
        se se_stesso.esecutore.in_esecuzione:
            se_stesso.esecutore.ferma()
            se_stesso.scrivi("\n■ interrotto\n", "info")

    definisci _invia(se_stesso, evento_tk=Nessuno):
        riga = se_stesso.ingresso.get()
        se_stesso.ingresso.delete(0, "end")
        se_stesso.scrivi(riga + "\n", "utente")
        se_stesso.esecutore.invia(riga)

    @property
    definisci in_esecuzione(se_stesso):
        ritorna se_stesso.esecutore.in_esecuzione
