"""Finestra della galleria di esempi: scegli un esempio, leggi cosa insegna e crea un progetto già pronto."""
importa tkinter come tk
da tkinter importa ttk

da rad.dialoghi importa DialogoBase
da rad.esempi importa elenco_esempi


classe DialogoEsempi(DialogoBase):
    """Elenco degli esempi per categoria, con descrizione. Ritorna l'esempio scelto (o Nessuno)."""

    definisci __inizializza__(se_stesso, genitore, colori, esempi=Nessuno):
        DialogoBase.__init__(se_stesso, genitore, "Galleria di esempi", colori, 860, 520)
        se_stesso.resizable(Vero, Vero)
        se_stesso.esempi = esempi se esempi è non Nessuno altrimenti elenco_esempi()
        c = colori
        se_stesso.grid_columnconfigure(1, weight=1)
        se_stesso.grid_rowconfigure(0, weight=1)
        sinistra = tk.Frame(se_stesso, background=c["pannello"])
        sinistra.grid(row=0, column=0, sticky="ns", padx=(14, 6), pady=14)
        se_stesso.albero = ttk.Treeview(sinistra, show="tree", selectmode="browse", height=18)
        se_stesso.albero.pack(fill="y", expand=Vero)
        se_stesso.albero.column("#0", width=250)
        se_stesso.albero.bind("<<TreeviewSelect>>", se_stesso._scelta)
        se_stesso.albero.bind("<Double-Button-1>", lambda e: se_stesso._conferma())
        destra = tk.Frame(se_stesso, background=c["pannello"])
        destra.grid(row=0, column=1, sticky="nsew", padx=(6, 14), pady=14)
        se_stesso.titolo = tk.Label(destra, text="Scegli un esempio a sinistra", anchor="w", background=c["pannello"], foreground=c["primo_piano"], font=("Segoe UI Semibold", 14))
        se_stesso.titolo.pack(fill="x")
        se_stesso.riga_info = tk.Label(destra, text="", anchor="w", background=c["pannello"], foreground=c["accento"], font=("Segoe UI", 9))
        se_stesso.riga_info.pack(fill="x", pady=(0, 8))
        se_stesso.testo = tk.Text(destra, wrap="word", relief="flat", font=("Segoe UI", 10), background=c["campo"], foreground=c["primo_piano"], height=14,
                                  highlightthickness=1, highlightbackground=c["bordo"], state="disabled", padx=10, pady=8)
        se_stesso.testo.pack(fill="both", expand=Vero)
        se_stesso.testo.tag_configure("titolo", font=("Segoe UI Semibold", 10), foreground=c["accento"], spacing1=8)
        fondo = tk.Frame(se_stesso, background=c["pannello"])
        fondo.grid(row=1, column=0, columnspan=2, sticky="e", padx=14, pady=(0, 12))
        tk.Button(fondo, text="Chiudi", command=se_stesso.destroy, background=c["pulsante"], foreground=c["primo_piano"], relief="flat", padx=14).pack(side="right", padx=4)
        se_stesso.pulsante = tk.Button(fondo, text="Crea un progetto da questo esempio", command=se_stesso._conferma, background=c["accento"], foreground="#ffffff",
                                       relief="flat", padx=14, state="disabled")
        se_stesso.pulsante.pack(side="right", padx=4)
        se_stesso.per_id = {}
        categorie = []
        per e in se_stesso.esempi:
            se e["categoria"] non in categorie:
                categorie.append(e["categoria"])
        per cat in categorie:
            se_stesso.albero.insert("", "end", iid="cat:" + cat, text=cat, open=Vero)
            per e in se_stesso.esempi:
                se e["categoria"] == cat:
                    se_stesso.albero.insert("cat:" + cat, "end", iid=e["id"], text="   " + e["titolo"])
                    se_stesso.per_id[e["id"]] = e
        se non se_stesso.esempi:
            se_stesso.titolo.configure(text="Nessun esempio trovato")
        se_stesso.bind("<Return>", lambda e: se_stesso._conferma())
        se se_stesso.esempi:
            se_stesso.albero.selection_set(se_stesso.esempi[0]["id"])

    definisci _scelta(se_stesso, e=Nessuno):
        sel = se_stesso.albero.selection()
        esempio = se_stesso.per_id.get(sel[0]) se sel altrimenti Nessuno
        se non esempio:
            se_stesso.pulsante.configure(state="disabled")
            ritorna
        se_stesso.pulsante.configure(state="normal")
        se_stesso.titolo.configure(text=esempio["titolo"])
        se_stesso.riga_info.configure(text=f"{esempio['categoria']}  ·  {esempio['livello']}")
        t = se_stesso.testo
        t.configure(state="normal")
        t.delete("1.0", "end")
        t.insert("end", esempio["descrizione"] + "\n")
        t.insert("end", "\nCosa impari\n", "titolo")
        per voce in esempio["impara"]:
            t.insert("end", f"  •  {voce}\n")
        t.insert("end", "\nCosa trovi nel progetto\n", "titolo")
        t.insert("end", "  " + ", ".join(sorted(f per f in __import__("os").listdir(esempio["cartella"]) se f != "esempio.json")) + "\n")
        t.insert("end", "\nCome si usa\n", "titolo")
        t.insert("end", "  Premi «Crea un progetto da questo esempio»: PitStudio copia i file in una cartella tua e apre il programma. "
                        "Poi premi Esegui per provarlo e cambia qualcosa per vedere cosa succede.\n")
        t.configure(state="disabled")

    definisci _conferma(se_stesso):
        sel = se_stesso.albero.selection()
        esempio = se_stesso.per_id.get(sel[0]) se sel altrimenti Nessuno
        se esempio:
            se_stesso.risultato = esempio
            se_stesso.destroy()
