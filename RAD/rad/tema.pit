    "scuro": {
        "sfondo": "#1e1f22", "pannello": "#2b2d30", "primo_piano": "#dfe1e5",
        "tenue": "#8c8f94", "bordo": "#393b40",
        "editor": "#1b1c1f", "editor_testo": "#d7dae0", "selezione": "#2f4f7f",
        "riga_corrente": "#26282c", "numeri_sfondo": "#1e1f22", "numeri": "#6b6e75",
        "cursore": "#ffffff", "pulsante": "#3a3d43", "pulsante_attivo": "#4a4e56",
        "campo": "#26282c", "casella": "#e8eaed", "accento": "#4d8dee", "errore": "#f2706b", "ok": "#6cc070",
        "avviso": "#e0b050",
        "parola_chiave": "#cc7832", "builtin": "#8888ff", "stringa": "#6a9955",
        "commento": "#7a7e85", "numero": "#6897bb", "definizione": "#ffc66d",
        "decoratore": "#bbb529", "costante": "#9876aa",
        "chat_utente": "#2a3a52", "chat_ai": "#24262a", "chat_strumento": "#2d2a1f",
    },
    "chiaro": {
        "sfondo": "#f2f2f2", "pannello": "#e6e7e9", "primo_piano": "#1f2328",
        "tenue": "#6a6f76", "bordo": "#c9ccd1",
        "editor": "#ffffff", "editor_testo": "#1f2328", "selezione": "#b4d5fe",
        "riga_corrente": "#f1f5fb", "numeri_sfondo": "#f2f2f2", "numeri": "#8a8f96",
        "cursore": "#000000", "pulsante": "#dfe1e5", "pulsante_attivo": "#cfd3d9",
        "campo": "#ffffff", "casella": "#ffffff", "accento": "#1a62d6", "errore": "#c62828", "ok": "#2e7d32",
        "avviso": "#b7791f",
        "parola_chiave": "#9a3d00", "builtin": "#3949ab", "stringa": "#1b7f2a",
        "commento": "#7a7f87", "numero": "#0b66b2", "definizione": "#8a5a00",
        "decoratore": "#8c7a00", "costante": "#7b3fa0",
