}


definisci colori(config):
    """Colori del tema scelto, con le eventuali personalizzazioni dell'utente."""
    nome = config.ottieni("tema", "scuro")
    base = dict(TEMI.get(nome, TEMI["scuro"]))
    base.update(config.ottieni("temi_personalizzati." + nome, {}) o {})
    ritorna base


_COLORI_SCELTE = []          # bordo, riempimento e segno delle caselle, secondo il tema corrente


# ---------------------------------------------------------------- caselle di spunta e pulsanti di scelta leggibili in ogni tema
# Windows disegna la spunta sempre in nero: su un fondo scuro non si vede. Per questo la casella è disegnata da noi (sfondo del campo, bordo, segno nel colore del testo).
definisci _segmento(px, py, ax, ay, bx, by):
    dx, dy = bx - ax, by - ay
    t = max(0.0, min(1.0, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)))
    ritorna math.hypot(px - (ax + t * dx), py - (ay + t * dy))


definisci _immagine_scelta(radice, tipo_, acceso, bordo, riempimento, segno):
    cache = radice.__dict__.setdefault("_cache_scelte", {})
    chiave = (tipo_, acceso, bordo, riempimento, segno)
    se chiave in cache:
        ritorna cache[chiave]
    n = 16
    img = tkinter.PhotoImage(master=radice, width=n, height=n)
    vuoti = []
    per y in intervallo_di(n):
        riga = []
        per x in intervallo_di(n):
            se tipo_ == "check":
                se x < 1 o x > 14 o y < 1 o y > 14:
                    colore = riempimento
                    vuoti.append((x, y))
                altrimenti_se x in (1, 14) o y in (1, 14):
                    colore = bordo
                altrimenti_se acceso e min(_segmento(x, y, 4, 8, 7, 11), _segmento(x, y, 7, 11, 12, 4)) <= 1.1:
                    colore = segno
                altrimenti:
                    colore = riempimento
            altrimenti:
                d = math.hypot(x - 7.5, y - 7.5)
                se d > 7:
                    colore = riempimento
                    vuoti.append((x, y))
                altrimenti_se d > 6:
                    colore = bordo
                altrimenti_se acceso e d <= 3:
                    colore = segno
                altrimenti:
                    colore = riempimento
            riga.append(colore)
        img.put("{" + " ".join(riga) + "}", to=(0, y))
    per x, y in vuoti:
        img.transparency_set(x, y, Vero)
    cache[chiave] = img
    ritorna img


definisci stila_scelta(w, bordo, riempimento, segno):
    """Casella di spunta o pulsante di scelta con la spunta (il pallino) sempre visibile: sfondo del campo, segno nel colore del testo."""
    prova:
        se int(str(w.cget("indicatoron"))) == 0 e non getattr(w, "_scelta_tema", Falso):
            ritorna          # già a pulsante: ha un suo aspetto
        tipo_ = "check" se w.winfo_class() == "Checkbutton" altrimenti "radio"
        r = w._root()
        spento = _immagine_scelta(r, tipo_, Falso, bordo, riempimento, segno)
        acceso = _immagine_scelta(r, tipo_, Vero, bordo, riempimento, segno)
        fondo = w.cget("background")
        w._scelta_img = (spento, acceso)
        w._scelta_tema = Falso          # la prima volta il selectcolor va impostato: il filtro di configure parte dopo
        w.configure(indicatoron=Falso, image=spento, selectimage=acceso, compound="left", borderwidth=0, relief="flat", overrelief="flat",
                    offrelief="flat", selectcolor=fondo, activebackground=fondo, highlightthickness=0)
        w._scelta_tema = Vero
    eccetto tkinter.TclError:
        passa


definisci _in_anteprima(w):
    m = w
    mentre m è non Nessuno:
        se getattr(m, "_anteprima", Falso):
            ritorna Vero
        m = getattr(m, "master", Nessuno)
    ritorna Falso


definisci installa_scelte(colori_correnti):
    """Fa sì che ogni Checkbutton e Radiobutton creato dopo abbia la casella leggibile (colori_correnti() = bordo, riempimento, segno)."""
    se getattr(tkinter, "_scelte_installate", Falso):
        ritorna

    definisci avvolgi(classe_tk):
        originale = classe_tk.__init__

        definisci nuovo(se_stesso, *a, **k):
            originale(se_stesso, *a, **k)
            se non _in_anteprima(se_stesso):
                colori_ = colori_correnti()
                se colori_:
                    stila_scelta(se_stesso, *colori_)
        classe_tk.__init__ = nuovo
        originale_configura = classe_tk.configure

        definisci configura(se_stesso, cnf=Nessuno, **k):
            # su una casella disegnata da noi il colore «selezionato» deve restare uguale allo sfondo (altrimenti la casella spuntata cambia colore)
            se getattr(se_stesso, "_scelta_tema", Falso) e cnf è Nessuno e k:
                k.pop("selectcolor", Nessuno)
                se "background" in k o "bg" in k:
                    k["selectcolor"] = k.get("background", k.get("bg"))
                    k.setdefault("activebackground", k["selectcolor"])
            ritorna originale_configura(se_stesso, cnf, **k)
        classe_tk.configure = configura
        classe_tk.config = configura
    avvolgi(tkinter.Checkbutton)
    avvolgi(tkinter.Radiobutton)
    tkinter._scelte_installate = Vero


definisci configura_stile(radice, c, carattere_ui=(FONT_UI, 10)):
    """Imposta gli stili ttk in base ai colori c."""
    _COLORI_SCELTE.clear()
    _COLORI_SCELTE.extend([c["tenue"], c["campo"], c["primo_piano"]])
    installa_scelte(lambda: tuple(_COLORI_SCELTE))
    s = ttk.Style(radice)
    prova:
        s.theme_use("clam")
    eccetto tkinter.TclError:
        passa
    s.configure(".", background=c["pannello"], foreground=c["primo_piano"],
                fieldbackground=c["campo"], bordercolor=c["bordo"],
                lightcolor=c["pannello"], darkcolor=c["pannello"],
                troughcolor=c["sfondo"], font=carattere_ui)
    s.configure("TFrame", background=c["pannello"])
    s.configure("TLabel", background=c["pannello"], foreground=c["primo_piano"])
    s.configure("TButton", background=c["pulsante"], foreground=c["primo_piano"],
                padding=(8, 3), borderwidth=1)
    s.map("TButton", background=[("active", c["pulsante_attivo"]), ("pressed", c["accento"])])
    s.configure("TCheckbutton", background=c["pannello"], foreground=c["primo_piano"])
    s.configure("TRadiobutton", background=c["pannello"], foreground=c["primo_piano"])
    s.configure("TEntry", fieldbackground=c["campo"], foreground=c["primo_piano"],
                insertcolor=c["cursore"])
    s.configure("TCombobox", fieldbackground=c["campo"], foreground=c["primo_piano"],
                background=c["pulsante"], arrowcolor=c["primo_piano"])
    s.map("TCombobox", fieldbackground=[("readonly", c["campo"])],
          foreground=[("readonly", c["primo_piano"])])
    s.configure("TNotebook", background=c["sfondo"], borderwidth=0, tabmargins=(2, 4, 2, 0))
    s.configure("TNotebook.Tab", background=c["pannello"], foreground=c["tenue"],
                padding=(10, 4), borderwidth=0)
    s.map("TNotebook.Tab", background=[("selected", c["editor"])],
          foreground=[("selected", c["primo_piano"])])
    s.configure("Treeview", background=c["campo"], fieldbackground=c["campo"],
                foreground=c["primo_piano"], borderwidth=0, rowheight=22)
    s.map("Treeview", background=[("selected", c["selezione"])],
          foreground=[("selected", c["primo_piano"])])
    s.configure("Treeview.Heading", background=c["pulsante"], foreground=c["primo_piano"])
    s.configure("TPanedwindow", background=c["sfondo"])
    s.configure("Sash", background=c["sfondo"], sashthickness=5)
    s.configure("TScrollbar", background=c["pulsante"], troughcolor=c["sfondo"],
                arrowcolor=c["tenue"], bordercolor=c["sfondo"], lightcolor=c["pulsante"],
                darkcolor=c["pulsante"], gripcount=0)
    s.map("TScrollbar", background=[("active", c["pulsante_attivo"]), ("!active", c["pulsante"])],
          arrowcolor=[("active", c["primo_piano"])])
    s.configure("Horizontal.TProgressbar", background=c["accento"], troughcolor=c["sfondo"])
    s.configure("TLabelframe", background=c["pannello"], bordercolor=c["bordo"])
    s.configure("TLabelframe.Label", background=c["pannello"], foreground=c["tenue"])
    s.configure("TSeparator", background=c["bordo"])
    s.configure("Accento.TButton", background=c["accento"], foreground="#ffffff")
    s.map("Accento.TButton", background=[("active", c["accento"])])
    s.configure("Barra.TFrame", background=c["sfondo"])
    s.configure("Barra.TLabel", background=c["sfondo"], foreground=c["tenue"])


definisci applica(widget, c):
    """Colora ricorsivamente i widget tk classici (i ttk usano gli stili)."""
    se getattr(widget, "_anteprima", Falso):
        ritorna      # l'anteprima di una finestra mantiene l'aspetto che avrà la finestra vera
    cl = widget.winfo_class()
    prova:
        se cl in ("Frame", "Toplevel", "Tk", "Labelframe"):
            widget.configure(background=c["pannello"])
        altrimenti_se cl == "Label":
            widget.configure(background=c["pannello"], foreground=c["primo_piano"])
        altrimenti_se cl == "Button":
            widget.configure(background=c["pulsante"], foreground=c["primo_piano"],
                             activebackground=c["pulsante_attivo"],
                             activeforeground=c["primo_piano"], relief="flat", borderwidth=0)
        altrimenti_se cl in ("Entry", "Spinbox"):
            widget.configure(background=c["campo"], foreground=c["primo_piano"],
                             insertbackground=c["cursore"], relief="flat",
                             highlightthickness=1, highlightbackground=c["bordo"],
                             highlightcolor=c["accento"])
        altrimenti_se cl == "Text":
            se non getattr(widget, "_tema_proprio", Falso):
                widget.configure(background=c["campo"], foreground=c["primo_piano"],
                                 insertbackground=c["cursore"],
                                 selectbackground=c["selezione"], relief="flat",
                                 highlightthickness=0)
        altrimenti_se cl == "Listbox":
            widget.configure(background=c["campo"], foreground=c["primo_piano"],
                             selectbackground=c["selezione"], selectforeground=c["primo_piano"],
                             relief="flat", highlightthickness=0, borderwidth=0)
        altrimenti_se cl == "Canvas":
            se non getattr(widget, "_tema_proprio", Falso):
                widget.configure(background=c["campo"], highlightthickness=0)
        altrimenti_se cl == "Menu":
            widget.configure(background=c["pannello"], foreground=c["primo_piano"],
                             activebackground=c["accento"], activeforeground="#ffffff",
                             relief="flat", borderwidth=0)
        altrimenti_se cl in ("Checkbutton", "Radiobutton"):
            se getattr(widget, "_scelta_tema", Falso):
                stila_scelta(widget, *_COLORI_SCELTE)
        altrimenti_se cl == "Panedwindow":
            widget.configure(background=c["sfondo"], sashwidth=5, borderwidth=0)
    eccetto tkinter.TclError:
        passa
    per figlio in widget.winfo_children():
        applica(figlio, c)
