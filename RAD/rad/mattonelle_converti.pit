"""Conversione inversa: da un programma pytonIta (.pit) a un programma a mattonelle.

Si usa l'albero sintattico dell'interprete: ogni costrutto che ha una mattonella corrispondente diventa mattonella;
il resto (classi, costrutti rari...) viene conservato com'è in mattonelle «codice» / «espressione» oppure come
codice di modulo, così il programma convertito fa le stesse cose dell'originale.
"""
importa ast
importa io
importa re
importa textwrap
importa tokenize

da rad.mattonelle_modello importa (Mattonella, Programma, Funzione, collega_pila, definizione, ingressi_di,
                                   nome_variabile_valido, SLOT_VARI)

BINARI = {ast.Add: "somma", ast.Sub: "sottrai", ast.Mult: "moltiplica", ast.Div: "dividi", ast.FloorDiv: "dividi_intero",
          ast.Mod: "resto", ast.Pow: "potenza"}
OPERATORI_VARI = {ast.BitOr: "|", ast.BitAnd: "&", ast.BitXor: "^", ast.LShift: "<<", ast.RShift: ">>", ast.MatMult: "@"}
OPERATORI_AUMENTATI = {ast.Add: "+", ast.Sub: "-", ast.Mult: "*", ast.Div: "/", ast.FloorDiv: "//", ast.Mod: "%", ast.Pow: "**",
                       ast.BitOr: "|", ast.BitAnd: "&", ast.BitXor: "^", ast.LShift: "<<", ast.RShift: ">>", ast.MatMult: "@"}
CONFRONTI = {ast.Eq: "uguale", ast.NotEq: "diverso", ast.Lt: "minore", ast.Gt: "maggiore", ast.LtE: "minore_uguale",
             ast.GtE: "maggiore_uguale", ast.In: "contiene", ast.Is: "identico", ast.IsNot: "non_identico"}
UNARIE = {"tipo_intero": "intero_di", "int": "intero_di", "tipo_decimale": "decimale_di", "float": "decimale_di",
          "tipo_testo": "testo_di", "str": "testo_di", "lunghezza_di": "lunghezza_di", "len": "lunghezza_di",
          "arrotonda": "arrotonda", "round": "arrotonda", "valore_assoluto": "assoluto", "abs": "assoluto",
          "ordinato_di": "ordina_lista", "sorted": "ordina_lista", "somma_di": "somma_lista", "sum": "somma_lista"}
BINARIE = {"massimo_di": "massimo_di", "max": "massimo_di", "minimo_di": "minimo_di", "min": "minimo_di"}
METODI_TESTO = {"maiuscolo": "maiuscolo", "upper": "maiuscolo", "minuscolo": "minuscolo", "lower": "minuscolo"}


definisci _primo_ingresso(tipo_):
    """Nome del primo ingresso di un tipo di mattonella."""
    ritorna ingressi_di(definizione(tipo_))[0][1]


classe Convertitore:
    """Trasforma il testo di un programma pytonIta in un Programma a mattonelle."""

    definisci __inizializza__(se_stesso, sorgente, nome="programma"):
        se_stesso.sorgente = sorgente.replace("\r\n", "\n")
        se_stesso.righe = se_stesso.sorgente.split("\n")
        se_stesso.programma = Programma(nome)
        se_stesso.funzioni = {}            # nome -> numero di parametri
        se_stesso.commenti = {}            # riga -> testo dei commenti a riga intera
        se_stesso.moduli = set()           # nomi importati (moduli e simili): si chiamano per nome, come testo
        se_stesso.rapporto = {"funzioni": 0, "mattonelle": 0, "righe_libere": 0, "espressioni_libere": 0,
                              "commenti": 0, "classi_e_codice_di_modulo": 0, "libere": [], "avvisi": []}
        se_stesso._leggi_commenti()

    # ------------------------------------------------------------ utilità sul testo
    definisci _leggi_commenti(se_stesso):
        prova:
            per t in tokenize.generate_tokens(io.StringIO(se_stesso.sorgente).readline):
                se t.type == tokenize.COMMENT e se_stesso.righe[t.start[0] - 1].strip().startswith("#"):
                    se_stesso.commenti[t.start[0]] = t.string.lstrip("#").strip()
        eccetto (tokenize.TokenError, IndentationError, SyntaxError):
            passa

    definisci testo_di(se_stesso, nodo):
        """Le righe originali del nodo, con il rientro tolto."""
        righe = se_stesso.righe[nodo.lineno - 1:nodo.end_lineno]
        ritorna textwrap.dedent("\n".join(righe)).rstrip()

    definisci segmento(se_stesso, nodo):
        s = ast.get_source_segment(se_stesso.sorgente, nodo)
        ritorna s.strip() se s altrimenti "Nessuno"

    definisci nuova(se_stesso, tipo_):
        se_stesso.rapporto["mattonelle"] += 1
        ritorna Mattonella(tipo_, se_stesso.programma)

    definisci _collega(se_stesso, padre, slot, figlio):
        padre.ingressi[slot] = figlio
        figlio.padre, figlio.ruolo = padre, f"ingresso:{slot}"

    # ------------------------------------------------------------ espressioni
    definisci _tipo_slot(se_stesso, m, slot):
        per i in ingressi_di(definizione(m.tipo, se_stesso.programma)):
            se i[1] == slot:
                ritorna i[2]
        ritorna "valore"

    definisci ingresso(se_stesso, m, slot, nodo):
        """Collega l'espressione 'nodo' all'ingresso 'slot' di m (come valore scritto a mano o come mattonella)."""
        tipo_slot = se_stesso._tipo_slot(m, slot)
        numero = Nessuno
        se isinstance(nodo, ast.Constant) e isinstance(nodo.value, (int, float)) e non isinstance(nodo.value, bool):
            numero = repr(nodo.value)
        altrimenti_se (isinstance(nodo, ast.UnaryOp) e isinstance(nodo.op, ast.USub) e isinstance(nodo.operand, ast.Constant)
                       e isinstance(nodo.operand.value, (int, float)) e non isinstance(nodo.operand.value, bool)):
            numero = "-" + repr(nodo.operand.value)
        se numero è non Nessuno e tipo_slot in ("numero", "valore", "booleano"):
            m.letterali[slot] = numero
            ritorna
        se isinstance(nodo, ast.Constant) e isinstance(nodo.value, str) e tipo_slot == "testo":
            m.letterali[slot] = nodo.value
            ritorna
        se isinstance(nodo, ast.Constant) e (nodo.value è Nessuno o isinstance(nodo.value, bool)) e tipo_slot in ("valore", "booleano"):
            m.letterali[slot] = {Vero: "Vero", Falso: "Falso"}.get(nodo.value, "Nessuno") se nodo.value è non Nessuno altrimenti "Nessuno"
            ritorna
        se_stesso._collega(m, slot, se_stesso.espressione(nodo))

    definisci _libera(se_stesso, nodo):
        m = se_stesso.nuova("espressione")
        m.campi["testo"] = se_stesso.segmento(nodo)
        se_stesso.rapporto["espressioni_libere"] += 1
        se lunghezza_di(se_stesso.rapporto["libere"]) < 25:
            se_stesso.rapporto["libere"].append((nodo.lineno, m.campi["testo"][:70]))
        ritorna m

    definisci espressione(se_stesso, nodo):
        """Mattonella-valore per un'espressione (o 'espressione' libera se non c'è un equivalente)."""
        se isinstance(nodo, ast.Constant):
            v = nodo.value
            se isinstance(v, bool):
                ritorna se_stesso.nuova("vero" se v altrimenti "falso")
            se v è Nessuno:
                ritorna se_stesso.nuova("nessuno")
            se isinstance(v, (int, float)):
                m = se_stesso.nuova("numero")
                m.campi["valore"] = repr(v)
                ritorna m
            se isinstance(v, str):
                m = se_stesso.nuova("testo_lett")
                m.campi["valore"] = v
                ritorna m
            ritorna se_stesso._libera(nodo)
        se isinstance(nodo, ast.Name):
            m = se_stesso.nuova("variabile")
            m.campi["nome"] = nodo.id
            ritorna m
        se isinstance(nodo, ast.UnaryOp):
            se isinstance(nodo.op, ast.Not):
                m = se_stesso.nuova("non_logico")
                se_stesso.ingresso(m, "a", nodo.operand)
                ritorna m
            se isinstance(nodo.op, ast.USub) e isinstance(nodo.operand, ast.Constant) e isinstance(nodo.operand.value, (int, float)):
                m = se_stesso.nuova("numero")
                m.campi["valore"] = "-" + repr(nodo.operand.value)
                ritorna m
            se isinstance(nodo.op, ast.USub):
                m = se_stesso.nuova("negativo")
                se_stesso.ingresso(m, "a", nodo.operand)
                ritorna m
            ritorna se_stesso._libera(nodo)
        se isinstance(nodo, ast.BinOp) e tipo_di(nodo.op) in BINARI:
            m = se_stesso.nuova(BINARI[tipo_di(nodo.op)])
            se_stesso.ingresso(m, "a", nodo.left)
            se_stesso.ingresso(m, "b", nodo.right)
            ritorna m
        se isinstance(nodo, ast.Compare) e lunghezza_di(nodo.ops) == 1 e tipo_di(nodo.ops[0]) in CONFRONTI:
            m = se_stesso.nuova(CONFRONTI[tipo_di(nodo.ops[0])])
            se_stesso.ingresso(m, "a", nodo.left)
            se_stesso.ingresso(m, "b", nodo.comparators[0])
            ritorna m
        se isinstance(nodo, ast.BoolOp):
            tipo_ = "e_logico" se isinstance(nodo.op, ast.And) altrimenti "o_logico"
            acc = nodo.values[0]
            m = Nessuno
            per v in nodo.values[1:]:
                m = se_stesso.nuova(tipo_)
                se isinstance(acc, Mattonella):
                    se_stesso._collega(m, "a", acc)
                altrimenti:
                    se_stesso.ingresso(m, "a", acc)
                se_stesso.ingresso(m, "b", v)
                acc = m
            ritorna m
        se isinstance(nodo, ast.Subscript) e isinstance(nodo.slice, ast.Slice) e nodo.slice.step è Nessuno:
            m = se_stesso.nuova("fetta")
            se_stesso.ingresso(m, "obj", nodo.value)
            se nodo.slice.lower è non Nessuno:
                se_stesso.ingresso(m, "da", nodo.slice.lower)
            se nodo.slice.upper è non Nessuno:
                se_stesso.ingresso(m, "a", nodo.slice.upper)
            ritorna m
        se isinstance(nodo, ast.Subscript) e non isinstance(nodo.slice, (ast.Slice, ast.Tuple)):
            m = se_stesso.nuova("elemento_di")
            se_stesso.ingresso(m, "n", nodo.slice)
            se_stesso.ingresso(m, "lista", nodo.value)
            ritorna m
        se isinstance(nodo, ast.List) e lunghezza_di(nodo.elts) <= 12:
            se non nodo.elts:
                ritorna se_stesso.nuova("lista_vuota")
            m = se_stesso.nuova("lista_di")
            se_stesso._elementi(m, nodo.elts)
            ritorna m
        se isinstance(nodo, ast.Compare) e lunghezza_di(nodo.ops) == 1 e isinstance(nodo.ops[0], ast.NotIn):
            dentro = se_stesso.nuova("contiene")
            se_stesso.ingresso(dentro, "a", nodo.left)
            se_stesso.ingresso(dentro, "b", nodo.comparators[0])
            m = se_stesso.nuova("non_logico")
            se_stesso._collega(m, "a", dentro)
            ritorna m
        se isinstance(nodo, ast.Compare) e lunghezza_di(nodo.ops) == 2 e tipo_di(nodo.ops[0]) è ast.LtE e tipo_di(nodo.ops[1]) è ast.LtE:
            m = se_stesso.nuova("tra")
            se_stesso.ingresso(m, "a", nodo.left)
            se_stesso.ingresso(m, "x", nodo.comparators[0])
            se_stesso.ingresso(m, "b", nodo.comparators[1])
            ritorna m
        se isinstance(nodo, ast.Attribute):
            m = se_stesso.nuova("attributo")
            m.campi["nome"] = nodo.attr
            se_stesso.ingresso(m, "obj", nodo.value)
            ritorna m
        se isinstance(nodo, ast.Tuple) e lunghezza_di(nodo.elts) <= 12 e non any(isinstance(elemento, ast.Starred) per elemento in nodo.elts):
            m = se_stesso.nuova("tupla")
            se_stesso._elementi(m, nodo.elts)
            ritorna m
        se isinstance(nodo, ast.Set) e 1 <= lunghezza_di(nodo.elts) <= 12:
            m = se_stesso.nuova("insieme_di")
            se_stesso._elementi(m, nodo.elts)
            ritorna m
        se isinstance(nodo, ast.JoinedStr):
            m = se_stesso._frase(nodo)
            se m è non Nessuno:
                ritorna m
        se isinstance(nodo, ast.BinOp) e tipo_di(nodo.op) in OPERATORI_VARI:
            m = se_stesso.nuova("operatore")
            m.campi["op"] = OPERATORI_VARI[tipo_di(nodo.op)]
            se_stesso.ingresso(m, "a", nodo.left)
            se_stesso.ingresso(m, "b", nodo.right)
            ritorna m
        se (isinstance(nodo, ast.DictComp) e lunghezza_di(nodo.generators) == 1 e non nodo.generators[0].is_async
                e lunghezza_di(nodo.generators[0].ifs) <= 1):
            g = nodo.generators[0]
            m = se_stesso.nuova("dizionario_da")
            m.campi["var"] = se_stesso.segmento(g.target)
            se_stesso.ingresso(m, "k", nodo.key)
            se_stesso.ingresso(m, "v", nodo.value)
            se_stesso.ingresso(m, "elenco", g.iter)
            se g.ifs:
                se_stesso.ingresso(m, "cond", g.ifs[0])
            ritorna m
        se isinstance(nodo, ast.Starred):
            m = se_stesso.nuova("spacchetta")
            se_stesso.ingresso(m, "v", nodo.value)
            ritorna m
        se isinstance(nodo, ast.Dict) e 1 <= lunghezza_di(nodo.keys) <= 12:
            m = se_stesso.nuova("dizionario")
            voci = []
            per k, v in zip(nodo.keys, nodo.values):
                se k è Nessuno:
                    t = se_stesso.nuova("spacchetta_dizionario")
                    se_stesso.ingresso(t, "v", v)
                altrimenti:
                    t = se_stesso.nuova("coppia")
                    se_stesso.ingresso(t, "k", k)
                    se_stesso.ingresso(t, "v", v)
                voci.append(t)
            per slot, t in zip(SLOT_VARI, voci):
                se_stesso._collega(m, slot, t)
            ritorna m
        se isinstance(nodo, ast.IfExp):
            m = se_stesso.nuova("valore_se")
            se_stesso.ingresso(m, "a", nodo.body)
            se_stesso.ingresso(m, "cond", nodo.test)
            se_stesso.ingresso(m, "b", nodo.orelse)
            ritorna m
        se isinstance(nodo, ast.Lambda) e se_stesso._parametri(nodo) è non Nessuno:
            m = se_stesso.nuova("funzione_anonima")
            m.campi["parametri"] = se_stesso._parametri(nodo)
            se_stesso.ingresso(m, "corpo", nodo.body)
            ritorna m
        se (isinstance(nodo, (ast.ListComp, ast.SetComp, ast.GeneratorExp)) e lunghezza_di(nodo.generators) == 1
                e non nodo.generators[0].is_async e lunghezza_di(nodo.generators[0].ifs) <= 1):
            g = nodo.generators[0]
            tipo_ = {ast.ListComp: "lista_da", ast.SetComp: "insieme_da", ast.GeneratorExp: "generatore_da"}[tipo_di(nodo)]
            m = se_stesso.nuova(tipo_)
            m.campi["var"] = se_stesso.segmento(g.target)
            se_stesso.ingresso(m, "espr", nodo.elt)
            se_stesso.ingresso(m, "elenco", g.iter)
            se g.ifs:
                se_stesso.ingresso(m, "cond", g.ifs[0])
            ritorna m
        se isinstance(nodo, ast.Call):
            m = se_stesso._chiamata(nodo)
            se m è non Nessuno:
                ritorna m
        ritorna se_stesso._libera(nodo)

    definisci _elementi(se_stesso, m, elementi):
        """Collega gli elementi di una lista, tupla o insieme agli ingressi a, b, c… della mattonella."""
        per slot, elemento in zip(SLOT_VARI, elementi):
            se_stesso.ingresso(m, slot, elemento)

    definisci _frase(se_stesso, nodo):
        """f-string -> mattonella «frase»: modello con {a}, {b}… e i valori negli ingressi. Nessuno se non ci sta."""
        valori = [v per v in nodo.values se isinstance(v, ast.FormattedValue)]
        se lunghezza_di(valori) > 6:
            ritorna Nessuno
        modello = ""
        da_collegare = []
        per v in nodo.values:
            se isinstance(v, ast.Constant):
                modello += tipo_testo(v.value).replace("{", "{{").replace("}", "}}")
            altrimenti:
                se v.format_spec è non Nessuno e any(isinstance(x, ast.FormattedValue) per x in v.format_spec.values):
                    ritorna Nessuno
                lettera = "abcdef"[lunghezza_di(da_collegare)]
                da_collegare.append(v.value)
                conv = {115: "!s", 114: "!r", 97: "!a"}.get(v.conversion, "")
                spec = ""
                se v.format_spec è non Nessuno:
                    spec = ":" + "".join(tipo_testo(x.value) per x in v.format_spec.values)
                modello += "{" + lettera + conv + spec + "}"
        m = se_stesso.nuova("testo_f")
        m.campi["modello"] = modello
        per lettera, elemento in zip("abcdef", da_collegare):
            se_stesso.ingresso(m, lettera, elemento)
        ritorna m

    definisci _radice_modulo(se_stesso, f):
        """Vero se f è un nome (o nome.attributo...) che parte da un modulo importato, una funzione o una classe del programma."""
        mentre isinstance(f, ast.Attribute):
            f = f.value
        ritorna isinstance(f, ast.Name) e (f.id in se_stesso.moduli o f.id in se_stesso.funzioni o se_stesso.programma.classe_(f.id) è non Nessuno)

    definisci _chiamata_generale(se_stesso, c, istruzione):
        """Chiamata con qualsiasi argomento (anche nome=valore) come mattonella chiama / chiama_su. Nessuno se non si può."""
        f = c.func
        argomenti = [("pos", a) per a in c.args] + [("kw", k) per k in c.keywords]
        se isinstance(f, ast.Name) o (isinstance(f, ast.Attribute) e se_stesso._nome_chiamabile(f) e se_stesso._radice_modulo(f)):
            se lunghezza_di(argomenti) > 12:
                ritorna Nessuno
            m = se_stesso.nuova("chiama" se istruzione altrimenti "chiamata")
            m.campi["nome"] = se_stesso.segmento(f)
            slots = SLOT_VARI
        altrimenti_se isinstance(f, ast.Attribute):
            se lunghezza_di(argomenti) > 12:
                ritorna Nessuno
            m = se_stesso.nuova("chiama_su" se istruzione altrimenti "chiamata_su")
            m.campi["nome"] = f.attr
            se_stesso.ingresso(m, "obj", f.value)
            slots = SLOT_VARI
        altrimenti:
            ritorna Nessuno
        per slot, (genere, a) in zip(slots, argomenti):
            se genere == "pos":
                se_stesso.ingresso(m, slot, a)
            altrimenti_se a.arg è Nessuno:
                valore = se_stesso.nuova("spacchetta_dizionario")
                se_stesso.ingresso(valore, "v", a.value)
                se_stesso._collega(m, slot, valore)
            altrimenti:
                valore = se_stesso.nuova("opzione")
                valore.campi["nome"] = a.arg
                se_stesso.ingresso(valore, "val", a.value)
                se_stesso._collega(m, slot, valore)
        ritorna m

    definisci _semplice(se_stesso, chiamata):
        """Vero se la chiamata ha solo argomenti posizionali (niente nome=valore, *args)."""
        ritorna non chiamata.keywords e non any(isinstance(a, ast.Starred) per a in chiamata.args)

    definisci _chiamata(se_stesso, c):
        f = c.func
        n = lunghezza_di(c.args)
        se isinstance(f, ast.Name) e se_stesso._semplice(c):
            nome = f.id
            se nome in ("leggi_tastiera", "input") e n <= 1:
                m = se_stesso.nuova("leggi")
                se n:
                    se_stesso.ingresso(m, "messaggio", c.args[0])
                ritorna m
            se nome in UNARIE e n == 1:
                m = se_stesso.nuova(UNARIE[nome])
                se_stesso.ingresso(m, _primo_ingresso(m.tipo), c.args[0])
                ritorna m
            se nome in BINARIE e n == 2:
                m = se_stesso.nuova(BINARIE[nome])
                se_stesso.ingresso(m, "a", c.args[0])
                se_stesso.ingresso(m, "b", c.args[1])
                ritorna m
            se nome in ("intervallo_di", "range") e n == 2:
                m = se_stesso.nuova("intervallo")
                se_stesso.ingresso(m, "a", c.args[0])
                se_stesso.ingresso(m, "b", c.args[1])
                ritorna m
            se nome in se_stesso.funzioni e se_stesso.funzioni[nome] == n:
                m = se_stesso.nuova("fnv:" + nome)
                per i, a in enumera(c.args):
                    se_stesso.ingresso(m, f"p{i}", a)
                ritorna m
        se isinstance(f, ast.Attribute) e se_stesso._semplice(c):
            se f.attr == "intero_casuale" e isinstance(f.value, ast.Name) e f.value.id == "casuale" e n == 2:
                m = se_stesso.nuova("casuale_tra")
                se_stesso.ingresso(m, "a", c.args[0])
                se_stesso.ingresso(m, "b", c.args[1])
                ritorna m
        ritorna se_stesso._chiamata_generale(c, Falso)

    definisci _nome_chiamabile(se_stesso, f):
        """Nome semplice o catena di attributi (a.b.c): si può scrivere nel campo di una mattonella «chiama»."""
        mentre isinstance(f, ast.Attribute):
            f = f.value
        ritorna isinstance(f, ast.Name)

    # ------------------------------------------------------------ istruzioni
    definisci _riga_libera(se_stesso, nodo):
        m = se_stesso.nuova("codice")
        m.campi["testo"] = se_stesso.testo_di(nodo)
        se_stesso.rapporto["righe_libere"] += 1
        se lunghezza_di(se_stesso.rapporto["libere"]) < 25:
            se_stesso.rapporto["libere"].append((nodo.lineno, m.campi["testo"].split("\n")[0][:70]))
        ritorna [m]

    definisci corpo(se_stesso, nodi, commenti=Vero):
        """Lista di mattonelle per una sequenza di istruzioni (con i commenti che le precedono)."""
        tessere = []
        per n in nodi:
            se commenti:
                tessere.extend(se_stesso._commenti_prima(n))
            tessere.extend(se_stesso.istruzione(n))
        ritorna tessere

    definisci _commenti_prima(se_stesso, nodo):
        righe = []
        r = nodo.lineno - 1
        mentre r >= 1 e r in se_stesso.commenti:
            righe.append(r)
            r -= 1
        tessere = []
        per r in reversed(righe):
            m = se_stesso.nuova("commento")
            m.campi["testo"] = se_stesso.commenti[r]
            se_stesso.rapporto["commenti"] += 1
            tessere.append(m)
        ritorna tessere

    definisci _riempi(se_stesso, m, nome_corpo, nodi):
        pila = se_stesso.corpo(nodi)
        m.corpi[nome_corpo] = pila
        collega_pila(pila, m, f"corpo:{nome_corpo}")

    definisci istruzione(se_stesso, nodo):
        """Lista di mattonelle (di solito una) per un'istruzione."""
        se isinstance(nodo, ast.Expr) e isinstance(nodo.value, ast.Call):
            c = nodo.value
            f = c.func
            n = lunghezza_di(c.args)
            se isinstance(f, ast.Name) e se_stesso._semplice(c):
                se f.id in ("stampa", "print") e 1 <= n <= 3:
                    m = se_stesso.nuova("stampa")
                    per slot, a in zip(("valore", "valore2", "valore3"), c.args):
                        se_stesso.ingresso(m, slot, a)
                    ritorna [m]
                se f.id in se_stesso.funzioni e se_stesso.funzioni[f.id] == n:
                    m = se_stesso.nuova("fn:" + f.id)
                    per i, a in enumera(c.args):
                        se_stesso.ingresso(m, f"p{i}", a)
                    ritorna [m]
            se isinstance(f, ast.Attribute) e f.attr in ("aggiungi", "append") e n == 1 e se_stesso._semplice(c):
                m = se_stesso.nuova("aggiungi_a_lista")
                se_stesso.ingresso(m, "valore", c.args[0])
                se_stesso.ingresso(m, "lista", f.value)
                ritorna [m]
            m = se_stesso._chiamata_generale(c, Vero)
            se m è non Nessuno:
                ritorna [m]
        se isinstance(nodo, ast.Assign) e lunghezza_di(nodo.targets) == 1 e isinstance(nodo.targets[0], ast.Name):
            m = se_stesso.nuova("imposta")
            m.campi["var"] = nodo.targets[0].id
            se_stesso.ingresso(m, "valore", nodo.value)
            ritorna [m]
        se (isinstance(nodo, ast.Assign) e lunghezza_di(nodo.targets) == 1 e isinstance(nodo.targets[0], (ast.Attribute, ast.Subscript, ast.Tuple))
                e non isinstance(getattr(nodo.targets[0], "slice", Nessuno), ast.Slice)
                e non any(isinstance(x, (ast.Starred, ast.Slice)) per x in ast.walk(nodo.targets[0]))):
            m = se_stesso.nuova("assegna")
            se_stesso.ingresso(m, "dest", nodo.targets[0])
            se_stesso.ingresso(m, "val", nodo.value)
            ritorna [m]
        se (isinstance(nodo, ast.AugAssign) e non (isinstance(nodo.target, ast.Name) e isinstance(nodo.op, ast.Add))
                e (tipo_di(nodo.op) in BINARI o tipo_di(nodo.op) in OPERATORI_VARI)
                e isinstance(nodo.target, (ast.Name, ast.Attribute, ast.Subscript))
                e non any(isinstance(x, ast.Slice) per x in ast.walk(nodo.target))):
            m = se_stesso.nuova("aumenta")
            m.campi["op"] = OPERATORI_AUMENTATI[tipo_di(nodo.op)]
            se_stesso.ingresso(m, "dest", nodo.target)
            se_stesso.ingresso(m, "val", nodo.value)
            ritorna [m]
        se isinstance(nodo, ast.AugAssign) e isinstance(nodo.target, ast.Name) e isinstance(nodo.op, ast.Add):
            m = se_stesso.nuova("cambia")
            m.campi["var"] = nodo.target.id
            se_stesso.ingresso(m, "valore", nodo.value)
            ritorna [m]
        se isinstance(nodo, ast.If):
            m = se_stesso.nuova("se_altrimenti" se nodo.orelse altrimenti "se")
            se_stesso.ingresso(m, "cond", nodo.test)
            se_stesso._riempi(m, "corpo", nodo.body)
            se nodo.orelse:
                se_stesso._riempi(m, "altro", nodo.orelse)
            ritorna [m]
        se isinstance(nodo, ast.For) e (nodo.orelse o non isinstance(nodo.target, ast.Name)):
            m = se_stesso.nuova("per_ogni")
            se isinstance(nodo.target, ast.Tuple) e lunghezza_di(nodo.target.elts) == 1 e isinstance(nodo.target.elts[0], ast.Name):
                m.campi["var"] = "(" + nodo.target.elts[0].id + ",)"
            altrimenti:
                m.campi["var"] = se_stesso.segmento(nodo.target)
            se_stesso.ingresso(m, "elenco", nodo.iter)
            se_stesso._riempi(m, "corpo", nodo.body)
            se nodo.orelse:
                se_stesso._riempi(m, "altro", nodo.orelse)
            ritorna [m]
        se isinstance(nodo, ast.For) e isinstance(nodo.target, ast.Name):
            it = nodo.iter
            se (nodo.target.id == "_" e isinstance(it, ast.Call) e isinstance(it.func, ast.Name) e it.func.id in ("intervallo_di", "range")
                    e lunghezza_di(it.args) == 1 e se_stesso._semplice(it)):
                m = se_stesso.nuova("ripeti")
                se_stesso.ingresso(m, "n", it.args[0])
            altrimenti:
                m = se_stesso.nuova("per_ogni")
                m.campi["var"] = nodo.target.id
                se_stesso.ingresso(m, "elenco", it)
            se_stesso._riempi(m, "corpo", nodo.body)
            ritorna [m]
        se isinstance(nodo, ast.While):
            m = se_stesso.nuova("mentre")
            se_stesso.ingresso(m, "cond", nodo.test)
            se_stesso._riempi(m, "corpo", nodo.body)
            se nodo.orelse:
                se_stesso._riempi(m, "altro", nodo.orelse)
            ritorna [m]
        se isinstance(nodo, ast.Break):
            ritorna [se_stesso.nuova("interrompi")]
        se isinstance(nodo, ast.Continue):
            ritorna [se_stesso.nuova("continua")]
        se isinstance(nodo, ast.Pass):
            ritorna [se_stesso.nuova("passa")]
        se isinstance(nodo, ast.Return):
            m = se_stesso.nuova("ritorna")
            se nodo.value è non Nessuno:
                se_stesso.ingresso(m, "valore", nodo.value)
            ritorna [m]
        se isinstance(nodo, ast.Global):
            tessere = []
            per nome in nodo.names:
                m = se_stesso.nuova("globale")
                m.campi["var"] = nome
                tessere.append(m)
            ritorna tessere
        se isinstance(nodo, ast.Try) e lunghezza_di(nodo.handlers) <= 1 e non nodo.orelse e (nodo.handlers o nodo.finalbody):
            h = nodo.handlers[0] se nodo.handlers altrimenti Nessuno
            se h è Nessuno o h.type è Nessuno o non any(isinstance(x, ast.Starred) per x in ast.walk(h.type)):
                m = se_stesso.nuova("prova")
                se h è non Nessuno:
                    m.campi["tipo"] = se_stesso.segmento(h.type) se h.type è non Nessuno altrimenti ""
                    m.campi["come"] = h.name o ""
                se_stesso._riempi(m, "corpo", nodo.body)
                se h è non Nessuno:
                    se_stesso._riempi(m, "errore", h.body)
                se nodo.finalbody:
                    se_stesso._riempi(m, "infine", nodo.finalbody)
                ritorna [m]
        se isinstance(nodo, ast.Raise) e nodo.cause è Nessuno:
            m = se_stesso.nuova("solleva")
            se nodo.exc è non Nessuno:
                se_stesso.ingresso(m, "eccezione", nodo.exc)
            ritorna [m]
        se isinstance(nodo, ast.Delete):
            tessere = []
            per t in nodo.targets:
                m = se_stesso.nuova("elimina")
                se_stesso.ingresso(m, "v", t)
                tessere.append(m)
            ritorna tessere
        se isinstance(nodo, ast.Expr) e isinstance(nodo.value, (ast.Yield, ast.YieldFrom)) e nodo.value.value è non Nessuno:
            m = se_stesso.nuova("produci" se isinstance(nodo.value, ast.Yield) altrimenti "produci_da")
            se_stesso.ingresso(m, "v", nodo.value.value)
            ritorna [m]
        se isinstance(nodo, ast.Import):
            m = se_stesso.nuova("importa")
            m.campi["modulo"] = ", ".join(a_.name + (" come " + a_.asname se a_.asname altrimenti "") per a_ in nodo.names)
            ritorna [m]
        se isinstance(nodo, ast.ImportFrom) e nodo.module è non Nessuno e nodo.level == 0:
            m = se_stesso.nuova("da_importa")
            m.campi["modulo"] = nodo.module
            m.campi["nomi"] = ", ".join(a_.name + (" come " + a_.asname se a_.asname altrimenti "") per a_ in nodo.names)
            ritorna [m]
        se isinstance(nodo, ast.With) e lunghezza_di(nodo.items) == 1:
            it = nodo.items[0]
            elemento = it.context_expr
            se (isinstance(elemento, ast.Call) e isinstance(elemento.func, ast.Name) e elemento.func.id in ("apri", "open") e lunghezza_di(elemento.args) == 1
                    e se_stesso._semplice(elemento) e isinstance(it.optional_vars, ast.Name)):
                m = se_stesso.nuova("con_file")
                m.campi["var"] = it.optional_vars.id
                se_stesso.ingresso(m, "nome", elemento.args[0])
                se_stesso._riempi(m, "corpo", nodo.body)
                ritorna [m]
        se isinstance(nodo, ast.With):
            esterno = Nessuno
            interno = Nessuno
            per it in nodo.items:
                c = se_stesso.nuova("con_blocco")
                se_stesso.ingresso(c, "espr", it.context_expr)
                c.campi["var"] = se_stesso.segmento(it.optional_vars) se it.optional_vars è non Nessuno altrimenti ""
                se interno è Nessuno:
                    esterno = c
                altrimenti:
                    interno.corpi["corpo"] = [c]
                    collega_pila(interno.corpi["corpo"], interno, "corpo:corpo")
                interno = c
            se_stesso._riempi(interno, "corpo", nodo.body)
            ritorna [esterno]
        ritorna se_stesso._riga_libera(nodo)

    # ------------------------------------------------------------ funzioni
    definisci _parametri(se_stesso, f):
        """Testo dei parametri di una funzione semplice, oppure Nessuno se non è convertibile."""
        a = f.args
        se a.posonlyargs:
            ritorna Nessuno
        pezzi = []
        n_pos = lunghezza_di(a.args)
        n_def = lunghezza_di(a.defaults)
        per i, arg in enumera(a.args):
            k = i - (n_pos - n_def)
            pezzi.append(arg.arg + ("=" + se_stesso.segmento(a.defaults[k]) se k >= 0 altrimenti ""))
        se a.vararg:
            pezzi.append("*" + a.vararg.arg)
        altrimenti_se a.kwonlyargs:
            pezzi.append("*")
        per arg, d in zip(a.kwonlyargs, a.kw_defaults):
            pezzi.append(arg.arg + ("=" + se_stesso.segmento(d) se d è non Nessuno altrimenti ""))
        se a.kwarg:
            pezzi.append("**" + a.kwarg.arg)
        ritorna ", ".join(pezzi)

    definisci _convertibile(se_stesso, nodo):
        ritorna (isinstance(nodo, ast.FunctionDef) e non nodo.decorator_list e se_stesso._parametri(nodo) è non Nessuno)

    definisci _classe_convertibile(se_stesso, n):
        """Una classe diventa classe a mattonelle se i suoi metodi sono semplici e senza nomi doppi."""
        se non isinstance(n, ast.ClassDef) o n.keywords o n.decorator_list:
            ritorna Falso
        se se_stesso.programma.classe_(n.name) o se_stesso.programma.funzione(n.name):
            ritorna Falso
        nomi = []
        per x in n.body:
            se isinstance(x, ast.AsyncFunctionDef):
                ritorna Falso
            se isinstance(x, ast.FunctionDef):
                se x.name in nomi o se_stesso._parametri(x) è Nessuno o non nome_variabile_valido(x.name):
                    ritorna Falso
                nomi.append(x.name)
        ritorna non any(isinstance(b, ast.Starred) per b in n.bases)

    definisci _registra_classe(se_stesso, n):
        """Crea la classe e i suoi metodi (corpi ancora vuoti). Ritorna la lista (nodo, Funzione) dei metodi."""
        p = se_stesso.programma
        base = ", ".join(se_stesso.segmento(b) per b in n.bases)
        attributi = []
        per x in n.body:
            se non isinstance(x, ast.FunctionDef):
                attributi.append(se_stesso.testo_di(x))
        p.aggiungi_classe(n.name, base, "\n".join(attributi))
        metodi = []
        per x in n.body:
            se isinstance(x, ast.FunctionDef):
                decoratori = "\n".join("@" + se_stesso.segmento(d) per d in x.decorator_list)
                f = p.aggiungi_metodo(n.name, x.name, se_stesso._parametri(x), decoratori)
                metodi.append((x, f))
        ritorna metodi

    # ------------------------------------------------------------ programma intero
    definisci converti(se_stesso):
        albero = compile(se_stesso.sorgente, "<conversione>", "exec", ast.PyCF_ONLY_AST)
        p = se_stesso.programma
        per x in ast.walk(albero):
            se isinstance(x, ast.Import):
                se_stesso.moduli.update((a_.asname o a_.name).split(".")[0] per a_ in x.names)
            altrimenti_se isinstance(x, ast.ImportFrom):
                se_stesso.moduli.update(a_.asname o a_.name per a_ in x.names)
        nodi = albero.body
        # 1) registra le funzioni convertibili (nome e parametri), così le chiamate trovano la definizione
        funzioni = []
        per n in nodi:
            se se_stesso._convertibile(n) e non p.funzione(n.name):
                f = Funzione(n.name, se_stesso._parametri(n))
                p.funzioni.append(f)
                se_stesso.funzioni[n.name] = lunghezza_di(f.parametri())
                funzioni.append((n, f))
        classi_convertite = []
        per n in nodi:
            se se_stesso._classe_convertibile(n):
                classi_convertite.append(n)
                funzioni.extend(se_stesso._registra_classe(n))
        # 2) il resto del modulo
        flusso = []
        per i, n in enumera(nodi):
            se isinstance(n, (ast.Import, ast.ImportFrom)):
                p.importazioni.append(se_stesso.testo_di(n))
            altrimenti_se se_stesso._convertibile(n) e p.funzione(n.name) e n in [x[0] per x in funzioni]:
                continua
            altrimenti_se isinstance(n, ast.Expr) e isinstance(n.value, ast.Constant) e isinstance(n.value.value, str) e i == 0:
                continua                                  # docstring del modulo
            altrimenti_se n in classi_convertite:
                se_stesso.rapporto["classi"] = se_stesso.rapporto.get("classi", 0) + 1
            altrimenti_se isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                p.codice_iniziale += se_stesso.testo_di(n) + "\n\n\n"
                se_stesso.rapporto["classi_e_codice_di_modulo"] += 1
            altrimenti_se se_stesso._è_costante(n):
                p.codice_iniziale += se_stesso.testo_di(n) + "\n"
                se_stesso.rapporto["classi_e_codice_di_modulo"] += 1
            altrimenti_se (isinstance(n, ast.If) e isinstance(n.test, ast.Compare) e isinstance(n.test.left, ast.Name)
                         e n.test.left.id == "__name__" e n.orelse == []):
                flusso.extend(se_stesso.corpo(n.body))     # il blocco "se __nome__ == '__main__'" è già generato
            altrimenti:
                flusso.extend(se_stesso.corpo([n]))
        # 3) corpi delle funzioni
        per n, f in funzioni:
            corpo = n.body
            tessere = []
            se (corpo e isinstance(corpo[0], ast.Expr) e isinstance(corpo[0].value, ast.Constant) e isinstance(corpo[0].value.value, str)):
                c = se_stesso.nuova("commento")
                c.campi["testo"] = corpo[0].value.value.strip().split("\n")[0][:100]
                tessere.append(c)
                corpo = corpo[1:]
            tessere.extend(se_stesso.corpo(corpo))
            cap = f.area.cappello
            cap.lista.extend(tessere)
            collega_pila(cap.lista, cap.padre, "radice")
            se_stesso.rapporto["funzioni"] += 1
        cap = p.principale.cappello
        cap.lista.extend(flusso)
        collega_pila(cap.lista, cap.padre, "radice")
        # 4) variabili assegnate nel flusso principale e usate dalle funzioni = globali
        se_stesso._variabili_globali(nodi, funzioni)
        ritorna p

    definisci _è_costante(se_stesso, nodo):
        """Assegnazioni di modulo 'COSTANTE = ...' o '_nome = ...': restano codice di modulo."""
        se isinstance(nodo, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
            bersagli = nodo.targets se isinstance(nodo, ast.Assign) altrimenti [nodo.target]
            ritorna tutti_veri(isinstance(t, ast.Name) e (t.id.isupper() o t.id.startswith("_")) per t in bersagli)
        ritorna Falso

    definisci _nomi_liberi(se_stesso, f):
        """Nomi letti in una funzione che non sono suoi parametri né variabili locali."""
        a = f.args
        locali = {x.arg per x in a.posonlyargs + a.args + a.kwonlyargs}
        se a.vararg:
            locali.add(a.vararg.arg)
        se a.kwarg:
            locali.add(a.kwarg.arg)
        globali = set()
        corpo = f.body se isinstance(f.body, tipo_lista) altrimenti [f.body]
        per n in corpo:
            per x in ast.walk(n):
                se isinstance(x, (ast.Global, ast.Nonlocal)):
                    globali.update(x.names)
        per n in corpo:
            per x in ast.walk(n):
                se isinstance(x, ast.Name) e isinstance(x.ctx, (ast.Store, ast.Del)) e x.id non in globali:
                    locali.add(x.id)
        letti = set()
        per n in corpo:
            per x in ast.walk(n):
                se isinstance(x, ast.Name) e isinstance(x.ctx, ast.Load) e x.id non in locali:
                    letti.add(x.id)
        ritorna letti | globali

    definisci _variabili_globali(se_stesso, nodi, funzioni):
        usati = set()
        per n in nodi:
            se isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                per g in ast.walk(n):
                    se isinstance(g, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
                        usati |= se_stesso._nomi_liberi(g)
        assegnati = []
        per n in nodi:
            se isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Import, ast.ImportFrom)) o se_stesso._è_costante(n):
                continua
            per x in ast.walk(n):
                se isinstance(x, ast.Name) e isinstance(x.ctx, ast.Store) e x.id non in assegnati:
                    assegnati.append(x.id)
        p = se_stesso.programma
        for_nomi = [x per x in assegnati se x in usati]
        per nome in for_nomi:
            p.variabili_globali.append(nome)
        # avviso: una funzione assegna lo stesso nome senza dichiararlo globale
        per n, f in funzioni:
            dichiarati = set()
            per x in ast.walk(n):
                se isinstance(x, ast.Global):
                    dichiarati.update(x.names)
            per x in ast.walk(n):
                se isinstance(x, ast.Name) e isinstance(x.ctx, ast.Store) e x.id in for_nomi e x.id non in dichiarati:
                    se_stesso.rapporto["avvisi"].append(f"«{x.id}» è assegnata nella funzione {n.name} come variabile locale, "
                                                        "ma è anche una variabile globale del flusso principale: controlla.")
                    interrompi


definisci converti_sorgente(sorgente, nome="programma"):
    """(Programma, rapporto). Solleva SyntaxError se il sorgente non è pytonIta valido."""
    c = Convertitore(sorgente, nome)
    p = c.converti()
    ritorna p, c.rapporto


definisci descrivi_rapporto(r):
    """Testo leggibile del rapporto di conversione."""
    righe = [f"Funzioni convertite: {r['funzioni']}",
             f"Mattonelle create: {r['mattonelle']}",
             f"Commenti conservati: {r['commenti']}"]
    se r.get("classi"):
        righe.append(f"Classi convertite in mattonelle (un metodo per pagina): {r['classi']}")
    se r["classi_e_codice_di_modulo"]:
        righe.append(f"Classi e costanti lasciate come codice di modulo: {r['classi_e_codice_di_modulo']}")
    libere = r["righe_libere"] + r["espressioni_libere"]
    se libere:
        righe.append(f"Parti conservate come testo (senza mattonella equivalente): {r['righe_libere']} istruzioni, "
                     f"{r['espressioni_libere']} espressioni")
        per riga, t in r["libere"][:8]:
            righe.append(f"   riga {riga}: {t}")
    per a in r["avvisi"][:5]:
        righe.append("⚠ " + a)
    ritorna "\n".join(righe)
