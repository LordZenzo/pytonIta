"""Crea una maschera (finestra del progettista) collegata a una tabella: barra di navigazione con ricerca, elenco dei record e un campo per ogni colonna.
Usa i componenti dei dati (FonteDati, BarraNavigazione e i componenti con «Fonte» e «Campo»): la maschera si modifica poi nel progettista come ogni altra finestra."""
importa os
importa re
importa shutil

da rad importa form_modello

LARGHEZZA = 780


definisci nome_campo(colonna):
    """Nome valido (e senza parole riservate) per il componente di una colonna: campo_<colonna>."""
    pulito = re.sub(r"\W", "_", colonna)
    ritorna "campo_" + pulito


definisci nome_etichetta(colonna):
    ritorna "etichetta_" + re.sub(r"\W", "_", colonna)


definisci disegna_form(nome_form, titolo, tabella, nomi_colonne, dialetto="sqlite", database="", parametri=Nessuno):
    """Il Form del progettista: navigazione in alto, elenco, campi (una o due colonne di campi), tutti legati alla fonte dati."""
    f = form_modello.Form(nome_form, titolo)
    n = lunghezza_di(nomi_colonne)
    su_due = n > 6
    righe_campi = (n + 1) // 2 se su_due altrimenti n
    y_elenco = 58
    h_elenco = 190
    y_campi = y_elenco + h_elenco + 16
    f.aspetto = "chiaro"
    f.larghezza = LARGHEZZA
    f.altezza = y_campi + righe_campi * 34 + 24
    valori = {"database": database, "tabella": tabella}
    se dialetto in ("mysql", "postgres") e parametri:
        server, porta, utente, nome_db = parametri
        valori.update({"dialetto": dialetto, "server": server, "porta": int(porta), "utente": utente, "database": nome_db})
    f.aggiungi("FonteDati", LARGHEZZA - 150, 4, nome="fonte", **valori)
    f.aggiungi("BarraNavigazione", 16, 12, nome="barra", larghezza=LARGHEZZA - 32, altezza=34, fonte="fonte", cerca=Vero, ancoraggio="sad")
    visibili = nomi_colonne[:8]
    f.aggiungi("Albero", 16, y_elenco, nome="elenco_dati", larghezza=LARGHEZZA - 32, altezza=h_elenco, colonne=tipo_lista(visibili), fonte="fonte",
               larghezze=[max(60, min(200, (LARGHEZZA - 60) // lunghezza_di(visibili))) per _ in visibili], allineamenti=["w"] * lunghezza_di(visibili))
    per i, colonna in enumera(nomi_colonne):
        blocco = i // righe_campi se su_due altrimenti 0
        riga = i % righe_campi se su_due altrimenti i
        x0 = 16 + blocco * 380
        y = y_campi + riga * 34
        f.aggiungi("Etichetta", x0, y + 2, nome=nome_etichetta(colonna), testo=colonna, larghezza=120, altezza=24)
        f.aggiungi("CampoTesto", x0 + 124, y, nome=nome_campo(colonna), larghezza=226 se su_due altrimenti 300, altezza=26, fonte="fonte", campo=colonna)
    ritorna f


definisci crea_maschera(cartella, nome_form, tabella, nomi_colonne, dialetto="sqlite", db_percorso="", parametri=Nessuno):
    """Scrive nel progetto `cartella` la maschera (form.json, UI generata, logica) e fonte_dati.pit. Ritorna {"form": ..., "logica": ..., "fonte": ..., "scritti": [...]}."""
    db_relativo = db_percorso
    se dialetto == "sqlite" e db_percorso:
        prova:
            relativo = os.path.relpath(db_percorso, cartella)
        eccetto ValueError:
            relativo = db_percorso
        db_relativo = (relativo.replace("\\", "/")) se non relativo.startswith("..") e non os.path.isabs(relativo) altrimenti db_percorso
    f = disegna_form(nome_form, "Maschera: " + tabella, tabella, nomi_colonne, dialetto, db_relativo, parametri)
    p = form_modello.percorsi_form(cartella, nome_form)
    se os.path.exists(p["logica"]) o os.path.exists(p["json"]):
        solleva FileExistsError(f"Esiste già una finestra chiamata «{nome_form}».")
    scritti = form_modello.salva_form(f, cartella)
    ritorna {"form": p["json"], "logica": p["logica"], "fonte": os.path.join(cartella, "fonte_dati.pit"), "scritti": scritti}
