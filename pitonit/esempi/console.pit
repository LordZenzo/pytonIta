importa code
c = code.InteractiveConsole()
per riga in ["x = [1, 2]", "x.aggiungi(Vero)", "x", "se x:", "    stampa('dentro', lunghezza_di(x))", "", "1/0", "non_esiste"]:
    c.push(riga)
da _pyrepl.console importa InteractiveColoredConsole
