definisci fattoriale(n):
    se n <= 1:
        ritorna 1
    ritorna n * fattoriale(n - 1)

classe Animale:
    definisci __inizializza__(se_stesso, nome):
        se_stesso.nome = nome

    definisci parla(se_stesso):
        ritorna f"{se_stesso.nome} fa miao"

stampa(fattoriale(5), Vero e non Falso, Nessuno è Nessuno)
riga_testo = tipo_lista(intervallo_di(4))
riga_testo.aggiungi(9)
stampa(riga_testo, lunghezza_di(riga_testo), ", ".unisci(["a", "b"]).maiuscolo())
stampa(Animale("Micio").parla())
prova:
    1 / 0
eccetto DivisionePerZero come errore:
    stampa("errore:", errore)
per i in intervallo_di(3):
    se i == 1:
        continua
    stampa(i)
stampa(print)
