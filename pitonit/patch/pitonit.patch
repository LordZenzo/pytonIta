+# --------------------------------------------------------------------------
+# Strumenti per i moduli italiani delle librerie (usati da Lib/<modulo>.py)
+# --------------------------------------------------------------------------
+import functools as _ft
+
+
+def _proprietario(tipo, nome):
+    for k in tipo.__mro__:
+        if nome in vars(k):
+            return k
+    return None
+
+
+def alias_tipo(tipo, mappa):
+    """Aggiunge a `tipo` i nomi italiani {italiano: inglese} dei suoi attributi."""
+    for it, en in mappa.items():
+        if en.startswith("@"):                  # attributo di istanza
+            n = en[1:]
+            setattr(tipo, it, property(lambda self, n=n: getattr(self, n),
+                                       lambda self, v, n=n: setattr(self, n, v)))
+            continue
+        k = _proprietario(tipo, en)
+        if k is None:
+            raise AttributeError(f"{tipo.__name__} non ha '{en}' (alias '{it}')")
+        if vars(k).get(it) is vars(k)[en]:
+            continue
+        _v = vars(k)[en]
+        if getattr(getattr(_v, '__func__', _v), '_ponte_it', None):
+            raise ValueError(f"{en} e' un metodo di ponte ({it})")
+        try:
+            setattr(k, it, _delega(vars(k)[en], en, it))
+        except TypeError:                      # tipi scritti in C
+            if not _b._aggiungi_alias(k, en, it):
+                raise
+
+
+
+def _delega(v, en, it):
+    """Alias che rispetta le sottoclassi: richiama sempre il nome inglese
+    (cosi' se una sottoclasse ridefinisce `submit`, `invia` usa la sua versione)."""
+    import types
+    if isinstance(v, types.FunctionType):
+        def alias(self, *a, **k):
+            return getattr(self, en)(*a, **k)
+        alias.__name__ = it
+        alias.__qualname__ = it
+        alias.__doc__ = v.__doc__
+        return alias
+    if isinstance(v, property):
+        return property(
+            lambda self: getattr(self, en),
+            (lambda self, val: setattr(self, en, val)) if v.fset else None,
+            (lambda self: delattr(self, en)) if v.fdel else None,
+            v.__doc__)
+    if isinstance(v, classmethod) and isinstance(v.__func__, types.FunctionType):
+        def alias(cls, *a, **k):
+            return getattr(cls, en)(*a, **k)
+        alias.__name__ = it
+        return classmethod(alias)
+    return v
+
+
+def traduci_kw(f, mappa, valori=None):
+    """Avvolge f perche' accetti le opzioni italiane (anche i valori testuali)."""
+    if getattr(f, "_kw_it", False):
+        return f
+
+    @_ft.wraps(f)
+    def avvolta(*a, **k):
+        if k:
+            n = {}
+            for x, v in k.items():
+                x = mappa.get(x, x)
+                if valori and isinstance(v, str) and x in valori:
+                    v = valori[x].get(v, v)
+                n[x] = v
+            k = n
+        return f(*a, **k)
+    avvolta._kw_it = True
+    return avvolta
+
+
+def kw_tipo(tipo, metodi, mappa, valori=None):
+    """Fa accettare le opzioni italiane ai metodi indicati (nomi inglesi)."""
+    for nome in metodi:
+        k = _proprietario(tipo, nome)
+        if k is None:
+            continue
+        setattr(k, nome, traduci_kw(vars(k)[nome], mappa, valori))
+
+
+def ottieni(modulo, percorso):
+    """_orig.a.b.c a partire da 'a.b.c'."""
+    x = modulo
+    for p in percorso.split("."):
+        x = getattr(x, p)
+    return x
+
+
+def ponte(tipo, mappa):
+    """Per i metodi che la libreria richiama per nome (setUp, run, do_GET...).
+
+    mappa: {nome_inglese: nome_italiano}. Se la sottoclasse definisce il nome
+    italiano, la libreria lo usa; altrimenti usa il metodo originale."""
+    for en, it in mappa.items():
+        k = _proprietario(tipo, en)
+        if k is None:
+            raise AttributeError(f"{tipo.__name__} non ha '{en}'")
+        originale = vars(k)[en]
+        statico = isinstance(originale, (classmethod, staticmethod))
+        funzione = originale.__func__ if statico else originale
+
+        def fabbrica(funzione, it, classe):
+            if classe:
+                def m(cls, *a, **k):
+                    f = getattr(cls, it, None)
+                    return f(*a, **k) if f else funzione(cls, *a, **k)
+                m._ponte_it = it
+                return classmethod(m)
+
+            def m(self, *a, **k):
+                f = getattr(self, it, None)
+                return f(*a, **k) if f else funzione(self, *a, **k)
+            m._ponte_it = it
+            return m
+        setattr(k, en, fabbrica(funzione, it, isinstance(originale, classmethod)))
+
+
+def applica_auto(glob, orig, nomi, tipi):
+    """Applica gli alias generati dal glossario, senza mai sovrascrivere nulla."""
+    for it, en in nomi.items():
+        if it not in glob:
+            try:
+                glob[it] = ottieni(orig, en)
+            except AttributeError:
+                pass
+    for cn, mappa in tipi.items():
+        try:
+            t = getattr(orig, cn)
+        except AttributeError:
+            continue
+        for it, en in mappa.items():
+            if hasattr(t, it):
+                continue
+            try:
+                alias_tipo(t, {it: en})
+            except Exception:
+                pass
+
