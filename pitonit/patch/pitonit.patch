+    class abbina(zip):
+        """abbina(*liste, rigoroso=Falso): come zip, con l'opzione «rigoroso»."""
+        def __new__(cls, *iterabili, rigoroso=None, **k):
+            if rigoroso is not None:
+                k["strict"] = rigoroso
+            return super().__new__(cls, *iterabili, **k)
