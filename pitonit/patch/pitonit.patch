+   di un tipo scritto in C, anche se immutabile: serve per i metodi italiani
+   che accettano anche le opzioni con nome in italiano (ordina(chiave=...)). */
+static PyObject *
+builtin__imposta_nel_tipo(PyObject *module, PyObject *args)
+{
+    PyObject *tipo, *nome, *valore;
+    if (!PyArg_ParseTuple(args, "OUO", &tipo, &nome, &valore)) {
+        return NULL;
+    }
+    if (!PyType_Check(tipo)) {
+        PyErr_SetString(PyExc_TypeError, "serve un tipo");
+        return NULL;
+    }
+    PyObject *dict = PyType_GetDict((PyTypeObject *)tipo);
+    if (dict == NULL) {
+        Py_RETURN_FALSE;
+    }
+    PyObject *chiave = Py_NewRef(nome);
+    PyUnicode_InternInPlace(&chiave);
+    int r = PyDict_SetItem(dict, chiave, valore);
+    Py_DECREF(chiave);
+    Py_DECREF(dict);
+    if (r < 0) {
+        return NULL;
+    }
+    PyType_Modified((PyTypeObject *)tipo);
+    Py_RETURN_TRUE;
+}
