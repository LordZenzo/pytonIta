+    if (PyDict_SetItem(sysdict, &_Py_ID(stderr), pstderr) < 0) {
+        goto error;
+    }
+    if (PyDict_SetItemString(sysdict, "__stderr__", pstderr) < 0) {
+        goto error;
+    }
+    Py_DECREF(pstderr);
+    return _PyStatus_OK();
+
+error:
+    Py_XDECREF(pstderr);
+    return _PyStatus_ERR("can't set preliminary stderr");
+}
