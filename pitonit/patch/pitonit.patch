+    (str, "codifica", "encode", {"codifica": "encoding", "errori": "errors"}),
+    (bytes, "decodifica", "decode", {"codifica": "encoding", "errori": "errors"}),
+    (str, "sostituisci", "replace", {"conteggio": "count"}),
