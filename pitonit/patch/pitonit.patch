+def traduci_errore(testo):
+    """Traduce in italiano un messaggio/traceback di errore."""
+    for en, it in _FRASI:
+        testo = testo.replace(en, it)
+    for rx, sost in _REGEX:
+        testo = rx.sub(sost, testo)
+    righe = []
+    for riga in testo.split("\n"):
+        m = _re.match(r"^((?:\w+\.)*)(\w+)(:.*|)$", riga)
+        if m and m.group(2) in _NOMI_INVERSI and m.group(1) in ("", "builtins."):
+            riga = _NOMI_INVERSI[m.group(2)] + m.group(3)
+        righe.append(riga)
+    return "\n".join(righe)
+
+
+def _gancio_errori(tipo, valore, tb):
+    import traceback
+    testo = "".join(traceback.format_exception(tipo, valore, tb))
+    sys.stderr.write(traduci_errore(testo))
+
