+def _costruisci_builtins():
+    # Nomi italiani IN AGGIUNTA a quelli inglesi: il codice inglese eseguito da
+    # moduli italiani (dataclasses, namedtuple, enum... usano exec) deve
+    # continuare a funzionare con gli stessi globals.
+    d = dict(vars(_b))
+    traduzioni = {**FUNZIONI, **ECCEZIONI}
+    for nome, valore in vars(_b).items():
+        if nome in traduzioni:
+            d[traduzioni[nome]] = valore
+    return d
+
+
+# Dizionario usato come __builtins__ dal codice italiano (nomi italiani + inglesi).
+builtins_italiani = _costruisci_builtins()
+
