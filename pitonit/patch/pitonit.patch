+def _installa_alias():
+    import _io
+    tipi = [str, bytes, bytearray, list, dict, set, frozenset, tuple,
+            int, float, complex]
+    for nome in ("_IOBase", "_RawIOBase", "_BufferedIOBase", "_TextIOBase",
+                 "TextIOWrapper", "BufferedReader", "BufferedWriter",
+                 "BufferedRandom", "FileIO", "StringIO", "BytesIO"):
+        t = getattr(_io, nome, None)
+        if t is not None:
+            tipi.append(t)
+    aggiungi = _b._aggiungi_alias
+    for t in tipi:
+        for en, it in METODI.items():
+            aggiungi(t, en, it)
+
