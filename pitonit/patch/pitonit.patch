+# (tipo, nome italiano, nome inglese, opzioni)
+_KW_METODI = [
+    (list, "ordina", "sort", {"chiave": "key", "inverso": "reverse"}),
+    (str, "separa", "split", {"separatore": "sep", "max_divisioni": "maxsplit"}),
+    (str, "separa_da_destra", "rsplit", {"separatore": "sep", "max_divisioni": "maxsplit"}),
