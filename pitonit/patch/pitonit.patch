diff --git a/Lib/_controlla.py b/Lib/_controlla.py
new file mode 100644
index 0000000..1c305a1
--- /dev/null
+++ b/Lib/_controlla.py
@@ -0,0 +1,523 @@
+"""pitonit - controllo statico dei programmi .pit.
+
+Trova gli errori che nascono dagli alias italiani e che altrimenti
+comparirebbero tardi, con messaggi poco chiari, oppure mai (rami non eseguiti).
+
+ERRORI GRAVI (bloccano l'esecuzione):
+  * una parola chiave usata come nome: inglese («pass», «None», «class»...) o
+    italiana («classe», «da», «con»...);
+  * una funzione predefinita nascosta da una variabile e poi richiamata
+    (``testo = "a"`` ... ``testo(5)``).
+
+AVVISI (solo con ``pitonit -m _controlla file.pit``):
+  * funzioni predefinite nascoste da una variabile (anche se non richiamate);
+  * nomi inglesi al posto di quelli italiani (``print`` -> ``stampa``);
+  * nomi non definiti.
+
+Una riga con il commento ``# controlla: ok`` non viene segnalata.
+Per saltare tutto il controllo: variabile d'ambiente PITONIT_SENZA_CONTROLLO=1.
+"""
+import ast
+import builtins
+import keyword
+import os
+import sys
+
+FLAG_ITALIANO = 0x10000
+
+# parola chiave inglese -> italiana
+KW_INGLESI = {
+    "False": "Falso", "None": "Nessuno", "True": "Vero", "and": "e",
+    "as": "come", "assert": "asserisci", "async": "asincrono",
+    "await": "attendi", "break": "interrompi", "class": "classe",
+    "continue": "continua", "def": "definisci", "del": "elimina",
+    "elif": "altrimenti_se", "else": "altrimenti", "except": "eccetto",
+    "finally": "infine", "for": "per", "from": "da", "global": "globale",
+    "if": "se", "import": "importa", "is": "è", "not": "non", "or": "o",
+    "pass": "passa", "raise": "solleva", "return": "ritorna", "try": "prova",
+    "while": "mentre", "with": "con", "yield": "produci",
+}
+# parole chiave italiane (quelle uguali all'inglese, «in» e «lambda»,
+# «nonlocal», non sono errori)
+KW_ITALIANE = {
+    "e", "come", "asserisci", "asincrono", "attendi", "interrompi", "classe",
+    "continua", "definisci", "elimina", "altrimenti_se", "altrimenti",
+    "eccetto", "infine", "per", "da", "globale", "se", "importa", "è", "non",
+    "o", "passa", "solleva", "ritorna", "prova", "mentre", "con", "produci",
+}
+
+# lettere che si confondono con un numero o tra loro: non si usano come nomi
+NOMI_AMBIGUI = {"l", "I"}
+# nomi di una lettera di uso comune (contatori, coordinate, numeri): non si segnalano
+LETTERE_AMMESSE = {"i", "j", "k", "n", "x", "y", "z"}
+
+_SOLO_GENERE_VARIABILE ={"param", "assign", "for", "with", "except"}
+_SPECIALI = {"__file__", "__name__", "__doc__", "__builtins__", "__spec__",
+             "__loader__", "__package__", "__path__", "__cached__",
+             "__annotations__", "__class__", "__debug__", "__dict__"}
+
+
+def _italiani():
+    """(dizionario inglese->italiano dei builtin, insieme dei nomi italiani)"""
+    try:
+        import _italiano
+        en_it = {}
+        en_it.update(_italiano.FUNZIONI)
+        en_it.update(_italiano.ECCEZIONI)
+        return en_it
+    except Exception:
+        return {}
+
+
+EN_IT = _italiani()
+NOMI_IT = set(EN_IT.values())
+# funzioni predefinite richiamabili (italiane e inglesi): se una variabile con
+# questo nome viene richiamata, di solito nascondeva la funzione
+_ESCLUSI = {"exit", "quit", "copyright", "credits", "license", "help",
+            "esci", "termina", "diritti_d_autore", "riconoscimenti",
+            "licenza", "aiuto"}
+PREDEFINITE = {n for n in (set(EN_IT) | NOMI_IT)
+               if n not in _ESCLUSI and not n.startswith("_")
+               and n[:1].lower() == n[:1]}
+
+
+class Ambito:
+    def __init__(self, tipo, padre):
+        self.tipo = tipo            # modulo | funzione | classe | comprensione
+        self.padre = padre
+        self.lega = {}              # nome -> [(genere, riga, colonna)]
+        self.globali = set()
+        self.nonlocali = set()
+
+    def aggiungi(self, nome, genere, nodo):
+        self.lega.setdefault(nome, []).append(
+            (genere, getattr(nodo, "lineno", 0), getattr(nodo, "col_offset", 0)))
+
+
+class Analizzatore(ast.NodeVisitor):
+    def __init__(self):
+        self.modulo = Ambito("modulo", None)
+        self.ambiti = [self.modulo]
+        self.corrente = self.modulo
+        self.usi = []                # (ambito, nome, nodo, è_chiamata)
+        self.tutti = []              # (ambito, nome, nodo, genere) di ogni legame
+        self.nomi_parole = []        # (nodo, nome, tipo) per le parole chiave
+        self.stella = False          # from x import *
+        self.genere = "assign"
+
+    # ---- utilità
+    def _lega(self, nome, genere, nodo):
+        amb = self.corrente
+        if nome in amb.globali:
+            amb = self.modulo
+        self.nomi_parole.append((nodo, nome))
+        self.tutti.append((amb, nome, nodo, genere))
+        amb.aggiungi(nome, genere, nodo)
+
+    def _lega_membro(self, nome, genere, nodo):
+        """Un metodo o una classe interna è un attributo: non conta come nome libero."""
+        if self.corrente.tipo == "classe":
+            self.corrente.aggiungi(nome, genere, nodo)
+        else:
+            self._lega(nome, genere, nodo)
+
+    def _entra(self, tipo):
+        nuovo = Ambito(tipo, self.corrente)
+        self.ambiti.append(nuovo)
+        self.corrente = nuovo
+        return nuovo
+
+    def _esci(self):
+        self.corrente = self.corrente.padre
+
+    def _bersaglio(self, nodo, genere):
+        precedente = self.genere
+        self.genere = genere
+        self.visit(nodo)
+        self.genere = precedente
+
+    # ---- nomi
+    def visit_Name(self, n):
+        if isinstance(n.ctx, ast.Store):
+            self._lega(n.id, self.genere, n)
+        elif isinstance(n.ctx, ast.Load):
+            self.nomi_parole.append((n, n.id))
+            self.usi.append((self.corrente, n.id, n, False))
+
+    def visit_Call(self, n):
+        if isinstance(n.func, ast.Name):
+            self.nomi_parole.append((n.func, n.func.id))
+            self.usi.append((self.corrente, n.func.id, n.func, True))
+        else:
+            self.visit(n.func)
+        for a in n.args:
+            self.visit(a)
+        for k in n.keywords:
+            self.visit(k.value)
+
+    def visit_Global(self, n):
+        self.corrente.globali.update(n.names)
+        for nome in n.names:
+            self.nomi_parole.append((n, nome))
+
+    def visit_Nonlocal(self, n):
+        self.corrente.nonlocali.update(n.names)
+
+    # ---- assegnazioni e cicli
+    def visit_Assign(self, n):
+        self.visit(n.value)
+        # `nome = lambda ...` definisce una funzione: è un modo voluto di chiamarla
+        genere = "def" if isinstance(n.value, ast.Lambda) else "assign"
+        for t in n.targets:
+            self._bersaglio(t, genere)
+
+    def visit_AugAssign(self, n):
+        self.visit(n.value)
+        if isinstance(n.target, ast.Name):
+            self.usi.append((self.corrente, n.target.id, n.target, False))
+        self._bersaglio(n.target, "assign")
+
+    def visit_AnnAssign(self, n):
+        if n.value is not None:
+            self.visit(n.value)
+        self.visit(n.annotation)
+        if n.value is not None or not isinstance(n.target, ast.Name):
+            self._bersaglio(n.target, "assign")
+
+    def visit_NamedExpr(self, n):
+        self.visit(n.value)
+        amb = self.corrente
+        while amb.tipo == "comprensione" and amb.padre is not None:
+            amb = amb.padre
+        vecchio = self.corrente
+        self.corrente = amb
+        self._lega(n.target.id, "assign", n.target)
+        self.corrente = vecchio
+
+    def visit_For(self, n):
+        self.visit(n.iter)
+        self._bersaglio(n.target, "for")
+        for s in n.body + n.orelse:
+            self.visit(s)
+
+    visit_AsyncFor = visit_For
+
+    def visit_With(self, n):
+        for item in n.items:
+            self.visit(item.context_expr)
+            if item.optional_vars is not None:
+                self._bersaglio(item.optional_vars, "with")
+        for s in n.body:
+            self.visit(s)
+
+    visit_AsyncWith = visit_With
+
+    def visit_ExceptHandler(self, n):
+        if n.type is not None:
+            self.visit(n.type)
+        if n.name:
+            self._lega(n.name, "except", n)
+        for s in n.body:
+            self.visit(s)
+
+    def visit_Import(self, n):
+        for a in n.names:
+            nome = a.asname or a.name.split(".")[0]
+            self._lega(nome, "import", n)
+
+    def visit_ImportFrom(self, n):
+        for a in n.names:
+            if a.name == "*":
+                self.stella = True
+            else:
+                self._lega(a.asname or a.name, "import", n)
+
+    def visit_MatchAs(self, n):
+        if n.name:
+            self._lega(n.name, "assign", n)
+        if n.pattern is not None:
+            self.visit(n.pattern)
+
+    def visit_MatchStar(self, n):
+        if n.name:
+            self._lega(n.name, "assign", n)
+
+    def visit_MatchMapping(self, n):
+        for k in n.keys:
+            self.visit(k)
+        for p in n.patterns:
+            self.visit(p)
+        if n.rest:
+            self._lega(n.rest, "assign", n)
+
+    # ---- funzioni, classi, comprensioni
+    def _parametri(self, args):
+        for a in args.posonlyargs + args.args + args.kwonlyargs:
+            self._lega(a.arg, "param", a)
+        if args.vararg:
+            self._lega(args.vararg.arg, "param", args.vararg)
+        if args.kwarg:
+            self._lega(args.kwarg.arg, "param", args.kwarg)
+
+    def _predefiniti(self, args):
+        for d in args.defaults + [d for d in args.kw_defaults if d is not None]:
+            self.visit(d)
+        for a in args.posonlyargs + args.args + args.kwonlyargs:
+            if a.annotation is not None:
+                self.visit(a.annotation)
+
+    def _funzione(self, n):
+        for d in n.decorator_list:
+            self.visit(d)
+        self._predefiniti(n.args)
+        if n.returns is not None:
+            self.visit(n.returns)
+        self._lega_membro(n.name, "def", n)
+        self._entra("funzione")
+        self._parametri(n.args)
+        for s in n.body:
+            self.visit(s)
+        self._esci()
+
+    visit_FunctionDef = _funzione
+    visit_AsyncFunctionDef = _funzione
+
+    def visit_Lambda(self, n):
+        self._predefiniti(n.args)
+        self._entra("funzione")
+        self._parametri(n.args)
+        self.visit(n.body)
+        self._esci()
+
+    def visit_ClassDef(self, n):
+        for d in n.decorator_list:
+            self.visit(d)
+        for b in n.bases:
+            self.visit(b)
+        for k in n.keywords:
+            self.visit(k.value)
+        self._lega_membro(n.name, "class", n)
+        self._entra("classe")
+        for s in n.body:
+            self.visit(s)
+        self._esci()
+
+    def _comprensione(self, n):
+        prima = n.generators[0]
+        self.visit(prima.iter)
+        self._entra("comprensione")
+        for i, g in enumerate(n.generators):
+            if i > 0:
+                self.visit(g.iter)
+            self._bersaglio(g.target, "for")
+            for c in g.ifs:
+                self.visit(c)
+        if isinstance(n, ast.DictComp):
+            self.visit(n.key)
+            self.visit(n.value)
+        else:
+            self.visit(n.elt)
+        self._esci()
+
+    visit_ListComp = visit_SetComp = visit_GeneratorExp = visit_DictComp = _comprensione
+
+
+def _risolvi(ambito, nome):
+    """L'ambito che lega `nome` visto da `ambito`, o None."""
+    if nome in ambito.globali:
+        return _modulo(ambito) if nome in _modulo(ambito).lega else None
+    primo = True
+    s = ambito
+    while s is not None:
+        if (primo or s.tipo != "classe") and nome in s.lega:
+            return s
+        primo = False
+        s = s.padre
+    return None
+
+
+def _modulo(ambito):
+    while ambito.padre is not None:
+        ambito = ambito.padre
+    return ambito
+
+
+def _riga(righe, n):
+    return righe[n - 1] if 0 < n <= len(righe) else ""
+
+
+def analizza(sorgente, percorso="<stringa>"):
+    """-> (errori, avvisi, righe): liste di (riga, colonna, messaggio)."""
+    if isinstance(sorgente, str):
+        dati = sorgente.encode("utf-8")
+    else:
+        dati = sorgente
+    try:
+        albero = compile(dati, percorso, "exec", FLAG_ITALIANO | ast.PyCF_ONLY_AST,
+                         dont_inherit=True)
+    except (SyntaxError, ValueError):
+        return [], [], []          # ci pensa l'esecuzione normale
+    testo = dati.decode("utf-8", "replace").lstrip("﻿")
+    righe = testo.splitlines()
+    if any("controlla: ignora-file" in r for r in righe[:5]):
+        return [], [], righe
+    an = Analizzatore()
+    an.visit(albero)
+
+    errori, avvisi = [], []
+
+    def segnala(lista, nodo, msg):
+        riga = getattr(nodo, "lineno", 0)
+        if "controlla: ok" in _riga(righe, riga):
+            return
+        lista.append((riga, getattr(nodo, "col_offset", 0), msg))
+
+    # 1. parole chiave usate come nomi (nomi, parametri, def, class, ...)
+    viste = set()
+
+    def parola(nodo, nome):
+        chiave = (getattr(nodo, "lineno", 0), getattr(nodo, "col_offset", 0), nome)
+        if chiave in viste:
+            return
+        viste.add(chiave)
+        if nome in KW_INGLESI and nome not in ("in", "lambda"):
+            segnala(errori, nodo,
+                    f"«{nome}» è una parola chiave inglese: in pytonIta si scrive «{KW_INGLESI[nome]}»")
+        elif nome in ("e", "o"):
+            segnala(errori, nodo,
+                    f"«{nome}» è l'operatore «{'and' if nome == 'e' else 'or'}» e una lettera sola non è un nome chiaro: "
+                    f"usa un nome intero (per esempio «evento», «errore», «elemento»)")
+        elif nome in NOMI_AMBIGUI:
+            segnala(errori, nodo,
+                    f"«{nome}» si confonde con altri caratteri (1, l, I): scegli un altro nome")
+        elif nome in KW_ITALIANE:
+            segnala(errori, nodo,
+                    f"«{nome}» è una parola chiave: non si può usare come nome di variabile, funzione o parametro (scegline un altro)")
+
+    for nodo, nome in an.nomi_parole:
+        parola(nodo, nome)
+    for nodo in ast.walk(albero):
+        if isinstance(nodo, ast.arg):
+            parola(nodo, nodo.arg)
+
+    # 2. funzioni predefinite nascoste da una variabile e richiamate
+    for ambito, nome, nodo, chiamata in an.usi:
+        if not (chiamata and nome in PREDEFINITE):
+            continue
+        s = _risolvi(ambito, nome)
+        if s is None:
+            continue
+        generi = {g for g, _, _ in s.lega[nome]}
+        if generi <= _SOLO_GENERE_VARIABILE:
+            riga0 = s.lega[nome][0][1]
+            segnala(errori, nodo,
+                    f"{nome}(...) richiama la variabile «{nome}» (definita alla riga {riga0}), "
+                    f"che nasconde la funzione predefinita {nome}(): cambia il nome della variabile")
+
+    # avvisi: funzione o classe definita due volte nello stesso ambito (la seconda cancella la prima)
+    for contenitore in ast.walk(albero):
+        if not isinstance(contenitore, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
+            continue
+        definite = {}
+        for istruzione in contenitore.body:
+            if not isinstance(istruzione, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) or istruzione.decorator_list:
+                continue
+            if istruzione.name in definite:
+                segnala(avvisi, istruzione, f"«{istruzione.name}» è già definita alla riga {definite[istruzione.name]}: "
+                                            f"vale solo l'ultima, la prima non verrà mai usata")
+            definite[istruzione.name] = istruzione.lineno
+    # avvisi: funzioni predefinite nascoste (anche se non richiamate)
+    for ambito in an.ambiti:
+        for nome, legami in ambito.lega.items():
+            if nome in PREDEFINITE:
+                genere, riga, col = legami[0]
+                if ambito.tipo == "classe" and genere in ("def", "class"):
+                    continue
+                if "controlla: ok" not in _riga(righe, riga):
+                    avvisi.append((riga, col, f"«{nome}» nasconde la funzione predefinita {nome}()"))
+    # avvisi: nomi di una sola lettera (tranne quelli di uso comune in matematica e nei cicli)
+    for amb_, nome, nodo, genere in an.tutti:
+        if len(nome) == 1 and nome not in LETTERE_AMMESSE and nome != "_" and isinstance(nodo, (ast.Name, ast.arg)):
+            if nome in NOMI_AMBIGUI or nome in ("e", "o"):
+                continue            # già un errore grave
+            segnala(avvisi, nodo, f"«{nome}» è un nome di una sola lettera: scegli un nome che dica cosa contiene "
+                                  f"(le lettere i, j, k, n, x, y, z sono ammesse)")
+    # avvisi: nomi inglesi e nomi non definiti
+    for ambito, nome, nodo, chiamata in an.usi:
+        s = _risolvi(ambito, nome)
+        if s is None:
+            if an.stella:
+                continue
+            if nome in EN_IT and nome not in _ESCLUSI and EN_IT[nome] != nome:
+                segnala(avvisi, nodo, f"«{nome}» è inglese: in pytonIta si scrive «{EN_IT[nome]}»")
+            elif (nome not in NOMI_IT and nome not in KW_INGLESI and not hasattr(builtins, nome)
+                  and nome not in _SPECIALI):
+                segnala(avvisi, nodo, f"il nome «{nome}» non è definito")
+    return errori, avvisi, righe
+
+
+def stampa_problemi(percorso, righe, problemi, etichetta, file=None):
+    file = file or sys.stderr
+    for riga, col, msg in sorted(problemi):
+        print(f'  File "{percorso}", riga {riga}', file=file)
+        testo = _riga(righe, riga).rstrip()
+        if testo:
+            print("    " + testo.strip(), file=file)
+        print(f"{etichetta}: {msg}", file=file)
+
+
+def controlla_file(percorso):
+    """Restituisce il numero di errori gravi (li stampa su stderr)."""
+    if os.environ.get("PITONIT_SENZA_CONTROLLO"):
+        return 0
+    try:
+        with open(percorso, "rb") as f:
+            dati = f.read()
+    except OSError:
+        return 0
+    errori, _, righe = analizza(dati, percorso)
+    if not errori:
+        return 0
+    print("Errori gravi trovati prima dell'esecuzione:", file=sys.stderr)
+    stampa_problemi(percorso, righe, errori, "ErroreGrave")
+    n = len(errori)
+    print(f"\nEsecuzione bloccata: {n} {'errore grave' if n == 1 else 'errori gravi'}. "
+          f"(Per saltare il controllo: PITONIT_SENZA_CONTROLLO=1; "
+          f"per ignorare una riga: # controlla: ok)", file=sys.stderr)
+    return n
+
+
+def controlla_sorgente_importata(sorgente, percorso):
+    """Per i moduli .pit importati: solleva SyntaxError se ci sono errori gravi."""
+    if os.environ.get("PITONIT_SENZA_CONTROLLO"):
+        return
+    errori, _, _ = analizza(sorgente, str(percorso))
+    if errori:
+        riga, col, msg = sorted(errori)[0]
+        altri = len(errori) - 1
+        if altri:
+            msg += f"  (e altri {altri} errori gravi nello stesso file)"
+        e = SyntaxError(msg)
+        e.filename, e.lineno, e.offset = str(percorso), riga, col + 1
+        e.text = None
+        raise e
+
+
+def main(argv):
+    """pitonit -m _controlla file.pit [altri.pit ...]"""
+    if not argv:
+        print("uso: pitonit -m _controlla file.pit [...]", file=sys.stderr)
+        return 2
+    tot_err = 0
+    for percorso in argv:
+        with open(percorso, "rb") as f:
+            dati = f.read()
+        errori, avvisi, righe = analizza(dati, percorso)
+        stampa_problemi(percorso, righe, errori, "ErroreGrave", sys.stdout)
+        stampa_problemi(percorso, righe, avvisi, "Avviso", sys.stdout)
+        tot_err += len(errori)
+    return 1 if tot_err else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
