+
+
+def _delega(v, en, it):
+    """Alias che rispetta le sottoclassi: richiama sempre il nome inglese
+    (cosi' se una sottoclasse ridefinisce `submit`, `invia` usa la sua versione)."""
+    import types
+    if isinstance(v, types.FunctionType):
+        def alias(self, *a, **k):
+            return getattr(self, en)(*a, **k)
+        alias.__name__ = it
+        alias.__qualname__ = it
+        alias.__doc__ = v.__doc__
+        return alias
+    if isinstance(v, property):
+        return property(
+            lambda self: getattr(self, en),
+            (lambda self, val: setattr(self, en, val)) if v.fset else None,
+            (lambda self: delattr(self, en)) if v.fdel else None,
+            v.__doc__)
+    if isinstance(v, classmethod) and isinstance(v.__func__, types.FunctionType):
+        def alias(cls, *a, **k):
+            return getattr(cls, en)(*a, **k)
+        alias.__name__ = it
+        return classmethod(alias)
+    return v
+
+
+def traduci_kw(f, mappa, valori=None):
+    """Avvolge f perche' accetti le opzioni italiane (anche i valori testuali)."""
+    if getattr(f, "_kw_it", False):
+        return f
+
+    @_ft.wraps(f)
+    def avvolta(*a, **k):
+        if k:
+            n = {}
+            for x, v in k.items():
+                x = mappa.get(x, x)
+                if valori and isinstance(v, str) and x in valori:
+                    v = valori[x].get(v, v)
+                n[x] = v
+            k = n
+        return f(*a, **k)
+    avvolta._kw_it = True
+    return avvolta
+
+
+def kw_tipo(tipo, metodi, mappa, valori=None):
+    """Fa accettare le opzioni italiane ai metodi indicati (nomi inglesi)."""
+    for nome in metodi:
+        k = _proprietario(tipo, nome)
+        if k is None:
+            continue
+        setattr(k, nome, traduci_kw(vars(k)[nome], mappa, valori))
