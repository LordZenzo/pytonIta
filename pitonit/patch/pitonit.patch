-    }
-
-    PySys_WriteStderr("'");
-    for (; *str != L'\0'; str++) {
-        unsigned int ch = (unsigned int)*str;
-        if (ch == L'\'') {
-            PySys_WriteStderr("\\'");
-        } else if (0x20 <= ch && ch < 0x7f) {
-            PySys_WriteStderr("%c", ch);
-        }
-        else if (ch <= 0xff) {
-            PySys_WriteStderr("\\x%02x", ch);
-        }
-#if SIZEOF_WCHAR_T > 2
-        else if (ch > 0xffff) {
-            PySys_WriteStderr("\\U%08x", ch);
-        }
-#endif
-        else {
-            PySys_WriteStderr("\\u%04x", ch);
-        }
-    }
-    PySys_WriteStderr("'");
-}
