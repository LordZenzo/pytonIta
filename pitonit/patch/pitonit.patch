+
+def ottieni(modulo, percorso):
+    """_orig.a.b.c a partire da 'a.b.c'."""
+    x = modulo
+    for p in percorso.split("."):
+        x = getattr(x, p)
+    return x
+
+
+def ponte(tipo, mappa):
+    """Per i metodi che la libreria richiama per nome (setUp, run, do_GET...).
+
+    mappa: {nome_inglese: nome_italiano}. Se la sottoclasse definisce il nome
+    italiano, la libreria lo usa; altrimenti usa il metodo originale."""
+    for en, it in mappa.items():
+        k = _proprietario(tipo, en)
+        if k is None:
+            raise AttributeError(f"{tipo.__name__} non ha '{en}'")
+        originale = vars(k)[en]
+        statico = isinstance(originale, (classmethod, staticmethod))
+        funzione = originale.__func__ if statico else originale
+
+        def fabbrica(funzione, it, classe):
+            if classe:
+                def m(cls, *a, **k):
+                    f = getattr(cls, it, None)
+                    return f(*a, **k) if f else funzione(cls, *a, **k)
+                m._ponte_it = it
+                return classmethod(m)
+
+            def m(self, *a, **k):
+                f = getattr(self, it, None)
+                return f(*a, **k) if f else funzione(self, *a, **k)
+            m._ponte_it = it
+            return m
+        setattr(k, en, fabbrica(funzione, it, isinstance(originale, classmethod)))
+
+
+def applica_auto(glob, orig, nomi, tipi):
+    """Applica gli alias generati dal glossario, senza mai sovrascrivere nulla."""
+    for it, en in nomi.items():
+        if it not in glob:
+            try:
+                glob[it] = ottieni(orig, en)
+            except AttributeError:
+                pass
+    for cn, mappa in tipi.items():
+        try:
+            t = getattr(orig, cn)
+        except AttributeError:
+            continue
+        for it, en in mappa.items():
+            if hasattr(t, it):
+                continue
+            try:
+                alias_tipo(t, {it: en})
+            except Exception:
+                pass
+
