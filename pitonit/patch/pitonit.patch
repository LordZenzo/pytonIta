+static int
+should_audit(PyInterpreterState *interp)
+{
+    /* interp must not be NULL, but test it just in case for extra safety */
+    assert(interp != NULL);
+    if (!interp) {
+        return 0;
+    }
+    return (interp->runtime->audit_hooks.head
+            || interp->audit_hooks
+            || PyDTrace_AUDIT_ENABLED());
+}
