+def rappresenta(x):
+    """repr() che scrive Vero/Falso/Nessuno (anche dentro liste, tuple, ...)."""
+    t = type(x)
+    if x is True or x is False or x is None:
+        return _COSTANTI[x]
+    if t is list:
+        return "[" + ", ".join(rappresenta(i) for i in x) + "]"
+    if t is tuple:
+        if len(x) == 1:
+            return "(" + rappresenta(x[0]) + ",)"
+        return "(" + ", ".join(rappresenta(i) for i in x) + ")"
+    if t is dict:
+        return "{" + ", ".join(rappresenta(k) + ": " + rappresenta(v)
+                               for k, v in x.items()) + "}"
+    if t is set and x:
+        return "{" + ", ".join(rappresenta(i) for i in x) + "}"
+    return repr(x)
