+    builtins_italiani["abbina"] = abbina
+
+    imposta = getattr(_b, "_imposta_nel_tipo", None)
+    if imposta is None:
+        return
+    for tipo, it, en, mappa in _KW_METODI:
+        orig = vars(tipo).get(en)
+        if orig is None:
+            continue
+
+        def metodo(self, *a, _orig=orig, _mappa=mappa, **k):
+            if k:
+                k = {_mappa.get(x, x): v for x, v in k.items()}
