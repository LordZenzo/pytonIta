-                                "or an integer in range [0; 4294967295]");
-        }
-        /* Use a specific hash */
-        config->use_hash_seed = 1;
-        config->hash_seed = seed;
-    }
-    else {
-        /* Use a random hash */
-        config->use_hash_seed = 0;
-        config->hash_seed = 0;
-    }
-    return _PyStatus_OK();
