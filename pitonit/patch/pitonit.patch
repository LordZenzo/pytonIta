+    "ordinato": {"chiave": "key", "inverso": "reverse"},
+    "massimo": {"chiave": "key", "predefinito": "default"},
+    "minimo": {"chiave": "key", "predefinito": "default"},
+    "somma": {"inizio": "start"},
+    "arrotonda": {"cifre": "ndigits"},
+    "apri": {"modalita": "mode", "codifica": "encoding", "errori": "errors",
+             "a_capo": "newline"},
