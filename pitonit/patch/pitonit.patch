+/* pitonit: controllo statico del programma .pit prima di eseguirlo.
+   _controlla.controlla_file() stampa gli errori gravi su stderr e ne
+   restituisce il numero; se e' > 0 il programma non parte. Un guasto del
+   controllo stesso non blocca mai l'esecuzione. */
+static int
+pymain_controlla_file(PyObject *filename)
+{
+    PyObject *mod = PyImport_ImportModule("_controlla");
+    if (mod == NULL) {
+        PyErr_Clear();
+        return 0;
+    }
+    PyObject *res = PyObject_CallMethod(mod, "controlla_file", "O", filename);
+    Py_DECREF(mod);
+    if (res == NULL) {
+        PyErr_Clear();
+        return 0;
+    }
+    long n = PyLong_AsLong(res);
+    Py_DECREF(res);
+    if (n == -1 && PyErr_Occurred()) {
+        PyErr_Clear();
+        return 0;
+    }
+    return n > 0;
+}
