+# --------------------------------------------------------------------------
+# Strumenti per i moduli italiani delle librerie (usati da Lib/<modulo>.py)
+# --------------------------------------------------------------------------
+import functools as _ft
+
+
+def _proprietario(tipo, nome):
+    for k in tipo.__mro__:
+        if nome in vars(k):
+            return k
+    return None
+
+
+def alias_tipo(tipo, mappa):
+    """Aggiunge a `tipo` i nomi italiani {italiano: inglese} dei suoi attributi."""
+    for it, en in mappa.items():
+        if en.startswith("@"):                  # attributo di istanza
+            n = en[1:]
+            setattr(tipo, it, property(lambda self, n=n: getattr(self, n),
+                                       lambda self, v, n=n: setattr(self, n, v)))
+            continue
+        k = _proprietario(tipo, en)
+        if k is None:
+            raise AttributeError(f"{tipo.__name__} non ha '{en}' (alias '{it}')")
+        if vars(k).get(it) is vars(k)[en]:
+            continue
+        _v = vars(k)[en]
+        if getattr(getattr(_v, '__func__', _v), '_ponte_it', None):
+            raise ValueError(f"{en} e' un metodo di ponte ({it})")
+        try:
+            setattr(k, it, _delega(vars(k)[en], en, it))
+        except TypeError:                      # tipi scritti in C
+            if not _b._aggiungi_alias(k, en, it):
+                raise
