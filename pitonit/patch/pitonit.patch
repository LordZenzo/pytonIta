+static PyObject *
+get_warnoptions(PyThreadState *tstate)
+{
+    PyObject *warnoptions;
+    if (_PySys_GetOptionalAttr(&_Py_ID(warnoptions), &warnoptions) < 0) {
+        return NULL;
