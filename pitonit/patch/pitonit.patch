+static const char *const it_soft_keywords[][2] = {
+    {"confronta", "match"}, {"caso", "case"}, {"tipo", "type"},
+    {NULL, NULL}
+};
+
+/* "e" e "o" sono anche nomi di variabile molto comuni (except X as e):
+   sono operatori solo tra due operandi. */
+static int
+_it_is_operator_position(Parser *p, struct token *new_token)
+{
+    if (p->fill == 0) {
+        return 0;
+    }
+    Token *prev = p->tokens[p->fill - 1];
+    int t = prev->type;
+    int operand_end = (t == NAME || t == NUMBER || t == STRING ||
+                       t == RPAR || t == RSQB || t == RBRACE ||
+                       t == ELLIPSIS || t == FSTRING_END);
+    if (!operand_end) {
+        const char *s = PyBytes_AsString(prev->bytes);
+        operand_end = s && (strcmp(s, "Vero") == 0 || strcmp(s, "Falso") == 0 ||
+                            strcmp(s, "Nessuno") == 0);
+    }
+    if (!operand_end) {
+        return 0;
+    }
+    const char *q = new_token->end;
+    while (*q == ' ' || *q == '\t') {
+        q++;
+    }
+    switch (*q) {
+        /* "a e" + fine riga (o commento, o "\"): dopo un operando e' l'operatore, la condizione continua */
+        case '\0': case '\n': case '\r': case '#': case '\\':
+            return 1;
+    }
+    switch (*q) {
+        case '\0': case '\n': case '\r': case '=': case ',': case ')':
+        case ']': case '}': case ':': case '.': case ';': case '#': case '\\':
+            return 0;
+    }
+    return 1;
+}
+
+/* ---- pitonit: parole riservate usabili come nomi ---------------------
+   Parole come "classe", "con" (connessione), "prova", "da" sono anche nomi
+   molto naturali in italiano. Nel punto in cui una parola chiave NON puo'
+   comparire (dopo un punto, tra gli argomenti, prima di un "=", dopo un
+   operatore...) la si legge come un normale nome. Le regole sono prudenti:
+   nel dubbio resta una parola chiave. */
+
+static int
+_it_prev_word(Token *prev, const char *w)
+{
+    if (prev == NULL || prev->type == NAME || prev->bytes == NULL) {
+        return 0;
+    }
+    const char *s = PyBytes_AsString(prev->bytes);
+    return s != NULL && strcmp(s, w) == 0;
+}
+
+static int
+_it_prev_is_expr_keyword(Token *prev)
+{
+    static const char *const parole[] = {
+        "se", "altrimenti_se", "mentre", "ritorna", "in", "non", "e", "o",
+        "\xc3\xa8", "produci", "attendi", "asserisci", "elimina", "solleva",
+        "per", "come", "eccetto", "da", "importa", "lambda", NULL};
+    for (int i = 0; parole[i] != NULL; i++) {
+        if (_it_prev_word(prev, parole[i])) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int
+_it_prev_is_expr_start(Token *prev)
+{
+    switch (prev->type) {
+        case LPAR: case LSQB: case LBRACE: case COMMA: case EQUAL:
+        case PLUS: case MINUS: case STAR: case SLASH: case VBAR: case AMPER:
+        case LESS: case GREATER: case PERCENT: case EQEQUAL: case NOTEQUAL:
+        case LESSEQUAL: case GREATEREQUAL: case TILDE: case CIRCUMFLEX:
+        case LEFTSHIFT: case RIGHTSHIFT: case DOUBLESTAR: case DOUBLESLASH:
+        case AT: case RARROW: case COLONEQUAL: case PLUSEQUAL: case MINEQUAL:
+        case STAREQUAL: case SLASHEQUAL: case PERCENTEQUAL: case AMPEREQUAL:
+        case VBAREQUAL: case CIRCUMFLEXEQUAL: case LEFTSHIFTEQUAL:
+        case RIGHTSHIFTEQUAL: case DOUBLESTAREQUAL: case DOUBLESLASHEQUAL:
+        case ATEQUAL:
+            return 1;
+    }
+    return _it_prev_is_expr_keyword(prev);
+}
+
+static int
+_it_prev_is_operand_end(Token *prev)
+{
+    int t = prev->type;
+    if (t == NAME || t == NUMBER || t == STRING || t == RPAR || t == RSQB ||
+        t == RBRACE || t == ELLIPSIS || t == FSTRING_END) {
+        return 1;
+    }
+    return _it_prev_word(prev, "Vero") || _it_prev_word(prev, "Falso") ||
+           _it_prev_word(prev, "Nessuno");
+}
+
+/* dopo "da" seguito da soli punti: "da . importa x" -> "importa" e' una parola chiave */
+static int
+_it_dots_after_from(Parser *p)
+{
+    int i = p->fill - 1;
+    while (i >= 0 && (p->tokens[i]->type == DOT || p->tokens[i]->type == ELLIPSIS)) {
+        i--;
+    }
+    return i >= 0 && i < p->fill - 1 && _it_prev_word(p->tokens[i], "da");
+}
+
+static int
+_it_in_list(const char *en, const char *const *lista)
+{
+    for (int i = 0; lista[i] != NULL; i++) {
+        if (strcmp(en, lista[i]) == 0) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* "per a, in x" / "[v per w, in x]": la virgola chiude il bersaglio del ciclo, "in" e' la parola chiave */
+static int
+_it_in_for_target(Parser *p)
+{
+    int depth = 0;
+    for (int i = p->fill - 1; i >= 0; i--) {
+        Token *t = p->tokens[i];
+        if (t->type == RPAR || t->type == RSQB || t->type == RBRACE) {
+            depth++;
+        }
+        else if (t->type == LPAR || t->type == LSQB || t->type == LBRACE) {
+            if (depth == 0) {
+                return 0;
+            }
+            depth--;
+        }
+        else if (depth == 0) {
+            if (t->type == NEWLINE || t->type == INDENT || t->type == DEDENT || t->type == COLON ||
+                t->type == EQUAL || _it_prev_word(t, "in")) {
+                return 0;
+            }
+            if (_it_prev_word(t, "per")) {
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
+static int
+_it_keyword_is_name(Parser *p, struct token *tok, const char *en)
+{
+    /* le costanti restano costanti; "e"/"o" hanno la loro regola */
+    if (strcmp(en, "True") == 0 || strcmp(en, "False") == 0 || strcmp(en, "None") == 0 ||
+        strcmp(en, "and") == 0 || strcmp(en, "or") == 0) {
+        return 0;
+    }
+    Token *prev = p->fill > 0 ? p->tokens[p->fill - 1] : NULL;
+
+    if (prev != NULL) {
+        /* x.classe : attributo (ma "da . importa" e' un import relativo) */
+        if (prev->type == DOT || prev->type == ELLIPSIS) {
+            if (strcmp(en, "import") == 0 && _it_dots_after_from(p)) {
+                return 0;
+            }
+            if (prev->type == DOT) {
+                return 1;
+            }
+        }
+        /* dopo per/come/globale/nonlocale/importa serve un nome, mai una parola chiave */
+        if (_it_prev_word(prev, "per") || _it_prev_word(prev, "come") ||
+            _it_prev_word(prev, "globale") || _it_prev_word(prev, "nonlocale") ||
+            _it_prev_word(prev, "importa")) {
+            return 1;
+        }
+        /* definisci classe(...) / classe con(...) */
+        if (_it_prev_word(prev, "definisci") || _it_prev_word(prev, "classe")) {
+            return 1;
+        }
+    }
+
+    /* una parola gia' definita come funzione o classe in questo file ("definisci elimina(x)")
+       resta un nome: si puo' quindi anche chiamare come istruzione */
+    {
+        int len = (int)(tok->end - tok->start);
+        for (int i = p->fill - 1; i >= 1; i--) {
+            Token *t = p->tokens[i];
+            if (t->type == NAME && t->bytes != NULL &&
+                PyBytes_GET_SIZE(t->bytes) == len &&
+                memcmp(PyBytes_AS_STRING(t->bytes), tok->start, len) == 0 &&
+                (_it_prev_word(p->tokens[i - 1], "definisci") ||
+                 _it_prev_word(p->tokens[i - 1], "classe"))) {
+                return 1;
+            }
+        }
+    }
+
+    /* "elimina(x)" attaccato alla parentesi e' una chiamata (nome di funzione o parametro), non "del (x)":
+       chi vuole cancellare un nome scrive "elimina x" */
+    if (strcmp(en, "del") == 0 && *tok->end == '(') {
+        return 1;
