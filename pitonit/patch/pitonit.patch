+               copy previously encountered bases. */
+            if (!(new_bases = PyList_New(i))) {
+                Py_DECREF(new_base);
+                goto error;
+            }
+            for (j = 0; j < i; j++) {
+                base = args[j];
+                PyList_SET_ITEM(new_bases, j, Py_NewRef(base));
+            }
+        }
+        j = PyList_GET_SIZE(new_bases);
+        if (PyList_SetSlice(new_bases, j, j, new_base) < 0) {
+            Py_DECREF(new_base);
+            goto error;
+        }
