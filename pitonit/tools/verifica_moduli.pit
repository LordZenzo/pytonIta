importa importlib
importa sistema

moduli = apri(sistema.argomenti[1], encoding="utf-8").leggi_tutto().split()
errori = 0
per nome in moduli:
    prova:
        importlib.import_module(nome)
    eccetto Eccezione come errore:
        errori += 1
        stampa(f"ERRORE {nome}: {tipo_di(errore).__name__}: {errore}")
stampa(f"{lunghezza_di(moduli) - errori}/{lunghezza_di(moduli)} moduli importati correttamente")
sistema.termina(1 se errori altrimenti 0)
